+/*
+ * wasm has no indirect branch. LLVM's WebAssembly backend lowers the computed
+ * goto by flattening every opcode handler into one irreducible dispatch loop
+ * driven by a state variable, which is the same br_table a switch would give
+ * us plus the loss of every optimisation that flattening prevents. The switch
+ * form is what the backend wants; -DMCWEB_USELABELS restores the original.
+ */
+#if defined(__EMSCRIPTEN__) && !defined(MCWEB_USELABELS)
+#undef USELABELS
+#endif
+
 #undef CASE
 #ifdef USELABELS
 #define CASE(opcode) opc ## opcode
