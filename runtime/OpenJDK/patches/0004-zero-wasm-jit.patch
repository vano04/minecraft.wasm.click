+#ifndef SHARE_INTERPRETER_ZERO_ZEROWASMCOMPILER_HPP
+#define SHARE_INTERPRETER_ZERO_ZEROWASMCOMPILER_HPP
+
+#include "memory/allStatic.hpp"
