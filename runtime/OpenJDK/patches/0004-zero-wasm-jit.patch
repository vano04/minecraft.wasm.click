+
+// Slots are intptr_t, which is 4 bytes on wasm32. The whole address model
+// below assumes that, so say so once rather than in every offset.
+STATIC_ASSERT(sizeof(intptr_t) == 4);
+static const int SLOT = 4;
+
+// -XX:ZeroWasmJITDisable is a bisection tool, not a tuning knob: with a dozen
+// independent emitters a single wrong byte anywhere shows up as a corrupt
+// class file three subsystems away, and turning them off one at a time is the
+// only way to find which one.
+enum {
+  NO_CALLS = 1, NO_ALLOC = 2, NO_TYPECHECK = 4, NO_SWITCH = 8, NO_FLOAT = 16,
+  NO_OOPSTORE = 32, NO_SHUFFLE = 64, NO_OSR = 128, NO_INLINE = 256,
+  NO_DEEPMERGE = 512
+};
+static bool disabled(int f) { return (ZeroWasmJITDisable & (uintx)f) != 0; }
