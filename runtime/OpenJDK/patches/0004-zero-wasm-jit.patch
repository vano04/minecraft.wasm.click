+EM_JS(int, zwc_install, (const unsigned char* bytes, int len), {
+  try {
+    const mod = new WebAssembly.Module(HEAPU8.subarray(bytes, bytes + len));
+    const inst = new WebAssembly.Instance(mod, { env: {
+      memory: wasmMemory,
+      __indirect_function_table: wasmTable
+    } });
+    globalThis.__zwcFns ||= [null];        // index 0 means "not compiled"
+    return globalThis.__zwcFns.push(inst.exports.f) - 1;
+  } catch (e) {
+    if (!globalThis.__zwcErr) { globalThis.__zwcErr = 1; err('[zwc] install failed: ' + e); }
+    return -1;
+  }
+});
+
+EM_JS(int, zwc_call, (int idx, int locals, int tos, int out, int istate, int entry), {
+  return globalThis.__zwcFns[idx](locals, tos, out, istate, entry);
+});
