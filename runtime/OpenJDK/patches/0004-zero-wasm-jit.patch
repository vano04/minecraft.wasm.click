+// ---------------------------------------------------------------------------
+// A very small wasm module writer
+// ---------------------------------------------------------------------------
+class WasmBuf {
+ private:
+  unsigned char* _data;
+  int _len;
+  int _cap;
+
+  void ensure(int extra) {
+    if (_len + extra <= _cap) return;
+    int want = (_cap == 0 ? 256 : _cap * 2);
+    while (want < _len + extra) want *= 2;
+    _data = (unsigned char*)::realloc(_data, want);
+    _cap = want;
+  }
+
+ public:
+  WasmBuf() : _data(nullptr), _len(0), _cap(0) {}
+  ~WasmBuf() { ::free(_data); }
+
+  const unsigned char* data() const { return _data; }
+  int length() const { return _len; }
+  bool overflowed() const { return _data == nullptr && _len > 0; }
+
+  void u8(int b) { ensure(1); _data[_len++] = (unsigned char)b; }
+  void bytes(const void* p, int n) { ensure(n); memcpy(_data + _len, p, n); _len += n; }
+  void append(const WasmBuf& o) { bytes(o.data(), o.length()); }
+
+  void uleb(unsigned v) {
+    do {
+      unsigned char b = v & 0x7f;
+      v >>= 7;
+      if (v) b |= 0x80;
+      u8(b);
+    } while (v);
+  }
+
+  void sleb64(jlong v) {
+    for (;;) {
+      unsigned char b = (unsigned char)(v & 0x7f);
+      v >>= 7;
+      if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { u8(b); return; }
+      u8(b | 0x80);
+    }
+  }
+
+  void sleb(int v) {
+    for (;;) {
+      unsigned char b = v & 0x7f;
+      v >>= 7;
+      if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { u8(b); return; }
+      u8(b | 0x80);
+    }
+  }
+
+  // id + size + body, so no section length is ever counted by hand.
+  void section(int id, const WasmBuf& body) {
+    u8(id);
+    uleb((unsigned)body.length());
+    append(body);
+  }
+};
