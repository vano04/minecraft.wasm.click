+// ---------------------------------------------------------------------------
+// Installing generated code
+//
+// The only runtime code path a browser offers: build a Module, import the
+// JVM's own linear memory into it, grow the indirect function table and put
+// the export there. The index that comes back IS a C function pointer.
+//
+// Returns -1 if the engine rejects the module, which must stay survivable: a
+// refused compile has to leave the interpreter running, not abort the VM.
+// ---------------------------------------------------------------------------
+// Emscripten's dynamic linker owns the indirect function table: every side
+// module is placed at a table base that must be identical on every thread, so
+// a JIT that grows the table makes the next dlopen land somewhere else and
+// libnio.so fails to load with "unexpected table size".
+//
+// So generated code is not installed in the table at all. It is kept in a
+// per-thread JS array -- each pthread has its own JS context, which is exactly
+// the per-thread scope the code cache wants anyway -- and called through an
+// import. That costs an extra wasm->JS crossing per call, which does not
+// matter: the JIT is entered once per *trace*, and a trace can run a loop
+// thousands of iterations deep before it hands back.
+// ---------------------------------------------------------------------------
+// Out-of-line calls
+//
+// Without this a compiled trace stops at its first invoke, and real code is
+// call-dense enough that "its first invoke" is usually within a few bytecodes.
+// Handing back there costs a boundary crossing and buys almost nothing.
+//
+// So generated code calls this instead, through the JVM's own indirect
+// function table -- a wasm->wasm call of a couple of nanoseconds, against the
+// ~9 ns a return to the interpreter and a re-entry would cost. It does exactly
+// what BytecodeInterpreter's invoke cases and ZeroInterpreter::main_loop's
+// call_method arm do between them, and nothing else.
+//
+// Returns 1 if the call completed, 0 if the whole bytecode must go back to the
+// interpreter (unresolved, null receiver, a dispatch shape not handled here),
+// and -1 if the callee left an exception pending.
+extern "C" EMSCRIPTEN_KEEPALIVE int zwc_invoke(int istate_i, int bci, int tos_i) {
+  interpreterState istate = (interpreterState)(intptr_t)istate_i;
+  intptr_t* tos = (intptr_t*)(intptr_t)tos_i;
+  JavaThread* thread = istate->thread();
+  Method* method = istate->method();
+  address pc = method->code_base() + bci;
+  Bytecodes::Code opcode = (Bytecodes::Code)*pc;
+  Bytecodes::Code as = (opcode == Bytecodes::_fast_invokevfinal)
+                     ? Bytecodes::_invokevirtual : opcode;
+
+  ConstantPoolCache* cp = istate->constants();
+  if (cp == nullptr) return 0;
+  ResolvedMethodEntry* entry =
+      cp->constant_pool()->resolved_method_entry_at((int)Bytes::get_native_u2(pc + 1));
+  if (entry == nullptr || !entry->is_resolved(as)) return 0;
+  // Interp-only mode wants an entry point this does not pick, and every event
+  // it exists to post would be missed.
+  if (JvmtiExport::can_post_interpreter_events() && thread->is_interp_only_mode()) return 0;
+
+  int parms = entry->number_of_parameters();
+  Method* callee = nullptr;
+  switch (opcode) {
+    case Bytecodes::_invokestatic:
+      callee = entry->method();
+      break;
+    case Bytecodes::_invokespecial:
+    case Bytecodes::_fast_invokevfinal:
+      if (tos[parms] == 0) return 0;               // null receiver: the interpreter throws
+      callee = entry->method();
+      break;
+    case Bytecodes::_invokevirtual: {
+      if (tos[parms] == 0) return 0;
+      if (entry->is_vfinal()) { callee = entry->method(); break; }
+      oop rcvr = cast_to_oop((void*)tos[parms]);
+      callee = (Method*)rcvr->klass()->method_at_vtable(entry->table_index());
+      break;
+    }
+    case Bytecodes::_invokeinterface: {
+      if (tos[parms] == 0) return 0;
+      oop rcvr = cast_to_oop((void*)tos[parms]);
+      // java.lang.Object's methods called through an interface are a plain
+      // vtable dispatch; cpCache marks them.
+      if (entry->is_forced_virtual()) {
+        callee = entry->is_vfinal() ? entry->method()
+               : (Method*)rcvr->klass()->method_at_vtable(entry->table_index());
+        break;
+      }
+      // A private interface method needs a receiver subtype check that can
+      // throw; leave that to the interpreter.
+      if (entry->is_vfinal()) return 0;
+      if (!rcvr->klass()->is_instance_klass()) return 0;
+      Method* iface_method = entry->method();
+      InstanceKlass* iclass = iface_method->method_holder();
+      InstanceKlass* rk = (InstanceKlass*)rcvr->klass();
+      // The itable scan, and both of its failures -- a class that does not
+      // implement the interface and an abstract target -- handed back so the
+      // interpreter raises the right linkage error with the right message.
+      Klass* refc = entry->interface_klass();
+      itableOffsetEntry* scan = (itableOffsetEntry*)rk->start_of_itable();
+      bool refc_ok = false;
+      for (; scan->interface_klass() != nullptr; scan++) {
+        if (scan->interface_klass() == refc) { refc_ok = true; break; }
+      }
+      if (!refc_ok) return 0;
+      itableOffsetEntry* ki = (itableOffsetEntry*)rk->start_of_itable();
+      int i = 0;
+      for (; i < rk->itable_length(); i++, ki++) {
+        if (ki->interface_klass() == iclass) break;
+      }
+      if (i == rk->itable_length()) return 0;
+      callee = ki->first_method_entry(rcvr->klass())[iface_method->itable_index()].method();
+      if (callee == nullptr) return 0;
+      break;
+    }
+    default:
+      return 0;
+  }
+  if (callee == nullptr) return 0;
+
+  istate->set_bcp(pc);
+  istate->set_stack(tos);
+  istate->set_callee(callee);
+  istate->set_callee_entry_point(callee->from_interpreted_entry());
+  istate->set_msg(BytecodeInterpreter::call_method);
+
+  // From here down this is main_loop's call_method arm verbatim, including the
+  // frame anchor: our caller set it before entering the interpreter, and the
+  // callee must not see a stale one.
+  ZeroStack* stack = thread->zero_stack();
+  thread->reset_last_Java_frame();
+  stack->set_sp(istate->stack() + 1);
+  ZeroInterpreter::invoke_method(callee, istate->callee_entry_point(), thread);
+  istate->set_stack(stack->sp() - 1);
+  stack->set_sp(istate->stack_limit() + 1);
+  thread->set_last_Java_frame();
+  istate->set_msg(BytecodeInterpreter::method_resume);
+
+  // Compiled code computed the post-call stack pointer itself, from the
+  // parameter count and the return type in the same resolved entry. If the
+  // two ever disagree the operand stack silently slides, which shows up
+  // somewhere else entirely -- so check it while the evidence is here.
+  if (ZeroWasmJITVerbose) {
+    TosState ts = (TosState)entry->tos_state();
+    int rs = (ts == vtos) ? 0 : (ts == ltos || ts == dtos) ? 2 : 1;
+    intptr_t* expect = tos + parms - rs;
+    if (istate->stack() != expect) {
+      ResourceMark rm;
+      tty->print_cr("[zwc] CALL MISMATCH in %s @%d: parms=%d rs=%d off-by %d slots",
+                    method->name_and_sig_as_C_string(), bci, parms, rs,
+                    (int)(istate->stack() - expect));
+    }
+  }
+
+  return thread->has_pending_exception() ? -1 : 1;
+}
