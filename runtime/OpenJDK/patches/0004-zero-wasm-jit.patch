+// ---------------------------------------------------------------------------
+// The compiler
+// ---------------------------------------------------------------------------
+class Codegen {
+ public:
+  const char* _why = "ok";
+  // Reported with the refusal so "the trace was too short" is followed by the
+  // opcode that ended it -- which is the whole roadmap for what to add next.
+  // Where emit_range gave up outright: the opcode it could not model and the
+  // bci, which is the difference between "this method is call-dense" and
+  // "there is a shape here worth implementing".
+  const char* fail_where() {
+    if (_fail_bci < 0) return "";
+    jio_snprintf(_fail_buf, sizeof(_fail_buf), " [refused %s @%d]",
+                 _fail_op >= 0 && _fail_op < Bytecodes::number_of_codes
+                     ? Bytecodes::name((Bytecodes::Code)_fail_op) : "?", _fail_bci);
+    return _fail_buf;
+  }
+  char _fail_buf[64];
+  int  osr_count() const { return _nosr; }
+  int  osr_bci(int i) const { return _osr_bci[i]; }
+  int  osr_blk(int i) const { return _osr_blk[i]; }
+  const char* bail_op_name() const {
+    return _first_bail_op >= 0 && _first_bail_op < Bytecodes::number_of_codes
+        ? Bytecodes::name((Bytecodes::Code)_first_bail_op) : "-";
+  }
+
+ private:
+  Method* const _method;
+  address const _code;
+  const int _len;
+
+  // Basic blocks: bci -> block number, or -1. Built from branch targets.
+  int* _block_of;
+  int  _blocks;
+  // Operand-stack depth on entry to each block, -1 until an edge into it is
+  // seen. javac leaves values on the stack across a merge for every ternary
+  // and every short-circuit operator, so assuming zero here refused most real
+  // methods outright.
+  // Back-edge targets, in bci order: the only bcis on-stack replacement may
+  // enter at. Each one is a block leader whose entry depth was proved to be
+  // zero, which is what makes entering there the same as entering at the top.
+  static const int MAX_OSR = 16;
+  int _osr_bci[MAX_OSR];
+  int _osr_blk[MAX_OSR];
+  int _nosr;
+
+  int* _entry_depth;
+  // ...and what kind each of those slots holds. Two edges only merge if they
+  // agree, because a long at depth 3 and an int at depth 3 live in different
+  // wasm locals -- but two longs live in the same one, so requiring "all int"
+  // here threw away every ternary sitting on top of a long.
+  unsigned char* _entry_kind;
+  bool _fell_through;
+  int  _last_exit_depth;
+  int  _last_bci;
+
+  // Work done before the trace first hands back, in bci order. A body that
+  // bails after two bytecodes costs a 9 ns crossing and saves nothing, so it
+  // must not be installed at all.
+  int  _ops_before_bail;
+  int  _inlined_before_bail;
+  bool _loop_before_bail;
+  bool _bailed;
+
+  // wasm locals: 0..2 are the parameters, then $blk, $budget, then the
+  // operand stack. Keeping the stack in locals is the whole point -- V8's
+  // register allocator then sees ordinary SSA values, not memory traffic.
+  int _stack_base_local;
+  int _max_stack;
+
+  static const int L_LOCALS = 0, L_TOS = 1, L_OUT = 2, L_ISTATE = 3, L_ENTRY = 4;
+  static const int L_BLK = 5, L_BUDGET = 6;
+  static const int FIRST_STACK_LOCAL = 7;
+  static const int NPARAMS = 5;
+  // Operand-stack slots get a fixed reservation so that locals belonging to
+  // inlined callees can be numbered above them without a second pass. A method
+  // that needs a deeper stack than this is refused.
+  static const int MAX_DEPTH = 64;
+  static const int MAX_INLINE_DEPTH = 6;
+  static const int MAX_INLINE_BYTECODES = 180;
+
+  // Inlining context. _local_base >= 0 means "we are inside an inlined callee,
+  // whose locals are wasm locals rather than slots in a Zero frame" -- which is
+  // the entire point: an inlined call builds no interpreter frame at all.
+  int _local_base;
+  int _next_local;
+
+  // Java slot kinds. A long or double takes two Java slots but one wasm local,
+  // so the upper slot is simply never named.
+  // A float occupies one Java slot like an int, but it needs its own wasm
+  // local: keeping it as raw bits in an i32 would put a reinterpret on every
+  // use, and V8 would then have to move between register banks each time.
+  enum Kind { K_I32 = 0, K_I64 = 1, K_F64 = 2, K_F32 = 3, K_COUNT = 4, K_TOP = 4 };
+  static bool is_wide(int kind) { return kind == K_I64 || kind == K_F64; }
+  static int wasm_type_of(int kind) {
+    return kind == K_I64 ? WT_I64 : kind == K_F64 ? WT_F64
+         : kind == K_F32 ? WT_F32 : WT_I32;
+  }
+
+  // Every declared local carries its own type. wasm's local vector is a list
+  // of (count, type) runs, so emitting one run per local lets indices be handed
+  // out in first-use order and keeps a function from declaring wide locals it
+  // never touches.
+  static const int MAX_LOCALS = 400;
+  unsigned char _local_kind[MAX_LOCALS];
+  int _wide_map[K_COUNT][MAX_DEPTH];
+  // What each operand-stack slot holds, so a bail can spill it with the right
+  // width. K_TOP marks the upper half of a long or double, which its lower
+  // half has already written.
+  unsigned char _stack_kind[MAX_DEPTH];
+  int _inline_depth;
+  int _inlined;
+  int _bad_op;        // opcode that made the last callee un-inlinable
+  int _fail_bci;      // where emit_range gave up outright, as opposed to bailing
+  int _fail_op;
+  int _first_bail_op; // opcode the outer trace first handed back on
+  int _first_bail_bci;
+  const char* _shape = "shape";
+
+  // Control flow inside an inlined callee. Its forward branch targets become
+  // nested wasm blocks opened at the top of the splice and closed as each
+  // target is reached, so a branch is a `br` outwards. That is only valid for
+  // a forward-only, properly nested CFG -- which is what javac emits for
+  // if/else, ternaries and short-circuit operators -- and inline_cfg() proves
+  // it before a byte is emitted.
+  static const int MAX_TARGETS = 48;
+  int  _inl_targets[MAX_TARGETS];
+  int  _inl_ntargets;
+  int  _inl_next;
+  int* _inl_depth_at;
+  int  _inl_result_slot;
+  // Where a bail inside an inlined body must actually land: the caller's
+  // invoke bci, with the caller's stack as it was before the call. A callee
+  // bci would resume the interpreter at a nonsense offset in the caller's
+  // method. Re-executing the whole invoke is correct because inlinable()
+  // admits no callee that writes to the heap.
+  int  _inl_bail_bci;
+  int  _inl_bail_depth;
+  // A bail inside an inlined body hands back at the caller's invoke, so the
+  // caller's arguments must still be on its operand stack -- but the callee's
+  // own operand stack starts exactly there and overwrites them the moment it
+  // pushes anything. These hold the originals.
+  int  _inl_save_base;
+  int  _inl_save_n;
+  // A non-guard bail can stop emit_range before it reaches forward targets.
+  // Those targets still have to land at the caller's invoke, rather than
+  // falling through the splice as though the callee had returned normally.
+  bool _inl_body_bailed;
+  // inline_cfg() measures the callee's stack depth from zero, but stack_local()
+  // indexes the caller's slots, so the callee's operand stack starts wherever
+  // the caller's happened to be. Without this offset a branch target reads the
+  // slot below the one the value was written to.
+  int  _inl_base_depth;
+
+  // Baked at construction: this thread's TLAB and the heap's card table. Both
+  // are stable addresses, and the code cache is thread-local, so neither can
+  // be stale by the time the generated code runs.
+  address _tlab_top_addr;
+  address _tlab_end_addr;
+  address _card_base;
+  bool    _can_alloc;         // header layout is the one emit_object_init writes
+  bool    _can_store_oop;     // a card-table barrier set is in use
+
+  WasmBuf _code_buf;
+  bool _failed;
+
+  void fail() { _failed = true; }
+
+  void emit(int op) { _code_buf.u8(op); }
+  void emit_const(int v) { _code_buf.u8(WOP_I32_CONST); _code_buf.sleb(v); }
+  void emit_f32_const(jfloat v) {
+    jint bits; memcpy(&bits, &v, sizeof(bits));
+    _code_buf.u8(WOP_F32_CONST);
+    for (int i = 0; i < 4; i++) _code_buf.u8((int)((bits >> (8 * i)) & 0xff));
+  }
+  void local_get(int i) { _code_buf.u8(WOP_LOCAL_GET); _code_buf.uleb((unsigned)i); }
+  void local_set(int i) { _code_buf.u8(WOP_LOCAL_SET); _code_buf.uleb((unsigned)i); }
+  void br(int depth) { _code_buf.u8(WOP_BR); _code_buf.uleb((unsigned)depth); }
+  void br_if(int depth) { _code_buf.u8(WOP_BR_IF); _code_buf.uleb((unsigned)depth); }
+  // align=2 (4-byte), offset=0
+  void i32_load() { _code_buf.u8(WOP_I32_LOAD); _code_buf.uleb(2); _code_buf.uleb(0); }
+  void i32_store() { _code_buf.u8(WOP_I32_STORE); _code_buf.uleb(2); _code_buf.uleb(0); }
+  // Field access bakes the offset into the load/store immediate. It is a
+  // compile-time constant because the JIT only ever sees a method HotSpot has
+  // already rewritten to _fast_*, which means the field is already resolved.
+  void mem_op(int op, int align, int offset) {
+    _code_buf.u8(op); _code_buf.uleb((unsigned)align); _code_buf.uleb((unsigned)offset);
+  }
+
+  // A compiled loop must not outrun a safepoint. Every back-edge spends one
+  // unit of budget and hands back when it runs out, which costs no call out of
+  // wasm at all: the interpreter's own check runs the moment we return.
+  void emit_backedge_budget(bool backward, int resume_bci, int resume_depth) {
+    if (!backward) return;
+    if (!_bailed) _loop_before_bail = true;
+    local_get(L_BUDGET); emit_const(1); emit(WOP_I32_SUB); local_set(L_BUDGET);
+    local_get(L_BUDGET); emit(WOP_I32_EQZ);
+    emit(WOP_IF); emit(0x40);
+    emit_bail(resume_bci, resume_depth, true);
+    emit(WOP_END);
+  }
+
+  // Null check that hands back at the *same* bci with the stack untouched, so
+  // the interpreter re-executes the bytecode and throws the real NPE. No
+  // exception machinery in generated code at all.
+  void guard_nonnull(int obj_local, int bci, int depth) {
+    local_get(obj_local);
+    emit(WOP_I32_EQZ);
+    emit(WOP_IF); emit(0x40);
+    emit_bail(bci, depth, true);
+    emit(WOP_END);
+  }
+
+  // Plain getfield, resolved through the same entry the _fast_ form uses.
+  // HotSpot does not always rewrite a getfield to _fast_igetfield -- the
+  // measured blocker for inlining a trivial final getter was exactly this --
+  // so both spellings have to be understood.
+  bool getfield_shape(Method* m, int cp_index, Bytecodes::Code as,
+                      int* offset, int* load_op, int* align) {
+    ConstantPoolCache* cache = m->constants()->cache();
+    if (cache == nullptr) return false;
+    ResolvedFieldEntry* e = m->constants()->resolved_field_entry_at(cp_index);
+    if (e == nullptr || !e->is_resolved(as) || e->is_volatile()) return false;
+    int off = e->field_offset();
+    if (off <= 0) return false;
+    switch (e->tos_state()) {
+      case btos: case ztos: *load_op = WOP_I32_LOAD8_S;  *align = 0; break;
+      case stos:            *load_op = WOP_I32_LOAD16_S; *align = 1; break;
+      case ctos:            *load_op = WOP_I32_LOAD16_U; *align = 1; break;
+      case itos: case atos: *load_op = WOP_I32_LOAD;     *align = 2; break;
+      default:              return false;   // long, float, double not yet emitted
+    }
+    *offset = off;
+    return true;
+  }
+
+  // Null and bounds checks for an array access. Both hand back at this very
+  // bci with the stack untouched, so the interpreter re-executes the bytecode
+  // and raises the correct NullPointerException or
+  // ArrayIndexOutOfBoundsException. Generated code never throws anything.
+  void guard_array(int arr, int idx, int bci, int depth) {
+    guard_nonnull(arr, bci, depth);
+    local_get(idx);
+    local_get(arr);
+    mem_op(WOP_I32_LOAD, 2, arrayOopDesc::length_offset_in_bytes());
+    emit(WOP_I32_GE_U);
+    emit(WOP_IF); emit(0x40);
+    emit_bail(bci, depth, true);
+    emit(WOP_END);
+  }
+
+  // address = array + base + index * scale
+  void emit_element_addr(int arr, int idx, BasicType t) {
+    local_get(arr);
+    local_get(idx);
+    int scale = type2aelembytes(t);
+    if (scale != 1) { emit_const(scale); emit(WOP_I32_MUL); }
+    emit(WOP_I32_ADD);
+  }
+
+  // Resolved field offset, or -1 if this entry must not be compiled.
+  int field_offset_at(Method* m, int cp_index) {
+    ConstantPoolCache* cache = m->constants()->cache();
+    if (cache == nullptr) return -1;
+    ResolvedFieldEntry* e = m->constants()->resolved_field_entry_at(cp_index);
+    if (e == nullptr) return -1;
+    if (e->is_volatile()) return -1;      // needs ordering this does not emit
+    int off = e->field_offset();
+    return off > 0 ? off : -1;
+  }
+
+  int u2_at(address code, int bci) {
+    return (int)Bytes::get_native_u2((address)(code + bci));
+  }
+
+  // Branch offsets and switch tables are always big-endian in the class file
+  // and are never rewritten, unlike the constant-pool indices above.
+  static int s2_at(address code, int bci) {
+    return (int)(short)(((unsigned char)code[bci] << 8) | (unsigned char)code[bci + 1]);
+  }
+  static int s2u_at(address code, int bci) {
+    return (((unsigned char)code[bci]) << 8) | (unsigned char)code[bci + 1];
+  }
+  static int s4_at(address code, int bci) {
+    return (int)(((unsigned)(unsigned char)code[bci]     << 24)
+               | ((unsigned)(unsigned char)code[bci + 1] << 16)
+               | ((unsigned)(unsigned char)code[bci + 2] << 8)
+               |  (unsigned)(unsigned char)code[bci + 3]);
+  }
+
+  // tableswitch/lookupswitch pad to a 4-byte boundary measured from the start
+  // of the code, so their length depends on both the bci and the table.
+  struct SwitchInfo { int pad, def, lo, hi, npairs, size; };
+  static bool switch_info(address code, int bci, int code_len, SwitchInfo* si) {
+    Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+    int pad = (4 - ((bci + 1) & 3)) & 3;
+    int base = bci + 1 + pad;
+    if (base + 8 > code_len) return false;
+    si->pad = pad;
+    si->def = s4_at(code, base);
+    if (c == Bytecodes::_tableswitch) {
+      si->lo = s4_at(code, base + 4);
+      si->hi = s4_at(code, base + 8);
+      if (si->hi < si->lo) return false;
+      int64_t n = (int64_t)si->hi - (int64_t)si->lo + 1;
+      if (n > 4096) return false;
+      si->npairs = (int)n;
+      si->size = 1 + pad + 12 + (int)n * 4;
+    } else {
+      si->lo = si->hi = 0;
+      si->npairs = s4_at(code, base + 4);
+      if (si->npairs < 0 || si->npairs > 4096) return false;
+      si->size = 1 + pad + 8 + si->npairs * 8;
+    }
+    return bci + si->size <= code_len;
+  }
+  // Branch target of entry i (0-based) of an already-decoded switch.
+  static int switch_target(address code, int bci, const SwitchInfo& si, int i) {
+    Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+    int base = bci + 1 + si.pad;
+    return bci + (c == Bytecodes::_tableswitch ? s4_at(code, base + 12 + i * 4)
+                                               : s4_at(code, base + 8 + i * 8 + 4));
+  }
+  static int switch_key(address code, int bci, const SwitchInfo& si, int i) {
+    int base = bci + 1 + si.pad;
+    return s4_at(code, base + 8 + i * 8);
+  }
+
+  // Bytecodes::length_for() returns 0 for everything whose length is not in
+  // the table. Those are exactly wide, the two switches and the wide gotos,
+  // and all four have to be *scannable* or a single one of them refuses the
+  // whole method rather than merely ending the trace.
+  static int insn_length(address code, int bci, int code_len) {
+    Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+    int size = Bytecodes::length_for(c);
+    if (size > 0) return size;
+    switch (c) {
+      case Bytecodes::_wide: {
+        if (bci + 1 >= code_len) return 0;
+        return ((Bytecodes::Code)(unsigned char)code[bci + 1] == Bytecodes::_iinc) ? 6 : 4;
+      }
+      case Bytecodes::_goto_w: case Bytecodes::_jsr_w:
+        return 5;
+      case Bytecodes::_tableswitch: case Bytecodes::_lookupswitch: {
+        SwitchInfo si;
+        return switch_info(code, bci, code_len, &si) ? si.size : 0;
+      }
+      default:
+        return 0;
+    }
+  }
+
+  int stack_local(int depth) { return FIRST_STACK_LOCAL + depth; }
+
+  void set_slot(int depth, int kind) {
+    if (depth >= 0 && depth < MAX_DEPTH) _stack_kind[depth] = (unsigned char)kind;
+  }
+  int slot_kind(int depth) {
+    return (depth >= 0 && depth < MAX_DEPTH) ? _stack_kind[depth] : K_I32;
+  }
+
+  // Every narrow push must stamp the slot kind too: a slot that previously
+  // held a double would otherwise still be spilled as f64 at a bail while the
+  // value now lives in the i32 local.
+  void set_i32(int depth) { local_set(stack_local(depth)); set_slot(depth, K_I32); }
+
+  // Pushes a long or double: one wasm local, two Java slots.
+  void push_wide(int kind, int depth) {
+    local_set(wide_local(kind, depth));
+    set_slot(depth, kind);
+    set_slot(depth + 1, K_TOP);
+  }
+  void get_wide(int kind, int depth) { local_get(wide_local(kind, depth)); }
+
+  // The same two operations for a value of any kind, so the shuffles and the
+  // conversions do not each need their own four-way switch.
+  void push_val(int kind, int depth) {
+    if (kind == K_F32 && disabled(NO_FLOAT)) fail();
+    if (kind == K_I32) { local_set(stack_local(depth)); set_slot(depth, K_I32); }
+    else if (kind == K_F32) { local_set(wide_local(K_F32, depth)); set_slot(depth, K_F32); }
+    else push_wide(kind, depth);
+  }
+  void get_val(int kind, int depth) {
+    if (kind == K_I32) local_get(stack_local(depth)); else local_get(wide_local(kind, depth));
+  }
+
+  // Copies one operand-stack slot to another, carrying its kind. The upper
+  // half of a long or double holds no value of its own, so it is only a mark.
+  void move_slot(int from, int to) {
+    int k = slot_kind(from);
+    if (k == K_TOP) { set_slot(to, K_TOP); return; }
+    get_val(k, from);
+    if (k == K_I32) local_set(stack_local(to)); else local_set(wide_local(k, to));
+    set_slot(to, k);
+    if (is_wide(k)) set_slot(to + 1, K_TOP);
+  }
+
+  // The whole dup/swap family as one operation: take the top `n` slots and
+  // re-insert a copy `m` slots down. dup is (1,1), dup_x2 is (1,3),
+  // dup2_x2 is (2,4). Working downwards keeps every read ahead of its write.
+  bool dup_slots(int n, int m, int& depth) {
+    if (disabled(NO_SHUFFLE) && m != n) return false;
+    if (depth < m || depth + n >= MAX_DEPTH) return false;
+    // A category-2 value must not be split by either boundary.
+    if (slot_kind(depth - m) == K_TOP || slot_kind(depth - n) == K_TOP) return false;
+    for (int i = 0; i < n; i++) move_slot(depth - n + i, depth + i);
+    if (m > n) {
+      for (int i = m - n - 1; i >= 0; i--) move_slot(depth - m + i, depth - m + n + i);
+      for (int i = 0; i < n; i++) move_slot(depth + i, depth - m + i);
+    }
+    depth += n;
+    return true;
+  }
+
+  // LOCALS_LONG(k) and the operand-stack equivalent both address the *upper*
+  // slot: Zero stores a 64-bit value at &slots[-(k+1)].
+  void push_wide_local_addr(int index) {
+    local_get(L_LOCALS);
+    emit_const((index + 1) * SLOT);
+    emit(WOP_I32_SUB);
+  }
+
+  // LOCALS_INT(k) lives at locals - 4k: Zero's locals array is indexed
+  // downwards from the pointer it hands the interpreter.
+  void push_local_addr(int index) {
+    local_get(L_LOCALS);
+    emit_const(index * SLOT);
+    emit(WOP_I32_SUB);
+  }
+
+  // A local read. In the outer method that is a load from the real frame, so
+  // the interpreter can take over at any bail. Inside an inlined callee there
+  // is no frame, and the local is simply a wasm local.
+  void emit_local_load(int k) {
+    if (_local_base >= 0) { local_get(_local_base + k); }
+    else { push_local_addr(k); i32_load(); }
+  }
+
+  void emit_local_store(int k, int src) {
+    if (_local_base >= 0) { local_get(src); local_set(_local_base + k); }
+    else { push_local_addr(k); local_get(src); i32_store(); }
+  }
+
+  void emit_local_inc(int k, int inc) {
+    if (_local_base >= 0) {
+      local_get(_local_base + k); emit_const(inc); emit(WOP_I32_ADD);
+      local_set(_local_base + k);
+    } else {
+      push_local_addr(k); push_local_addr(k); i32_load();
+      emit_const(inc); emit(WOP_I32_ADD); i32_store();
+    }
+  }
+
+  int alloc_locals(int n) {
+    int b = _next_local;
+    for (int i = 0; i < n; i++) set_kind(_next_local++, K_I32);
+    return b;
+  }
+
+  void set_kind(int idx, int kind) {
+    int slot = idx - NPARAMS;                 // the parameters come first
+    if (slot >= 0 && slot < MAX_LOCALS) _local_kind[slot] = (unsigned char)kind;
+  }
+
+  // The wasm local holding a long or double sitting at this stack depth.
+  int wide_local(int kind, int depth) {
+    if (depth < 0 || depth >= MAX_DEPTH) return -1;
+    int& slot = _wide_map[kind][depth];
+    if (slot == 0) {
+      slot = _next_local++;
+      set_kind(slot, kind);
+    }
+    return slot;
+  }
+
+
+  // ---- typed field access -------------------------------------------------
+  // The kind a resolved field entry's tos_state means, plus the load and store
+  // for it. One place, so getfield, putfield, their _fast_ spellings and
+  // getstatic can never disagree about a width.
+  static bool tos_shape(TosState t, int* kind, int* load_op, int* store_op, int* align) {
+    switch (t) {
+      case btos: case ztos: *kind=K_I32; *load_op=WOP_I32_LOAD8_S;  *store_op=WOP_I32_STORE8;  *align=0; return true;
+      case stos:            *kind=K_I32; *load_op=WOP_I32_LOAD16_S; *store_op=WOP_I32_STORE16; *align=1; return true;
+      case ctos:            *kind=K_I32; *load_op=WOP_I32_LOAD16_U; *store_op=WOP_I32_STORE16; *align=1; return true;
+      case itos: case atos: *kind=K_I32; *load_op=WOP_I32_LOAD;     *store_op=WOP_I32_STORE;   *align=2; return true;
+      case ftos:            *kind=K_F32; *load_op=WOP_F32_LOAD;     *store_op=WOP_F32_STORE;   *align=2; return true;
+      // A long or double field is only 4-byte aligned on a 32-bit heap, so the
+      // hint must stay at 2: wasm rejects a hint wider than the real alignment.
+      case ltos:            *kind=K_I64; *load_op=WOP_I64_LOAD;     *store_op=WOP_I64_STORE;   *align=2; return true;
+      case dtos:            *kind=K_F64; *load_op=WOP_F64_LOAD;     *store_op=WOP_F64_STORE;   *align=2; return true;
+      default: return false;
+    }
+  }
+
+  bool field_shape(Method* m, int cp_index, Bytecodes::Code as, bool need_resolved,
+                   int* offset, int* kind, int* load_op, int* store_op, int* align,
+                   bool* is_oop) {
+    if (m->constants()->cache() == nullptr) return false;
+    ResolvedFieldEntry* e = m->constants()->resolved_field_entry_at(cp_index);
+    if (e == nullptr) return false;
+    if (need_resolved && !e->is_resolved(as)) return false;
+    if (e->is_volatile()) return false;         // needs ordering this cannot emit
+    int off = e->field_offset();
+    if (off <= 0) return false;
+    if (!tos_shape((TosState)e->tos_state(), kind, load_op, store_op, align)) return false;
+    *offset = off;
+    *is_oop = ((TosState)e->tos_state() == atos);
+    return true;
+  }
+
+  // ---- write barrier ------------------------------------------------------
+  // Serial and Parallel both use a card table, and its post-barrier is a single
+  // byte store. That is the whole reason reference stores can be compiled at
+  // all: without it every putfield of an object would end the trace.
+  void emit_card_mark(int addr_local, int offset) {
+    emit_const((int)(intptr_t)_card_base);
+    local_get(addr_local);
+    if (offset != 0) { emit_const(offset); emit(WOP_I32_ADD); }
+    emit_const((int)CardTable::card_shift());
+    emit(WOP_I32_SHR_U);
+    emit(WOP_I32_ADD);
+    emit_const((int)CardTable::dirty_card_val());
+    mem_op(WOP_I32_STORE8, 0, 0);
+  }
+
+  // ---- allocation ---------------------------------------------------------
+  // The code cache is per-thread, so this thread's TLAB pointers are compile-
+  // time constants. If the bump does not fit, hand back and let the interpreter
+  // run the whole bytecode -- that is the only path that can refill or GC, and
+  // it is reached with a frame the collector already understands.
+  void emit_tlab_alloc(int size_bytes, int dst, int bci, int depth) {
+    emit_const((int)(intptr_t)_tlab_top_addr); i32_load(); local_set(dst);
+    emit_const((int)(intptr_t)_tlab_end_addr); i32_load();
+    local_get(dst);
+    emit(WOP_I32_SUB);
+    emit_const(size_bytes);
+    _code_buf.u8(0x49);                          // i32.lt_u
+    emit(WOP_IF); emit(0x40);
+    emit_bail(bci, depth, true);
+    emit(WOP_END);
+    emit_const((int)(intptr_t)_tlab_top_addr);
+    local_get(dst); emit_const(size_bytes); emit(WOP_I32_ADD);
+    i32_store();
+  }
+
+  // mark word, klass word, then zeroed fields -- the same order MemAllocator
+  // uses, followed by the same store-store fence, because another thread may
+  // see this object as soon as it is published.
+  void emit_object_init(int dst, Klass* k, int size_bytes) {
+    local_get(dst);
+    emit_const((int)(intptr_t)markWord::prototype().value());
+    mem_op(WOP_I32_STORE, 2, oopDesc::mark_offset_in_bytes());
+    local_get(dst);
+    emit_const((int)(intptr_t)k);
+    mem_op(WOP_I32_STORE, 2, oopDesc::klass_offset_in_bytes());
+    int hdr = oopDesc::header_size() * HeapWordSize;
+    for (int off = hdr; off < size_bytes; off += 4) {
+      local_get(dst); emit_const(0); mem_op(WOP_I32_STORE, 2, off);
+    }
+    _code_buf.u8(0xfe); _code_buf.u8(0x03); _code_buf.u8(0x00);   // atomic.fence
+  }
+
+  // ---- out-of-line calls --------------------------------------------------
+  // Spills the operand stack, calls zwc_invoke through the table, and reloads
+  // everything that is still live. The reload is not optional: a call can
+  // collect, and every oop the trace was holding in a wasm local moved while
+  // the frame's copy was updated in place.
+  void emit_spill(int depth) {
+    for (int i = 0; i < depth; i++) {
+      int k = slot_kind(i);
+      if (k == K_TOP) continue;
+      local_get(L_TOS);
+      emit_const((is_wide(k) ? (i + 1) : i) * SLOT);
+      emit(WOP_I32_SUB);
+      get_val(k, i);
+      mem_op(k == K_I32 ? WOP_I32_STORE : k == K_F32 ? WOP_F32_STORE
+           : k == K_I64 ? WOP_I64_STORE : WOP_F64_STORE, 2, 0);
+    }
+  }
+  void emit_reload(int depth) {
+    for (int i = 0; i < depth; i++) {
+      int k = slot_kind(i);
+      if (k == K_TOP) continue;
+      local_get(L_TOS);
+      emit_const((is_wide(k) ? (i + 1) : i) * SLOT);
+      emit(WOP_I32_SUB);
+      mem_op(k == K_I32 ? WOP_I32_LOAD : k == K_F32 ? WOP_F32_LOAD
+           : k == K_I64 ? WOP_I64_LOAD : WOP_F64_LOAD, 2, 0);
+      if (k == K_I32) local_set(stack_local(i)); else local_set(wide_local(k, i));
+    }
+  }
+
+  static int result_kind_of(BasicType t) {
+    switch (t) {
+      case T_FLOAT:  return K_F32;
+      case T_LONG:   return K_I64;
+      case T_DOUBLE: return K_F64;
+      default:       return K_I32;
+    }
+  }
+
+  bool emit_call_out(Method* m, address code, int bci, int& depth) {
+    if (disabled(NO_CALLS)) return false;
+    ConstantPool* cp = m->constants();
+    if (cp->cache() == nullptr) return false;
+    ResolvedMethodEntry* e = cp->resolved_method_entry_at(u2_at(code, bci + 1));
+    if (e == nullptr) return false;
+    Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+    Bytecodes::Code as = (c == Bytecodes::_fast_invokevfinal) ? Bytecodes::_invokevirtual : c;
+    if (!e->is_resolved(as)) return false;
+    Method* sig = e->method();
+    if (sig == nullptr) return false;
+    int nargs = e->number_of_parameters();
+    BasicType rt = sig->result_type();
+    int rslots = (rt == T_VOID) ? 0 : (rt == T_LONG || rt == T_DOUBLE) ? 2 : 1;
+    if (depth < nargs) return false;
+    int after = depth - nargs + rslots;
+    if (after >= MAX_DEPTH || _next_local >= 500) return false;
+
+    emit_spill(depth);
+    int st = alloc_locals(1);
+    local_get(L_ISTATE);
+    emit_const(bci);
+    local_get(L_TOS); emit_const(depth * SLOT); emit(WOP_I32_SUB);
+    emit_const((int)(intptr_t)&zwc_invoke);
+    emit(0x11); _code_buf.uleb(1); _code_buf.uleb(0);      // call_indirect type 1, table 0
+    local_set(st);
+
+    local_get(st);
+    emit_const(1);
+    emit(WOP_I32_NE);
+    emit(WOP_IF); emit(0x40);
+      local_get(st);
+      emit(WOP_I32_EQZ);
+      emit(WOP_IF); emit(0x40);
+        emit_bail(bci, depth, true);       // nothing ran: re-execute the invoke
+      emit(WOP_END);
+      // The callee threw. The frame is already coherent and the interpreter
+      // looks the handler up from the bcp, which is this invoke.
+      local_get(L_OUT);
+      local_get(L_TOS); emit_const(after * SLOT); emit(WOP_I32_SUB);
+      i32_store();
+      emit_const(bci);
+      emit(WOP_RETURN);
+    emit(WOP_END);
+
+    depth -= nargs;
+    if (rslots > 0) {
+      set_slot(depth, result_kind_of(rt));
+      if (rslots == 2) set_slot(depth + 1, K_TOP);
+      depth += rslots;
+    }
+    emit_reload(depth);
+    return true;
+  }
+
+  // ---- type checks --------------------------------------------------------
+  // HotSpot's own fast subtype test: one word at a fixed offset in the
+  // subject's Klass either is the target (primary supers, and the secondary
+  // cache when it hits) or the answer needs the slow path, which is a bail.
+  void emit_klass_of(int obj_local) {
+    local_get(obj_local);
+    mem_op(WOP_I32_LOAD, 2, oopDesc::klass_offset_in_bytes());
+  }
+  // Leaves 1 on the stack if obj is certainly an instance of `target`, 0 if
+  // the answer needs the interpreter. super_check_offset belongs to the
+  // target: at that offset in any subtype's Klass sits the target itself,
+  // and when it is the secondary-super cache a hit is still an answer.
+  void emit_is_subtype(int obj_local, Klass* target) {
+    int scoff = (int)target->super_check_offset();
+    emit_klass_of(obj_local);
+    emit_const((int)(intptr_t)target);
+    emit(WOP_I32_EQ);
+    emit_klass_of(obj_local);
+    mem_op(WOP_I32_LOAD, 2, scoff);
+    emit_const((int)(intptr_t)target);
+    emit(WOP_I32_EQ);
+    emit(WOP_I32_OR);
+  }
+
+  // The resolved Klass* behind a cp index, or null if this site must not be
+  // compiled. Klass metadata does not move, so the pointer can be baked in.
+  Klass* resolved_klass(Method* m, int cp_index) {
+    ConstantPool* cp = m->constants();
+    if (cp_index <= 0 || cp_index >= cp->length()) return nullptr;
+    if (cp->tag_at(cp_index).is_unresolved_klass()) return nullptr;
+    if (!cp->tag_at(cp_index).is_klass()) return nullptr;
+    return cp->resolved_klass_at(cp_index);
+  }
+
+  // Fixes the depth a block must be entered with. Both edges into a merge use
+  // the same wasm locals for the operand stack, so the values transfer for
+  // free -- but only if they agree on depth, and only for plain 32-bit slots,
+  // since a long and a double at the same depth live in different locals.
+  bool record_entry(int target_bci, int d) {
+    if (target_bci < 0 || target_bci >= _len) return false;
+    int b = _block_of[target_bci];
+    if (b < 0 || d < 0 || d > MAX_DEPTH) return false;
+    unsigned char* k = &_entry_kind[b * MAX_DEPTH];
+    if (d > 0 && disabled(NO_DEEPMERGE)) return false;
+    if (_entry_depth[b] < 0) {
+      _entry_depth[b] = d;
+      for (int i = 0; i < d; i++) k[i] = (unsigned char)slot_kind(i);
+      return true;
+    }
+    if (_entry_depth[b] != d) return false;
+    for (int i = 0; i < d; i++) if (k[i] != (unsigned char)slot_kind(i)) return false;
+    return true;
+  }
+
+  // Relative wasm depth of an inlined callee's branch target. Open blocks run
+  // innermost-first from _inl_next upwards, with $inline_exit just outside.
+  int inl_target_depth(int t) {
+    for (int i = _inl_next; i < _inl_ntargets; i++) {
+      if (_inl_targets[i] == t) return i - _inl_next;
+    }
+    return -1;
+  }
+  int inl_exit_depth() { return _inl_ntargets - _inl_next; }
+
+  // The callee of a statically bound invoke, or null. Used by both the
+  // inlinability scan and the emitter so they can never disagree.
+  Method* static_callee(Method* m, address code, int bci) {
+    ConstantPoolCache* cache = m->constants()->cache();
+    if (cache == nullptr) return nullptr;
+    Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+    Bytecodes::Code as = (c == Bytecodes::_fast_invokevfinal) ? Bytecodes::_invokevirtual : c;
+    ResolvedMethodEntry* e = m->constants()->resolved_method_entry_at(u2_at(code, bci + 1));
+    if (e == nullptr || !e->is_resolved(as)) return nullptr;
+    return e->method();
+  }
+
+  // A static field lives in the holder's mirror, which is an ordinary heap oop
+  // and therefore moves under GC -- so its address must never be baked into
+  // generated code. The OopHandle's storage slot does not move, so load the
+  // mirror from there at runtime and index the field off that.
+  bool getstatic_shape(Method* m, int cp_index, Bytecodes::Code as, address* handle,
+                       int* offset, int* kind, int* load_op, int* store_op, int* align) {
+    ConstantPoolCache* cache = m->constants()->cache();
+    if (cache == nullptr) return false;
+    ResolvedFieldEntry* e = m->constants()->resolved_field_entry_at(cp_index);
+    if (e == nullptr || !e->is_resolved(as) || e->is_volatile()) return false;
+    InstanceKlass* holder = e->field_holder();
+    if (holder == nullptr || !holder->is_initialized()) return false;
+    oop* slot = holder->java_mirror_handle().ptr_raw();
+    if (slot == nullptr) return false;
+    if (!tos_shape((TosState)e->tos_state(), kind, load_op, store_op, align)) return false;
+    if (as == Bytecodes::_putstatic && (TosState)e->tos_state() == atos) return false;
+    *handle = (address)slot;
+    *offset = e->field_offset();
+    return true;
+  }
+
+ public:
+  Codegen(Method* m)
+    : _method(m), _code(m->code_base()), _len(m->code_size()),
+      _block_of(nullptr), _blocks(0), _entry_depth(nullptr), _entry_kind(nullptr),
+      _nosr(0), _fell_through(false), _last_exit_depth(0), _last_bci(0),
+      _ops_before_bail(0), _inlined_before_bail(0),
+      _loop_before_bail(false), _bailed(false),
+      _local_base(-1), _next_local(FIRST_STACK_LOCAL + MAX_DEPTH),
+      _inline_depth(0), _inlined(0), _bad_op(-1), _fail_bci(-1), _fail_op(-1),
+      _first_bail_op(-1), _first_bail_bci(-1),
+      _inl_ntargets(0), _inl_next(0), _inl_depth_at(nullptr), _inl_result_slot(0),
+      _inl_bail_bci(-1), _inl_bail_depth(0),
+      _inl_save_base(0), _inl_save_n(0), _inl_body_bailed(false), _inl_base_depth(0),
+      _stack_base_local(FIRST_STACK_LOCAL), _max_stack(m->max_stack()),
+      _failed(false) {
+    // These are read before they are written -- wide_local() treats 0 as "not
+    // allocated yet" and the operand-stack reservation is never set_kind()'d,
+    // so it has to already say K_I32. A Codegen lives on the C stack, where
+    // none of that is true by default.
+    memset(_local_kind, 0, sizeof(_local_kind));
+    memset(_wide_map,   0, sizeof(_wide_map));
+    memset(_stack_kind, 0, sizeof(_stack_kind));
+
+    JavaThread* self = JavaThread::current();
+    ThreadLocalAllocBuffer& tlab = self->tlab();
+    _tlab_top_addr = (address)&tlab + in_bytes(ThreadLocalAllocBuffer::top_offset());
+    _tlab_end_addr = (address)&tlab + in_bytes(ThreadLocalAllocBuffer::end_offset());
+    // emit_object_init writes a full-width mark word followed by a full-width
+    // Klass*. That is the layout on a 32-bit heap; anything else must not be
+    // allocated from generated code.
+    _can_alloc = UseTLAB && !ZeroTLAB && !UseCompactObjectHeaders
+              && !UseCompressedClassPointers && !oopDesc::has_klass_gap()
+              && oopDesc::header_size() * HeapWordSize == 8
+              && oopDesc::mark_offset_in_bytes() == 0
+              && oopDesc::klass_offset_in_bytes() == 4;
+    _card_base = nullptr;
+    BarrierSet* bs = BarrierSet::barrier_set();
+    if (bs != nullptr && bs->is_a(BarrierSet::CardTableBarrierSet)) {
+      _card_base = (address)((CardTableBarrierSet*)bs)->card_table()->byte_map_base();
+    }
+    _can_store_oop = (_card_base != nullptr);
+  }
+
+  ~Codegen() { ::free(_block_of); ::free(_entry_depth); ::free(_entry_kind); }
+
+  bool compile(WasmBuf& module);
+
+ private:
+  bool discover_blocks();
+  bool emit_body();
+  bool emit_block(int b, int start, int end, int nesting_to_loop);
+  bool emit_range(Method* m, address code, int start, int end, int& depth,
+                  int nesting_to_loop, bool allow_branches);
+  bool try_inline(Method* m, address code, int bci, int& depth);
+  bool inlinable(Method* callee, int nest = 0);
+  bool inline_cfg(Method* callee, int nest, int* targets, int* ntargets, int* depth_at);
+  // is_guard: a null/bounds check that only fires on the exception path.
+  // It must not count as the end of the trace, or every method with a
+  // field access looks like it stops at its first guard.
+  void emit_bail(int bci, int depth, bool is_guard = false);
+};
+
+// Marks every branch target and every instruction after a branch as a leader,
+// then numbers the leaders. Refuses anything it does not understand, so an
+// unsupported opcode can never be silently skipped over.
+bool Codegen::discover_blocks() {
+  _why = "unsupported opcode in block scan";
+  _block_of = (int*)::calloc(_len + 1, sizeof(int));
+  if (_block_of == nullptr) return false;
+  bool* leader = (bool*)::calloc(_len + 1, sizeof(bool));
+  if (leader == nullptr) return false;
+  leader[0] = true;
+  int* backward = (int*)::calloc(_len + 1, sizeof(int));
+  if (backward == nullptr) { ::free(leader); return false; }
+  int nbackward = 0;
+
+  int bci = 0;
+  bool ok = true;
+  while (bci < _len && ok) {
+    // HotSpot rewrites getfield/invoke/ldc to _fast_* variants before a method
+    // is ever hot enough to reach the JIT, so refusing them outright refused
+    // 78% of all candidates. They only need to be *scannable* here -- their
+    // lengths are in the same table -- and emit_block turns each one into a
+    // bail. Variable-length codes (wide, the switches) still have no static
+    // length, so those still refuse the method.
+    int raw = (unsigned char)_code[bci];
+    if (raw >= Bytecodes::number_of_codes) { _why = "illegal opcode"; ok = false; break; }
+    Bytecodes::Code c = (Bytecodes::Code)raw;
+    int size = insn_length(_code, bci, _len);
+    if (size <= 0) { ok = false; break; }
+    switch (c) {
+      case Bytecodes::_goto_w: case Bytecodes::_jsr_w: {
+        int target = bci + s4_at(_code, bci + 1);
+        if (target < 0 || target >= _len) { ok = false; break; }
+        leader[target] = true;
+        if (target < bci) backward[nbackward++] = target;
+        if (bci + size < _len) leader[bci + size] = true;
+        break;
+      }
+      case Bytecodes::_tableswitch: case Bytecodes::_lookupswitch: {
+        SwitchInfo si;
+        if (!switch_info(_code, bci, _len, &si)) { ok = false; break; }
+        int d = bci + si.def;
+        if (d < 0 || d >= _len) { ok = false; break; }
+        leader[d] = true;
+        if (d < bci) backward[nbackward++] = d;
+        for (int i = 0; i < si.npairs && ok; i++) {
+          int t = switch_target(_code, bci, si, i);
+          if (t < 0 || t >= _len) { ok = false; break; }
+          leader[t] = true;
+          if (t < bci) backward[nbackward++] = t;
+        }
+        if (bci + size < _len) leader[bci + size] = true;
+        break;
+      }
+      case Bytecodes::_goto:
+      case Bytecodes::_ifeq: case Bytecodes::_ifne:
+      case Bytecodes::_iflt: case Bytecodes::_ifge:
+      case Bytecodes::_ifgt: case Bytecodes::_ifle:
+      case Bytecodes::_ifnull: case Bytecodes::_ifnonnull:
+      case Bytecodes::_if_acmpeq: case Bytecodes::_if_acmpne:
+      case Bytecodes::_if_icmpeq: case Bytecodes::_if_icmpne:
+      case Bytecodes::_if_icmplt: case Bytecodes::_if_icmpge:
+      case Bytecodes::_if_icmpgt: case Bytecodes::_if_icmple: {
+        int off = (int)(short)(((unsigned char)_code[bci + 1] << 8) | (unsigned char)_code[bci + 2]);
+        int target = bci + off;
+        if (target < 0 || target >= _len) { ok = false; break; }
+        leader[target] = true;
+        if (target < bci) backward[nbackward++] = target;
+        if (bci + size < _len) leader[bci + size] = true;
+        break;
+      }
+      default:
+        break;
+    }
+    bci += size;
+  }
+  if (!ok) { ::free(leader); ::free(backward); return false; }
+
+  // A handler is never branched to from compiled code -- the interpreter
+  // performs the throw -- but its body is still walked linearly, and it starts
+  // with the exception on the stack. Without a leader here the walk falls into
+  // it at the wrong depth and the whole method is refused.
+  if (_method->has_exception_handler()) {
+    ExceptionTable et(_method);
+    for (int i = 0; i < et.length(); i++) {
+      int h = et.handler_pc(i);
+      if (h >= 0 && h < _len) leader[h] = true;
+    }
+  }
+
+  _blocks = 0;
+  for (int i = 0; i <= _len; i++) {
+    _block_of[i] = leader[i] ? _blocks++ : -1;
+  }
+  ::free(leader);
+  if (_blocks <= 0) { ::free(backward); return false; }
+
+  _entry_depth = (int*)::calloc(_blocks, sizeof(int));
+  _entry_kind  = (unsigned char*)::calloc((size_t)_blocks * MAX_DEPTH, 1);
+  if (_entry_depth == nullptr || _entry_kind == nullptr) return false;
+  for (int i = 0; i < _blocks; i++) _entry_depth[i] = -1;
+  _entry_depth[0] = 0;
+  // A back-edge is emitted after its target block, so without this the loop
+  // body looks unreachable when it is emitted. javac always closes a loop with
+  // an empty stack; if some class file does not, the back-edge refuses then.
+  for (int i = 0; i < nbackward; i++) {
+    int b = _block_of[backward[i]];
+    if (b >= 0) _entry_depth[b] = 0;
+  }
+  if (_method->has_exception_handler()) {
+    ExceptionTable et(_method);
+    for (int i = 0; i < et.length(); i++) {
+      int h = et.handler_pc(i);
+      if (h >= 0 && h < _len && _block_of[h] >= 0) {
+        int b = _block_of[h];
+        _entry_depth[b] = 1;
+        _entry_kind[b * MAX_DEPTH] = K_I32;
+      }
+    }
+  }
+  for (int i = 0; i < nbackward && _nosr < MAX_OSR; i++) {
+    int b = _block_of[backward[i]];
+    bool seen = false;
+    for (int j = 0; j < _nosr; j++) if (_osr_blk[j] == b) seen = true;
+    if (!seen) { _osr_bci[_nosr] = backward[i]; _osr_blk[_nosr] = b; _nosr++; }
+  }
+  ::free(backward);
+  return true;
+}
+
+// Spill the operand stack to the real frame and hand control back. Everything
+// the interpreter needs must be true here: values in memory where Zero's
+// macros expect them, and topOfStack consistent with the depth.
+//
+// Zero pushes downwards: with entry tos T0 and depth d, the i'th value from
+// the bottom sits at T0 - 4i and topOfStack is T0 - 4d.
+void Codegen::emit_bail(int bci, int depth, bool is_guard) {
+  if (!is_guard && _local_base >= 0 && _inl_bail_bci >= 0) {
+    // emit_range() may return as soon as an unsupported opcode is reached.
+    // Remember that this happened inside an inline splice; try_inline() adds
+    // a landing bail after the splice so forward branch targets cannot skip
+    // the one already emitted at that opcode.
+    _inl_body_bailed = true;
+  }
+  int from_save = -1;
+  if (_local_base >= 0 && _inl_bail_bci >= 0) {
+    bci = _inl_bail_bci;
+    depth = _inl_bail_depth;
+    from_save = depth - _inl_save_n;   // slots at or above this are the args
+  }
+  if (!is_guard && !_bailed && bci >= 0 && bci < _len) {
+    _first_bail_op = (unsigned char)_code[bci];
+    _first_bail_bci = bci;
+  }
+  if (!is_guard) _bailed = true;
+  for (int i = 0; i < depth; i++) {
+    if (from_save >= 0 && i >= from_save) {
+      // The caller's argument, taken from the copy made before the callee was
+      // spliced in. Arguments are always plain slots -- try_inline refuses a
+      // callee whose arguments are not.
+      local_get(L_TOS);
+      emit_const(i * SLOT);
+      emit(WOP_I32_SUB);
+      local_get(_inl_save_base + (i - from_save));
+      i32_store();
+      continue;
+    }
+    int k = slot_kind(i);
+    if (k == K_TOP) continue;                 // written by its lower half
+    if (k == K_I32 || k == K_F32) {
+      local_get(L_TOS);
+      emit_const(i * SLOT);
+      emit(WOP_I32_SUB);
+      get_val(k, i);
+      if (k == K_I32) i32_store(); else mem_op(WOP_F32_STORE, 2, 0);
+    } else {
+      local_get(L_TOS);
+      emit_const((i + 1) * SLOT);
+      emit(WOP_I32_SUB);
+      local_get(wide_local(k, i));
+      mem_op(k == K_I64 ? WOP_I64_STORE : WOP_F64_STORE, 2, 0);
+    }
+  }
+  local_get(L_OUT);
+  local_get(L_TOS);
+  emit_const(depth * SLOT);
+  emit(WOP_I32_SUB);
+  i32_store();
+  emit_const(bci);
+  emit(WOP_RETURN);
+}
+
+bool Codegen::compile(WasmBuf& module) {
+  if (_len <= 0) { _why = "empty"; return false; }
+  if (_method->is_synchronized()) { _why = "synchronized"; return false; }
+  // A method with exception handlers is fine. Every bail leaves the frame
+  // exactly as the interpreter would have left it at that bytecode, and every
+  // guard bails *before* the effect it guards, so the interpreter re-executes
+  // the throwing bytecode and finds the handler itself. Nothing here has to
+  // know the handler table exists.
+  if (JvmtiExport::can_post_field_access() || JvmtiExport::can_post_field_modification()) {
+    _why = "JVMTI field watches active"; return false;
+  }
+  if (!discover_blocks()) return false;
+  _why = "codegen refused";
+  if (!emit_body() || _failed) return false;
+  // Worth installing? A trace that hands back after a few bytecodes saves
+  // less than the 9 ns crossing costs. But an *inlined* call is worth ~23 ns
+  // on its own -- a whole interpreter frame that never gets built -- so a
+  // three-line method that inlines three getters is one of the best things
+  // this compiler can do, and counting only bytecodes threw it away.
+  if (!_loop_before_bail && _inlined_before_bail == 0 && _ops_before_bail < 20) {
+    _why = "trace too short";
+    return false;
+  }
+  _why = "ok";
+
+  // ---- assemble the module ----
+  WasmBuf b;
+
+  module.u8(0x00); module.u8(0x61); module.u8(0x73); module.u8(0x6d);
+  module.u8(0x01); module.u8(0x00); module.u8(0x00); module.u8(0x00);
+
+  // type 0: the compiled body, (locals, tos, out, istate) -> resume bci
+  // type 1: zwc_invoke, (istate, bci, tos) -> status
+  b.uleb(2);
+  b.u8(0x60); b.uleb(5);
+  b.u8(0x7f); b.u8(0x7f); b.u8(0x7f); b.u8(0x7f); b.u8(0x7f);
+  b.uleb(1); b.u8(0x7f);
+  b.u8(0x60); b.uleb(3); b.u8(0x7f); b.u8(0x7f); b.u8(0x7f);
+  b.uleb(1); b.u8(0x7f);
+  module.section(1, b);
+
+  // Imports: the JVM's own memory, and its indirect function table. The table
+  // is what makes an out-of-line call a wasm->wasm call: a C function pointer
+  // is an index into it, so call_indirect reaches zwc_invoke directly. It is
+  // imported, never grown -- growing it moves every side module's table base
+  // and the next dlopen fails.
+  WasmBuf imp;
+  imp.uleb(2);
+  imp.uleb(3); imp.bytes("env", 3);
+  imp.uleb(6); imp.bytes("memory", 6);
+  imp.u8(0x02); imp.u8(0x03); imp.uleb(0); imp.uleb(65536);
+  imp.uleb(3); imp.bytes("env", 3);
+  imp.uleb(25); imp.bytes("__indirect_function_table", 25);
+  imp.u8(0x01); imp.u8(0x70); imp.u8(0x00); imp.uleb(0);
+  module.section(2, imp);
+
+  WasmBuf fn; fn.uleb(1); fn.uleb(0);
+  module.section(3, fn);
+
+  WasmBuf ex; ex.uleb(1); ex.uleb(1); ex.bytes("f", 1); ex.u8(0x00); ex.uleb(0);
+  module.section(7, ex);
+
+  // code: one body, locals = $blk, $budget and the operand stack
+  WasmBuf body;
+  // One run per local: $blk, $budget, the operand-stack reservation, one slot
+  // per local of every inlined callee, and any wide locals that were needed.
+  int extra_locals = _next_local - NPARAMS;
+  if (extra_locals > MAX_LOCALS) { _why = "too many locals"; return false; }
+  body.uleb((unsigned)extra_locals);
+  for (int i = 0; i < extra_locals; i++) {
+    body.uleb(1);
+    body.u8(wasm_type_of(_local_kind[i]));
+  }
+  body.bytes(_code_buf.data(), _code_buf.length());
+  body.u8(WOP_END);
+
+  WasmBuf codesec;
+  codesec.uleb(1);
+  codesec.uleb((unsigned)body.length());
+  codesec.append(body);
+  module.section(10, codesec);
+  return true;
+}
+
+bool Codegen::emit_body() {
+  // $budget bounds how many back-edges compiled code may take before handing
+  // control back. That is what keeps safepoints reachable: a compiled loop
+  // cannot spin forever, and the interpreter's own back-edge check runs when
+  // we return. No call out of wasm is needed to stay safe.
+  emit_const((int)ZeroWasmJITBackedgeBudget);
+  local_set(L_BUDGET);
+  // Entry block, not always zero: on-stack replacement enters at a loop header
+  // when the method itself is only ever called once, which is exactly the
+  // shape of every "do this for all 4096 blocks in the section" loop.
+  local_get(L_ENTRY);
+  local_set(L_BLK);
+
+  // block $exit { loop $L { block $B(n-1) ... block $B0 { br_table } ... } }
+  emit(WOP_BLOCK); emit(0x40);           // $exit, void
+  emit(WOP_LOOP);  emit(0x40);           // $L
+  for (int i = _blocks - 1; i >= 0; i--) { emit(WOP_BLOCK); emit(0x40); }
+
+  // Inside $B0: depth k reaches $Bk, depth _blocks reaches $L, +1 reaches $exit.
+  local_get(L_BLK);
+  emit(WOP_BR_TABLE);
+  _code_buf.uleb((unsigned)_blocks);
+  for (int i = 0; i < _blocks; i++) _code_buf.uleb((unsigned)i);
+  _code_buf.uleb((unsigned)_blocks + 1);   // default -> $exit
+
+  // Walk the bytecode once, closing a block's `end` as each leader arrives.
+  int block = 0;
+  int bci = 0;
+  int next_leader = 0;
+  while (bci < _len) {
+    if (_block_of[bci] >= 0) {
+      emit(WOP_END);                       // closes $B(block), code follows
+      block = _block_of[bci];
+      int end = _len;
+      for (int j = bci + 1; j <= _len; j++) {
+        if (_block_of[j] >= 0) { end = j; break; }
+      }
+      if (!emit_block(block, bci, end, _blocks - 1 - block)) return false;
+      // Falling out of a block hands its stack to the next one; a block that
+      // ended in a branch, a switch or a bail hands over nothing.
+      if (_fell_through && end < _len) {
+        if (!record_entry(end, _last_exit_depth)) {
+          _why = "merge depth conflict";
+          if (ZeroWasmJITVerbose) {
+            tty->print_cr("[zwc]   merge @%d: block %d wants %d, edge from [%d,%d) "
+                          "last=%s brings %d",
+                          end, _block_of[end], _entry_depth[_block_of[end]],
+                          bci, end,
+                          Bytecodes::name((Bytecodes::Code)(unsigned char)_code[_last_bci]),
+                          _last_exit_depth);
+          }
+          return false;
+        }
+      }
+      bci = end;
+      next_leader = end;
+      continue;
+    }
+    // discover_blocks guarantees leaders line up with instruction starts
+    return false;
+  }
+  (void)next_leader;
+
+  emit(WOP_END);                           // loop $L
+  emit(WOP_END);                           // block $exit
+  // Falling out of $exit means a bail already returned; be explicit anyway.
+  emit_bail(0, 0);
+  return true;
+}
+
+// Emits one basic block. `nesting_to_loop` is the relative depth of $L from
+// inside this block's code: after $B0's end we are inside $B1..$B(n-1), then
+// $L, then $exit.
+bool Codegen::emit_block(int b, int start, int end, int nesting_to_loop) {
+  int depth = _entry_depth[b];
+  if (depth < 0) {
+    // No edge reaches this block: every branch records its target before it is
+    // emitted, and back-edge targets were seeded during the scan. It is code
+    // after a bail, so it is dead here -- but it still has to be emitted,
+    // because the dispatch table has a slot for it.
+    _fell_through = false;
+    emit_bail(start, 0);
+    return true;
+  }
+  unsigned char* k = &_entry_kind[b * MAX_DEPTH];
+  for (int i = 0; i < depth; i++) set_slot(i, k[i]);
+  bool ok = emit_range(_method, _code, start, end, depth, nesting_to_loop, true);
+  _last_exit_depth = depth;
+  return ok;
+}
+
+// Emits a run of bytecode. Used both for a top-level basic block and for the
+// body of an inlined callee, which is why the method and code base are
+// explicit rather than taken from the fields.
+bool Codegen::emit_range(Method* m, address code, int start, int end,
+                         int& depth, int nesting_to_loop, bool allow_branches) {
+  // Refusing outright is different from bailing: it throws the whole method
+  // away, so it has to say where. Every one of these is a shape the emitter
+  // does not model, and each one is a lead.
+  #define REFUSE() do { if (_fail_bci < 0) { _fail_bci = bci; _fail_op = raw; } \
+                        return false; } while (0)
+  const int L_DEPTH = nesting_to_loop;
+  const int EXIT_DEPTH = nesting_to_loop + 1;
+
+  if (allow_branches) _fell_through = false;
+  // A goto or a switch ends the block: control leaves through the loop
+  // dispatch, so nothing is handed to the block that happens to follow it in
+  // bci order.
+  bool terminal = false;
+  int bci = start;
+  while (bci < end) {
+    int raw = (unsigned char)code[bci];
+    if (raw >= Bytecodes::number_of_codes) { emit_bail(bci, depth); return true; }
+    Bytecodes::Code c = (Bytecodes::Code)raw;
+    int size = insn_length(code, bci, allow_branches ? _len : m->code_size());
+    if (size <= 0) { emit_bail(bci, depth); return true; }
+
+    if (!allow_branches) {
+      // A target reached: close its block, and adopt the depth the CFG check
+      // proved every incoming edge agrees on.
+      while (_inl_next < _inl_ntargets && _inl_targets[_inl_next] == bci) {
+        emit(WOP_END);
+        _inl_next++;
+        if (_inl_depth_at != nullptr && _inl_depth_at[bci] >= 0) {
+          depth = _inl_base_depth + _inl_depth_at[bci];
+        }
+      }
+    }
+
+    if (!_bailed) _ops_before_bail++;
+    if (allow_branches) _last_bci = bci;
+    if (allow_branches && (uintx)bci >= ZeroWasmJITStopAt) {
+      emit_bail(bci, depth); return true;
+    }
+
+    switch (c) {
+      case Bytecodes::_nop: break;
+
+      case Bytecodes::_iconst_m1: case Bytecodes::_iconst_0:
+      case Bytecodes::_iconst_1:  case Bytecodes::_iconst_2:
+      case Bytecodes::_iconst_3:  case Bytecodes::_iconst_4:
+      case Bytecodes::_iconst_5:
+        emit_const((int)c - (int)Bytecodes::_iconst_0);
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_bipush:
+        emit_const((int)(signed char)code[bci + 1]);
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_sipush:
+        emit_const((int)(short)(((unsigned char)code[bci+1] << 8) | (unsigned char)code[bci+2]));
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_iload_0: case Bytecodes::_iload_1:
+      case Bytecodes::_iload_2: case Bytecodes::_iload_3:
+        emit_local_load((int)c - (int)Bytecodes::_iload_0);
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_iload:
+        emit_local_load((unsigned char)code[bci + 1]);
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_istore_0: case Bytecodes::_istore_1:
+      case Bytecodes::_istore_2: case Bytecodes::_istore_3:
+        if (depth < 1) REFUSE();
+        emit_local_store((int)c - (int)Bytecodes::_istore_0, stack_local(depth - 1)); depth--;
+        break;
+
+      case Bytecodes::_istore:
+        if (depth < 1) REFUSE();
+        emit_local_store((unsigned char)code[bci + 1], stack_local(depth - 1));
+        depth--;
+        break;
+
+      case Bytecodes::_iinc:
+        emit_local_inc((unsigned char)code[bci + 1], (int)(signed char)code[bci + 2]);
+        break;
+
+      case Bytecodes::_pop:
+        if (depth < 1) REFUSE();
+        depth--;
+        break;
+
+      case Bytecodes::_dup:
+        if (!dup_slots(1, 1, depth)) REFUSE();
+        break;
+
+      case Bytecodes::_ineg:
+        if (depth < 1) REFUSE();
+        emit_const(0);
+        local_get(stack_local(depth - 1));
+        emit(WOP_I32_SUB);
+        set_i32(depth - 1);
+        break;
+
+      case Bytecodes::_i2b: case Bytecodes::_i2s:
+        if (depth < 1) REFUSE();
+        local_get(stack_local(depth - 1));
+        emit(c == Bytecodes::_i2b ? WOP_I32_EXTEND8_S : WOP_I32_EXTEND16_S);
+        set_i32(depth - 1);
+        break;
+
+      case Bytecodes::_iadd: case Bytecodes::_isub: case Bytecodes::_imul:
+      case Bytecodes::_iand: case Bytecodes::_ior:  case Bytecodes::_ixor:
+      case Bytecodes::_ishl: case Bytecodes::_ishr: case Bytecodes::_iushr: {
+        if (depth < 2) REFUSE();
+        local_get(stack_local(depth - 2));
+        local_get(stack_local(depth - 1));
+        int op;
+        switch (c) {
+          case Bytecodes::_iadd:  op = WOP_I32_ADD;   break;
+          case Bytecodes::_isub:  op = WOP_I32_SUB;   break;
+          case Bytecodes::_imul:  op = WOP_I32_MUL;   break;
+          case Bytecodes::_iand:  op = WOP_I32_AND;   break;
+          case Bytecodes::_ior:   op = WOP_I32_OR;    break;
+          case Bytecodes::_ixor:  op = WOP_I32_XOR;   break;
+          case Bytecodes::_ishl:  op = WOP_I32_SHL;   break;
+          case Bytecodes::_ishr:  op = WOP_I32_SHR_S; break;
+          default:                op = WOP_I32_SHR_U; break;
+        }
+        // Java masks the shift count to 5 bits; wasm does the same for i32,
+        // so no explicit mask is needed.
+        emit(op);
+        set_i32(depth - 2); depth--;
+        break;
+      }
+
+
+      // Reference loads/stores. On wasm32 an oop is a 4-byte address and the
+      // slot is 4 bytes, so these are the same move as the int forms. An oop
+      // may sit in a wasm local because a trace contains no safepoint: the
+      // only ways out are a bail (which spills the stack to the frame first)
+      // and the back-edge budget (where the stack is empty).
+      case Bytecodes::_aload_0: case Bytecodes::_aload_1:
+      case Bytecodes::_aload_2: case Bytecodes::_aload_3:
+        emit_local_load((int)c - (int)Bytecodes::_aload_0);
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_fast_aload_0:
+        emit_local_load(0);
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_aload:
+        emit_local_load((unsigned char)code[bci + 1]);
+        set_i32(depth); depth++;
+        break;
+
+      case Bytecodes::_astore_0: case Bytecodes::_astore_1:
+      case Bytecodes::_astore_2: case Bytecodes::_astore_3:
+        if (depth < 1) REFUSE();
+        emit_local_store((int)c - (int)Bytecodes::_astore_0, stack_local(depth - 1)); depth--;
+        break;
+
+      case Bytecodes::_fast_iload:
+        emit_local_load((unsigned char)code[bci + 1]);
+        set_i32(depth); depth++;
+        break;
+
+      // getfield of any width. _fast_agetfield loads a reference, which is a
+      // plain load: reading an oop needs no barrier in these collectors.
+      case Bytecodes::_fast_igetfield: case Bytecodes::_fast_agetfield:
+      case Bytecodes::_fast_bgetfield: case Bytecodes::_fast_sgetfield:
+      case Bytecodes::_fast_cgetfield: case Bytecodes::_fast_lgetfield:
+      case Bytecodes::_fast_fgetfield: case Bytecodes::_fast_dgetfield: {
+        if (depth < 1 || slot_kind(depth - 1) != K_I32) REFUSE();
+        int off, kind, lop, sop, align; bool is_oop;
+        if (!field_shape(m, u2_at(code, bci + 1), Bytecodes::_getfield, false,
+                         &off, &kind, &lop, &sop, &align, &is_oop)) {
+          emit_bail(bci, depth); return true;
+        }
+        guard_nonnull(stack_local(depth - 1), bci, depth);
+        local_get(stack_local(depth - 1));
+        mem_op(lop, align, off);
+        depth--;
+        push_val(kind, depth);
+        depth += is_wide(kind) ? 2 : 1;
+        break;
+      }
+
+      // putfield of any width, references included. A reference store needs
+      // the collector's post-barrier, which for a card table is one byte
+      // store -- and without it every object field assignment would end the
+      // trace, which is most of what real code does.
+      case Bytecodes::_fast_iputfield: case Bytecodes::_fast_bputfield:
+      case Bytecodes::_fast_zputfield: case Bytecodes::_fast_sputfield:
+      case Bytecodes::_fast_cputfield: case Bytecodes::_fast_lputfield:
+      case Bytecodes::_fast_fputfield: case Bytecodes::_fast_dputfield:
+      case Bytecodes::_fast_aputfield:
+      case Bytecodes::_putfield: case Bytecodes::_nofast_putfield: {
+        bool slow_form = (c == Bytecodes::_putfield || c == Bytecodes::_nofast_putfield);
+        int off, kind, lop, sop, align; bool is_oop;
+        if (!field_shape(m, u2_at(code, bci + 1), Bytecodes::_putfield, slow_form,
+                         &off, &kind, &lop, &sop, &align, &is_oop)) {
+          emit_bail(bci, depth); return true;
+        }
+        if (is_oop && (!_can_store_oop || disabled(NO_OOPSTORE))) {
+          emit_bail(bci, depth); return true;
+        }
+        int vs = is_wide(kind) ? 2 : 1;
+        if (depth < 1 + vs) REFUSE();
+        int objd = depth - vs - 1;
+        if (slot_kind(objd) != K_I32 || slot_kind(depth - vs) != kind) REFUSE();
+        guard_nonnull(stack_local(objd), bci, depth);
+        local_get(stack_local(objd));
+        get_val(kind, depth - vs);
+        mem_op(sop, align, off);
+        if (is_oop) emit_card_mark(stack_local(objd), off);
+        depth -= (vs + 1);
+        break;
+      }
+
+      case Bytecodes::_getfield: case Bytecodes::_nofast_getfield: {
+        if (depth < 1 || slot_kind(depth - 1) != K_I32) REFUSE();
+        int off, kind, lop, sop, align; bool is_oop;
+        if (!field_shape(m, u2_at(code, bci + 1), Bytecodes::_getfield, true,
+                         &off, &kind, &lop, &sop, &align, &is_oop)) {
+          emit_bail(bci, depth); return true;
+        }
+        guard_nonnull(stack_local(depth - 1), bci, depth);
+        local_get(stack_local(depth - 1));
+        mem_op(lop, align, off);
+        depth--;
+        push_val(kind, depth);
+        depth += is_wide(kind) ? 2 : 1;
+        break;
+      }
+
+
+      // ---- long and double ----
+      // wasm has i64 and f64 natively, so the arithmetic the in-world profile
+      // is made of (LegacyRandomSource.next, Mth.floor) becomes single
+      // instructions instead of Zero's software long routines.
+      case Bytecodes::_lconst_0: case Bytecodes::_lconst_1:
+        _code_buf.u8(WOP_I64_CONST); _code_buf.sleb((int)c - (int)Bytecodes::_lconst_0);
+        push_wide(K_I64, depth); depth += 2;
+        break;
+
+      case Bytecodes::_dconst_0: case Bytecodes::_dconst_1: {
+        double v = (c == Bytecodes::_dconst_0) ? 0.0 : 1.0;
+        jlong bits; memcpy(&bits, &v, sizeof(bits));
+        _code_buf.u8(WOP_F64_CONST);
+        for (int i = 0; i < 8; i++) _code_buf.u8((int)((bits >> (8 * i)) & 0xff));
+        push_wide(K_F64, depth); depth += 2;
+        break;
