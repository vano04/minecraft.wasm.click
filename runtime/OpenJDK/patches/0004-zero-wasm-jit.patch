+        mem_op(WOP_I32_LOAD16_U, 1, arrayOopDesc::base_offset_in_bytes(T_CHAR));
+        set_i32(depth - 2); depth--;
+        break;
+      }
+
+      case Bytecodes::_pop2:
+        if (depth < 2) REFUSE();
+        depth -= 2; break;
+
+      case Bytecodes::_dup_x1:   if (!dup_slots(1, 2, depth)) REFUSE(); break;
+      case Bytecodes::_dup_x2:   if (!dup_slots(1, 3, depth)) REFUSE(); break;
+      case Bytecodes::_dup2:     if (!dup_slots(2, 2, depth)) REFUSE(); break;
+      case Bytecodes::_dup2_x1:  if (!dup_slots(2, 3, depth)) REFUSE(); break;
+      case Bytecodes::_dup2_x2:  if (!dup_slots(2, 4, depth)) REFUSE(); break;
+
+      case Bytecodes::_swap:
+        if (depth < 2 || depth >= MAX_DEPTH) REFUSE();
+        if (slot_kind(depth - 1) == K_TOP || slot_kind(depth - 2) == K_TOP) REFUSE();
+        move_slot(depth - 1, depth);
+        move_slot(depth - 2, depth - 1);
+        move_slot(depth, depth - 2);
+        break;
+
+      // ---- division ----
+      // wasm traps where Java throws or wraps, so both cases hand back and let
+      // the interpreter produce the ArithmeticException or the wrapped value.
+      case Bytecodes::_idiv: case Bytecodes::_irem: {
+        if (depth < 2 || slot_kind(depth - 2) != K_I32 || slot_kind(depth - 1) != K_I32) REFUSE();
+        local_get(stack_local(depth - 1));
+        emit(WOP_I32_EQZ);
+        if (c == Bytecodes::_idiv) {
+          local_get(stack_local(depth - 1)); emit_const(-1); emit(WOP_I32_EQ);
+          emit(WOP_I32_OR);
+        }
+        emit(WOP_IF); emit(0x40);
+        emit_bail(bci, depth, true);
+        emit(WOP_END);
+        local_get(stack_local(depth - 2));
+        local_get(stack_local(depth - 1));
+        emit(c == Bytecodes::_idiv ? WOP_I32_DIV_S : WOP_I32_REM_S);
+        set_i32(depth - 2); depth--;
+        break;
+      }
+
+      case Bytecodes::_ldiv: case Bytecodes::_lrem: {
+        if (depth < 4 || slot_kind(depth - 4) != K_I64 || slot_kind(depth - 2) != K_I64) REFUSE();
+        get_wide(K_I64, depth - 2);
+        _code_buf.u8(0x50);                        // i64.eqz
+        if (c == Bytecodes::_ldiv) {
+          get_wide(K_I64, depth - 2);
+          _code_buf.u8(WOP_I64_CONST); _code_buf.sleb64(-1);
+          emit(WOP_I64_EQ);
+          emit(WOP_I32_OR);
+        }
+        emit(WOP_IF); emit(0x40);
+        emit_bail(bci, depth, true);
+        emit(WOP_END);
+        get_wide(K_I64, depth - 4);
+        get_wide(K_I64, depth - 2);
+        emit(c == Bytecodes::_ldiv ? WOP_I64_DIV_S : WOP_I64_REM_S);
+        depth -= 2;
+        push_wide(K_I64, depth - 2);
+        break;
+      }
+
+      // ---- float ----
+      // Minecraft's rendering, its matrices and every entity position are
+      // floats. Without these the whole client stays interpreted no matter
+      // how good the integer path is.
+      case Bytecodes::_fconst_0: case Bytecodes::_fconst_1: case Bytecodes::_fconst_2:
+        emit_f32_const((jfloat)((int)c - (int)Bytecodes::_fconst_0));
+        push_val(K_F32, depth); depth++;
+        break;
+
+      case Bytecodes::_fload: case Bytecodes::_fload_0: case Bytecodes::_fload_1:
+      case Bytecodes::_fload_2: case Bytecodes::_fload_3: {
+        if (_local_base >= 0) REFUSE();        // inlined locals are i32 only
+        int index = (c == Bytecodes::_fload) ? (unsigned char)code[bci + 1]
+                                             : (int)c - (int)Bytecodes::_fload_0;
+        push_local_addr(index);
+        mem_op(WOP_F32_LOAD, 2, 0);
+        push_val(K_F32, depth); depth++;
+        break;
+      }
+
+      case Bytecodes::_fstore: case Bytecodes::_fstore_0: case Bytecodes::_fstore_1:
+      case Bytecodes::_fstore_2: case Bytecodes::_fstore_3: {
+        if (_local_base >= 0) REFUSE();
+        if (depth < 1 || slot_kind(depth - 1) != K_F32) REFUSE();
+        int index = (c == Bytecodes::_fstore) ? (unsigned char)code[bci + 1]
+                                              : (int)c - (int)Bytecodes::_fstore_0;
+        push_local_addr(index);
+        get_val(K_F32, depth - 1);
+        mem_op(WOP_F32_STORE, 2, 0);
+        depth--;
+        break;
+      }
+
+      case Bytecodes::_fadd: case Bytecodes::_fsub:
+      case Bytecodes::_fmul: case Bytecodes::_fdiv:
+        if (depth < 2 || slot_kind(depth - 2) != K_F32 || slot_kind(depth - 1) != K_F32) REFUSE();
+        get_val(K_F32, depth - 2);
+        get_val(K_F32, depth - 1);
+        emit(c == Bytecodes::_fadd ? WOP_F32_ADD : c == Bytecodes::_fsub ? WOP_F32_SUB
+           : c == Bytecodes::_fmul ? WOP_F32_MUL : WOP_F32_DIV);
+        depth--;
+        push_val(K_F32, depth - 1);
+        break;
+
+      case Bytecodes::_fneg:
+        if (depth < 1 || slot_kind(depth - 1) != K_F32) REFUSE();
+        get_val(K_F32, depth - 1);
+        emit(WOP_F32_NEG);
+        push_val(K_F32, depth - 1);
+        break;
+
+      case Bytecodes::_i2f:
+        if (depth < 1 || slot_kind(depth - 1) != K_I32) REFUSE();
+        local_get(stack_local(depth - 1));
+        emit(WOP_F32_CONVERT_I32_S);
+        push_val(K_F32, depth - 1);
+        break;
+
+      case Bytecodes::_l2f:
+        if (depth < 2 || slot_kind(depth - 2) != K_I64) REFUSE();
+        get_wide(K_I64, depth - 2);
+        emit(WOP_F32_CONVERT_I64_S);
+        depth -= 2;
+        push_val(K_F32, depth); depth++;
+        break;
+
+      case Bytecodes::_d2f:
+        if (depth < 2 || slot_kind(depth - 2) != K_F64) REFUSE();
+        get_wide(K_F64, depth - 2);
+        emit(WOP_F32_DEMOTE_F64);
+        depth -= 2;
+        push_val(K_F32, depth); depth++;
+        break;
+
+      case Bytecodes::_f2d:
+        if (depth < 1 || slot_kind(depth - 1) != K_F32) REFUSE();
+        get_val(K_F32, depth - 1);
+        emit(WOP_F64_PROMOTE_F32);
+        depth--;
+        push_wide(K_F64, depth); depth += 2;
+        break;
+
+      case Bytecodes::_f2i:
+        if (depth < 1 || slot_kind(depth - 1) != K_F32) REFUSE();
+        get_val(K_F32, depth - 1);
+        emit(0xfc); _code_buf.uleb(0);             // i32.trunc_sat_f32_s
+        set_i32(depth - 1);
+        break;
+
+      case Bytecodes::_f2l:
+        if (depth < 1 || slot_kind(depth - 1) != K_F32) REFUSE();
+        get_val(K_F32, depth - 1);
+        emit(0xfc); _code_buf.uleb(4);             // i64.trunc_sat_f32_s
+        depth--;
+        push_wide(K_I64, depth); depth += 2;
+        break;
+
+      case Bytecodes::_fcmpl: case Bytecodes::_fcmpg: {
+        if (depth < 2 || slot_kind(depth - 2) != K_F32 || slot_kind(depth - 1) != K_F32) REFUSE();
+        get_val(K_F32, depth - 2); get_val(K_F32, depth - 1); emit(WOP_F32_GT);
+        get_val(K_F32, depth - 2); get_val(K_F32, depth - 1); emit(WOP_F32_LT);
+        emit(WOP_I32_SUB);
+        emit_const(c == Bytecodes::_fcmpg ? 1 : -1);
+        get_val(K_F32, depth - 2); get_val(K_F32, depth - 2); emit(WOP_F32_EQ);
+        get_val(K_F32, depth - 1); get_val(K_F32, depth - 1); emit(WOP_F32_EQ);
+        emit(WOP_I32_AND);
+        emit(WOP_SELECT);
+        depth--;
+        set_i32(depth - 1);
+        break;
+      }
+
+      // ---- wide array elements ----
+      case Bytecodes::_laload: case Bytecodes::_daload: case Bytecodes::_faload: {
+        if (depth < 2 || slot_kind(depth - 2) != K_I32 || slot_kind(depth - 1) != K_I32) REFUSE();
+        BasicType t = (c == Bytecodes::_laload) ? T_LONG
+                    : (c == Bytecodes::_daload) ? T_DOUBLE : T_FLOAT;
+        int kind = (c == Bytecodes::_laload) ? K_I64 : (c == Bytecodes::_daload) ? K_F64 : K_F32;
+        int arr = stack_local(depth - 2), idx = stack_local(depth - 1);
+        guard_array(arr, idx, bci, depth);
+        emit_element_addr(arr, idx, t);
+        mem_op(kind == K_I64 ? WOP_I64_LOAD : kind == K_F64 ? WOP_F64_LOAD : WOP_F32_LOAD,
+               2, arrayOopDesc::base_offset_in_bytes(t));
+        depth -= 2;
+        push_val(kind, depth);
+        depth += is_wide(kind) ? 2 : 1;
+        break;
+      }
+
+      case Bytecodes::_lastore: case Bytecodes::_dastore: case Bytecodes::_fastore: {
+        BasicType t = (c == Bytecodes::_lastore) ? T_LONG
+                    : (c == Bytecodes::_dastore) ? T_DOUBLE : T_FLOAT;
+        int kind = (c == Bytecodes::_lastore) ? K_I64 : (c == Bytecodes::_dastore) ? K_F64 : K_F32;
+        int vs = is_wide(kind) ? 2 : 1;
+        if (depth < 2 + vs) REFUSE();
+        if (slot_kind(depth - vs) != kind) REFUSE();
+        int arr = stack_local(depth - vs - 2), idx = stack_local(depth - vs - 1);
+        if (slot_kind(depth - vs - 2) != K_I32 || slot_kind(depth - vs - 1) != K_I32) REFUSE();
+        guard_array(arr, idx, bci, depth);
+        emit_element_addr(arr, idx, t);
+        get_val(kind, depth - vs);
+        mem_op(kind == K_I64 ? WOP_I64_STORE : kind == K_F64 ? WOP_F64_STORE : WOP_F32_STORE,
+               2, arrayOopDesc::base_offset_in_bytes(t));
+        depth -= (2 + vs);
+        break;
+      }
+
+      // ---- allocation ----
+      // The TLAB bump only; anything that would need a refill, a GC or a slow
+      // path hands back and lets the interpreter run the whole bytecode.
+      case Bytecodes::_new: {
+        if (!_can_alloc || disabled(NO_ALLOC) || _next_local >= 500) {
+          emit_bail(bci, depth); return true;
+        }
+        Klass* k = resolved_klass(m, s2u_at(code, bci + 1));
+        if (k == nullptr || !k->is_instance_klass()) { emit_bail(bci, depth); return true; }
+        InstanceKlass* ik = InstanceKlass::cast(k);
+        if (!ik->is_initialized() || !ik->can_be_fastpath_allocated()) {
+          emit_bail(bci, depth); return true;
+        }
+        int size_bytes = (int)ik->size_helper() * HeapWordSize;
+        if (size_bytes > 256 || depth >= MAX_DEPTH) { emit_bail(bci, depth); return true; }
+        int dst = alloc_locals(1);
+        emit_tlab_alloc(size_bytes, dst, bci, depth);
+        emit_object_init(dst, ik, size_bytes);
+        local_get(dst);
+        set_i32(depth); depth++;
+        break;
+      }
+
+      // ---- type checks ----
+      // The fast path is exact-or-primary-super; anything else is not "false",
+      // it is "ask the interpreter", so it bails.
+      case Bytecodes::_checkcast: {
+        if (depth < 1 || slot_kind(depth - 1) != K_I32) REFUSE();
+        Klass* k = disabled(NO_TYPECHECK) ? nullptr : resolved_klass(m, s2u_at(code, bci + 1));
+        if (k == nullptr) { emit_bail(bci, depth); return true; }
+        int obj = stack_local(depth - 1);
+        local_get(obj);
+        emit(WOP_IF); emit(0x40);
+        if (k->is_final()) { emit_klass_of(obj); emit_const((int)(intptr_t)k); emit(WOP_I32_EQ); }
+        else emit_is_subtype(obj, k);
+        emit(WOP_I32_EQZ);
+        emit(WOP_IF); emit(0x40);
+        emit_bail(bci, depth, true);
+        emit(WOP_END);
+        emit(WOP_END);
+        break;
+      }
+
+      case Bytecodes::_instanceof: {
+        if (depth < 1 || slot_kind(depth - 1) != K_I32) REFUSE();
+        Klass* k = disabled(NO_TYPECHECK) ? nullptr : resolved_klass(m, s2u_at(code, bci + 1));
+        if (k == nullptr) { emit_bail(bci, depth); return true; }
+        if (_next_local >= 500) { emit_bail(bci, depth); return true; }
+        int obj = stack_local(depth - 1);
+        // A final class has no subclasses, so the exact test is the whole
+        // answer and a false result needs no interpreter.
+        bool exact = k->is_final();
+        // The result goes to a scratch local first. It shares a slot with the
+        // receiver, and a bail has to hand the interpreter the receiver -- not
+        // a half-computed answer written over it.
+        int tmp = alloc_locals(1);
+        local_get(obj);
+        emit(WOP_IF); emit(0x40);
+        if (exact) { emit_klass_of(obj); emit_const((int)(intptr_t)k); emit(WOP_I32_EQ); }
+        else emit_is_subtype(obj, k);
+        local_set(tmp);
+        if (!exact) {
+          local_get(tmp);
+          emit(WOP_I32_EQZ);
+          emit(WOP_IF); emit(0x40);
+          emit_bail(bci, depth, true);
+          emit(WOP_END);
+        }
+        local_get(tmp);
+        local_set(stack_local(depth - 1));
+        emit(0x05);                                // else
+        emit_const(0);
+        local_set(stack_local(depth - 1));
+        emit(WOP_END);
+        set_slot(depth - 1, K_I32);
+        break;
+      }
+
+      // ---- resolved oop constants ----
+      // The array moves under GC but the OopHandle's storage slot does not, so
+      // the array is loaded fresh and the element indexed off it.
+      case Bytecodes::_fast_aldc: case Bytecodes::_fast_aldc_w: {
+        int index = (c == Bytecodes::_fast_aldc) ? (unsigned char)code[bci + 1]
+                                                 : u2_at(code, bci + 1);
+        ConstantPoolCache* cache = m->constants()->cache();
+        if (cache == nullptr) { emit_bail(bci, depth); return true; }
+        oop resolved = m->constants()->resolved_reference_at(index);
+        if (resolved == nullptr) { emit_bail(bci, depth); return true; }
+        if (resolved == Universe::the_null_sentinel()) {
+          emit_const(0); set_i32(depth); depth++; break;
+        }
+        oop* storage = *(oop**)((address)cache
+            + in_bytes(ConstantPoolCache::resolved_references_offset()));
+        if (storage == nullptr) { emit_bail(bci, depth); return true; }
+        emit_const((int)(intptr_t)storage);
+        i32_load();
+        mem_op(WOP_I32_LOAD, 2,
+               arrayOopDesc::base_offset_in_bytes(T_OBJECT) + index * (int)heapOopSize);
+        set_i32(depth); depth++;
+        break;
+      }
+
+      // ---- wide gotos and switches ----
+      case Bytecodes::_goto_w: {
+        int target = bci + s4_at(code, bci + 1);
+        if (!allow_branches) { int d = inl_target_depth(target); if (d < 0) REFUSE(); br(d); break; }
+        if (!record_entry(target, depth)) REFUSE();
+        emit_backedge_budget(target < bci, target, depth);
+        emit_const(_block_of[target]);
+        local_set(L_BLK);
+        br(L_DEPTH);
+        terminal = true;
+        break;
+      }
+
+      case Bytecodes::_tableswitch: case Bytecodes::_lookupswitch: {
+        if (!allow_branches) REFUSE();
+        if (disabled(NO_SWITCH)) { emit_bail(bci, depth); return true; }
+        if (depth < 1 || slot_kind(depth - 1) != K_I32) REFUSE();
+        int keyslot = stack_local(depth - 1);
+        depth--;
+        SwitchInfo si;
+        if (!switch_info(code, bci, _len, &si)) { emit_bail(bci, depth); return true; }
+        int limit = (c == Bytecodes::_tableswitch) ? 1024 : 64;
+        if (si.npairs > limit) { emit_bail(bci, depth); return true; }
+        int def_t = bci + si.def;
+        if (!record_entry(def_t, depth)) REFUSE();
+        bool backward = def_t < bci;
+        for (int i = 0; i < si.npairs; i++) {
+          int t = switch_target(code, bci, si, i);
+          if (!record_entry(t, depth)) REFUSE();
+          if (t < bci) backward = true;
+        }
+        emit_backedge_budget(backward, bci, depth + 1);
+        if (c == Bytecodes::_tableswitch) {
+          // block $sel(result i32) { block $c_n { ... block $c_0 { br_table } } }
+          emit(WOP_BLOCK); emit(WT_I32);
+          for (int i = 0; i <= si.npairs; i++) { emit(WOP_BLOCK); emit(0x40); }
+          local_get(keyslot);
+          emit_const(si.lo);
+          emit(WOP_I32_SUB);
+          emit(WOP_BR_TABLE);
+          _code_buf.uleb((unsigned)si.npairs);
+          for (int i = 0; i < si.npairs; i++) _code_buf.uleb((unsigned)i);
+          _code_buf.uleb((unsigned)si.npairs);
+          for (int i = 0; i <= si.npairs; i++) {
+            emit(WOP_END);
+            int t = (i == si.npairs) ? def_t : switch_target(code, bci, si, i);
+            emit_const(_block_of[t]);
+            br(si.npairs - i);
+          }
+          emit(WOP_END);
+          local_set(L_BLK);
+        } else {
+          emit_const(_block_of[def_t]);
+          local_set(L_BLK);
+          for (int i = 0; i < si.npairs; i++) {
+            local_get(keyslot);
+            emit_const(switch_key(code, bci, si, i));
+            emit(WOP_I32_EQ);
+            emit(WOP_IF); emit(0x40);
+            emit_const(_block_of[switch_target(code, bci, si, i)]);
+            local_set(L_BLK);
+            emit(WOP_END);
+          }
+        }
+        br(L_DEPTH);
+        terminal = true;
+        break;
+      }
+
+      // ---- wide-index locals ----
+      case Bytecodes::_wide: {
+        Bytecodes::Code sub = (Bytecodes::Code)(unsigned char)code[bci + 1];
+        int index = (((unsigned char)code[bci + 2]) << 8) | (unsigned char)code[bci + 3];
+        switch (sub) {
+          case Bytecodes::_iload: case Bytecodes::_aload:
+            emit_local_load(index); set_i32(depth); depth++; break;
+          case Bytecodes::_istore: case Bytecodes::_astore:
+            if (depth < 1 || slot_kind(depth - 1) != K_I32) REFUSE();
+            emit_local_store(index, stack_local(depth - 1)); depth--; break;
+          case Bytecodes::_fload:
+            if (_local_base >= 0) REFUSE();
+            push_local_addr(index); mem_op(WOP_F32_LOAD, 2, 0);
+            push_val(K_F32, depth); depth++; break;
+          case Bytecodes::_fstore:
+            if (_local_base >= 0) REFUSE();
+            if (depth < 1 || slot_kind(depth - 1) != K_F32) REFUSE();
+            push_local_addr(index); get_val(K_F32, depth - 1);
+            mem_op(WOP_F32_STORE, 2, 0); depth--; break;
+          case Bytecodes::_lload: case Bytecodes::_dload: {
+            if (_local_base >= 0) REFUSE();
+            int k = (sub == Bytecodes::_dload) ? K_F64 : K_I64;
+            push_wide_local_addr(index);
+            mem_op(k == K_F64 ? WOP_F64_LOAD : WOP_I64_LOAD, 2, 0);
+            push_wide(k, depth); depth += 2; break;
+          }
+          case Bytecodes::_lstore: case Bytecodes::_dstore: {
+            if (_local_base >= 0) REFUSE();
+            int k = (sub == Bytecodes::_dstore) ? K_F64 : K_I64;
+            if (depth < 2 || slot_kind(depth - 2) != k) REFUSE();
+            push_wide_local_addr(index);
+            get_wide(k, depth - 2);
+            mem_op(k == K_F64 ? WOP_F64_STORE : WOP_I64_STORE, 2, 0);
+            depth -= 2; break;
+          }
+          case Bytecodes::_iinc:
+            emit_local_inc(index, s2_at(code, bci + 4)); break;
+          default:
+            emit_bail(bci, depth); return true;
+        }
+        break;
+      }
+
+      // Object.<init> is one byte of this, and refusing it refused every
+      // constructor. It is a no-op unless the receiver's class has a
+      // finalizer, and that is a bit in the Klass.
+      case Bytecodes::_return_register_finalizer: {
+        if (allow_branches) { emit_bail(bci, depth); return true; }
+        if (_local_base < 0) REFUSE();
+        emit_klass_of(_local_base);
+        mem_op(WOP_I32_LOAD8_U, 0, (int)in_bytes(Klass::misc_flags_offset()));
+        emit_const(4);                             // KlassFlags::_misc_has_finalizer
+        emit(WOP_I32_AND);
+        emit(WOP_IF); emit(0x40);
+        emit_bail(bci, depth, true);
+        emit(WOP_END);
+        br(inl_exit_depth());
+        break;
+      }
+
+      default:
+        // Anything still not implemented -- the polymorphic calls, athrow,
+        // monitors -- ends the compiled trace with a coherent frame. The
+        // interpreter picks it up from exactly here.
+        emit_bail(bci, depth);
+        return true;
+    }
+    bci += size;
+  }
+
+  // Ran off the end of the block into the next one: nothing to emit, the
+  // nesting makes it fall through.
+  if (!allow_branches) return true;         // inlined body ended at its return
+  if (allow_branches) _fell_through = !terminal;
+  (void)EXIT_DEPTH;
+  return true;
+  #undef REFUSE
+}
+
+
+// Stack effect of the opcodes an inlined body may contain. Returns false for
+// anything not modelled, which is what keeps inline_cfg() honest.
+static bool stack_delta(Bytecodes::Code c, Method* m, address code, int bci, int* d) {
+  switch (c) {
+    case Bytecodes::_nop: case Bytecodes::_iinc:
+    case Bytecodes::_ineg: case Bytecodes::_i2b: case Bytecodes::_i2s:
+    case Bytecodes::_i2c: case Bytecodes::_arraylength:
+    case Bytecodes::_getfield: case Bytecodes::_fast_igetfield:
+    case Bytecodes::_fast_agetfield: case Bytecodes::_fast_bgetfield:
+    case Bytecodes::_fast_sgetfield: case Bytecodes::_fast_cgetfield:
+    case Bytecodes::_goto: case Bytecodes::_return:
+      *d = 0; return true;
+    case Bytecodes::_iaload: case Bytecodes::_aaload: case Bytecodes::_baload:
+    case Bytecodes::_caload: case Bytecodes::_saload:
+      *d = -1; return true;
+    case Bytecodes::_ldc: case Bytecodes::_ldc_w:
+      *d = 1; return true;
+    case Bytecodes::_iconst_m1: case Bytecodes::_iconst_0: case Bytecodes::_iconst_1:
+    case Bytecodes::_iconst_2:  case Bytecodes::_iconst_3: case Bytecodes::_iconst_4:
+    case Bytecodes::_iconst_5:  case Bytecodes::_bipush:   case Bytecodes::_sipush:
+    case Bytecodes::_iload: case Bytecodes::_iload_0: case Bytecodes::_iload_1:
+    case Bytecodes::_iload_2: case Bytecodes::_iload_3: case Bytecodes::_fast_iload:
+    case Bytecodes::_aload: case Bytecodes::_aload_0: case Bytecodes::_aload_1:
+    case Bytecodes::_aload_2: case Bytecodes::_aload_3: case Bytecodes::_fast_aload_0:
+    case Bytecodes::_dup: case Bytecodes::_getstatic:
+    case Bytecodes::_fast_iaccess_0: case Bytecodes::_fast_aaccess_0:
+      *d = 1; return true;
+    case Bytecodes::_istore: case Bytecodes::_istore_0: case Bytecodes::_istore_1:
+    case Bytecodes::_istore_2: case Bytecodes::_istore_3:
+    case Bytecodes::_astore_0: case Bytecodes::_astore_1:
+    case Bytecodes::_astore_2: case Bytecodes::_astore_3:
+    case Bytecodes::_pop:
+    case Bytecodes::_iadd: case Bytecodes::_isub: case Bytecodes::_imul:
+    case Bytecodes::_iand: case Bytecodes::_ior:  case Bytecodes::_ixor:
+    case Bytecodes::_ishl: case Bytecodes::_ishr: case Bytecodes::_iushr:
+    case Bytecodes::_ifeq: case Bytecodes::_ifne: case Bytecodes::_iflt:
+    case Bytecodes::_ifge: case Bytecodes::_ifgt: case Bytecodes::_ifle:
+    case Bytecodes::_ifnull: case Bytecodes::_ifnonnull:
+    case Bytecodes::_ireturn: case Bytecodes::_areturn:
+      *d = -1; return true;
+    case Bytecodes::_if_icmpeq: case Bytecodes::_if_icmpne:
+    case Bytecodes::_if_icmplt: case Bytecodes::_if_icmpge:
+    case Bytecodes::_if_icmpgt: case Bytecodes::_if_icmple:
+    case Bytecodes::_if_acmpeq: case Bytecodes::_if_acmpne:
+      *d = -2; return true;
+    default:
+      return false;
+  }
+}
+
+// Can this callee be spliced into its caller? The rules exist to make one
+// thing true: a guard that fires anywhere inside the inlined body may hand
+// back at the *caller's* invoke bci, and the interpreter will then re-execute
+// the whole call. That is only safe if the callee has done nothing observable
+// first -- hence "no stores". Straight-line only for now, so the body has a
+// single exit and needs no share of the caller's block dispatch.
+bool Codegen::inlinable(Method* callee, int nest) {
+  if (nest == 0) { _bad_op = -1; _shape = "shape"; }
+  if (callee == nullptr) { _shape = "null callee"; return false; }
+  if (callee->is_native())       { _shape = "native"; return false; }
+  if (callee->is_abstract())     { _shape = "abstract"; return false; }
+  if (callee->is_synchronized()) { _shape = "synchronized"; return false; }
+  int len = callee->code_size();
+  if (len <= 0)                     { _shape = "empty"; return false; }
+  if (len > MAX_INLINE_BYTECODES)   { _shape = "too big"; return false; }
+  if (callee->max_locals() + callee->max_stack() > MAX_DEPTH) {
+    _shape = "frame too wide"; return false;
+  }
+  return inline_cfg(callee, nest, nullptr, nullptr, nullptr);
+}
+
+// Walks the callee proving three things at once: every opcode is one we emit,
+// every branch goes forward (so the targets nest as wasm blocks), and the
+// operand stack depth at each target is the same on every path that reaches
+// it. Optionally records the targets and depths for the emitter, so the check
+// and the emission can never disagree about the shape.
+bool Codegen::inline_cfg(Method* callee, int nest,
+                         int* targets, int* ntargets, int* depth_at) {
+  address code = callee->code_base();
+  int len = callee->code_size();
+  int local_targets[MAX_TARGETS];
+  int local_depths[MAX_INLINE_BYTECODES + 1];
+  int n = 0;
+  for (int i = 0; i <= len; i++) local_depths[i] = -1;
+  local_depths[0] = 0;
+
+  int depth = 0;
+  bool reachable = true;
+  bool saw_return = false;
+
+  for (int bci = 0; bci < len; ) {
+    int raw = (unsigned char)code[bci];
+    if (raw >= Bytecodes::number_of_codes) { if (_bad_op < 0) _bad_op = raw; return false; }
+    Bytecodes::Code c = (Bytecodes::Code)raw;
+    int size = Bytecodes::length_for(c);
+    if (size <= 0) { if (_bad_op < 0) _bad_op = raw; return false; }
+
+    if (local_depths[bci] >= 0) {
+      if (reachable && depth != local_depths[bci]) return false;  // merge mismatch
+      depth = local_depths[bci];
+      reachable = true;
+    } else if (!reachable) {
+      return false;              // unreachable code we cannot type
+    } else {
+      local_depths[bci] = depth;
+    }
+
+    switch (c) {
+      case Bytecodes::_invokestatic: case Bytecodes::_invokespecial:
+      case Bytecodes::_fast_invokevfinal: {
+        if (nest + 1 >= MAX_INLINE_DEPTH) { if (_bad_op < 0) _bad_op = raw; return false; }
+        Method* target = static_callee(callee, code, bci);
+        if (target == nullptr || !inlinable(target, nest + 1)) {
+          if (_bad_op < 0) _bad_op = raw;
+          return false;
+        }
+        depth -= target->size_of_parameters();
+        if (target->result_type() != T_VOID) depth += 1;
+        if (target->result_type() == T_LONG || target->result_type() == T_DOUBLE) return false;
+        if (depth < 0) return false;
+        break;
+      }
+      case Bytecodes::_ireturn: case Bytecodes::_areturn:
+        saw_return = true; depth -= 1; reachable = false; break;
+      case Bytecodes::_return:
+      case Bytecodes::_return_register_finalizer:
+        saw_return = true; reachable = false; break;
+      default: {
+        int d;
+        if (!stack_delta(c, callee, code, bci, &d)) { if (_bad_op < 0) _bad_op = raw; return false; }
+        depth += d;
+        if (depth < 0) return false;
+        bool is_branch =
+            (c >= Bytecodes::_ifeq && c <= Bytecodes::_if_acmpne)
+            || c == Bytecodes::_ifnull || c == Bytecodes::_ifnonnull
+            || c == Bytecodes::_goto;
+        if (is_branch) {
+          int off = (int)(short)(((unsigned char)code[bci+1] << 8) | (unsigned char)code[bci+2]);
+          int t = bci + off;
+          if (off <= 0 || t > len) return false;      // forward only, no loops
+          if (local_depths[t] >= 0 && local_depths[t] != depth) return false;
+          local_depths[t] = depth;
+          bool seen = false;
+          for (int i = 0; i < n; i++) if (local_targets[i] == t) seen = true;
+          if (!seen) {
+            if (n >= MAX_TARGETS) return false;
+            if ((uintx)n >= ZeroWasmJITMaxInlineTargets) return false;
+            local_targets[n++] = t;
+          }
+          if (c == Bytecodes::_goto) reachable = false;
+        }
+        break;
+      }
+    }
+    bci += size;
+  }
+  if (!saw_return) { if (_bad_op < 0) _shape = "no single return"; return false; }
+
+  // ascending, so they close innermost-first as the walk passes each one
+  for (int i = 1; i < n; i++) {
+    int v = local_targets[i], j = i - 1;
+    while (j >= 0 && local_targets[j] > v) { local_targets[j+1] = local_targets[j]; j--; }
+    local_targets[j+1] = v;
+  }
+  if (targets != nullptr) {
+    for (int i = 0; i < n; i++) targets[i] = local_targets[i];
+    *ntargets = n;
+    for (int i = 0; i <= len; i++) depth_at[i] = local_depths[i];
+  }
+  return true;
+}
+
+// Splices the callee's body into the caller. Its locals become wasm locals and
+// its operand stack continues the caller's, so no Zero frame is built and no
+// interpreter entry happens -- which is where the win is, because a frame
+// build dwarfs the handful of bytecodes a getter actually executes.
+bool Codegen::try_inline(Method* m, address code, int bci, int& depth) {
+  #define INLINE_NO(reason) do { if (ZeroWasmJITVerbose) \
+      tty->print_cr("[zwc]   no-inline @%d: %s", bci, reason); return false; } while (0)
+  if (disabled(NO_INLINE)) INLINE_NO("disabled");
+  if (_inline_depth >= MAX_INLINE_DEPTH) INLINE_NO("nesting limit");
+  ConstantPoolCache* cache = m->constants()->cache();
+  if (cache == nullptr) INLINE_NO("no cpCache");
+  Method* callee = static_callee(m, code, bci);
+  if (callee == nullptr) INLINE_NO("unresolved or not statically bound");
+  if (!inlinable(callee)) {
+    if (ZeroWasmJITVerbose) { ResourceMark rm;
+      tty->print_cr("[zwc]   no-inline @%d: body %s (%d bytes) blocked by %s", bci,
+                    callee == nullptr ? "null" : callee->name_and_sig_as_C_string(),
+                    callee == nullptr ? 0 : callee->code_size(),
+                    _bad_op >= 0 ? Bytecodes::name((Bytecodes::Code)_bad_op) : _shape); }
+    return false;
+  }
+
+  int nargs = callee->size_of_parameters();     // includes the receiver
+  if (depth < nargs) INLINE_NO("args not on stack");
+  // The callee's locals become i32 wasm locals, so every argument slot has to
+  // already be one. A float or a long argument would be copied out of the
+  // wrong local entirely.
+  for (int k = 0; k < nargs; k++) {
+    if (slot_kind(depth - nargs + k) != K_I32) INLINE_NO("wide argument");
+  }
+  if (depth + callee->max_stack() >= MAX_DEPTH) INLINE_NO("stack too deep");
+
+  const int bail_bci = bci;                     // where a bail must resume
+  const int bail_depth = depth;                 // with the args still pushed
+
+  int base = alloc_locals(callee->max_locals());
+  if (_next_local > 512) INLINE_NO("too many locals");
+
+  // Only the outermost splice needs this: a bail anywhere inside, however
+  // deeply nested, unwinds to the outermost invoke and re-executes it, so it
+  // is that call's arguments that have to survive.
+  int save_base = 0;
+  if (_inl_bail_bci < 0 && nargs > 0) {
+    save_base = alloc_locals(nargs);
+    if (_next_local > 512) INLINE_NO("too many locals");
+    for (int k = 0; k < nargs; k++) {
+      local_get(stack_local(depth - nargs + k));
+      local_set(save_base + k);
+    }
+  }
+
+  for (int k = 0; k < nargs; k++) {
+    local_get(stack_local(depth - nargs + k));
+    local_set(base + k);
+  }
+  if (!callee->is_static()) {
+    // Receiver null check, handing back at the caller's invoke bci with the
+    // arguments still on the caller's stack, exactly as they were.
+    guard_nonnull(base, bci, depth);
+  }
+  depth -= nargs;
+
+  // Shape of the callee's control flow, recomputed here so the emitter uses
+  // exactly what the check approved.
+  int targets[MAX_TARGETS];
+  int ntargets = 0;
+  int depth_at[MAX_INLINE_BYTECODES + 1];
+  if (!inline_cfg(callee, _inline_depth, targets, &ntargets, depth_at)) {
+    INLINE_NO("cfg changed under us");
+  }
+
+  // Save the enclosing splice's state: inlining nests.
+  int s_targets[MAX_TARGETS];
+  for (int i = 0; i < _inl_ntargets; i++) s_targets[i] = _inl_targets[i];
+  int s_nt = _inl_ntargets, s_next = _inl_next, s_slot = _inl_result_slot;
+  int* s_da = _inl_depth_at;
+  int s_bbci = _inl_bail_bci, s_bdepth = _inl_bail_depth;
+  int s_save_base = _inl_save_base, s_save_n = _inl_save_n;
+  int s_base = _inl_base_depth;
+  bool s_body_bailed = _inl_body_bailed;
+
+  for (int i = 0; i < ntargets; i++) _inl_targets[i] = targets[i];
+  _inl_ntargets = ntargets;
+  _inl_next = 0;
+  _inl_depth_at = depth_at;
+  _inl_result_slot = stack_local(depth);
+  _inl_base_depth = depth;
+  // Nested splices keep the outermost landing site: unwinding to the top-level
+  // invoke re-executes everything, which is what the interpreter expects.
+  if (s_bbci < 0) {
+    _inl_bail_bci = bail_bci;
+    _inl_bail_depth = bail_depth;
+    _inl_save_base = save_base;
+    _inl_save_n = nargs;
+  }
+  _inl_body_bailed = false;
+
+  emit(WOP_BLOCK); emit(0x40);                  // $inline_exit
+  for (int i = ntargets - 1; i >= 0; i--) { emit(WOP_BLOCK); emit(0x40); }
+
+  int saved_base = _local_base;
+  _local_base = base;
+  _inline_depth++;
+  int cdepth = depth;
+  bool ok = emit_range(callee, callee->code_base(), 0, callee->code_size(),
+                       cdepth, -1, false);
+  _inline_depth--;
+
+  while (_inl_next < _inl_ntargets) { emit(WOP_END); _inl_next++; }
+  emit(WOP_END);                                // $inline_exit
+
+  // A non-guard bail can have truncated the linear walk before one of the
+  // callee's forward targets. A path that branches to such a target would
+  // otherwise leave the splice through $inline_exit with a stale result and
+  // continue in the caller. Re-execute the caller's invoke on every path
+  // reaching that exit; the saved arguments make this the same state as the
+  // original call. This is outside the target blocks, so it covers both the
+  // truncated fall-through and every bypassing branch.
+  bool body_bailed = _inl_body_bailed;
+  if (body_bailed) emit_bail(bail_bci, bail_depth);
+  _local_base = saved_base;
+
+  _inl_ntargets = s_nt; _inl_next = s_next; _inl_depth_at = s_da;
+  _inl_result_slot = s_slot;
+  _inl_bail_bci = s_bbci; _inl_bail_depth = s_bdepth;
+  _inl_save_base = s_save_base; _inl_save_n = s_save_n;
+  _inl_base_depth = s_base;
+  _inl_body_bailed = s_body_bailed;
+  for (int i = 0; i < s_nt; i++) _inl_targets[i] = s_targets[i];
+
+  if (!ok) { fail(); return true; }             // body was pre-verified; not a bail
+  if (callee->result_type() != T_VOID) { set_slot(depth, K_I32); depth += 1; }
+  _inlined++;
+  if (!_bailed) _inlined_before_bail++;
+  return true;
+  #undef INLINE_NO
+}
+
+// ---------------------------------------------------------------------------
+// Thread-local code cache
+//
+// The wasm table is per-thread, so an index is only meaningful on the thread
+// that installed it. Compiling is ~13 us, which is far cheaper than any scheme
+// for sharing entries between threads.
+// ---------------------------------------------------------------------------
+struct CacheEntry {
+  Method* method;
+  int     index;        // code index, -1 = refused
+  int     count;        // entries seen before compiling
+  int     nosr;         // loop headers compiled code may be entered at
+  int     osr_bci[8];
+  int     osr_blk[8];
+};
+
+// 3800 distinct methods produced 400k compile attempts on a real client run:
+// a 1024-entry table with straight eviction thrashes, and every eviction pays
+// for the whole scan again. Bigger, plus one extra probe so a collision
+// displaces nothing that already has a verdict.
+static const int CACHE_SIZE = 8192;
+static THREAD_LOCAL CacheEntry* _cache = nullptr;
+static THREAD_LOCAL int _compiled = 0;
+static THREAD_LOCAL int _refused = 0;
+
+static CacheEntry* cache_find(Method* m) {
+  if (_cache == nullptr) {
+    _cache = (CacheEntry*)::calloc(CACHE_SIZE, sizeof(CacheEntry));
+    if (_cache == nullptr) return nullptr;
+  }
+  unsigned h = (unsigned)((uintptr_t)m >> 3) & (CACHE_SIZE - 1);
+  for (int probe = 0; probe < 2; probe++) {
+    CacheEntry* e = &_cache[h ^ (unsigned)probe];
+    if (e->method == m) return e;
+    if (e->method == nullptr) { e->method = m; e->index = 0; e->count = 0; return e; }
+  }
+  // Both probes belong to other methods that already have a verdict. Leave
+  // them alone and interpret this one: losing a compile is a slowdown, and
+  // evicting a compiled entry to re-earn it is a worse one.
+  CacheEntry* e = &_cache[h];
+  if (e->index == 0) { e->method = m; e->count = 0; return e; }
+  return nullptr;
+}
+
+static bool compile_into(Method* method, CacheEntry* e);
+
+void ZeroWasmCompiler::print_statistics() {
+  tty->print_cr("[zwc] compiled=%d refused=%d", _compiled, _refused);
+}
+
+// The real entry point, called from the `run:` label with everything the
+// interpreter has established.
+bool ZeroWasmCompiler::maybe_run(Method* method, intptr_t* locals,
+                                 address code_base, address* pc, intptr_t** tos,
+                                 void* istate) {
+  // Entry conditions are checked by the caller, which can do it with loads it
+  // has already made.
+
+  CacheEntry* e = cache_find(method);
+  if (e == nullptr || e->index < 0) return false;
+
+  if (e->index == 0) {
+    if (++e->count < (int)ZeroWasmJITThreshold) return false;
+    if (!compile_into(method, e)) return false;
+  }
+
+  intptr_t out = 0;
+  int bci = zwc_call(e->index, (int)(intptr_t)locals, (int)(intptr_t)*tos,
+                     (int)(intptr_t)&out, (int)(intptr_t)istate, 0);
+  *pc = code_base + bci;
+  *tos = (intptr_t*)out;
+  return true;
+}
+
+// Compiles the method into this cache entry. Returns false if it was refused,
+// having marked the entry so it is never attempted again on this thread.
+static bool compile_into(Method* method, CacheEntry* e) {
+  {
+    // -XX:ZeroWasmJITOnly=Foo isolates a suspect method from everything the
+    // JDK compiles during boot, which is the only practical way to get a
+    // clean differential on a miscompile that breaks startup.
+    if (ZeroWasmJITOnly != nullptr) {
+      ResourceMark rm;
+      if (::strstr(method->name_and_sig_as_C_string(), ZeroWasmJITOnly) == nullptr) {
+        e->index = -1;
+        return false;
+      }
+    }
+    WasmBuf module;
+    Codegen gen(method);
+    bool built = gen.compile(module);
+    // Dumping the module is the only way to see what was actually emitted;
+    // reasoning about the encoding from the emitter is how a wrong br depth
+    // survives review. Disassemble with: wasm-dis <file>
+    if (built && ZeroWasmJITDump != nullptr) {
+      ResourceMark rm;
+      char path[512];
+      const char* n = method->name_and_sig_as_C_string();
+      char safe[256];
+      size_t i = 0;
+      for (; n[i] != '\0' && i < sizeof(safe) - 1; i++) {
+        char ch = n[i];
+        safe[i] = (ch == '/' || ch == '(' || ch == ')' || ch == ';' || ch == ' ') ? '_' : ch;
+      }
+      safe[i] = '\0';
+      jio_snprintf(path, sizeof(path), "%s/%s.wasm", ZeroWasmJITDump, safe);
+      FILE* f = ::fopen(path, "wb");
+      if (f != nullptr) {
+        ::fwrite(module.data(), 1, (size_t)module.length(), f);
+        ::fclose(f);
+      }
+    }
+    int idx = built ? zwc_install(module.data(), module.length()) : -1;
+    if (ZeroWasmJITVerbose) {
+      ResourceMark rm;
+      tty->print_cr("[zwc] %s %s (%d bytes bytecode): %s%s%s%s",
+                    idx > 0 ? "compiled" : "refused",
+                    method->name_and_sig_as_C_string(), method->code_size(),
+                    idx > 0 ? "ok" : (built ? "engine rejected module" : gen._why),
+                    idx > 0 ? "" : " at ", idx > 0 ? "" : gen.bail_op_name(),
+                    idx > 0 ? "" : gen.fail_where());
+    }
+    if (idx <= 0) { e->index = -1; _refused++; return false; }
+    e->index = idx;
+    e->nosr = gen.osr_count() < 8 ? gen.osr_count() : 8;
+    for (int i = 0; i < e->nosr; i++) {
+      e->osr_bci[i] = gen.osr_bci(i);
+      e->osr_blk[i] = gen.osr_blk(i);
+    }
+    _compiled++;
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// On-stack replacement
+//
+// A method is compiled when it has been *entered* often enough, which never
+// fires for a method that runs one long loop -- and a chunk mesher, a worldgen
+// pass and a benchmark's main() are all exactly that. This is the other
+// trigger: a back-edge taken often enough compiles the method and enters the
+// compiled body at the loop header instead of at bci 0.
+//
+// Safe because a back-edge target is a block leader whose entry depth the
+// compiler proved to be zero -- so the state the interpreter has at the branch
+// is the state compiled code expects at that block.
+THREAD_LOCAL int ZeroWasmCompiler::_osr_countdown = OSR_SAMPLE;
+
+bool ZeroWasmCompiler::maybe_run_osr(Method* method, intptr_t* locals,
+                                     address* pc, intptr_t** tos, void* istate) {
+  _osr_countdown = OSR_SAMPLE;
+  address code_base = method->code_base();
+  int bci = (int)(*pc - code_base);
+
+  CacheEntry* e = cache_find(method);
+  if (e == nullptr || e->index < 0) return false;
+  if (e->index == 0) {
+    // Each sample stands for OSR_SAMPLE back-edges, so this reaches the
+    // threshold after a few thousand iterations of a real loop.
+    if (++e->count < (int)ZeroWasmJITThreshold) return false;
+    if (!compile_into(method, e)) return false;
+  }
+  if (disabled(NO_OSR)) return false;
+  int blk = -1;
+  for (int i = 0; i < e->nosr; i++) if (e->osr_bci[i] == bci) blk = e->osr_blk[i];
+  if (blk < 0) return false;
+
+  intptr_t out = 0;
+  int at = zwc_call(e->index, (int)(intptr_t)locals, (int)(intptr_t)*tos,
+                    (int)(intptr_t)&out, (int)(intptr_t)istate, blk);
+  *pc = code_base + at;
+  *tos = (intptr_t*)out;
+  return true;
+}
+
+#endif // __EMSCRIPTEN__
