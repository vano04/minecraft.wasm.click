+#ifdef __EMSCRIPTEN__
+
+class Method;
+
+/*
+ * Compiles Java bytecode to wasm at runtime.
+ *
+ * wasm has no writable-executable memory, so this cannot emit into the code
+ * cache the way every other HotSpot compiler does. Instead each method becomes
+ * a small WebAssembly.Module which imports the JVM's own linear memory and is
+ * installed into the indirect function table, where the index *is* a callable
+ * function pointer. See docs/JIT-DESIGN.md and OpenJDK/jit-probe/.
+ *
+ * Two consequences shape the whole design:
+ *
+ *  - the table is per-thread, so the code cache is thread-local. Compiling is
+ *    ~13 us, which is cheaper than any scheme for sharing across threads.
+ *
+ *  - generated code operates on the *real* Zero frame in linear memory, so the
+ *    GC, stack walking and exception handling continue to see exactly what they
+ *    saw before. Nothing may live only in a wasm local across a safepoint.
+ *
+ * The entry point is called from the `run:` label of BytecodeInterpreter::run,
+ * where pc, topOfStack and locals are all established and the state is exactly
+ * defined. Everything with VM interaction -- method entry, returns, monitors,
+ * calls -- stays in the interpreter: compiled code covers the arithmetic
+ * interior and hands back a coherent istate at the first thing it does not
+ * implement.
+ */
+class ZeroWasmCompiler : AllStatic {
+ public:
+  // Runs compiled code for this method if there is any, compiling it first if
+  // it is hot enough. On true, *pc and *tos have been moved to wherever the
+  // compiled code stopped and the frame is coherent for the interpreter to
+  // continue from. On false nothing ran and nothing changed.
+  // istate is passed straight through to compiled code, which needs it to
+  // make a call without going back to the interpreter first.
+  static bool maybe_run(Method* method, intptr_t* locals, address code_base,
+                        address* pc, intptr_t** tos, void* istate);
+
+  // On-stack replacement, called from a back-edge. Compiles the method if the
+  // loop is hot enough and re-enters compiled code at the loop header, so a
+  // method that is only ever entered once still gets compiled.
+  //
+  // Sampled rather than checked every time: one decrement per back-edge is
+  // affordable, a hash probe per back-edge is not.
+  static bool maybe_run_osr(Method* method, intptr_t* locals,
+                            address* pc, intptr_t** tos, void* istate);
+  static const int OSR_SAMPLE = 64;
+  static THREAD_LOCAL int _osr_countdown;
+
+  // One-line summary for -Xlog:jit.
+  static void print_statistics();
+};
+
+#endif // __EMSCRIPTEN__
+
+#endif // SHARE_INTERPRETER_ZERO_ZEROWASMCOMPILER_HPP
