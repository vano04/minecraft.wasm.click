+static ZeroWasmBaseline::Result run_linked_group(
+    Method* method, intptr_t* locals, address code_base, address* pc,
+    intptr_t** tos, interpreterState istate) {
+  if (!UseZeroWasmLinkedGroup || istate == nullptr
+      || istate->thread()->has_pending_exception()) return ZeroWasmBaseline::NotRun;
+  int virtual_bci = -1;
+  int safe_div_bci = -1;
+  int return_bci = -1;
+  LinkedMethodKind kind = verify_linked_method(method, &virtual_bci,
+                                                &safe_div_bci, &return_bci);
+  if (ZeroWasmLinkedGroupVerbose && fixture_class(method)
+      && _linked_entry_diagnostics < 16) {
+    tty->print_cr("[zbg] ENTRY method=%s kind=%d locals0=%d locals-1=%d",
+                  method->name()->as_C_string(), (int)kind,
+                  locals == nullptr ? 0 : (jint)locals[0],
+                  locals == nullptr ? 0 : (jint)locals[-1]);
+    _linked_entry_diagnostics++;
+  }
+  if (kind == LinkedNoMethod || return_bci < 0) return ZeroWasmBaseline::NotRun;
+  if (_linked_module_id < 0
+      && !install_linked_group(method, virtual_bci, safe_div_bci)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+
+  LinkedStatus result;
+  switch (kind) {
+    case LinkedLeafMethod:
+      result = decode_linked_status(linked_table_call1(
+          _linked_table_slots[LinkedLeaf], (jint)locals[0]));
+      break;
+    case LinkedCallerMethod:
+      _linked_caller_entries++;
+      if (ZeroWasmLinkedGroupVerbose && _linked_caller_entries == 1) {
+        tty->print_cr("[zbg] DIRECT_CALL caller->leaf runtime=1");
+      }
+      result = decode_linked_status(linked_table_call1(
+          _linked_table_slots[LinkedCaller], (jint)locals[0]));
+      break;
+    case LinkedVirtualMethod: {
+      oop receiver = cast_to_oop((void*)locals[0]);
+      if (receiver == nullptr) return ZeroWasmBaseline::NotRun;
+      jint x = (jint)locals[-1];
+      jint tag = receiver->klass()->name()->equals("ZeroBaselineFixture$Good") ? 1 : 0;
+      result = decode_linked_status(linked_table_call2(
+          _linked_table_slots[LinkedVirtual], tag, x));
+      if (ZeroWasmLinkedGroupVerbose && _linked_calls <= 8) {
+        tty->print_cr("[zbg] STATUS virtualValue tag=%d status=%d bci=%d value=%d",
+                      tag, result.status, result.bci, result.value);
+      }
+      if (result.status == LINKED_RETURN && tag == 1 && result.bci == 0) {
+        if (!linked_validate_pre_push(istate, *tos, 1)) {
+          return ZeroWasmBaseline::NotRun;
+        }
+        push_int(tos, result.value);
+        if (!linked_prepare_state(istate, tos, pc, code_base + return_bci, 1)) {
+          return ZeroWasmBaseline::NotRun;
+        }
+        _linked_returned++;
+        return ZeroWasmBaseline::Returned;
+      }
+      if (result.status != LINKED_DEOPT || result.bci != virtual_bci) {
+        return ZeroWasmBaseline::NotRun;
+      }
+      if (!linked_validate_pre_push(istate, *tos, 2)) {
+        return ZeroWasmBaseline::NotRun;
+      }
+      push_oop(tos, receiver);
+      push_int(tos, x);
+      if (!linked_prepare_state(istate, tos, pc, code_base + virtual_bci, 2)) {
+        return ZeroWasmBaseline::NotRun;
+      }
+      _linked_deopt++;
+      if (ZeroWasmLinkedGroupVerbose) {
+        tty->print_cr("[zbg] STATE_SPILL virtualValue status=DEOPT resume-bci=%d depth=2 sp-offset=%ld pending=0",
+                      virtual_bci,
+                      (long)(istate->stack_base() - istate->stack()));
+      }
+      return ZeroWasmBaseline::DeoptResume;
+    }
+    case LinkedSafeDivMethod: {
+      jint x = (jint)locals[0];
+      jint y = (jint)locals[-1];
+      result = decode_linked_status(linked_table_call2(
+          _linked_table_slots[LinkedSafeDiv], x, y));
+      if (ZeroWasmLinkedGroupVerbose && _linked_calls <= 8) {
+        tty->print_cr("[zbg] STATUS safeDiv status=%d bci=%d value=%d",
+                      result.status, result.bci, result.value);
+      }
+      if (y != 0 && result.status == LINKED_RETURN && result.bci == 0) {
+        if (!linked_validate_pre_push(istate, *tos, 1)) {
+          return ZeroWasmBaseline::NotRun;
+        }
+        push_int(tos, result.value);
+        if (!linked_prepare_state(istate, tos, pc, code_base + return_bci, 1)) {
+          return ZeroWasmBaseline::NotRun;
+        }
+        _linked_returned++;
+        return ZeroWasmBaseline::Returned;
+      }
+      if (y == 0 && result.status == LINKED_EXCEPTION && result.bci == safe_div_bci) {
+        // No exception is pending here. Re-execute idiv exactly once and let
+        // BytecodeInterpreter::handle_exception find the real catch handler.
+        if (!linked_validate_pre_push(istate, *tos, 2)) {
+          return ZeroWasmBaseline::NotRun;
+        }
+        push_int(tos, x);
+        push_int(tos, y);
+        if (!linked_prepare_state(istate, tos, pc, code_base + safe_div_bci, 2)) {
+          return ZeroWasmBaseline::NotRun;
+        }
+        _linked_exception++;
+        if (ZeroWasmLinkedGroupVerbose) {
+          tty->print_cr("[zbg] STATE_SPILL safeDiv status=EXCEPTION resume-bci=%d depth=2 sp-offset=%ld pending=0",
+                        safe_div_bci,
+                        (long)(istate->stack_base() - istate->stack()));
+        }
+        return ZeroWasmBaseline::ExceptionResume;
+      }
+      return ZeroWasmBaseline::NotRun;
+    }
+    default:
+      return ZeroWasmBaseline::NotRun;
+  }
+
+  if (result.status != LINKED_RETURN || result.bci != 0) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  if (!linked_validate_pre_push(istate, *tos, 1)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  push_int(tos, result.value);
+  if (!linked_prepare_state(istate, tos, pc, code_base + return_bci, 1)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  _linked_returned++;
+  return ZeroWasmBaseline::Returned;
+}
