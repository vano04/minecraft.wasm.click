+  if (barrier == nullptr || !barrier->is_a(BarrierSet::CardTableBarrierSet)) {
+    return false;
+  }
+  CardTableBarrierSet* card_barrier =
+      static_cast<CardTableBarrierSet*>(barrier);
+  CardTable* card_table = card_barrier->card_table();
+  address card_base = card_table == nullptr ? nullptr
+      : card_table->byte_map_base();
+  if (card_base == nullptr) return false;
