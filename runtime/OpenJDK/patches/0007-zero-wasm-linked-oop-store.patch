+// Install-time metadata is resolved from the already-loaded fixture Box class,
+// not from whichever supported method happens to execute first.  If the
+// class/fields or collector layout are not available, the complete linked
+// group stays out of the VM and every method remains interpreted.
+static bool linked_oop_layout_for_fixture(Method* seed,
+                                          LinkedOopLayout* layout) {
+  if (seed == nullptr || layout == nullptr) return false;
+  const char* box_name_text = "ZeroBaselineFixture$Box";
+  Symbol* box_name = SymbolTable::probe(box_name_text, (int)strlen(box_name_text));
+  if (box_name == nullptr) return false;
+  InstanceKlass* holder = seed->method_holder();
+  Thread* current = Thread::current();
+  Handle loader(current, holder->class_loader());
+  InstanceKlass* box_klass = SystemDictionary::find_instance_klass(
+      current, box_name, loader);
+  return linked_oop_layout_for_class(box_klass, layout);
+}
+
+static CardTable::CardValue* linked_card_for(const LinkedOopLayout& layout,
+                                             oop box) {
+  uintptr_t field_address = (uintptr_t)box + (uintptr_t)layout.child_offset;
+  uintptr_t card_address = (uintptr_t)(uint32_t)layout.card_base
+      + (field_address >> layout.card_shift);
+  return (CardTable::CardValue*)card_address;
+}
