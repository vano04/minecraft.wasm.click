+static bool linked_oop_layout_for(oop box, LinkedOopLayout* layout) {
+  if (box == nullptr || !box->klass()->is_instance_klass()) return false;
+  return linked_oop_layout_for_class(InstanceKlass::cast(box->klass()), layout);
