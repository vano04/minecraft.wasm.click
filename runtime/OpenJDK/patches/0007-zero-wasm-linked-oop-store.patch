+      child_signature_text, (int)strlen(child_signature_text));
+  Symbol* tag_name = SymbolTable::probe("tag", 3);
+  Symbol* int_signature = SymbolTable::probe("I", 1);
+  if (child_name == nullptr || child_signature == nullptr || tag_name == nullptr
+      || int_signature == nullptr) return false;
