+// The object lane is deliberately a raw linear-memory operation. It has no
+// calls, allocation, or safepoint, so the two real oops remain rooted in the
+// Zero locals for the entire boundary. The field and card-table constants are
+// supplied only after VM metadata and the active SerialGC layout pass checks.
+static void emit_linked_store_child(WasmBuf& body,
+                                    const LinkedOopLayout& layout) {
+  empty_locals(body);
+  body.u8(0x20); body.uleb(0);          // box oop address
+  body.u8(0x20); body.uleb(1);          // child oop address
+  body.u8(0x36); body.uleb(2); body.uleb((unsigned)layout.child_offset);
+
+  // SerialGC's post-write card mark: byte_map_base + ((field_address) >>
+  // card_shift) = dirty_card. byte_map_base is the VM's biased card base.
+  body.u8(0x41); body.sleb((int)layout.card_base);
+  body.u8(0x20); body.uleb(0);
+  body.u8(0x41); body.sleb(layout.child_offset);
+  body.u8(0x6a);                       // field address
+  body.u8(0x41); body.sleb(layout.card_shift);
+  body.u8(0x76);                       // i32.shr_u
+  body.u8(0x6a);                       // card address
+  body.u8(0x41); body.sleb(layout.dirty_card);
+  body.u8(0x3a); body.uleb(0); body.uleb(0); // i32.store8
+
+  body.u8(0x20); body.uleb(1);          // child oop address
+  body.u8(0x28); body.uleb(2); body.uleb((unsigned)layout.tag_offset);
+  linked_extend_i32(body);              // return child.tag as packed i64
+  body.u8(0x0b);
+}
