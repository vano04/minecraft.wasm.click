+  fieldDescriptor tag_field;
+  if (box_klass->find_field(child_name, child_signature, false, &child_field)
+          == nullptr
+      || box_klass->find_field(tag_name, int_signature, false, &tag_field)
+          == nullptr
+      || child_field.field_holder() != box_klass
+      || tag_field.field_holder() != box_klass
+      || child_field.field_type() != T_OBJECT
+      || tag_field.field_type() != T_INT
+      || child_field.is_volatile() || tag_field.is_volatile()) {
+    return false;
+  }
