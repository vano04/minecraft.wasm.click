+static bool invokestatic_target_is(Method* method, int invoke_bci,
+                                   const char* expected_owner,
+                                   const char* expected_name,
+                                   const char* expected_signature) {
+  const unsigned char* code = method->code_base();
+  if (invoke_bci < 0 || invoke_bci + 3 >= method->code_size()
+      || code[invoke_bci] != (unsigned char)Bytecodes::_invokestatic) {
+    return false;
+  }
+  int index = Bytes::get_native_u2((address)(code + invoke_bci + 1));
+  ConstantPool* constants = method->constants();
+  if (index < 0 || index >= constants->resolved_method_entries_length()) {
+    return false;
+  }
+  Symbol* owner = constants->klass_ref_at_noresolve(index, Bytecodes::_invokestatic);
+  Symbol* name = constants->name_ref_at(index, Bytecodes::_invokestatic);
+  Symbol* signature = constants->signature_ref_at(index, Bytecodes::_invokestatic);
+  return owner != nullptr && name != nullptr && signature != nullptr
+      && owner->equals(expected_owner) && name->equals(expected_name)
+      && signature->equals(expected_signature);
+}
+
+static InstanceKlass* linked_invokestatic_target_klass(Method* method,
+                                                        int invoke_bci,
+                                                        const char* owner_name,
+                                                        const char* target_name,
+                                                        const char* target_signature) {
+  if (!invokestatic_target_is(method, invoke_bci, owner_name, target_name,
+                              target_signature)) return nullptr;
+  const unsigned char* code = method->code_base();
+  int index = Bytes::get_native_u2((address)(code + invoke_bci + 1));
+  Symbol* owner = method->constants()->klass_ref_at_noresolve(
+      index, Bytecodes::_invokestatic);
+  JavaThread* current = JavaThread::current();
+  Handle loader(current, method->method_holder()->class_loader());
+  // Resolve/load metadata without invoking class initialization. The
+  // interpreter remains the only owner of the initialization barrier.
+  Klass* klass = SystemDictionary::resolve_or_null(owner, loader, current);
+  if (klass == nullptr || current->has_pending_exception()
+      || !klass->is_instance_klass()) return nullptr;
+  return InstanceKlass::cast(klass);
+}
+
+static bool init_caller_shape(Method* method) {
+  const unsigned char* code = method->code_base();
+  return method->code_size() == 10
+      && code[0] == 0x1a && code[1] == 0x9a
+      && code[2] == 0x00 && code[3] == 0x05
+      && code[4] == 0x03 && code[5] == 0xac
+      && code[6] == 0xb8 && code[9] == 0xac;
+}
+
+static bool fail_caller_shape(Method* method) {
+  const unsigned char* code = method->code_base();
+  return method->code_size() == 4 && code[0] == 0xb8 && code[3] == 0xac;
+}
