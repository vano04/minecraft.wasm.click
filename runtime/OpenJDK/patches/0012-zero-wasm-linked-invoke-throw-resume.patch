+static bool linked_throw_leaf_shape(Method* method) {
+  const unsigned char* code = (const unsigned char*)method->code_base();
+  if (method->code_size() != 14 || code[0] != 0x1a || code[1] != 0x9a
+      || (int16_t)((code[2] << 8) | code[3]) != 11
+      || code[4] != 0xbb || code[7] != 0x59 || code[8] != 0xb7
+      || code[11] != 0xbf || code[12] != 0x1a || code[13] != 0xac) {
+    return false;
+  }
+  ConstantPool* constants = method->constants();
+  // `new` retains the class-file big-endian CP operand; invokespecial is a
+  // rewritten method-entry operand and is native-endian in this Zero stream.
+  int new_index = Bytes::get_Java_u2((address)(code + 5));
+  int init_index = Bytes::get_native_u2((address)(code + 9));
+  if (new_index <= 0 || new_index >= constants->length()
+      || init_index <= 0 || init_index >= constants->length()) return false;
+  if (!constants->tag_at(new_index).is_klass()
+      && !constants->tag_at(new_index).is_unresolved_klass()) return false;
+  Symbol* new_owner = constants->klass_name_at(new_index);
+  Symbol* init_owner = constants->klass_ref_at_noresolve(
+      init_index, Bytecodes::_invokespecial);
+  Symbol* init_name = constants->name_ref_at(init_index,
+                                              Bytecodes::_invokespecial);
+  Symbol* init_signature = constants->signature_ref_at(
+      init_index, Bytecodes::_invokespecial);
+  return new_owner != nullptr && init_owner != nullptr && init_name != nullptr
+      && init_signature != nullptr
+      && new_owner->equals("java/lang/IllegalStateException")
+      && init_owner->equals("java/lang/IllegalStateException")
+      && init_name->equals("<init>") && init_signature->equals("()V");
