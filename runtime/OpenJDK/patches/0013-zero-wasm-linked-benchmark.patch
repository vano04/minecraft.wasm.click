+// Benchmark-only bodies. They are emitted only in the opt-in benchmark
+// module, so the production ten-export module remains byte-for-byte stable.
+// Each wrapper performs its complete N-iteration loop in Wasm; the host makes
+// one typed table call for the outer invocation.
+static void emit_bench_prim(WasmBuf& body, int caller_index) {
+  // Parameters are n and base; locals are the i64 accumulator and iteration.
+  body.u8(2);
+  body.uleb(1); body.u8(0x7e);
+  body.uleb(1); body.u8(0x7f);
+  linked_i64_const(body, 0);
+  body.u8(0x21); body.uleb(2);        // local.set accumulator
+  body.u8(0x41); body.sleb(0);
+  body.u8(0x21); body.uleb(3);        // local.set iteration
+  body.u8(0x02); body.u8(0x40);       // block
+  body.u8(0x03); body.u8(0x40);       // loop
+  body.u8(0x20); body.uleb(3);
+  body.u8(0x20); body.uleb(0);
+  body.u8(0x4f);                      // iteration >= n
+  body.u8(0x0d); body.uleb(1);         // break block
+  body.u8(0x20); body.uleb(1);
+  body.u8(0x20); body.uleb(3);
+  body.u8(0x6a);                      // base + iteration
+  body.u8(0x10); body.uleb((unsigned)caller_index);
+  body.u8(0x20); body.uleb(2);
+  body.u8(0x7c);                      // i64.add to accumulator
+  body.u8(0x21); body.uleb(2);
+  body.u8(0x20); body.uleb(3);
+  body.u8(0x41); body.sleb(1);
+  body.u8(0x6a);                      // iteration++
+  body.u8(0x21); body.uleb(3);
+  body.u8(0x0c); body.uleb(0);
+  body.u8(0x0b); body.u8(0x0b);
+  body.u8(0x20); body.uleb(2);
+  body.u8(0x0b);
+}
+
+static void emit_bench_dispatch(WasmBuf& body, int target_index,
+                                int klass_offset) {
+  // Parameters are n, receiver A, receiver B, expected Klass. Both real Good
+  // oops are selected by iteration parity; x is 7 + iteration.
+  body.u8(2);
+  body.uleb(1); body.u8(0x7e);
+  body.uleb(1); body.u8(0x7f);
+  linked_i64_const(body, 0);
+  body.u8(0x21); body.uleb(4);        // accumulator
+  body.u8(0x41); body.sleb(0);
+  body.u8(0x21); body.uleb(5);        // iteration
+  body.u8(0x02); body.u8(0x40);
+  body.u8(0x03); body.u8(0x40);
+  body.u8(0x20); body.uleb(5);
+  body.u8(0x20); body.uleb(0);
+  body.u8(0x4f);
+  body.u8(0x0d); body.uleb(1);
+  // Select receiver A/B from the same iteration value for both paired lanes.
+  body.u8(0x20); body.uleb(5);
+  body.u8(0x41); body.sleb(1);
+  body.u8(0x71);
+  body.u8(0x04); body.u8(0x7f);
+  body.u8(0x20); body.uleb(2);
+  body.u8(0x05);
+  body.u8(0x20); body.uleb(1);
+  body.u8(0x0b);
+  body.u8(0x28); body.uleb(2); body.uleb((unsigned)klass_offset);
+  body.u8(0x20); body.uleb(3);        // expected Klass
+  body.u8(0x46);
+  body.u8(0x04); body.u8(0x7e);
+  body.u8(0x41); body.sleb(7);
+  body.u8(0x20); body.uleb(5);
+  body.u8(0x6a);
+  body.u8(0x10); body.uleb((unsigned)target_index);
+  body.u8(0x05);
+  linked_i64_const(body, 0);         // valid Good guard is required by host
+  body.u8(0x0b);
+  body.u8(0x20); body.uleb(4);
+  body.u8(0x7c);                      // i64.add to accumulator
+  body.u8(0x21); body.uleb(4);
+  body.u8(0x20); body.uleb(5);
+  body.u8(0x41); body.sleb(1);
+  body.u8(0x6a);
+  body.u8(0x21); body.uleb(5);
+  body.u8(0x0c); body.uleb(0);
+  body.u8(0x0b); body.u8(0x0b);
+  body.u8(0x20); body.uleb(4);
+  body.u8(0x0b);
+}
