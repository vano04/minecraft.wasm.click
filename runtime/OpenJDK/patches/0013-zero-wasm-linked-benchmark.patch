+static ZeroWasmBaseline::Result run_linked_benchmark(
+    Method* method, intptr_t* locals, address code_base, address* pc,
+    intptr_t** tos, interpreterState istate) {
+  if (!UseZeroWasmLinkedBenchmark || method == nullptr || istate == nullptr
+      || istate->thread()->has_pending_exception()) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  int return_bci = first_opcode(method, (unsigned char)Bytecodes::_ireturn);
+  int unused_virtual_bci = -1;
+  int unused_safe_div_bci = -1;
+  int unused_safe_div_handler_bci = -1;
+  int unused_alloc_bci = -1;
+  int unused_init_bci = -1;
+  int unused_dispatch_bci = -1;
+  int unused_throw_invoke_bci = -1;
+  int unused_throw_handler_bci = -1;
+  LinkedMethodKind kind = verify_linked_method(
+      method, &unused_virtual_bci, &unused_safe_div_bci,
+      &unused_safe_div_handler_bci, &return_bci, &unused_alloc_bci,
+      &unused_init_bci, &unused_dispatch_bci, &unused_throw_invoke_bci,
+      &unused_throw_handler_bci);
+  bool primitive = kind == LinkedBenchPrimCandidateMethod
+      || kind == LinkedBenchPrimReferenceMethod;
+  bool dispatch = kind == LinkedBenchDispatchCandidateMethod
+      || kind == LinkedBenchDispatchReferenceMethod;
+  bool store = kind == LinkedBenchStoreCandidateMethod
+      || kind == LinkedBenchStoreReferenceMethod;
+  bool div = kind == LinkedBenchDivCandidateMethod
+      || kind == LinkedBenchDivReferenceMethod;
+  bool throwing = kind == LinkedBenchThrowCandidateMethod
+      || kind == LinkedBenchThrowReferenceMethod;
+  if ((!primitive && !dispatch && !store && !div && !throwing)
+      || return_bci < 0 || locals == nullptr) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  if (_benchmark_module_id < 0 && !install_benchmark_module(method)) {
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbp] BENCH_REJECT reason=module-install-or-metadata");
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  const uint64_t sequence = ++_benchmark_sequence;
+  jlong raw;
+  jlong wasm_elapsed_ns = 0;
+  const char* lane;
+  jint n;
+  if (primitive) {
+    n = (jint)locals[0];
+    jint base = (jint)locals[-1];
+    int slot = kind == LinkedBenchPrimCandidateMethod ? 0 : 1;
+    lane = kind == LinkedBenchPrimCandidateMethod ? "primitive-candidate"
+                                                   : "primitive-reference";
+    raw = benchmark_timed_call2(_benchmark_slots[slot], n, base,
+                                &wasm_elapsed_ns);
+  } else if (store) {
+    n = (jint)locals[0];
+    oop box = cast_to_oop((void*)locals[-1]);
+    oop child_a = cast_to_oop((void*)locals[-2]);
+    oop child_b = cast_to_oop((void*)locals[-3]);
+    LinkedOopLayout layout;
+    int card_after_clean = -1;
+    if (box == nullptr || child_a == nullptr || child_b == nullptr
+        || !linked_oop_layout_for(box, &layout)
+        || !linked_reset_store_state(layout, box, &card_after_clean)) {
+      return ZeroWasmBaseline::NotRun;
+    }
+    int slot = kind == LinkedBenchStoreCandidateMethod ? 4 : 5;
+    lane = kind == LinkedBenchStoreCandidateMethod ? "store-candidate"
+                                                   : "store-reference";
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbp] BENCH_STORE_RESET lane=%s reset-excluded=1 "
+                    "field-null=1 card-before-clean=%d field-offset=%d",
+                    lane, card_after_clean, layout.child_offset);
+    }
+    raw = benchmark_timed_call4(_benchmark_slots[slot], n,
+                                (jint)(intptr_t)box,
+                                (jint)(intptr_t)child_a,
+                                (jint)(intptr_t)child_b, &wasm_elapsed_ns);
+    oop expected_child = n > 0 && ((n - 1) & 1) != 0 ? child_b : child_a;
+    oop actual_child = box->obj_field(layout.child_offset);
+    int final_tag = actual_child == nullptr ? -1
+        : actual_child->int_field(layout.tag_offset);
+    CardTable::CardValue* final_card = linked_card_for(layout, box);
+    int card_after_dirty = final_card == nullptr ? -1 : (int)*final_card;
+    bool child_match = actual_child == expected_child;
+    bool post_ok = child_match && actual_child != nullptr
+        && final_tag == expected_child->int_field(layout.tag_offset)
+        && card_after_dirty == layout.dirty_card;
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbp] BENCH_STORE_POST lane=%s child-match=%d final-tag=%d "
+                    "card-after-dirty=%d expected-dirty=%d field-offset=%d",
+                    lane, child_match ? 1 : 0, final_tag, card_after_dirty,
+                    layout.dirty_card, layout.child_offset);
+    }
+    if (!post_ok) {
+      if (ZeroWasmLinkedGroupVerbose) {
+        tty->print_cr("[zbp] BENCH_REJECT subreason=store-post-state lane=%s",
+                      lane);
+      }
+      return ZeroWasmBaseline::NotRun;
+    }
+  } else if (div || throwing) {
+    n = (jint)locals[0];
+    jint base = (jint)locals[-1];
+    bool is_div = div;
+    int slot = is_div
+        ? (kind == LinkedBenchDivCandidateMethod ? 6 : 7)
+        : (kind == LinkedBenchThrowCandidateMethod ? 8 : 9);
+    lane = is_div
+        ? (kind == LinkedBenchDivCandidateMethod ? "div-candidate" : "div-reference")
+        : (kind == LinkedBenchThrowCandidateMethod ? "throw-candidate" : "throw-reference");
+    raw = benchmark_timed_call2(_benchmark_slots[slot], n, base,
+                                &wasm_elapsed_ns);
+  } else {
+    oop receiver_a = cast_to_oop((void*)locals[0]);
+    oop receiver_b = cast_to_oop((void*)locals[-1]);
+    n = (jint)locals[-2];
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbp] BENCH_DISPATCH_ADAPTER locals0=%p locals-1=%p "
+                    "locals-2=%d receiver-a-klass=%p receiver-b-klass=%p",
+                    (void*)receiver_a, (void*)receiver_b, n,
+                    receiver_a == nullptr ? nullptr : (void*)receiver_a->klass(),
+                    receiver_b == nullptr ? nullptr : (void*)receiver_b->klass());
+    }
+    if (receiver_a == nullptr || receiver_b == nullptr
+        || receiver_a->klass() == nullptr || receiver_b->klass() == nullptr) {
+      if (ZeroWasmLinkedGroupVerbose) {
+        tty->print_cr("[zbp] BENCH_REJECT lane=dispatch reason=null-receiver");
+      }
+      return ZeroWasmBaseline::NotRun;
+    }
+    Method* dispatch_method = linked_group_method(
+        method, "dispatch", "(LZeroBaselineFixture$Base;I)I");
+    int dispatch_bci = dispatch_method == nullptr
+        ? -1 : first_opcode(dispatch_method,
+                            (unsigned char)Bytecodes::_invokevirtual);
+    InstanceKlass* expected_klass = nullptr;
+    Method* target_method = nullptr;
+    int table_index = -1;
+    if (dispatch_method == nullptr || dispatch_bci != 2
+        || !linked_dispatch_metadata(dispatch_method, dispatch_bci,
+                                     &expected_klass, &target_method,
+                                     &table_index)
+        || expected_klass == nullptr || target_method == nullptr
+        || receiver_a->klass() != expected_klass
+        || receiver_b->klass() != expected_klass) {
+      if (ZeroWasmLinkedGroupVerbose) {
+        tty->print_cr("[zbp] BENCH_REJECT lane=dispatch reason=exact-class "
+                      "method=%p bci=%d expected=%p a=%p b=%p target=%p table-index=%d",
+                      (void*)dispatch_method, dispatch_bci, (void*)expected_klass,
+                      receiver_a == nullptr ? nullptr : (void*)receiver_a->klass(),
+                      receiver_b == nullptr ? nullptr : (void*)receiver_b->klass(),
+                      (void*)target_method, table_index);
+      }
+      return ZeroWasmBaseline::NotRun;
+    }
+    int slot = kind == LinkedBenchDispatchCandidateMethod ? 2 : 3;
+    lane = kind == LinkedBenchDispatchCandidateMethod ? "dispatch-candidate"
+                                                       : "dispatch-reference";
+    raw = benchmark_timed_call4(_benchmark_slots[slot], n,
+                                (jint)(intptr_t)receiver_a,
+                                (jint)(intptr_t)receiver_b,
+                                (jint)(intptr_t)expected_klass,
+                                &wasm_elapsed_ns);
+  }
+  if (wasm_elapsed_ns <= 0) {
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbp] BENCH_REJECT subreason=non-positive-wasm-elapsed "
+                    "lane=%s elapsed-ns=%lld", lane,
+                    (long long)wasm_elapsed_ns);
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  jint result = (jint)(uint32_t)raw;
+  if (ZeroWasmLinkedGroupVerbose) {
+    tty->print_cr("[zbp] BENCH_WASM_ELAPSED lane=%s n=%d seq=%llu "
+                  "elapsed-ns=%lld checksum=%lld", lane, n,
+                  (unsigned long long)sequence, (long long)wasm_elapsed_ns,
+                  (long long)raw);
+    tty->print_cr("[zbp] BENCH_ENTRY lane=%s n=%d table-call=1 "
+                  "loops-in-wasm=1 direct-internal=1 checksum=%lld",
+                  lane, n, (long long)raw);
+  }
+  if (!linked_validate_pre_push(istate, *tos, 1)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  push_int(tos, result);
+  if (!linked_prepare_state(istate, tos, pc, code_base + return_bci, 1)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  return ZeroWasmBaseline::Returned;
+}
