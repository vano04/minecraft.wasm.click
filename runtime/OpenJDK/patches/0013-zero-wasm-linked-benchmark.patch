+      module.data(), length, key, (int)(intptr_t)_benchmark_slots,
+      ZeroWasmLinkedGroupVerbose ? 1 : 0);
+  if (ZeroWasmLinkedGroupVerbose) {
+    tty->print_cr("[zbp] BENCH_INSTALL_RESULT module-id=%d slots=%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
+                  _benchmark_module_id, _benchmark_slots[0],
+                  _benchmark_slots[1], _benchmark_slots[2],
+                  _benchmark_slots[3], _benchmark_slots[4], _benchmark_slots[5],
+                  _benchmark_slots[6], _benchmark_slots[7], _benchmark_slots[8],
+                  _benchmark_slots[9]);
+  }
+  if (_benchmark_module_id < 0) return false;
+  if (ZeroWasmLinkedGroupVerbose) {
+    tty->print_cr("[zbp] module benchmark-mode=1 exports=10 internal-functions=28 "
+                  "loops=direct-calls klass-offset=%d table-index=%d bytes=%d",
+                  oopDesc::klass_offset_in_bytes(), table_index, length);
+  }
+  return true;
+}
