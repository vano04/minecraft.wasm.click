+// A call-free, safepoint-free int[] load. Every linear-memory load is
+// dominated by a null, length-address, bounds, and end-address check. The
+// latter uses memory.size and i64 arithmetic so a 32-bit address wrap cannot
+// turn a rejected access into a Wasm trap or an out-of-range read.
+static void emit_linked_active_memory_bytes(WasmBuf& body) {
+  body.u8(0x3f); body.u8(0x00); body.u8(0xad);
+  body.u8(0x42); body.sleb64(65536); body.u8(0x7e);
+}
+
+static void emit_linked_effective_memory_bytes(WasmBuf& body) {
+  body.u8(0x20); body.uleb(2); body.u8(0x45);
+  body.u8(0x04); body.u8(0x7e);
+  emit_linked_active_memory_bytes(body);
+  body.u8(0x05);
+  emit_linked_active_memory_bytes(body);
+  body.u8(0x20); body.uleb(2); body.u8(0xad);
+  body.u8(0x42); body.sleb64(65536); body.u8(0x7e);
+  body.u8(0x54); // active bytes < override bytes
+  body.u8(0x04); body.u8(0x7e);
+  emit_linked_active_memory_bytes(body);
+  body.u8(0x05);
+  body.u8(0x20); body.uleb(2); body.u8(0xad);
+  body.u8(0x42); body.sleb64(65536); body.u8(0x7e);
+  body.u8(0x0b);
+  body.u8(0x0b);
+}
