+static void emit_linked_int_array_load(WasmBuf& body,
+                                       const LinkedIntArrayLayout& layout,
+                                       int iaload_bci) {
+  empty_locals(body);
+  body.u8(0x20); body.uleb(0); body.u8(0x45); // null
+  body.u8(0x04); body.u8(0x7e);
+  emit_linked_array_status(body, iaload_bci);
+  body.u8(0x05);
+
+  // Check array + length_offset + sizeof(jint) <= memory.size * 65536.
+  body.u8(0x20); body.uleb(0); body.u8(0xad);
+  body.u8(0x42); body.sleb64(layout.length_offset); body.u8(0x7c);
+  body.u8(0x42); body.sleb64(4); body.u8(0x7c);
+  emit_linked_effective_memory_bytes(body);
+  body.u8(0x58); // i64.le_u
+  body.u8(0x04); body.u8(0x7e);
+
+  body.u8(0x20); body.uleb(0);
+  body.u8(0x28); body.uleb(2); body.uleb((unsigned)layout.length_offset);
+  body.u8(0x20); body.uleb(1);
+  body.u8(0x4b); // length > unsigned index; negative indexes fail
+  body.u8(0x04); body.u8(0x7e);
+
+  // Check array + base_offset + index*4 + 4 <= memory end.
+  body.u8(0x20); body.uleb(0); body.u8(0xad);
+  body.u8(0x20); body.uleb(1); body.u8(0xad);
+  body.u8(0x42); body.sleb64(4); body.u8(0x7e);
+  body.u8(0x7c); // array address + index * sizeof(jint)
+  body.u8(0x42); body.sleb64(layout.base_offset + 4); body.u8(0x7c);
+  emit_linked_effective_memory_bytes(body);
+  body.u8(0x58);
+  body.u8(0x04); body.u8(0x7e);
+
+  // Recompute the checked start address and perform the only load.
+  body.u8(0x20); body.uleb(0); body.u8(0xad);
+  body.u8(0x20); body.uleb(1); body.u8(0xad);
+  body.u8(0x42); body.sleb64(4); body.u8(0x7e); body.u8(0x7c);
+  body.u8(0x42); body.sleb64(layout.base_offset); body.u8(0x7c);
+  body.u8(0xa7); // i32.wrap_i64 after the end check
+  body.u8(0x28); body.uleb(2); body.uleb(0);
+  body.u8(0xad); // zero-extend low jint; adapter restores signed result
+  body.u8(0x05);
+  emit_linked_array_status(body, iaload_bci);
+  body.u8(0x0b);
+  body.u8(0x05);
+  emit_linked_array_status(body, iaload_bci);
+  body.u8(0x0b);
+  body.u8(0x05);
+  emit_linked_array_status(body, iaload_bci);
+  body.u8(0x0b);
+  body.u8(0x0b); // close the outer null guard
+  body.u8(0x0b); // function end
+}
