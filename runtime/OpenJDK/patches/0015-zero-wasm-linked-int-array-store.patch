+static int build_linked_array_store_module(
+    WasmBuf& module, const LinkedIntArrayLayout& layout, int iastore_bci) {
+  static const unsigned char magic[] = {0x00, 0x61, 0x73, 0x6d,
+                                         0x01, 0x00, 0x00, 0x00};
