+  body.u8(0x42); body.sleb64(layout.length_offset); body.u8(0x7c);
+  body.u8(0x42); body.sleb64(4); body.u8(0x7c);
+  emit_linked_effective_memory_bytes(body, kArrayStoreMemoryLimitLocal);
+  body.u8(0x58);
+  body.u8(0x04); body.u8(0x7e);
