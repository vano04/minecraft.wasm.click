+  body.u8(0x20); body.uleb(0); body.u8(0xad);
+  body.u8(0x42); body.sleb64(layout.length_offset); body.u8(0x7c);
+  body.u8(0x42); body.sleb64(4); body.u8(0x7c);
+  emit_linked_effective_memory_bytes(body, 2);
+  body.u8(0x58); // i64.le_u
