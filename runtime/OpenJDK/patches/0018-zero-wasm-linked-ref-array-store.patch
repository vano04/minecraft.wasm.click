+// its sole export is intentionally exact.
+static int build_linked_ref_array_store_module(
+    WasmBuf& module, const LinkedRefArrayStoreLayout& layout, int aastore_bci) {
+  static const unsigned char magic[] = {0x00, 0x61, 0x73, 0x6d,
+                                         0x01, 0x00, 0x00, 0x00};
