+  // forced lane must report memory for every non-null call, including calls
+  // that would otherwise reexecute for an index or ArrayStoreException. The
+  // double eqz forms `memory-limit != 0` without introducing a fallible op;
+  // its then arm returns the status before the normal validation else arm.
+  body.u8(0x20); body.uleb(kArrayStoreMemoryLimitLocal);
+  body.u8(0x45); // memory-limit == 0
+  body.u8(0x45); // invert: memory-limit != 0
+  body.u8(0x04); body.u8(0x7e);
+  emit_linked_array_status(body, aastore_bci);
+  body.u8(0x05); // memory-limit == 0: continue with validation
