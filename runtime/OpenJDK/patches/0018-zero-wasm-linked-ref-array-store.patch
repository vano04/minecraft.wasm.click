+  body.u8(0x0b); // card overflow check
+  body.u8(0x0b); // assignability check
+  body.u8(0x0b); // element-end check
+  body.u8(0x0b); // bounds check
+  body.u8(0x0b); // header check
+  body.u8(0x0b); // memory override check
+  body.u8(0x0b); // outer null guard
