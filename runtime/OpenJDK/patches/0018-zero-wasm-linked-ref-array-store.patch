+  body.u8(0x20); body.uleb(0);
+  body.u8(0x28); body.uleb(2); body.uleb((unsigned)layout.length_offset);
+  body.u8(0x4f); // index >= length
+  body.u8(0x04); body.u8(0x7e);
+  emit_linked_array_status(body, aastore_bci);
+  body.u8(0x05); // valid index: continue with the element-end check
+
+  // Check array + base + index * oop-size + one oop word before wrapping.
+  body.u8(0x20); body.uleb(0); body.u8(0xad);
+  body.u8(0x20); body.uleb(1); body.u8(0xad);
+  body.u8(0x42); body.sleb64(layout.element_size); body.u8(0x7e);
+  body.u8(0x7c);
