+    WasmBuf& body, const LinkedRefArrayStoreLayout& layout, int aastore_bci) {
+  empty_locals(body);
+  body.u8(0x20); body.uleb(0); body.u8(0x45); // null array
+  body.u8(0x04); body.u8(0x7e);
