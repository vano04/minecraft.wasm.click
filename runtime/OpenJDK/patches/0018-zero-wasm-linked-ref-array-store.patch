+  body.u8(0x20); body.uleb(4); body.u8(0xad);
+  body.u8(0x20); body.uleb(0); body.u8(0xad);
+  body.u8(0x20); body.uleb(1); body.u8(0xad);
+  body.u8(0x42); body.sleb64(layout.element_size); body.u8(0x7e);
+  body.u8(0x7c);
+  body.u8(0x42); body.sleb64(layout.base_offset); body.u8(0x7c);
+  body.u8(0x42); body.sleb64(layout.card_shift);
+  body.u8(0x88); // field address >> card_shift (i64.shr_u)
