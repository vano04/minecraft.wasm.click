+static void linked_prepare_state_infallible(
+    interpreterState istate, intptr_t** tos, address* pc, address resume_pc,
+    int depth) {
+  assert(istate != nullptr && tos != nullptr && *tos != nullptr
+             && resume_pc != nullptr && depth > 0,
