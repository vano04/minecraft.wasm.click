+  types.uleb(1);
+  linked_type(types, 6);
+  module.section(1, types);
+
+  WasmBuf imports;
+  imports.uleb(1);
+  imports.string("env"); imports.string("memory");
+  imports.u8(0x02); imports.u8(0x03); imports.uleb(0); imports.uleb(65536);
+  module.section(2, imports);
+
+  WasmBuf functions;
+  functions.uleb(1);
+  functions.uleb(0);
+  module.section(3, functions);
+
+  WasmBuf exports;
+  exports.uleb(1);
