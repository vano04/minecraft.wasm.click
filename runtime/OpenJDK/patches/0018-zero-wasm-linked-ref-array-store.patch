+  body.u8(0x42); body.sleb64(layout.base_offset); body.u8(0x7c);
+  body.u8(0x42); body.sleb64(layout.card_shift);
+  body.u8(0x88); // field address >> card_shift (i64.shr_u)
+  body.u8(0x7c);
+  body.u8(0x42); body.sleb64(1); body.u8(0x7c);
