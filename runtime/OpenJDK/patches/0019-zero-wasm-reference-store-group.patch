+                    "thread-identity=1 stack-depth=2 stack-value=1 "
+                    "globals-cleared=1 pending=0",
+                    (long long)published_elapsed);
+    }
+    return ZeroWasmBaseline::Returned;
+  }
+  if (reference_store_group_perf_start_shape(method)) {
+    if (!_linked_ref_array_store_card_probe_pending
+        || _reference_store_group_perf_start_index < 0 || locals == nullptr
+        || code_base == nullptr || pc == nullptr || *pc != code_base
+        || tos == nullptr || *tos == nullptr
+        || !linked_validate_pre_push(istate, *tos, 1)) {
+      return ZeroWasmBaseline::NotRun;
+    }
+    {
+      NoSafepointVerifier nsv;
+      oop array = cast_to_oop((void*)locals[0]);
+      if (array == nullptr
+          || (uintptr_t)array != _linked_ref_array_store_card_probe_array_bits) {
+        fatal("ZeroWasm group perf prepared-start root changed");
+      }
+      push_int(tos, _reference_store_group_perf_start_index);
+      linked_prepare_state_infallible(istate, tos, pc, code_base + 1, 1);
+    }
+    return ZeroWasmBaseline::Returned;
+  }
+
+  const int lane = reference_store_group_perf_lane(method);
+  JavaThread* expected_thread = istate->thread();
+  intptr_t* publication_top = tos == nullptr ? nullptr : *tos;
+  if (lane < 0 || locals == nullptr || code_base == nullptr || pc == nullptr
+      || *pc != code_base || tos == nullptr || *tos == nullptr
+      || expected_thread == nullptr
+      || !linked_validate_pre_push(istate, publication_top, 2)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  LinkedRefArrayStoreLayout layout;
+  if (!linked_ref_array_store_layout_for_fixture(&layout)
+      || !_linked_ref_array_store_card_probe_pending
+      || !install_reference_store_group_perf(layout)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  const int pages_before = zbb_reference_store_group_perf_memory_pages();
+  if (pages_before <= 0) return ZeroWasmBaseline::NotRun;
+
+  jlong raw = 0;
+  jlong elapsed_ns = 0;
+  uint64_t expected = 0;
+  unsigned int gc_before = 0;
+  unsigned int gc_after = 0;
+  uint64_t safepoint_before = 0;
+  uint64_t safepoint_after = 0;
+  int pages_after = -1;
+  int n = 0;
+  int start_index = 0;
+  int span_count = 0;
+  uintptr_t array_bits = 0;
+  uintptr_t value_a_bits = 0;
+  uintptr_t value_b_bits = 0;
+  {
+    // The complete measurement transaction is one rooted no-safepoint scope.
+    // Installation, dumping, allocation, logging, and oracle setup are all
+    // excluded from the timed window.
+    NoSafepointVerifier nsv;
+    n = (jint)locals[0];
+    oop array = cast_to_oop((void*)locals[-1]);
+    start_index = (jint)locals[-2];
+    span_count = (jint)locals[-3];
+    oop value_a = cast_to_oop((void*)locals[-4]);
+    oop value_b = cast_to_oop((void*)locals[-5]);
+    if (array != cast_to_oop((void*)locals[-1])
+        || value_a != cast_to_oop((void*)locals[-4])
+        || value_b != cast_to_oop((void*)locals[-5])) {
+      fatal("ZeroWasm group perf rooted locals changed");
+    }
+    if (array == nullptr || value_a == nullptr || value_b == nullptr
+        || array->klass() != Universe::objectArrayKlass()
+        || (uintptr_t)array != _linked_ref_array_store_card_probe_array_bits
+        || objArrayOop(array)->length() != 2048
+        || start_index != _reference_store_group_perf_start_index
+        || span_count != 64 || n <= 0
+        || (span_count & (span_count - 1)) != 0
+        || start_index < 0 || start_index + span_count > 2048) {
+      fatal("ZeroWasm group perf fixture contract changed");
+    }
+    LinkedRefArrayStoreLayout live_layout;
+    if (!linked_ref_array_store_layout_for_fixture(&live_layout)
+        || memcmp(&layout, &live_layout, sizeof(layout)) != 0) {
+      fatal("ZeroWasm group perf layout changed");
+    }
+    bool all_null = true;
+    for (int i = 0; i < 2048; i++) {
+      if (objArrayOop(array)->obj_at(i) != nullptr) {
+        all_null = false;
+        break;
+      }
+    }
+    CardTable::CardValue* card = nullptr;
+    int span_kind = 0;
+    CardTable::CardValue* first_card = linked_ref_array_card_for(
+        layout, array, start_index);
+    CardTable::CardValue* last_card = linked_ref_array_card_for(
+        layout, array, start_index + span_count - 1);
+    if (!all_null || !linked_ref_array_card_span_proven(
+            layout, array, _linked_ref_array_store_card_probe_index, 2048,
+            &card, &span_kind)
+        || card == nullptr || span_kind != 1 || first_card != card
+        || last_card != card
+        || (uintptr_t)card != _linked_ref_array_store_card_probe_address_bits
+        || (int)*card != layout.clean_card) {
+      fatal("ZeroWasm group perf clean interior span proof failed");
+    }
+    BarrierSet* barrier = BarrierSet::barrier_set();
+    CardTableBarrierSet* card_barrier =
+        barrier != nullptr && barrier->is_a(BarrierSet::CardTableBarrierSet)
+            ? static_cast<CardTableBarrierSet*>(barrier) : nullptr;
+    CardTable* card_table = card_barrier == nullptr
+        ? nullptr : card_barrier->card_table();
+    if (card_table == nullptr || card_table->is_in_young(array)
+        || !card_table->is_in_young(value_a)
+        || !card_table->is_in_young(value_b)) {
+      fatal("ZeroWasm group perf old-array/young-values proof failed");
+    }
+
+    array_bits = (uintptr_t)array;
+    value_a_bits = (uintptr_t)value_a;
+    value_b_bits = (uintptr_t)value_b;
+    gc_before = Universe::heap()->total_collections();
+    safepoint_before = SafepointSynchronize::safepoint_id();
+    if (istate->thread() != expected_thread || *tos != publication_top
+        || !linked_validate_pre_push(istate, publication_top, 2)) {
+      fatal("ZeroWasm group perf publication destination changed before Wasm");
+    }
+    const jlong start_ns = os::javaTimeNanos();
+    raw = zbb_reference_store_group_perf_call(
+        lane, n, (jint)(intptr_t)array, start_index, span_count,
+        (jint)(intptr_t)value_a, (jint)(intptr_t)value_b,
+        (jint)(uint32_t)layout.card_base, pages_before);
+    elapsed_ns = os::javaTimeNanos() - start_ns;
+    _reference_store_group_perf_last_elapsed_ns = elapsed_ns;
+    pages_after = zbb_reference_store_group_perf_memory_pages();
+    safepoint_after = SafepointSynchronize::safepoint_id();
+    gc_after = Universe::heap()->total_collections();
+    if (elapsed_ns <= 0 || pages_after != pages_before
+        || gc_after != gc_before || safepoint_after != safepoint_before) {
+      fatal("ZeroWasm group perf timed-window invariant changed");
+    }
+
+    const uint32_t mask = (uint32_t)span_count - 1;
+    for (uint32_t i = 0; i < (uint32_t)n; i++) {
+      const uint32_t relative = i & mask;
+      const uint32_t index = (uint32_t)start_index + relative;
+      const uint32_t value = (i & 1) == 0
+          ? (uint32_t)value_a_bits : (uint32_t)value_b_bits;
+      const uint32_t pre = i < (uint32_t)span_count ? 0 : value;
+      expected += (uint64_t)i + index + pre + value + value;
+    }
+    if ((uint64_t)raw != expected || (int)*card != layout.dirty_card) {
+      fatal("ZeroWasm group perf checksum/card mismatch");
+    }
+    for (int relative = 0; relative < span_count; relative++) {
+      oop expected_value = nullptr;
+      if ((uint32_t)relative < (uint32_t)n) {
+        const uint32_t last = (uint32_t)relative
+            + (((uint32_t)n - 1 - (uint32_t)relative)
+               / (uint32_t)span_count) * (uint32_t)span_count;
+        expected_value = (last & 1) == 0 ? value_a : value_b;
+      }
+      if (objArrayOop(array)->obj_at(start_index + relative) != expected_value) {
+        fatal("ZeroWasm group perf final element map mismatch");
+      }
+    }
+    for (int relative = 0; relative < span_count; relative++) {
+      objArrayOop(array)->obj_at_put(start_index + relative, nullptr);
+    }
+    for (int i = 0; i < 2048; i++) {
+      if (objArrayOop(array)->obj_at(i) != nullptr) {
+        fatal("ZeroWasm group perf canonical clear failed");
+      }
+    }
+    *card = (CardTable::CardValue)layout.clean_card;
+    if ((int)*card != layout.clean_card) {
+      fatal("ZeroWasm group perf diagnostic card restore failed");
+    }
+    _linked_ref_array_store_card_probe_pending = false;
+    _linked_ref_array_store_card_probe_index = -1;
+    _linked_ref_array_store_card_probe_array_bits = 0;
+    _linked_ref_array_store_card_probe_address_bits = 0;
+    _linked_ref_array_store_card_probe_length = -1;
+    _linked_ref_array_store_card_probe_span_kind = 0;
+    _reference_store_group_perf_start_index = -1;
+    if (_linked_ref_array_store_card_probe_pending
+        || _linked_ref_array_store_card_probe_index != -1
+        || _linked_ref_array_store_card_probe_array_bits != 0
+        || _linked_ref_array_store_card_probe_address_bits != 0
+        || _linked_ref_array_store_card_probe_length != -1
+        || _linked_ref_array_store_card_probe_span_kind != 0
+        || _reference_store_group_perf_start_index != -1
+        || _reference_store_group_perf_last_elapsed_ns != elapsed_ns) {
+      fatal("ZeroWasm group perf pending globals cleanup failed");
+    }
+    if (istate->thread() != expected_thread) {
+      fatal("ZeroWasm group perf thread changed before long store");
+    }
+    reference_store_group_perf_push_long_infallible(
+        istate, tos, publication_top, raw, expected_thread);
+    if (istate->thread() != expected_thread) {
+      fatal("ZeroWasm group perf thread changed after long store");
+    }
+    linked_prepare_state_infallible(istate, tos, pc, code_base + 1, 2);
+    if (istate->thread() != expected_thread || istate->stack() != *tos
+        || *tos != publication_top - 2
+        || *((jlong*)&publication_top[-1]) != raw) {
+      fatal("ZeroWasm group perf post-publication state changed");
+    }
+  }
+  if (ZeroWasmLinkedGroupVerbose) {
+    static const char* lane_names[] = {"inline", "direct", "indirect"};
+    tty->print_cr("[zbp3] PERF_WINDOW lane=%s n=%d start=%d span=%d "
+                  "elapsed-ns=%lld checksum=%llu oracle=%llu "
+                  "array-bits=%u value-a-bits=%u value-b-bits=%u "
+                  "pages-before=%d pages-after=%d gc-before=%u gc-after=%u "
+                  "safepoint-before=%llu safepoint-after=%llu "
+                  "checksum-high32=%u thread-identity=1 stack-depth=2 "
+                  "stack-value=1 pending-cleared=1 card-globals-cleared=1 "
+                  "elapsed-pending=1 "
+                  "fallback=0 trap=0 map=pass card=clean-dirty-clean",
+                  lane_names[lane], n, start_index, span_count,
+                  (long long)elapsed_ns, (unsigned long long)(uint64_t)raw,
+                  (unsigned long long)expected, (unsigned)(uint32_t)array_bits,
+                  (unsigned)(uint32_t)value_a_bits,
+                  (unsigned)(uint32_t)value_b_bits,
+                  pages_before, pages_after, gc_before, gc_after,
+                  (unsigned long long)safepoint_before,
+                  (unsigned long long)safepoint_after,
+                  (unsigned)((uint64_t)raw >> 32));
+  }
+  return ZeroWasmBaseline::Returned;
+}
+
+static ZeroWasmBaseline::Result run_linked_reference_store_group(
+    Method* method, intptr_t* locals, address code_base, address* pc,
+    intptr_t** tos, interpreterState istate) {
+  if (!UseZeroWasmLinkedReferenceStoreGroup || istate == nullptr
+      || istate->thread()->has_pending_exception()
+      || !reference_store_group_fixture_class(method)) {
+    return ZeroWasmBaseline::NotRun;
+  }
+  int return_bci = -1;
+  LinkedReferenceStoreGroupPredicates predicates;
+  if (!linked_reference_store_group_shape(method, &return_bci, &predicates)) {
+    if (ZeroWasmLinkedGroupVerbose && method != nullptr
+        && method->name()->equals("groupedReferenceStore")) {
+      tty->print_cr("[zbg] REFERENCE_STORE_GROUP_CLASSIFY holder=%s method=%s "
+                    "descriptor=%s accepted=0 holder-predicate=%d "
+                    "member-predicate=%d body-predicate=%d edge-predicate=%d "
+                    "quickening-predicate=%d",
+                    method->method_holder()->name()->as_C_string(),
+                    method->name()->as_C_string(),
+                    method->signature()->as_C_string(),
+                    predicates.holder ? 1 : 0,
+                    predicates.members ? 1 : 0,
+                    predicates.body ? 1 : 0,
+                    predicates.edges ? 1 : 0,
+                    predicates.quickening ? 1 : 0);
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  if (locals == nullptr || code_base == nullptr || pc == nullptr || *pc == nullptr
+      || *pc != code_base || tos == nullptr || *tos == nullptr
+      || !linked_validate_pre_push(istate, *tos, 1)) {
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbg] REFERENCE_STORE_GROUP_REJECT "
+                    "reason=invalid-entry-frame-before-install");
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  const jlong memory_limit_pages =
+      (jlong)ZeroWasmLinkedReferenceStoreGroupMemoryLimitForTest;
+  if (memory_limit_pages < 0 || memory_limit_pages > INT_MAX) {
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbg] REFERENCE_STORE_GROUP_REJECT "
+                    "reason=invalid-memory-limit pages=%lld",
+                    (long long)memory_limit_pages);
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  LinkedRefArrayStoreLayout layout;
+  if (!linked_ref_array_store_layout_for_fixture(&layout)) {
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbg] REFERENCE_STORE_GROUP_REJECT stage=array-layout "
+                    "serial=%d compressed-oops=%d compressed-class=%d "
+                    "compact-headers=%d ptr=%d oop=%d heap-oop-size=%d",
+                    UseSerialGC ? 1 : 0, UseCompressedOops ? 1 : 0,
+                    UseCompressedClassPointers ? 1 : 0,
+                    UseCompactObjectHeaders ? 1 : 0, (int)sizeof(void*),
+                    (int)sizeof(oop), heapOopSize);
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  bool non_object_array = false;
+  {
+    NoSafepointVerifier nsv;
+    oop initial_array = cast_to_oop((void*)locals[0]);
+    non_object_array = initial_array != nullptr
+        && (initial_array->klass() == nullptr
+            || !initial_array->klass()->is_objArray_klass());
+  }
+  if (non_object_array) {
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbg] REFERENCE_STORE_GROUP_REJECT "
+                    "reason=non-object-array-before-install");
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  if (_linked_reference_store_group_module_id < 0
+      && !install_reference_store_group(layout)) {
+    if (ZeroWasmLinkedGroupVerbose) {
+      tty->print_cr("[zbg] REFERENCE_STORE_GROUP_REJECT stage=module-install");
+    }
+    return ZeroWasmBaseline::NotRun;
+  }
+  if (_linked_reference_store_group_module_id < 0
+      || _linked_reference_store_group_slot < 0) {
+    return ZeroWasmBaseline::NotRun;
+  }
+
+  const uint64_t sequence = ++_linked_reference_store_group_sequence;
+  const address original_pc = *pc;
+  intptr_t* const original_tos = *tos;
+  LinkedStatus result;
+  int outcome = 0; // 1=returned, 2=untouched whole-method interpreter fallback
+  uintptr_t array_bits = 0;
+  uintptr_t value_bits = 0;
+  jint index = 0;
+  jint assignable = 1;
+  int array_length = -1;
+  bool null_array = false;
+  bool bounds_ok = true;
+  bool assignability_ok = true;
+  bool card_dirty = false;
+  bool card_probe_active = false;
+  bool card_probe_array_old = false;
+  bool card_probe_child_young = false;
+  bool card_probe_clean_before = false;
+  uintptr_t card_probe_address_bits = 0;
+  CardTable::CardValue* card_probe_card = nullptr;
+  int card_probe_old_byte = -1;
+  int card_probe_span_kind = 0;
+  {
+    // One no-safepoint transaction owns rooted reread, exact subtype proof,
+    // raw ABI call, post-store verification, and infallible areturn state
+    // publication. There is no suspended activation or post-commit fallback.
+    NoSafepointVerifier nsv;
+    oop array = cast_to_oop((void*)locals[0]);
+    index = (jint)locals[-1];
+    oop value = cast_to_oop((void*)locals[-2]);
+    if (array != cast_to_oop((void*)locals[0])
+        || value != cast_to_oop((void*)locals[-2])) {
+      fatal("ZeroWasm reference-store group rooted locals changed");
+    }
+    array_bits = (uintptr_t)array;
+    value_bits = (uintptr_t)value;
+    null_array = array == nullptr;
+    if (array != nullptr) {
+      if (array->klass() == nullptr || !array->klass()->is_objArray_klass()) {
+        fatal("ZeroWasm reference-store group array klass changed");
+      }
+      array_length = objArrayOop(array)->length();
+      bounds_ok = (uint32_t)index < (uint32_t)array_length;
+      if (bounds_ok && value != nullptr) {
+        Klass* rhs = value->klass();
+        Klass* element = ObjArrayKlass::cast(array->klass())->element_klass();
+        assignability_ok = rhs == element || rhs->is_subtype_of(element);
+        assignable = assignability_ok ? 1 : 0;
+      } else if (!bounds_ok) {
+        assignable = 0;
+      }
+    }
+    LinkedRefArrayStoreLayout live_layout;
+    if (!linked_ref_array_store_layout_for_fixture(&live_layout)
+        || live_layout.length_offset != layout.length_offset
+        || live_layout.base_offset != layout.base_offset
+        || live_layout.element_size != layout.element_size
+        || live_layout.card_shift != layout.card_shift
+        || live_layout.clean_card != layout.clean_card
+        || live_layout.dirty_card != layout.dirty_card
+        || live_layout.card_base != layout.card_base) {
+      fatal("ZeroWasm reference-store group layout changed");
+    }
+    oop target_before = nullptr;
+    CardTable::CardValue* card_before_address = nullptr;
+    int card_before = -1;
+    if (!null_array && bounds_ok) {
+      target_before = objArrayOop(array)->obj_at(index);
+      card_before_address = linked_ref_array_card_for(layout, array, index);
+      if (card_before_address != nullptr) card_before = (int)*card_before_address;
+    }
+    if (_linked_ref_array_store_card_probe_pending) {
+      bool all_null_before_store = !null_array && bounds_ok
+          && array_length >= 1024;
+      if (all_null_before_store) {
+        for (int i = 0; i < array_length; i++) {
+          if (objArrayOop(array)->obj_at(i) != nullptr) {
+            all_null_before_store = false;
+            break;
+          }
+        }
+      }
+      CardTable::CardValue* rebound_card = nullptr;
+      int rebound_span_kind = 0;
+      if (!all_null_before_store
+          || (uintptr_t)array != _linked_ref_array_store_card_probe_array_bits
+          || index != _linked_ref_array_store_card_probe_index
+          || array_length != _linked_ref_array_store_card_probe_length
+          || _linked_ref_array_store_card_probe_span_kind != 1
+          || !linked_ref_array_card_span_proven(
+                 layout, array, index, array_length, &rebound_card,
+                 &rebound_span_kind)
+          || rebound_card == nullptr || rebound_span_kind != 1
+          || (uintptr_t)rebound_card
+                 != _linked_ref_array_store_card_probe_address_bits
+          || (int)*rebound_card != layout.clean_card) {
+        fatal("ZeroWasm reference-store group card probe binding changed");
+      }
+      card_probe_active = true;
+      card_probe_card = rebound_card;
+      card_probe_address_bits = (uintptr_t)rebound_card;
+      card_probe_old_byte = (int)*rebound_card;
+      card_probe_span_kind = rebound_span_kind;
+      card_probe_clean_before = true;
+    }
+    result = decode_linked_status(linked_reference_store_group_call(
+        (jint)(intptr_t)array, index, (jint)(intptr_t)value,
+        (jint)memory_limit_pages, (jint)(uint32_t)layout.card_base, assignable));
+    if (result.status == LINKED_RETURN && result.bci == 0) {
+      if (null_array || !bounds_ok || !assignability_ok
+          || memory_limit_pages != 0
+          || (uint32_t)result.value != (uint32_t)value_bits
+          || objArrayOop(array)->obj_at(index) != value) {
+        fatal("ZeroWasm reference-store group invalid direct result");
+      }
+      CardTable::CardValue* card = linked_ref_array_card_for(
+          layout, array, index);
+      card_dirty = card != nullptr && (int)*card == layout.dirty_card;
+      if (!card_dirty) {
+        fatal("ZeroWasm reference-store group card did not become dirty");
+      }
+      if (card_probe_active) {
+        BarrierSet* barrier = BarrierSet::barrier_set();
+        CardTableBarrierSet* card_barrier =
+            barrier != nullptr && barrier->is_a(BarrierSet::CardTableBarrierSet)
+                ? static_cast<CardTableBarrierSet*>(barrier) : nullptr;
+        CardTable* card_table = card_barrier == nullptr
+            ? nullptr : card_barrier->card_table();
+        CardTable::CardValue* proven_card = nullptr;
+        int proven_span_kind = 0;
+        card_probe_array_old = card_table != nullptr
+            && !card_table->is_in_young(array);
+        card_probe_child_young = value != nullptr && card_table != nullptr
+            && card_table->is_in_young(value);
+        if (!card_probe_array_old || !card_probe_child_young
+            || !linked_ref_array_card_span_proven(
+                   layout, array, index, array_length, &proven_card,
+                   &proven_span_kind)
+            || proven_card != card_probe_card
+            || (uintptr_t)proven_card != card_probe_address_bits
+            || card_probe_old_byte != layout.clean_card
+            || proven_span_kind != card_probe_span_kind
+            || (int)*proven_card != layout.dirty_card) {
+          fatal("ZeroWasm reference-store group card/root proof failed");
+        }
+        _linked_ref_array_store_card_probe_pending = false;
+        _linked_ref_array_store_card_probe_index = -1;
+        _linked_ref_array_store_card_probe_array_bits = 0;
+        _linked_ref_array_store_card_probe_address_bits = 0;
+        _linked_ref_array_store_card_probe_length = -1;
+        _linked_ref_array_store_card_probe_span_kind = 0;
+      }
+      linked_publish_ref_store_return_infallible(
+          istate, tos, pc, code_base + return_bci, value);
+      outcome = 1;
+    } else if (result.status == LINKED_REEXECUTE && result.bci == 0) {
+      if (card_probe_active) {
+        if (card_probe_card == nullptr
+            || (uintptr_t)card_probe_card != card_probe_address_bits
+            || (int)*card_probe_card != card_probe_old_byte) {
+          fatal("ZeroWasm reference-store group card probe refusal changed card");
+        }
