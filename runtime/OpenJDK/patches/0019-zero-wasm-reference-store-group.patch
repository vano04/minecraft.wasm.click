+// Four functions, one public entry, and three private direct-call members.
+// The imported memory does not add a function index; the exact indices are
+// therefore stable and are checked against the ordered edge manifest.
+static int build_reference_store_group_module(
+    WasmBuf& module, const LinkedRefArrayStoreLayout& layout) {
+  static const unsigned char magic[] = {0x00, 0x61, 0x73, 0x6d,
+                                         0x01, 0x00, 0x00, 0x00};
+  module.raw(magic, sizeof(magic));
+
+  WasmBuf types;
+  types.uleb(3);
+  linked_type(types, 6);      // type 0: exported entry -> i64
+  linked_i32_type(types, 1);  // type 1: leaf/relay -> i32
+  linked_void_type(types, 3); // type 2: commit(element,value,card) -> void
+  module.section(1, types);
+
+  WasmBuf imports;
+  imports.uleb(1);
+  imports.string("env"); imports.string("memory");
+  imports.u8(0x02); imports.u8(0x03); imports.uleb(0); imports.uleb(65536);
+  module.section(2, imports);
+
+  WasmBuf functions;
+  functions.uleb(4);
+  functions.uleb(0); // entry
+  functions.uleb(1); // leaf
+  functions.uleb(1); // relay
+  functions.uleb(2); // commit
+  module.section(3, functions);
+
+  WasmBuf exports;
+  exports.uleb(1);
+  emit_linked_export(exports, "groupedReferenceStore", ReferenceStoreGroupEntry);
+  module.section(7, exports);
+
+  WasmBuf code;
+  WasmBuf entry;
+  WasmBuf leaf;
+  WasmBuf relay;
+  WasmBuf commit;
+  emit_reference_store_group_entry(entry, layout);
+  emit_reference_store_group_leaf(leaf);
+  emit_reference_store_group_relay(relay);
+  emit_reference_store_group_commit(commit, layout);
+  code.uleb(4);
+  code.uleb((unsigned)entry.length()); code.raw(entry.data(), entry.length());
+  code.uleb((unsigned)leaf.length()); code.raw(leaf.data(), leaf.length());
+  code.uleb((unsigned)relay.length()); code.raw(relay.data(), relay.length());
+  code.uleb((unsigned)commit.length()); code.raw(commit.data(), commit.length());
+  module.section(10, code);
+  return module.length();
+}
