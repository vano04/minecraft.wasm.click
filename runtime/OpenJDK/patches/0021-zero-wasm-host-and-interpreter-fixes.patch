+bool ClassLoaderData::add_dependency_key(const void* key) {
+  assert_lock_strong(metaspace_lock());
+  if (2 * (_dependency_key_count + 1) > _dependency_key_capacity) {
+    int capacity = _dependency_key_capacity == 0 ? 64 : 2 * _dependency_key_capacity;
+    const void** keys = NEW_C_HEAP_ARRAY(const void*, capacity, mtClass);
+    memset(keys, 0, sizeof(const void*) * capacity);
+    for (int i = 0; i < _dependency_key_capacity; i++) {
+      const void* k = _dependency_keys[i];
+      if (k == nullptr) continue;
+      unsigned j = (unsigned)(((uintptr_t)k >> 3) * 2654435761u) & (unsigned)(capacity - 1);
+      while (keys[j] != nullptr) j = (j + 1) & (unsigned)(capacity - 1);
+      keys[j] = k;
+    }
+    FREE_C_HEAP_ARRAY(const void*, _dependency_keys);
+    _dependency_keys = keys;
+    _dependency_key_capacity = capacity;
+  }
+  unsigned mask = (unsigned)(_dependency_key_capacity - 1);
+  for (unsigned j = (unsigned)(((uintptr_t)key >> 3) * 2654435761u) & mask; ; j = (j + 1) & mask) {
+    if (_dependency_keys[j] == key) return false;
+    if (_dependency_keys[j] == nullptr) {
+      _dependency_keys[j] = key;
+      _dependency_key_count++;
+      return true;
+    }
+  }
+}
