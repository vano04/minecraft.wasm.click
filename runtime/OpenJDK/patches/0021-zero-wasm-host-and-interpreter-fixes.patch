diff --git a/src/hotspot/os_cpu/linux_zero/atomic_linux_zero.hpp b/src/hotspot/os_cpu/linux_zero/atomic_linux_zero.hpp
index 6409942..b53cb58 100644
--- a/src/hotspot/os_cpu/linux_zero/atomic_linux_zero.hpp
+++ b/src/hotspot/os_cpu/linux_zero/atomic_linux_zero.hpp
@@ -149,4 +149,33 @@ inline void Atomic::PlatformStore<8>::operator()(T volatile* dest,
   __atomic_store(dest, &store_value, __ATOMIC_RELAXED);
 }
 
+#ifdef __EMSCRIPTEN__
+// wasm32 falls into orderAccess_linux_zero.hpp's "strongest barriers" branch,
+// so a generic acquire load or release store is a plain access plus a full
+// atomic.fence -- which V8 lowers to mfence on x64 and dmb ish on ARM. Every
+// Method::from_interpreted_entry(), cpCache is_resolved() check and safepoint
+// poll paid that. wasm has sequentially consistent atomic loads and stores,
+// so use them, exactly as the aarch64 port does with ldar/stlr.
+template<size_t byte_size>
+struct Atomic::PlatformOrderedLoad<byte_size, X_ACQUIRE>
+{
+  template <typename T>
+  T operator()(const volatile T* p) const { T data; __atomic_load(const_cast<T*>(p), &data, __ATOMIC_ACQUIRE); return data; }
+};
+
+template<size_t byte_size>
+struct Atomic::PlatformOrderedStore<byte_size, RELEASE_X>
+{
+  template <typename T>
+  void operator()(volatile T* p, T v) const { __atomic_store(const_cast<T*>(p), &v, __ATOMIC_RELEASE); }
+};
+
+template<size_t byte_size>
+struct Atomic::PlatformOrderedStore<byte_size, RELEASE_X_FENCE>
+{
+  template <typename T>
+  void operator()(volatile T* p, T v) const { release_store(p, v); OrderAccess::fence(); }
+};
+#endif // __EMSCRIPTEN__
+
 #endif // OS_CPU_LINUX_ZERO_ATOMIC_LINUX_ZERO_HPP
