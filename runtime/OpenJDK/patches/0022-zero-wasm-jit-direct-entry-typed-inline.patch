+      case vmIntrinsics::_dsqrt: case vmIntrinsics::_dsqrt_strict:
+      case vmIntrinsics::_dabs: case vmIntrinsics::_fabs:
+      case vmIntrinsics::_iabs: case vmIntrinsics::_labs:
+      case vmIntrinsics::_minD: case vmIntrinsics::_maxD:
+      case vmIntrinsics::_minF: case vmIntrinsics::_maxF:
+      case vmIntrinsics::_min: case vmIntrinsics::_max:
+      case vmIntrinsics::_minL: case vmIntrinsics::_maxL:
+      case vmIntrinsics::_floatToRawIntBits: case vmIntrinsics::_intBitsToFloat:
