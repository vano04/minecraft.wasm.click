+        sites[bci]->taken = true;
+        sites[bci]->calls = 0x7fffffff;
+      }
+    }
+  }
+  // The site records themselves live as long as the code that points at
+  // them; only the per-bci index is replaced. Kept as the next profile.
+  if (e->sites != nullptr) ::free(e->sites);
+  e->sites = sites;
+  e->since = 0;
+}
