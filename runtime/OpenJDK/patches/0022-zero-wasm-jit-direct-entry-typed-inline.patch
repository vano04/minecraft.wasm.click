+    bool leaf = true, stores = false;
+    address code = method->code_base();
+    for (int bci = 0; bci < method->code_size() && leaf; ) {
+      Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+      if ((int)c >= Bytecodes::number_of_codes) { leaf = false; break; }
+      if (is_effect_op(c)) {
