+  // ---- lambda capture -------------------------------------------------------
+  // A lambda or method reference is an invokedynamic that LambdaMetafactory
+  // links to a ConstantCallSite, whose target is the site's appendix. With
+  // captured values it is the spun class's constructor handle, asType'd to
+  // the site's type, which keeps its class (DirectMethodHandle$Constructor:
+  // viewAsType). linkToTargetMethod -> invokeBasic -> DMH.newInvokeSpecial
+  // -> allocateInstance -> linkToSpecial -> <init> is five framed calls to
+  // build an object of two fields: 115 ns against 40 for the same class
+  // written by hand (tests/IndyBench), and allocateInstance's frames are on
+  // every thread's profile. The class and its <init> are fixed once the site
+  // is linked: a hidden, final, initialized class with Object as its super
+  // and no finalizer, defined strongly in the caller's nest, whose <init> is
+  // exactly what InnerClassLambdaMetafactory.generateConstructor writes --
+  //   aload_0, invokespecial Object.<init>,
+  //   then per argument: aload_0, xload <its slot>, putfield <its field>,
+  //   return
+  // -- which is checked here, bytecode by bytecode, so what is emitted is
+  // that <init> run on a fresh object: a TLAB bump, the header, the fields
+  // that no argument fills zeroed, a store per argument (a boolean cut to its
+  // low bit and a card mark for a reference, as putfield has), and one
+  // fence, which publishes the final fields as MemAllocator's fence publishes
+  // the header. The bump is the only thing that can fail, and nothing has
+  // happened when it does: at method level it falls into the linked call,
+  // which emit_indy_call still emits (a diamond like emit_vh_array's); in a
+  // splice or a frameless body it is `new`'s guard, and a frameless body's
+  // bail puts the TLAB top back.
+  // Without captured values the target is MethodHandles.constant's
+  // BoundMethodHandle$Species_L, and the lambda is its argL0: the appendix
+  // load emit_indy_call already makes, and one more, instead of two framed
+  // calls. Neither path calls anything or reaches a safepoint, so they are
+  // allowed in frameless bodies and splices too. ZeroWasmJITIndyFast bit 2.
+  static const int MAX_LAMBDA_ARGS = 16;
+  struct LambdaShape {
+    InstanceKlass* k;   // the lambda's class; nullptr for a constant
+    int rr_index;       // the appendix in resolved_references
+    int argl0;          // Species_L.argL0, for a constant
+    int size;           // instance bytes
+    int nslots;         // argument slots
+    int n;              // captured values
+    bool oop;           // any of them a reference
+    uint64_t covered;   // 4-byte words of the instance the stores fill
+    struct Arg { int slot; int off; int kind; int sop; int align; bool oop; bool z; } a[MAX_LAMBDA_ARGS];
+  };
+  struct LambdaOffsets { InstanceKlass* ctor; InstanceKlass* bmh_l; int init, iclass, argl0; };
+  // Found once both classes are initialized, which the first capturing and
+  // the first non-capturing lambda see to (one of them may come much later,
+  // so a miss is not cached).
+  static const LambdaOffsets* lambda_offsets() {
+    static LambdaOffsets c;
+    static volatile int ready = 0;
+    if (Atomic::load_acquire(&ready) != 0) return &c;
+    LambdaOffsets v;
+    v.ctor = initialized_boot_klass("java/lang/invoke/DirectMethodHandle$Constructor");
+    v.bmh_l = initialized_boot_klass("java/lang/invoke/BoundMethodHandle$Species_L");
+    if (v.ctor == nullptr || v.bmh_l == nullptr) return nullptr;
+    v.init = field_offset_named(v.ctor, "initMethod", "Ljava/lang/invoke/MemberName;", false);
+    v.iclass = field_offset_named(v.ctor, "instanceClass", "Ljava/lang/Class;", false);
+    v.argl0 = field_offset_named(v.bmh_l, "argL0", "Ljava/lang/Object;", false);
+    if (v.init <= 0 || v.iclass <= 0 || v.argl0 <= 0) return nullptr;
+    c = v;
+    Atomic::release_store(&ready, 1);
+    return &c;
+  }
+  // Whether `load` (a Java bytecode) loads local `slot` as type t.
+  static bool loads_slot(Bytecodes::Code load, address at, BasicType t, int slot) {
+    Bytecodes::Code first, one;
+    switch (t) {
+      case T_BOOLEAN: case T_BYTE: case T_CHAR: case T_SHORT: case T_INT:
+                      first = Bytecodes::_iload_0; one = Bytecodes::_iload; break;
+      case T_LONG:    first = Bytecodes::_lload_0; one = Bytecodes::_lload; break;
+      case T_FLOAT:   first = Bytecodes::_fload_0; one = Bytecodes::_fload; break;
+      case T_DOUBLE:  first = Bytecodes::_dload_0; one = Bytecodes::_dload; break;
+      case T_OBJECT: case T_ARRAY:
+                      first = Bytecodes::_aload_0; one = Bytecodes::_aload; break;
+      default: return false;
+    }
+    if (load == one) return (int)(unsigned char)at[1] == slot;
+    return (int)load - (int)first == slot && slot <= 3;
+  }
+  // Whether the invokedynamic at bci is a lambda emit_lambda can build, and
+  // how. The inliner's scan asks the same, so a callee it approves never
+  // bails here for the shape.
+  bool lambda_shape(Method* m, address code, int bci, LambdaShape* s) {
+    if (!indy_fast(2) || (Bytecodes::Code)(unsigned char)code[bci] != Bytecodes::_invokedynamic) return false;
+    ConstantPool* cp = m->constants();
+    if (cp->cache() == nullptr) return false;
+    ResolvedIndyEntry* ie = cp->resolved_indy_entry_at((int)Bytes::get_native_u4(code + bci + 1));
+    if (ie == nullptr || !ie->is_resolved() || !ie->has_appendix()) return false;
+    int cpi = ie->constant_pool_index();
+    if (!cp->tag_at(cpi).is_invoke_dynamic()) return false;
+    int bsm = cp->bootstrap_method_ref_index_at(cpi);
+    if (!cp->tag_at(bsm).is_method_handle()) return false;
+    Symbol* bn = cp->method_handle_name_ref_at(bsm);
+    if (!cp->klass_name_at(cp->method_handle_klass_index_at(bsm))->equals("java/lang/invoke/LambdaMetafactory")
+        || !(bn->equals("metafactory") || bn->equals("altMetafactory"))) return false;
+    Symbol* sig = cp->symbol_at(cp->signature_ref_index_at(cp->bootstrap_name_and_type_ref_index_at(cpi)));
+    const LambdaOffsets* o = lambda_offsets();
+    if (o == nullptr) return false;
+    oop app = cp->resolved_reference_at(ie->resolved_references_index());
+    if (app == nullptr) return false;
+    s->rr_index = ie->resolved_references_index();
+    s->k = nullptr;
+    s->n = 0; s->nslots = 0; s->oop = false; s->covered = 0;
+    if (app->klass() == o->bmh_l) {                  // MethodHandles.constant: ()L...;
+      if (sig->utf8_length() < 2 || sig->char_at(1) != ')') return false;
+      s->argl0 = o->argl0;
+      return true;
+    }
+    if (app->klass() != o->ctor) return false;
+    oop mn = app->obj_field(o->init);
+    Method* init = mn != nullptr ? java_lang_invoke_MemberName::vmtarget(mn) : nullptr;
+    if (init == nullptr || !init->is_object_initializer()) return false;
+    InstanceKlass* ik = init->method_holder();
+    oop icm = app->obj_field(o->iclass);              // what allocateInstance makes
+    if (icm == nullptr || java_lang_Class::as_Klass(icm) != ik) return false;
+    if (!ik->is_hidden() || !ik->is_final() || ik->super() != vmClasses::Object_klass()
+        || ik->has_finalizer() || !ik->is_initialized() || !ik->can_be_fastpath_allocated()) return false;
+    int size = (int)ik->size_helper() * HeapWordSize;
+    if (size > 256) return false;
+    // The site's arguments are <init>'s: "(args)I" against "(args)V".
+    Symbol* isig = init->signature();
+    int close = isig->utf8_length() - 2;
+    if (close < 1 || isig->char_at(close) != ')' || sig->utf8_length() <= close + 1
+        || ::memcmp(isig->bytes(), sig->bytes(), close + 1) != 0) return false;
+    // generateConstructor's <init>, and nothing else.
+    ConstantPool* icp = init->constants();
+    if (icp->cache() == nullptr) return false;
+    address ic = init->code_base();
+    const int len = init->code_size();
+    int b = 0;
+    auto at = [&](int i) { return i < len ? Bytecodes::java_code_at(init, ic + i) : Bytecodes::_illegal; };
+    auto step = [&]() { int l = Bytecodes::java_length_at(init, ic + b); b = l > 0 ? b + l : len + 1; };
+    if (at(b) != Bytecodes::_aload_0) return false;
+    step();
+    if (at(b) != Bytecodes::_invokespecial) return false;
+    int which = u2_at(ic, b + 1);
+    if (!icp->klass_ref_at_noresolve(which, Bytecodes::_invokespecial)->equals("java/lang/Object")
+        || !icp->name_ref_at(which, Bytecodes::_invokespecial)->equals("<init>")) return false;
+    step();
+    int slot = 1;
+    for (SignatureStream ss(isig); !ss.at_return_type(); ss.next()) {
+      BasicType t = ss.type();
+      if (s->n == MAX_LAMBDA_ARGS || at(b) != Bytecodes::_aload_0) return false;
+      step();
+      if (b >= len || !loads_slot(at(b), ic + b, t, slot)) return false;
+      step();
+      if (at(b) != Bytecodes::_putfield) return false;
+      int fi = u2_at(ic, b + 1);
+      ResolvedFieldEntry* fe = icp->resolved_field_entry_at(fi);
+      LambdaShape::Arg& a = s->a[s->n];
+      int lop;
+      if (fe == nullptr || !fe->is_resolved(Bytecodes::_putfield) || fe->field_holder() != ik
+          || fe->is_volatile() || (TosState)fe->tos_state() != as_TosState(t)
+          || !field_shape(init, fi, Bytecodes::_putfield, true, &a.off, &a.kind, &lop, &a.sop, &a.align, &a.oop)
+          || a.off + type2aelembytes(t) > size) return false;
+      step();
+      a.slot = slot - 1;
+      a.z = (t == T_BOOLEAN);
+      int w = type2aelembytes(t);
+      if (w >= 4 && (a.off & 3) == 0) {
+        for (int i = a.off / 4; i < (a.off + w) / 4; i++) s->covered |= (uint64_t)1 << i;
+      }
+      s->oop |= a.oop;
+      s->n++;
+      slot += type2size[t];
+    }
+    if (at(b) != Bytecodes::_return || b + 1 != len) return false;
+    if (slot - 1 != init->size_of_parameters() - 1) return false;
+    s->k = ik;
+    s->size = size;
+    s->nslots = slot - 1;
+    return true;
+  }
+  // Whether a capture may allocate here: a splice or a frameless body takes
+  // the same TLAB bump `new` does there (inline_new_ok, fl_alloc_ok).
+  bool lambda_alloc_ok(const LambdaShape& s, bool spliced) {
+    if (s.k == nullptr) return true;
+    if (!_can_alloc || disabled(NO_ALLOC) || (spliced && disabled(NO_INLINE_ALLOC))) return false;
+    if (_frameless && !fl_alloc_ok()) return false;
+    return !s.oop || (_can_store_oop && !disabled(NO_OOPSTORE));
+  }
+  // [a1..an] -> [the lambda]
+  bool emit_lambda(Method* m, address code, int bci, int& depth, bool allow_branches) {
+    LambdaShape s;
+    if (!lambda_shape(m, code, bci, &s)) return false;
+    const int D = depth;
+    if (s.k == nullptr) {
+      if (D >= MAX_DEPTH) return false;
+      oop* storage = *(oop**)((address)m->constants()->cache()
+          + in_bytes(ConstantPoolCache::resolved_references_offset()));
+      if (storage == nullptr) return false;
+      emit_const((int)(intptr_t)storage);
+      i32_load();
+      mem_op(WOP_I32_LOAD, 2,
+             arrayOopDesc::base_offset_in_bytes(T_OBJECT) + s.rr_index * (int)heapOopSize);
+      mem_op(WOP_I32_LOAD, 2, s.argl0);
+      set_i32(D);
+      depth = D + 1;
+      if (ZeroWasmJITVerbose) { ResourceMark rm;
+        tty->print_cr("[zwc]   lambda constant @%d in %s", bci, m->name_and_sig_as_C_string()); }
+      return true;
+    }
+    const int base = D - s.nslots;
+    const bool spliced = _frameless || _local_base >= 0;
+    if (base < 0 || !lambda_alloc_ok(s, spliced) || _next_local + 1 > LOCALS_SOFT_LIMIT) return false;
+    for (int i = 0; i < s.n; i++) if (slot_kind(base + s.a[i].slot) != s.a[i].kind) return false;
+    const bool diamond = allow_branches && !_frameless && m == _method && _inline_depth == 0
+                         && !disabled(NO_CALLS);
+    const int dst = alloc_locals(1);
+    if (diamond) {
+      emit(WOP_BLOCK); emit(0x40);                   // $done
+      emit(WOP_BLOCK); emit(0x40);                   // $slow
+      emit_const((int)(intptr_t)_tlab_top_addr); i32_load(); local_set(dst);
+      emit_const((int)(intptr_t)_tlab_end_addr); i32_load();
+      local_get(dst); emit(WOP_I32_SUB);
+      emit_const(s.size);
+      _code_buf.u8(0x49);                            // i32.lt_u
+      emit(WOP_BR_IF); _code_buf.uleb(0);            // to $slow
+      emit_const((int)(intptr_t)_tlab_top_addr);
+      local_get(dst); emit_const(s.size); emit(WOP_I32_ADD);
+      i32_store();
+    } else {
+      emit_tlab_alloc(s.size, dst, bci, D);
+    }
+    // emit_object_init's header and zeroing, less the words the arguments
+    // fill, and its fence after the stores instead of before them.
+    local_get(dst); emit_const((int)(intptr_t)markWord::prototype().value());
+    mem_op(WOP_I32_STORE, 2, oopDesc::mark_offset_in_bytes());
+    local_get(dst); emit_const((int)(intptr_t)s.k);
+    mem_op(WOP_I32_STORE, 2, oopDesc::klass_offset_in_bytes());
+    for (int off = oopDesc::header_size() * HeapWordSize; off < s.size; off += 4) {
+      if ((s.covered >> (off / 4)) & 1) continue;
+      local_get(dst); emit_const(0); mem_op(WOP_I32_STORE, 2, off);
+    }
+    for (int i = 0; i < s.n; i++) {
+      const LambdaShape::Arg& a = s.a[i];
+      local_get(dst);
+      get_val(a.kind, base + a.slot);
+      if (a.z) { emit_const(1); emit(WOP_I32_AND); }   // putfield keeps a boolean's low bit
+      mem_op(a.sop, a.align, a.off);
+      if (a.oop) emit_card_mark(dst, a.off);
+    }
+    _code_buf.u8(0xfe); _code_buf.u8(0x03); _code_buf.u8(0x00);   // atomic.fence
+    if (ZeroWasmJITVerbose) { ResourceMark rm;
+      tty->print_cr("[zwc]   lambda capture of %d @%d in %s%s", s.n, bci, m->name_and_sig_as_C_string(),
+                    diamond ? "" : ", guarded"); }
+    if (!diamond) {
+      local_get(dst); set_i32(base);
+      depth = base + 1;
+      return true;
+    }
+    // The result where the call's reload leaves it; the slot kinds stay
+    // what the call sequence below spills with.
+    local_get(dst); local_set(stack_local(base));
+    emit(WOP_BR); _code_buf.uleb(1);                 // to $done
+    emit(WOP_END);                                   // $slow
+    int d = D;
+    if (!emit_indy_call(m, code, bci, d)) {
+      emit_bail(bci, D, true);
+      d = base + 1;
+      set_slot(base, K_I32);
+    }
+    emit(WOP_END);                                   // $done
+    depth = d;
+    return true;
+  }
