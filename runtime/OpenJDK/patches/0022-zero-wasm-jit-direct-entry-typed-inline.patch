+      if (!ik->find_local_field(cn, cs, &fd) || fd.is_static() || fd.is_volatile()) return -1;
+      out[i].off = fd.offset();
+      out[i].t = fd.field_type();
+    }
+    if (pos != names->utf8_length()) return -1;
+    return n;
+  }
+
+  // The component's value from `obj` (a local), on the wasm stack.
+  void emit_component_load(int obj, const RecComp& c) {
+    local_get(obj);
+    switch (c.t) {
+      case T_BOOLEAN: mem_op(WOP_I32_LOAD8_U, 0, c.off); break;
+      case T_BYTE:    mem_op(WOP_I32_LOAD8_S, 0, c.off); break;
+      case T_CHAR:    mem_op(WOP_I32_LOAD16_U, 1, c.off); break;
+      case T_SHORT:   mem_op(WOP_I32_LOAD16_S, 1, c.off); break;
+      case T_FLOAT:   mem_op(WOP_F32_LOAD, 2, c.off); break;
+      case T_LONG:    mem_op(WOP_I64_LOAD, 3, c.off); break;
+      case T_DOUBLE:  mem_op(WOP_F64_LOAD, 3, c.off); break;
+      default:        mem_op(WOP_I32_LOAD, 2, c.off); break;   // int, and references
+    }
+  }
+  // A float's or double's bits with NaN canonical, as floatToIntBits and
+  // doubleToLongBits give them (what Float.hashCode and Float.compare use).
+  void emit_float_bits(int obj, const RecComp& c) {
+    if (c.t == T_FLOAT) {
+      emit_const(0x7fc00000);
+      emit_component_load(obj, c); emit(0xbc);                     // i32.reinterpret_f32
+      emit_component_load(obj, c); emit_component_load(obj, c); emit(0x5c);   // f32.ne: NaN
+    } else {
+      emit(WOP_I64_CONST); _code_buf.sleb64((jlong)0x7ff8000000000000LL);
+      emit_component_load(obj, c); emit(0xbd);                     // i64.reinterpret_f64
+      emit_component_load(obj, c); emit_component_load(obj, c); emit(WOP_F64_NE);
+    }
+    emit(WOP_SELECT);
+  }
+  ZwcCallSite* static_site(Method* m, address code, int bci, Method* callee, BasicType rt) {
+    ZwcCallSite* site = (ZwcCallSite*)::calloc(1, sizeof(ZwcCallSite));
+    if (site == nullptr) return nullptr;
+    site->caller = m;
+    site->bci = bci;
+    site->bcp = code + bci;
+    site->parms = callee->size_of_parameters();
+    site->result_slots = 1;
+    site->result_type = rt;
+    site->t.callee = callee;
+    return site;
+  }
+
+  bool emit_record_method(Method* m, address code, int bci, int& depth) {
+    if (disabled(NO_CALLS) || disabled(NO_INTRINSICS) || _frameless || m != _method
+        || _inline_depth != 0) return false;
+    bool eq;
+    RecComp comps[MAX_REC];
+    int n = record_components(m, code, bci, &eq, comps);
+    if (n < 0) return false;
+    int nin = eq ? 2 : 1;
+    if (depth < nin || depth + 3 >= MAX_DEPTH || _next_local + 8 >= LOCALS_SOFT_LIMIT) return false;
+    // The record reference(s) must also be locals 0 (and 1): javac's
+    // `aload_0 [aload_1] invokedynamic`. A reference component's hash or
+    // equals is a call made at this bci with more on the stack than the
+    // bytecode has there, and the frame map the collector reads describes
+    // the bytecode: the record in the stack slot below the call was not
+    // updated when a collection moved it, and the fold went on reading the
+    // old copy (a hash installed in a dead array, a stale field: in game,
+    // CubicSpline.Multipoint.hashCode handed Objects.hashCode garbage). The
+    // locals are roots at every bci, so each call is followed by a reload
+    // from them.
+    auto is_aload = [](int c, int k) {
+      return c == (int)Bytecodes::_aload_0 + k
+          || (k == 0 && (c == (int)Bytecodes::_fast_aload_0 || c == (int)Bytecodes::_nofast_aload_0));
+    };
+    if (bci < nin || !is_aload(code[bci - nin], 0) || (eq && !is_aload(code[bci - 1], 1))) return false;
+    bool refs = false;
+    for (int i = 0; i < n; i++) refs |= is_reference_type(comps[i].t);
+    Method* callee = nullptr;
+    if (refs) {
+      callee = eq ? objects_method("equals", "(Ljava/lang/Object;Ljava/lang/Object;)Z")
+                  : objects_method("hashCode", "(Ljava/lang/Object;)I");
+      if (callee == nullptr) return false;
+    }
+    const int D = depth;
+    const int a = stack_local(D - nin);                 // this
+    const int acc = alloc_locals(1);
+    Target tg[1] = { { nullptr, callee, T_CLASS } };
+    int ntg = (callee != nullptr && !disabled(NO_DIRECT_CALLS) && _stack_base != nullptr) ? 1 : 0;
+    if (!eq) {
+      emit_const(0); local_set(acc);
+      for (int i = 0; i < n; i++) {
+        const RecComp& c = comps[i];
+        if (is_reference_type(c.t)) {
+          ZwcCallSite* site = static_site(m, code, bci, callee, T_INT);
+          if (site == nullptr) return false;
+          emit_component_load(a, c); set_i32(D);
+          int d = D + 1;
+          emit_call_sequence(site, bci, d, 1, T_INT, D, tg, ntg);   // leaves the hash at D
+          emit_local_load(0); local_set(a);                         // it may have moved
+          local_get(acc); emit_const(31); emit(WOP_I32_MUL);
+          local_get(stack_local(D)); emit(WOP_I32_ADD); local_set(acc);
+          continue;
+        }
+        local_get(acc); emit_const(31); emit(WOP_I32_MUL);
+        switch (c.t) {
+          case T_BOOLEAN: emit_const(1231); emit_const(1237); emit_component_load(a, c); emit(WOP_SELECT); break;
+          case T_LONG:
+            emit_component_load(a, c); emit_component_load(a, c);
+            emit(WOP_I64_CONST); _code_buf.sleb64(32); emit(WOP_I64_SHR_U);
+            emit(WOP_I64_XOR); emit(WOP_I32_WRAP_I64); break;
+          case T_FLOAT: emit_float_bits(a, c); break;
+          case T_DOUBLE: {
+            int t64 = wide_local(K_I64, D);
+            emit_float_bits(a, c); local_set(t64);
+            local_get(t64); local_get(t64);
+            emit(WOP_I64_CONST); _code_buf.sleb64(32); emit(WOP_I64_SHR_U);
+            emit(WOP_I64_XOR); emit(WOP_I32_WRAP_I64); break;
+          }
+          default: emit_component_load(a, c); break;      // int, short, char, byte
+        }
+        emit(WOP_I32_ADD); local_set(acc);
+      }
+      local_get(acc); set_i32(D - 1);
+      depth = D;                                          // [this] -> [hash]
+      return true;
+    }
+    // equals: [this, o] -> [boolean]
+    const int b = stack_local(D - 1);
+    emit(WOP_BLOCK); emit(0x40);                          // $done, acc the answer
+    const int done = _nest;
+    auto br_done = [&]() { emit(WOP_BR); _code_buf.uleb((unsigned)(_nest - done)); };
+    emit_const(1); local_set(acc);
+    local_get(a); local_get(b); emit(WOP_I32_EQ);
+    emit(WOP_IF); emit(0x40); br_done(); emit(WOP_END);
+    emit_const(0); local_set(acc);
+    local_get(b); emit(WOP_I32_EQZ);
+    emit(WOP_IF); emit(0x40); br_done(); emit(WOP_END);
+    emit_klass_of(b); emit_const((int)(intptr_t)m->method_holder()); emit(WOP_I32_NE);
+    emit(WOP_IF); emit(0x40); br_done(); emit(WOP_END);
+    for (int i = 0; i < n; i++) {
+      const RecComp& c = comps[i];
+      if (is_reference_type(c.t)) {
+        // Objects.equals: the same reference or both null is equal without
+        // a call; a null against a non-null is not.
+        emit_component_load(a, c); emit_component_load(b, c); emit(WOP_I32_NE);
+        emit(WOP_IF); emit(0x40);
+          emit_component_load(a, c); emit(WOP_I32_EQZ);
+          emit(WOP_IF); emit(0x40); br_done(); emit(WOP_END);
+          ZwcCallSite* site = static_site(m, code, bci, callee, T_BOOLEAN);
+          if (site == nullptr) { fail(); return true; }
+          emit_component_load(a, c); set_i32(D);
+          emit_component_load(b, c); set_i32(D + 1);
+          int d = D + 2;
+          emit_call_sequence(site, bci, d, 2, T_BOOLEAN, D, tg, ntg);  // the answer at D
+          emit_local_load(0); local_set(a);                         // they may have moved
+          emit_local_load(1); local_set(b);
+          local_get(stack_local(D)); emit(WOP_I32_EQZ);
+          emit(WOP_IF); emit(0x40); br_done(); emit(WOP_END);
+        emit(WOP_END);
+        continue;
+      }
+      switch (c.t) {
+        case T_FLOAT: case T_DOUBLE: {
+          RecComp cb = c;
+          emit_float_bits(a, c);
+          // the same for `o`, loaded from b
+          if (c.t == T_FLOAT) {
+            emit_const(0x7fc00000);
+            emit_component_load(b, cb); emit(0xbc);
+            emit_component_load(b, cb); emit_component_load(b, cb); emit(0x5c);
+            emit(WOP_SELECT);
+            emit(WOP_I32_NE);
+          } else {
+            emit(WOP_I64_CONST); _code_buf.sleb64((jlong)0x7ff8000000000000LL);
+            emit_component_load(b, cb); emit(0xbd);
+            emit_component_load(b, cb); emit_component_load(b, cb); emit(WOP_F64_NE);
+            emit(WOP_SELECT);
+            emit(WOP_I64_NE);
+          }
+          break;
+        }
+        case T_LONG:
+          emit_component_load(a, c); emit_component_load(b, c); emit(WOP_I64_NE); break;
+        default:
+          emit_component_load(a, c); emit_component_load(b, c); emit(WOP_I32_NE); break;
+      }
+      emit(WOP_IF); emit(0x40); br_done(); emit(WOP_END);
+    }
+    emit_const(1); local_set(acc);
+    emit(WOP_END);                                        // $done
+    local_get(acc); set_i32(D - 2);
+    depth = D - 1;
+    return true;
+  }
+
+  bool emit_indy_call(Method* m, address code, int bci, int& depth) {
+    if (disabled(NO_CALLS) || _frameless) return false;
+    ConstantPool* cp = m->constants();
+    ConstantPoolCache* cache = cp->cache();
+    if (cache == nullptr) return false;
+    Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+    Method* adapter;
+    bool has_appendix;
+    int rr_index;
+    if (c == Bytecodes::_invokedynamic) {
+      int index = (int)Bytes::get_native_u4(code + bci + 1);
+      ResolvedIndyEntry* ie = cp->resolved_indy_entry_at(index);
+      if (ie == nullptr || !ie->is_resolved()) return false;
+      adapter = ie->method();
+      has_appendix = ie->has_appendix();
+      rr_index = ie->resolved_references_index();
+    } else {
+      ResolvedMethodEntry* me = cp->resolved_method_entry_at(u2_at(code, bci + 1));
+      if (me == nullptr || !me->is_resolved(Bytecodes::_invokehandle)) return false;
+      adapter = me->method();
+      has_appendix = me->has_appendix();
+      rr_index = me->resolved_references_index();
+    }
+    if (adapter == nullptr) return false;
+    int bail_depth = depth;
+    if (has_appendix) {
+      if (depth >= MAX_DEPTH) return false;
+      if (cp->resolved_reference_at(rr_index) == nullptr) return false;
+      oop* storage = *(oop**)((address)cache
+          + in_bytes(ConstantPoolCache::resolved_references_offset()));
+      if (storage == nullptr) return false;
+      emit_const((int)(intptr_t)storage);
+      i32_load();
+      mem_op(WOP_I32_LOAD, 2,
+             arrayOopDesc::base_offset_in_bytes(T_OBJECT) + rr_index * (int)heapOopSize);
+      set_i32(depth);
+      depth++;
+    }
+    int nargs = adapter->size_of_parameters();
+    BasicType rt = adapter->result_type();
+    int rslots = type2size[rt];
+    if (depth < nargs || depth - nargs + rslots >= MAX_DEPTH
+        || _next_local >= LOCALS_SOFT_LIMIT) {
+      depth = bail_depth;
+      return false;
+    }
+    ZwcCallSite* site = (ZwcCallSite*)::calloc(1, sizeof(ZwcCallSite));
+    if (site == nullptr) { depth = bail_depth; return false; }
+    site->bci = bci;
+    site->bcp = code + bci;
+    site->parms = nargs;
+    site->result_slots = rslots;
+    site->result_type = rt;
+    site->receiver = false;
+    site->dispatch = false;
+    site->t.callee = adapter;
+    note_mh_intrinsic(site, adapter);
+    if (m == _method && _sites != nullptr) _sites[bci] = site;   // a profile for the next compile
+    // The adapter is bound for good, so it is a statically bound target;
+    // when it is invokeBasic itself (invokehandle), the target the profile
+    // saw behind it.
+    Target tg[1] = { { nullptr, adapter, T_CLASS } };
+    int ntg = 0;
+    if (!disabled(NO_DIRECT_CALLS) && _stack_base != nullptr && m == _method) {
+      ZwcCallSite* ps = _profile != nullptr ? _profile[bci] : nullptr;
+      if (!site->mh_basic && !site->mh_link) {
+        ntg = 1;
+      } else if (ps != nullptr && ps->mh_target != nullptr && ps->mh_basic == site->mh_basic
+                 && ps->mh_link == site->mh_link) {
+        tg[0].m = ps->mh_target;
+        tg[0].kind = site->mh_basic ? T_MH_BASIC : T_MH_LINK;
+        ntg = 1;
+      }
+    }
+    emit_call_sequence(site, bci, depth, nargs, rt, bail_depth, tg, ntg);
+    return true;
+  }
+
+  // ---- VarHandles over reference arrays -------------------------------------
+  // AtomicReferenceArray.get is `AA.getVolatile(array, i)`: an invokehandle
+  // linked to VarHandleGuards.guard_LI_L, with the site's AccessDescriptor as
+  // its appendix, which tests the handle's access mode, linkToStatic's into
+  // VarHandleReferences$Array.getVolatile and casts the result. That is four
+  // framed calls for one load: 58 ns against 2.7 for a plain aaload
+  // (tests/VhBench), with the guard and Array frames on top of the render
+  // thread's profile (ClientChunkCache$Storage.getChunk, per chunk lookup).
+  // When the handle is exactly a VarHandleReferences$Array the chain computes
+  //   checkAccessModeThenIsDirect   the handle's `exact` is false
+  //   form test                     Array.FORM's method type for the
+  //                                 descriptor's access type is its erased one
+  //   arrayType.cast(o)             o's class is arrayType (exactly: a subtype
+  //                                 array, which cast also takes, goes slow)
+  //   checkIndex(i, o.length)       i <u o.length
+  //   the element                   with the mode's ordering
+  //   returnType.cast(r)            nothing when the site returns Object
+  // so that is emitted. What the site links to is fixed once it is linked
+  // (the descriptor is a resolved reference, Array.FORM is static final and
+  // its table @Stable), so the form test is made here, once; the handle is
+  // whatever the code has at run time, so its class, `exact` and arrayType
+  // are read there. Any test that fails is the call as before: at method
+  // level the linked call follows as the slow path (a diamond, like
+  // emit_direct_fast_path); in a splice or a frameless body, which cannot
+  // make it, a guard -- nothing has happened yet, so the interpreter re-runs
+  // the invokehandle and throws what it throws (a null array, an index out
+  // of bounds). The fast path makes no call and reaches no safepoint (the
+  // subtype test is zwc_subtype, a leaf), so nothing on the operand stack
+  // needs the frame map the record emitter has to respect. wasm atomics are
+  // sequentially consistent, which covers getVolatile, getAcquire and
+  // getOpaque; plain get is a plain load. ZeroWasmJITIndyFast bit 1.
+  struct VhArrayShape {
+    Klass* vh;          // VarHandleReferences$Array
+    int exact_off;      // VarHandle.exact
+    int atype_off;      // VarHandleReferences$Array.arrayType
+    bool atomic;        // getVolatile, getAcquire, getOpaque
+    Klass* cast;        // the site's return type, when it is not Object
+  };
+  static int field_offset_named(InstanceKlass* ik, const char* name, const char* sig, bool is_static) {
+    Symbol* n = SymbolTable::probe(name, (int)::strlen(name));
+    Symbol* s = SymbolTable::probe(sig, (int)::strlen(sig));
+    if (n == nullptr || s == nullptr) return -1;
+    fieldDescriptor fd;
+    if (ik->find_field(n, s, is_static, &fd) == nullptr) return -1;
+    return fd.offset();
+  }
+  static InstanceKlass* initialized_boot_klass(const char* name) {
+    Symbol* cn = SymbolTable::probe(name, (int)::strlen(name));
+    if (cn == nullptr) return nullptr;
+    InstanceKlass* ik = SystemDictionary::find_instance_klass(Thread::current(), cn, Handle());
+    return (ik != nullptr && ik->is_initialized()) ? ik : nullptr;
+  }
+  // The classes and offsets, found once both classes are initialized (the
+  // first ARA sees to that). Every thread computes the same values, so a
+  // race only repeats the work.
+  struct VhOffsets {
+    InstanceKlass* array; InstanceKlass* ad;
+    int exact, atype, form, mt_table, ad_type, ad_erased, ad_ret;
+  };
+  static const VhOffsets* vh_offsets() {
+    static VhOffsets c;
+    static volatile int ready = 0;
+    if (Atomic::load_acquire(&ready) != 0) return &c;
+    VhOffsets v;
+    v.array = initialized_boot_klass("java/lang/invoke/VarHandleReferences$Array");
+    v.ad = initialized_boot_klass("java/lang/invoke/VarHandle$AccessDescriptor");
+    InstanceKlass* vh = initialized_boot_klass("java/lang/invoke/VarHandle");
+    InstanceKlass* vf = initialized_boot_klass("java/lang/invoke/VarForm");
+    if (v.array == nullptr || v.ad == nullptr || vh == nullptr || vf == nullptr) return nullptr;
+    v.exact = field_offset_named(vh, "exact", "Z", false);
+    v.atype = field_offset_named(v.array, "arrayType", "Ljava/lang/Class;", false);
+    v.form = field_offset_named(v.array, "FORM", "Ljava/lang/invoke/VarForm;", true);
+    v.mt_table = field_offset_named(vf, "methodType_table", "[Ljava/lang/invoke/MethodType;", false);
+    v.ad_type = field_offset_named(v.ad, "type", "I", false);
+    v.ad_erased = field_offset_named(v.ad, "symbolicMethodTypeErased", "Ljava/lang/invoke/MethodType;", false);
+    v.ad_ret = field_offset_named(v.ad, "returnType", "Ljava/lang/Class;", false);
+    if (v.exact <= 0 || v.atype <= 0 || v.form <= 0 || v.mt_table <= 0
+        || v.ad_type <= 0 || v.ad_erased <= 0 || v.ad_ret <= 0) return nullptr;
+    c = v;
+    Atomic::release_store(&ready, 1);
+    return &c;
+  }
+  // Whether the invokehandle at bci reads an element through a VarHandle in
+  // a way emit_vh_array can do, and what it needs for it. The inliner's scan
+  // asks the same, so a callee it approves never bails here.
+  bool vh_array_shape(Method* m, address code, int bci, VhArrayShape* s) {
+    if (!indy_fast(1) || (Bytecodes::Code)(unsigned char)code[bci] != Bytecodes::_invokehandle) return false;
+    ConstantPool* cp = m->constants();
+    if (cp->cache() == nullptr) return false;
+    int which = u2_at(code, bci + 1);
+    ResolvedMethodEntry* me = cp->resolved_method_entry_at(which);
+    if (me == nullptr || !me->is_resolved(Bytecodes::_invokehandle) || !me->has_appendix()) return false;
+    if (!cp->klass_ref_at_noresolve(which, Bytecodes::_invokehandle)->equals("java/lang/invoke/VarHandle")) return false;
+    Symbol* name = cp->name_ref_at(which, Bytecodes::_invokehandle);
+    if (name->equals("get")) s->atomic = false;
+    else if (name->equals("getVolatile") || name->equals("getAcquire") || name->equals("getOpaque")) s->atomic = true;
+    else return false;
+    // (array, int) -> a reference
+    int np = 0;
+    BasicType pt[2];
+    SignatureStream ss(cp->signature_ref_at(which, Bytecodes::_invokehandle));
+    for (; !ss.at_return_type(); ss.next()) { if (np == 2) return false; pt[np++] = ss.type(); }
+    if (np != 2 || !is_reference_type(pt[0]) || pt[1] != T_INT || !is_reference_type(ss.type())) return false;
+    const VhOffsets* o = vh_offsets();
+    if (o == nullptr) return false;
+    oop ad = cp->resolved_reference_at(me->resolved_references_index());
+    if (ad == nullptr || ad->klass() != o->ad) return false;
+    oop form = o->array->java_mirror()->obj_field(o->form);
+    if (form == nullptr) return false;
+    objArrayOop table = objArrayOop(form->obj_field(o->mt_table));
+    int type = ad->int_field(o->ad_type);
+    if (table == nullptr || type < 0 || type >= table->length()) return false;
+    oop mt = table->obj_at(type);
+    if (mt == nullptr || mt != ad->obj_field(o->ad_erased)) return false;
+    oop ret = ad->obj_field(o->ad_ret);
+    Klass* rk = ret != nullptr ? java_lang_Class::as_Klass(ret) : nullptr;
+    if (rk == nullptr) return false;
+    s->cast = (rk == vmClasses::Object_klass()) ? nullptr : rk;
+    s->vh = o->array;
+    s->exact_off = o->exact;
+    s->atype_off = o->atype;
+    return true;
+  }
+  // [vh, array, index] -> [element]
+  bool emit_vh_array(Method* m, address code, int bci, int& depth, bool allow_branches) {
+    VhArrayShape s;
+    if (!vh_array_shape(m, code, bci, &s)) return false;
+    const int D = depth;
+    if (D < 3 || slot_kind(D - 3) != K_I32 || slot_kind(D - 2) != K_I32 || slot_kind(D - 1) != K_I32
+        || _next_local + 1 > LOCALS_SOFT_LIMIT) return false;
+    const bool diamond = allow_branches && !_frameless && m == _method && _inline_depth == 0
+                         && !disabled(NO_CALLS);
+    const int vh = stack_local(D - 3), arr = stack_local(D - 2), idx = stack_local(D - 1);
+    const int el = alloc_locals(1);
+    int slow = -1;
+    if (diamond) {
+      emit(WOP_BLOCK); emit(0x40);                   // $done
+      emit(WOP_BLOCK); emit(0x40);                   // $slow
+      slow = _nest;
+    }
+    // A nonzero on the stack: the call (diamond), or back to the interpreter.
+    auto fail_if = [&]() {
+      if (diamond) { emit(WOP_BR_IF); _code_buf.uleb((unsigned)(_nest - slow)); return; }
+      emit(WOP_IF); emit(0x40); emit_bail(bci, D, true); emit(WOP_END);
+    };
+    local_get(vh); emit(WOP_I32_EQZ); fail_if();
+    emit_klass_of(vh); emit_const((int)(intptr_t)s.vh); emit(WOP_I32_NE); fail_if();
+    local_get(vh); mem_op(WOP_I32_LOAD8_U, 0, s.exact_off); fail_if();
+    local_get(arr); emit(WOP_I32_EQZ); fail_if();
+    local_get(vh); mem_op(WOP_I32_LOAD, 2, s.atype_off);           // arrayType's Klass*
+    mem_op(WOP_I32_LOAD, 2, java_lang_Class::klass_offset());
+    emit_klass_of(arr); emit(WOP_I32_NE); fail_if();
+    local_get(idx);
+    local_get(arr); mem_op(WOP_I32_LOAD, 2, arrayOopDesc::length_offset_in_bytes());
+    emit(WOP_I32_GE_U); fail_if();
+    emit_element_addr(arr, idx, T_OBJECT);
+    mem_op(s.atomic ? (ATOMIC | 0x10) : WOP_I32_LOAD, 2, arrayOopDesc::base_offset_in_bytes(T_OBJECT));
+    local_set(el);
+    if (s.cast != nullptr) {                         // null passes a cast
+      local_get(el);
+      emit(WOP_IF); emit(0x40);
+        emit_is_subtype_full(el, s.cast); emit(WOP_I32_EQZ); fail_if();
+      emit(WOP_END);
+    }
+    if (ZeroWasmJITVerbose) { ResourceMark rm;
+      tty->print_cr("[zwc]   VarHandle array %s @%d in %s%s", s.atomic ? "atomic read" : "read", bci,
+                    m->name_and_sig_as_C_string(), diamond ? "" : ", guarded"); }
+    if (!diamond) {
+      local_get(el); set_i32(D - 3);
+      depth = D - 2;
+      return true;
+    }
+    // The result where the call's reload leaves it; the slot kinds stay
+    // what the call sequence below spills with.
+    local_get(el); local_set(vh);
+    emit(WOP_BR); _code_buf.uleb(1);                 // to $done
+    emit(WOP_END);                                   // $slow
+    int d = D;
+    if (!emit_indy_call(m, code, bci, d)) {
+      emit_bail(bci, D, true);
+      d = D - 2;
+      set_slot(D - 3, K_I32);
+    }
+    emit(WOP_END);                                   // $done
+    depth = d;
+    return true;
+  }
