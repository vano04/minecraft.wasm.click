+// ---------------------------------------------------------------------------
+// Native calls
+//
+// Zero calls every JNI native through libffi, and libffi's wasm port does the
+// call in JavaScript: it reads the argument types and values out of memory,
+// builds a JS array, calls the target's JS wrapper and writes the result back.
+// Each of those memory reads goes through Emscripten's growable-heap check,
+// which with threads is a WebAssembly.Memory.buffer read -- about twenty per
+// call. Booting the game makes millions of native calls (Unsafe accessors,
+// arraycopy, clone), and that JS was a fifth of all the time spent.
+//
+// So each distinct signature gets a trampoline, generated once per thread in
+// wasm: load each argument from avalue[i] with its own width, call_indirect
+// the target, store the result the way ffi_call_js does (integral results
+// narrower than 64 bits widened to 8 bytes, pointers 4). No JavaScript runs.
+//
+// libffi's JS call is lenient where call_indirect is not: a native whose C
+// definition does not match its Java signature exactly still runs through JS,
+// but traps here. So the first call of each target goes through a JS probe
+// that checks the arity and catches a signature trap; a target that fails
+// keeps using libffi.
+// ---------------------------------------------------------------------------
+static int ffi_wasm_type(ffi_type* t) {
+  switch (t->type) {
+    case FFI_TYPE_INT: case FFI_TYPE_SINT32: case FFI_TYPE_UINT32:
+    case FFI_TYPE_SINT8: case FFI_TYPE_UINT8: case FFI_TYPE_SINT16: case FFI_TYPE_UINT16:
+    case FFI_TYPE_POINTER:
+      return 0x7f;
+    case FFI_TYPE_SINT64: case FFI_TYPE_UINT64: return 0x7e;
+    case FFI_TYPE_FLOAT:  return 0x7d;
+    case FFI_TYPE_DOUBLE: return 0x7c;
+    default: return 0;      // void, structs, long double: not handled here
+  }
+}
+
+// The trampoline module, (fn, avalue, rvalue) -> (), or false if the
+// signature has a type this does not handle.
+static bool build_ffi_trampoline(ffi_cif* cif, WasmBuf& module) {
+  int nargs = (int)cif->nargs;
+  if (nargs > 32 || (int)cif->nfixedargs != nargs) return false;   // no varargs
+  for (int i = 0; i < nargs; i++) {
+    if (ffi_wasm_type(cif->arg_types[i]) == 0) return false;
+  }
+  ffi_type* rt = cif->rtype;
+  bool is_void = rt->type == FFI_TYPE_VOID;
+  int rwt = is_void ? 0 : ffi_wasm_type(rt);
+  if (!is_void && rwt == 0) return false;
+
+  module.u8(0x00); module.u8(0x61); module.u8(0x73); module.u8(0x6d);
+  module.u8(0x01); module.u8(0x00); module.u8(0x00); module.u8(0x00);
+
+  WasmBuf types;
+  types.uleb(2);
+  types.u8(0x60); types.uleb(3); types.u8(0x7f); types.u8(0x7f); types.u8(0x7f); types.uleb(0);
+  types.u8(0x60); types.uleb((unsigned)nargs);
+  for (int i = 0; i < nargs; i++) types.u8(ffi_wasm_type(cif->arg_types[i]));
+  if (is_void) types.uleb(0); else { types.uleb(1); types.u8(rwt); }
+  module.section(1, types);
+
+  WasmBuf imp;
+  imp.uleb(2);
+  imp.uleb(3); imp.bytes("env", 3);
+  imp.uleb(6); imp.bytes("memory", 6);
+  imp.u8(0x02); imp.u8(0x03); imp.uleb(0); imp.uleb(65536);
+  imp.uleb(3); imp.bytes("env", 3);
+  imp.uleb(25); imp.bytes("__indirect_function_table", 25);
+  imp.u8(0x01); imp.u8(0x70); imp.u8(0x00); imp.uleb(0);
+  module.section(2, imp);
+
+  WasmBuf fn; fn.uleb(1); fn.uleb(0);
+  module.section(3, fn);
+  WasmBuf ex; ex.uleb(1); ex.uleb(1); ex.bytes("f", 1); ex.u8(0x00); ex.uleb(0);
+  module.section(7, ex);
+
+  WasmBuf body;
+  if (is_void) body.uleb(0); else { body.uleb(1); body.uleb(1); body.u8(rwt); }   // local 3: result
+  for (int i = 0; i < nargs; i++) {
+    body.u8(WOP_LOCAL_GET); body.uleb(1);                        // avalue
+    body.u8(WOP_I32_LOAD); body.uleb(0); body.uleb((unsigned)(4 * i));
+    int op;
+    switch (cif->arg_types[i]->type) {
+      case FFI_TYPE_SINT8:  op = 0x2c; break;    // i32.load8_s
+      case FFI_TYPE_UINT8:  op = 0x2d; break;    // i32.load8_u
+      case FFI_TYPE_SINT16: op = 0x2e; break;    // i32.load16_s
+      case FFI_TYPE_UINT16: op = 0x2f; break;    // i32.load16_u
+      case FFI_TYPE_SINT64: case FFI_TYPE_UINT64: op = 0x29; break;
+      case FFI_TYPE_FLOAT:  op = 0x2a; break;
+      case FFI_TYPE_DOUBLE: op = 0x2b; break;
+      default:              op = 0x28; break;    // i32.load
+    }
+    // Alignment hint 0: the caller's buffers carry only C's alignment, and a
+    // 64-bit value may sit at a 4-byte boundary.
+    body.u8(op); body.uleb(0); body.uleb(0);
+  }
+  body.u8(WOP_LOCAL_GET); body.uleb(0);                           // fn
+  body.u8(0x11); body.uleb(1); body.uleb(0);                      // call_indirect type 1
+  if (!is_void) {
+    body.u8(WOP_LOCAL_SET); body.uleb(3);
+    body.u8(WOP_BLOCK); body.u8(0x40);
+    body.u8(WOP_LOCAL_GET); body.uleb(2);
+    body.u8(0x45);                                                // i32.eqz
+    body.u8(WOP_BR_IF); body.uleb(0);                             // NULL rvalue: discarded
+    body.u8(WOP_LOCAL_GET); body.uleb(2);
+    body.u8(WOP_LOCAL_GET); body.uleb(3);
+    switch (rt->type) {
+      case FFI_TYPE_INT: case FFI_TYPE_SINT32:
+        body.u8(0xac); body.u8(0x37); break;                      // i64.extend_i32_s, i64.store
+      case FFI_TYPE_UINT32:
+        body.u8(0xad); body.u8(0x37); break;                      // i64.extend_i32_u
+      case FFI_TYPE_SINT8:
+        body.u8(0xc0); body.u8(0xac); body.u8(0x37); break;       // i32.extend8_s
+      case FFI_TYPE_SINT16:
+        body.u8(0xc1); body.u8(0xac); body.u8(0x37); break;       // i32.extend16_s
+      case FFI_TYPE_UINT8:
+        body.u8(WOP_I32_CONST); body.sleb(0xff); body.u8(0x71);   // i32.and
+        body.u8(0xad); body.u8(0x37); break;
+      case FFI_TYPE_UINT16:
+        body.u8(WOP_I32_CONST); body.sleb(0xffff); body.u8(0x71);
+        body.u8(0xad); body.u8(0x37); break;
+      case FFI_TYPE_SINT64: case FFI_TYPE_UINT64: body.u8(0x37); break;
+      case FFI_TYPE_FLOAT:  body.u8(0x38); break;
+      case FFI_TYPE_DOUBLE: body.u8(0x39); break;
+      default:              body.u8(0x36); break;                 // pointer: i32.store
+    }
+    body.uleb(0); body.uleb(0);                                   // memarg: align 0, offset 0
+    body.u8(WOP_END);
+  }
+  body.u8(WOP_END);
+  WasmBuf code;
+  code.uleb(1);
+  code.uleb((unsigned)body.length());
+  code.append(body);
+  module.section(10, code);
+  return true;
+}
+
+// The first call of `fn` through the trampoline, from JS so that a mismatch
+// can be caught. 1: it ran and fn is good; 0: nothing ran, use libffi.
+EM_JS(int, zwc_ffi_probe, (int tramp, int fn, int nargs, int avalue, int rvalue), {
+  const f = wasmTable.get(fn);
+  if (!f || f.length !== nargs) return 0;
+  try {
+    wasmTable.get(tramp)(fn, avalue, rvalue);
+    return 1;
+  } catch (e) {
+    if (e instanceof WebAssembly.RuntimeError && /signature/.test(String(e.message))) return 0;
+    throw e;
+  }
+});
+
+typedef void (*zwc_ffi_fn)(int fn, int avalue, int rvalue);
+struct FfiTramp { ffi_cif* cif; zwc_ffi_fn tramp; };   // tramp null: unsupported
+struct FfiTarget { void* fn; int state; };             // 1 good, -1 use libffi
+static const int FFI_TRAMPS = 1024, FFI_TARGETS = 8192;
+static THREAD_LOCAL FfiTramp* _ffi_tramps = nullptr;
+static THREAD_LOCAL FfiTarget* _ffi_targets = nullptr;
+
+bool ZeroWasmCompiler::native_call(void* cif_v, void* fn, void* result, void** args) {
+  if (disabled(NO_FFI)) return false;
+  ffi_cif* cif = (ffi_cif*)cif_v;
+  if (_ffi_tramps == nullptr) {
+    _ffi_tramps = (FfiTramp*)::calloc(FFI_TRAMPS, sizeof(FfiTramp));
+    _ffi_targets = (FfiTarget*)::calloc(FFI_TARGETS, sizeof(FfiTarget));
+    if (_ffi_tramps == nullptr || _ffi_targets == nullptr) return false;
+  }
+  // The signature handler's cif lives as long as the VM, so its address is
+  // the key. Open addressing, never deleted.
+  unsigned h = ((unsigned)((uintptr_t)cif >> 3) * 2654435761u) >> 22;
+  FfiTramp* t = nullptr;
+  for (int probe = 0; probe < FFI_TRAMPS; probe++) {
+    FfiTramp* c = &_ffi_tramps[(h + probe) & (FFI_TRAMPS - 1)];
+    if (c->cif == cif) { t = c; break; }
+    if (c->cif == nullptr) {
+      c->cif = cif;
+      WasmBuf module;
+      int slot = build_ffi_trampoline(cif, module) ? take_slot() : -1;
+      if (slot >= 0 && zwc_install(module.data(), module.length(), (int)(intptr_t)zwc_slots[slot], 0, 0, 0, 0, nullptr, 0)) {
+        // Never recycled: slot sweeps only reclaim compiled methods.
+        c->tramp = (zwc_ffi_fn)zwc_slots[slot];
+        if (ZeroWasmJITVerbose) {
+          char sig[40];
+          int n = 0;
+          for (int i = 0; i < (int)cif->nargs && n < 32; i++) sig[n++] = (char)('0' + cif->arg_types[i]->type);
+          sig[n] = '\0';
+          tty->print_cr("[zwc] native trampoline (%s)%d", sig, (int)cif->rtype->type);
+        }
+      } else if (slot >= 0) {
+        _free_slots[_nfree++] = slot;
+      }
+      t = c;
+      break;
+    }
+  }
+  if (t == nullptr || t->tramp == nullptr) return false;
+
+  unsigned g = ((unsigned)((uintptr_t)fn >> 2) * 2654435761u) >> 19;
+  for (int probe = 0; probe < 16; probe++) {
+    FfiTarget* c = &_ffi_targets[(g + probe) & (FFI_TARGETS - 1)];
+    if (c->fn == fn) {
+      if (c->state < 0) return false;
+      t->tramp((int)(intptr_t)fn, (int)(intptr_t)args, (int)(intptr_t)result);
+      return true;
+    }
+    if (c->fn == nullptr) {
+      c->fn = fn;
+      int ok = zwc_ffi_probe((int)(intptr_t)t->tramp, (int)(intptr_t)fn, (int)cif->nargs,
+                             (int)(intptr_t)args, (int)(intptr_t)result);
+      c->state = ok ? 1 : -1;
+      if (!ok && ZeroWasmJITVerbose) {
+        tty->print_cr("[zwc] native %p keeps libffi: its wasm signature does not match", fn);
+      }
+      return ok != 0;
+    }
+  }
+  return false;   // table crowded here: libffi, uncached
+}
+
 #endif // __EMSCRIPTEN__
