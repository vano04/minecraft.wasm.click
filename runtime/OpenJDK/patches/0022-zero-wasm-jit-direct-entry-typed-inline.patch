+// An invoke's argument slots (receiver included) and result slots: from its
+// resolved constant-pool entry, or from the signature while it is unresolved.
+static bool invoke_slots(Method* m, address code, int bci, int* params, int* result) {
+  Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+  if (c != Bytecodes::_invokestatic && c != Bytecodes::_invokespecial
+      && c != Bytecodes::_invokevirtual && c != Bytecodes::_invokeinterface
+      && c != Bytecodes::_fast_invokevfinal) return false;
+  if (m->constants()->cache() == nullptr) return false;
+  Bytecodes::Code as = (c == Bytecodes::_fast_invokevfinal) ? Bytecodes::_invokevirtual : c;
+  int idx = (int)Bytes::get_native_u2((address)(code + bci + 1));
+  ResolvedMethodEntry* e = m->constants()->resolved_method_entry_at(idx);
+  if (e == nullptr) return false;
+  if (!e->is_resolved(as)) {
+    Symbol* sig = m->constants()->signature_ref_at(idx, as);
+    ArgumentSizeComputer args(sig);
+    ResultTypeFinder rt(sig);
+    *params = args.size() + (as == Bytecodes::_invokestatic ? 0 : 1);
+    *result = type2size[rt.type()];
+    return true;
+  }
+  *params = e->number_of_parameters();
+  *result = type2size[as_BasicType((TosState)e->tos_state())];
+  return true;
+}
+
+// An invoke whose constant-pool entry nobody has resolved yet.
+static bool invoke_unresolved(Method* m, int bci) {
+  address code = m->code_base();
+  Bytecodes::Code c = (Bytecodes::Code)(unsigned char)code[bci];
+  if (c != Bytecodes::_invokestatic && c != Bytecodes::_invokespecial
+      && c != Bytecodes::_invokevirtual && c != Bytecodes::_invokeinterface) return false;
+  if (m->constants()->cache() == nullptr) return false;
+  ResolvedMethodEntry* e = m->constants()->resolved_method_entry_at(
+      (int)Bytes::get_native_u2((address)(code + bci + 1)));
+  return e != nullptr && !zwc_entry_resolved(e, c);
+}
+
+// Slots popped and pushed by an instruction invoke_on_this walks over.
+static bool stack_effect(Method* m, address code, int bci, Bytecodes::Code c,
+                         int* pops, int* pushes) {
+  switch (c) {
+    case Bytecodes::_invokestatic: case Bytecodes::_invokespecial:
+    case Bytecodes::_invokevirtual: case Bytecodes::_invokeinterface:
+    case Bytecodes::_fast_invokevfinal:
+      return invoke_slots(m, code, bci, pops, pushes);
+    case Bytecodes::_fast_iputfield: case Bytecodes::_fast_bputfield:
+    case Bytecodes::_fast_zputfield: case Bytecodes::_fast_sputfield:
+    case Bytecodes::_fast_cputfield: case Bytecodes::_fast_fputfield:
+    case Bytecodes::_fast_aputfield:
+      *pops = 2; *pushes = 0; return true;
+    case Bytecodes::_fast_lputfield: case Bytecodes::_fast_dputfield:
+      *pops = 3; *pushes = 0; return true;
+    case Bytecodes::_putfield: case Bytecodes::_nofast_putfield:
+    case Bytecodes::_putstatic: {
+      int n = field_slots(m, code, bci);
+      if (n == 0) return false;
+      *pops = n + (c == Bytecodes::_putstatic ? 0 : 1); *pushes = 0; return true;
+    }
+    case Bytecodes::_new: *pops = 0; *pushes = 1; return true;
+    case Bytecodes::_newarray: case Bytecodes::_anewarray: *pops = 1; *pushes = 1; return true;
+    case Bytecodes::_athrow: case Bytecodes::_freturn:
+    case Bytecodes::_monitorenter: case Bytecodes::_monitorexit:
+      *pops = 1; *pushes = 0; return true;
+    case Bytecodes::_lreturn: case Bytecodes::_dreturn: *pops = 2; *pushes = 0; return true;
+    case Bytecodes::_iastore: case Bytecodes::_fastore: case Bytecodes::_aastore:
+    case Bytecodes::_bastore: case Bytecodes::_castore: case Bytecodes::_sastore:
+      *pops = 3; *pushes = 0; return true;
+    case Bytecodes::_lastore: case Bytecodes::_dastore: *pops = 4; *pushes = 0; return true;
+    default: {
+      int p = simple_pops(c), d;
+      if (p < 0 || !stack_delta(c, m, code, bci, &d) || p + d < 0) return false;
+      *pops = p; *pushes = p + d;
+      return true;
+    }
+  }
+}
