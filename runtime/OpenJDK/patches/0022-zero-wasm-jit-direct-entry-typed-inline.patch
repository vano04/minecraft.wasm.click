+    if (!unsafe_shape(t, &u)) return false;
+    if (!u.get && (_frameless || _local_base >= 0)) return false;
+    if (u.oop && (!_can_store_oop || disabled(NO_OOPSTORE) || _next_local + 1 > LOCALS_SOFT_LIMIT)) return false;
+    int vs = u.get ? 0 : (is_wide(u.kind) ? 2 : 1);
+    int base = depth - 4 - vs;                        // this, o, offset (2), [value]
+    if (base < 0 || slot_kind(base) != K_I32 || slot_kind(base + 1) != K_I32
+        || slot_kind(base + 2) != K_I64) return false;
+    if (!u.get && slot_kind(base + 4) != u.kind) return false;
+    bool fbits = u.kind == K_F32 && u.op >= ATOMIC;   // volatile float, as i32 bits
+    if (u.unaligned && _next_local + 2 > LOCALS_SOFT_LIMIT) return false;
+    guard_nonnull(stack_local(base), bci, depth);     // the interpreter throws the NPE
+    if (u.kind == K_I64 && u.op >= ATOMIC && _next_local + 1 > LOCALS_SOFT_LIMIT) return false;
+    local_get(stack_local(base + 1));
+    get_wide(K_I64, base + 2);
+    emit(0xa7);                                       // i32.wrap_i64
+    emit(WOP_I32_ADD);
+    if (u.unaligned) { emit_unsafe_unaligned(u, base, depth); return true; }
+    if (u.kind == K_I64 && u.op >= ATOMIC) {
