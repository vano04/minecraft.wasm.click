+            || c == Bytecodes::_multianewarray || c == Bytecodes::_monitorenter
+            || c == Bytecodes::_monitorexit || c == Bytecodes::_putstatic) leaf = false;
+        else stores = true;
+      }
+      if ((c >= Bytecodes::_invokevirtual && c <= Bytecodes::_invokedynamic)
+          || c == Bytecodes::_fast_invokevfinal || c == Bytecodes::_invokehandle) leaf = false;
+      int size = Bytecodes::length_at(method, code + bci);
+      if (size <= 0) { leaf = false; break; }
+      bci += size;
+    }
+    e->store_leaf = leaf && stores;
+  }
+  _slot_owner[slot] = e;
+  e->born = _takes_total;
+  e->fn = zwc_slots[slot];
+  e->max_locals = method->max_locals();
+  e->extra_locals = method->max_locals() - method->size_of_parameters();
+  e->max_stack = method->max_stack();
+  e->result_type = method->result_type();
+  e->result_slots = type2size[e->result_type];
+  e->is_initializer = method->is_object_initializer();
+  e->cpc = method->constants()->cache();
+  e->mirror_slot = method->method_holder()->java_mirror_handle().ptr_raw();
+  e->code_base = method->code_base();
