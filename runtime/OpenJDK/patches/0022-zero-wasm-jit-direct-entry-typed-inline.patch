+static bool still_valid(ZwcBuilt* b) {
+  if (b->e->method != b->method || b->e->index != PENDING) return false;
+  if (!deps_valid(b->piece, b->dep, b->dep_gen)) return false;
+  if (b->fl_built && !deps_valid(b->fpiece, b->fdep, b->fdep_gen)) {
+    _free_slots[_nfree++] = b->fs;       // just the frameless body goes
+    b->fs = -1;
+    b->fl_built = false;
+    b->fl_why = "callee changed";
+  }
+  return true;
+}
