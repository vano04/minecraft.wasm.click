+// Compiles the method into this cache entry. Returns false if it was refused,
+// having marked the entry so it is never attempted again on this thread.
+static bool compile_into(Method* method, CacheEntry* e) {
+  if (!ZeroWasmJITPrintCompileTime) return compile_into_timed(method, e);
+  jlong t0 = os::javaTimeNanos();
+  _ct_last_install = 0;
+  bool ok = compile_into_timed(method, e);
+  note_compile_time(method, os::javaTimeNanos() - t0);
+  return ok;
+}
