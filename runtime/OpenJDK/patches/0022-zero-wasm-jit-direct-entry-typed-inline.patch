+      if (is_wide(u.kind)) get_wide(u.kind, base + 4); else get_val(u.kind, base + 4);
+      if (fbits) emit(0xbc);                          // i32.reinterpret_f32
+      if (u.boolean) { emit_const(1); emit(WOP_I32_AND); }  // ... and Unsafe_PutBoolean
+      mem_op(u.op, u.align, 0);
