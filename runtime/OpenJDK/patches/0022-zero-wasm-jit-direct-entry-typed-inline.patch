+// Whether every direct callee a waiting body imports still has the code it
+// was built against, at the same slot.
+static bool deps_valid(const ZwcPiece& p, CacheEntry* const* dep, const unsigned* gen) {
+  for (int k = 0; k < p.ndirect; k++) {
+    CacheEntry* ce = dep[k];
+    if (ce == nullptr || ce->index != 1 || ce->gen != gen[k]
+        || (int)(intptr_t)ce->frameless != p.direct[k]) return false;
   }
