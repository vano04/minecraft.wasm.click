+    for (int piece = u.size; piece > 1; piece >>= 1, arms++) {
+      local_get(a); emit_const(piece - 1); emit(WOP_I32_AND); emit(WOP_I32_EQZ);
+      emit(WOP_IF); emit(!u.get ? 0x40 : u.size == 8 ? WT_I64 : WT_I32);
