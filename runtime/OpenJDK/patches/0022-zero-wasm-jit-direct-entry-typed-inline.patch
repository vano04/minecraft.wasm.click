+      emit(0x22); local_ref(a8);                      // local.tee
+      emit_const(7); emit(WOP_I32_AND);
+      emit(WOP_IF); emit(0x40);
+        emit_bail(bci, depth, true);
+      emit(WOP_END);
+      local_get(a8);
+    }
+    if (u.get) {
+      mem_op(u.op, u.align, 0);
