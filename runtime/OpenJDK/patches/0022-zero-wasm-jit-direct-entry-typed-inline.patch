+// -XX:+ZeroWasmJITPrintCompileTime: compile time per second on this thread.
+static THREAD_LOCAL jlong _ct_window_start = 0;
+static THREAD_LOCAL jlong _ct_total = 0;
+static THREAD_LOCAL jlong _ct_max = 0;
+static THREAD_LOCAL int _ct_count = 0;
+static THREAD_LOCAL Method* _ct_max_method = nullptr;
+static THREAD_LOCAL jlong _ct_install = 0;       // of which zwc_install, this window
+static THREAD_LOCAL jlong _ct_max_install = 0;   // the slowest compile's install
+static THREAD_LOCAL jlong _ct_last_install = 0;  // set by compile_into_timed
+static THREAD_LOCAL int _ct_units = 0;           // modules installed, this window
+static THREAD_LOCAL int _ct_unit_bodies = 0;     // ... holding this many bodies
+static NOINLINE void note_compile_time(Method* m, jlong ns) {
+  jlong now = os::javaTimeNanos();
+  if (_ct_window_start == 0) _ct_window_start = now;
+  _ct_total += ns; _ct_count++;
+  _ct_install += _ct_last_install;
+  if (ns > _ct_max) { _ct_max = ns; _ct_max_method = m; _ct_max_install = _ct_last_install; }
+  if (now - _ct_window_start < 1000000000LL) return;
+  if (_ct_total > 10000000LL) {
+    ResourceMark rm;
+    // The thread: only the client thread's compiles are frames the player
+    // sees. The reasons: whether the time is new code or recompiles
+    // (dependent cascades, bails, profiled and polymorphic-cache recompiles).
+    Thread* t = Thread::current();
+    tty->print_cr("[zwc] compile time %.1f ms (install %.1f) in the last %.1f s: %d compiles, %d units (%d bodies), slowest %.1f ms (install %.1f) %s"
+                  " | why: new %u dependent %u sweep %u bails %u profile %u | thread %s",
+                  _ct_total / 1e6, _ct_install / 1e6, (now - _ct_window_start) / 1e9, _ct_count,
+                  _ct_units, _ct_unit_bodies,
+                  _ct_max / 1e6, _ct_max_install / 1e6,
+                  _ct_max_method != nullptr ? _ct_max_method->name_and_sig_as_C_string() : "?",
+                  _ct_rr[RR_NEW], _ct_rr[RR_DEPENDENT], _ct_rr[RR_SWEEP], _ct_rr[RR_BAILS],
+                  _ct_rr[RR_PROFILE], t != nullptr && t->is_Java_thread()
+                      ? JavaThread::cast(t)->name() : "?");
+  }
+  for (int i = 0; i < RR_N; i++) _ct_rr[i] = 0;
+  _ct_window_start = now; _ct_total = 0; _ct_max = 0; _ct_count = 0; _ct_max_method = nullptr;
+  _ct_install = 0; _ct_max_install = 0; _ct_units = 0; _ct_unit_bodies = 0;
+}
