+  if (ZeroWasmJITVerbose || (ZeroWasmJITPrintRefused && !installed)) {
+    ResourceMark rm;
+    tty->print_cr("[zwc] %s %s (%d bytes bytecode): %s",
+                  installed ? "compiled" : "refused",
+                  method->name_and_sig_as_C_string(), method->code_size(),
+                  installed ? "ok" : "engine rejected module");
+  }
+  if (!installed) {
+    _free_slots[_nfree++] = slot;
+    ::free(sites);
+    ::free(b->osr);
+    _refused++;
+    e->index = -1;
+    return;
+  }
