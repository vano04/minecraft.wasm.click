+// The entry, once its bodies are in (or were refused).
+static void finish(ZwcBuilt* b, bool installed, bool fl_installed) {
+  CacheEntry* e = b->e;
+  Method* method = b->method;
+  ZwcCallSite** sites = b->sites;
+  ZwcCallSite** profile = b->profile;
+  int slot = b->slot, fs = b->fs;
