+  // ---- enum switches --------------------------------------------------------
+  // A switch over an enum with a `case null` or a pattern label is an
+  // invokedynamic SwitchBootstraps.enumSwitch: (E, restart)I, with the
+  // labels as static arguments. When every label is a constant's name (a
+  // String; a pattern is a Class), enumSwitch links the site to
+  // mappedEnumSwitch with the labels bound, which answers -1 for null, runs
+  // a generated typeSwitch when restart is not 0 (javac never passes one
+  // here: a guard needs a pattern), and otherwise returns
+  // constantsMap[v.ordinal()]: for each position of the enum's
+  // getEnumConstantsShared(), the first label that names that constant, or
+  // the number of labels. linkToTargetMethod -> the bound form -> the direct
+  // form -> linkToStatic -> mappedEnumSwitch is five framed calls for one
+  // array load: 104 ns against 14 for a tableswitch (tests/IndyBench), and
+  // about 9% of the meshing workers' profile. The labels are fixed by the
+  // class file and the constants by Class.enumConstants, which is cached
+  // once and read by every later call, so the map is built here the way
+  // mappedEnumSwitch builds it, into C memory kept for good (like
+  // static_site's sites), and the code is
+  //   v == null            -1
+  //   restart != 0         the call
+  //   ordinal >=u length   the call (mappedEnumSwitch throws there)
+  //   else                 map[ordinal]
+  // At method level the call is the linked call (a diamond like
+  // emit_vh_array's); in a splice or a frameless body it is a guard, and
+  // nothing has happened yet. No call and no safepoint, so the inliner and
+  // frameless bodies take it. ZeroWasmJITIndyFast bit 4.
+  static const int MAX_ENUM_CONSTANTS = 4096;
+  struct EnumSwitchShape {
+    int n;              // the enum's constants: the map's length
+    int ordinal_off;    // Enum.ordinal
+  };
+  struct EnumOffsets { int constants, name, ordinal; };
+  static const EnumOffsets* enum_offsets() {
+    static EnumOffsets c;
+    static volatile int ready = 0;
+    if (Atomic::load_acquire(&ready) != 0) return &c;
+    EnumOffsets v;
+    v.constants = field_offset_named(vmClasses::Class_klass(), "enumConstants", "[Ljava/lang/Object;", false);
+    v.name = field_offset_named(vmClasses::Enum_klass(), "name", "Ljava/lang/String;", false);
+    v.ordinal = field_offset_named(vmClasses::Enum_klass(), "ordinal", "I", false);
+    if (v.constants <= 0 || v.name <= 0 || v.ordinal <= 0) return nullptr;
+    c = v;
+    Atomic::release_store(&ready, 1);
+    return &c;
+  }
+  // Whether the invokedynamic at bci is an enum switch emit_enum_switch can
+  // do. With `map`, which has room for `cap` entries, it is also filled. The
+  // inliner's scan asks the same, so a callee it approves never bails here
+  // for the shape.
+  bool enum_switch_shape(Method* m, address code, int bci, EnumSwitchShape* s, int* map = nullptr, int cap = 0) {
+    if (!indy_fast(4) || (Bytecodes::Code)(unsigned char)code[bci] != Bytecodes::_invokedynamic) return false;
+    ConstantPool* cp = m->constants();
+    if (cp->cache() == nullptr) return false;
+    ResolvedIndyEntry* ie = cp->resolved_indy_entry_at((int)Bytes::get_native_u4(code + bci + 1));
+    if (ie == nullptr || !ie->is_resolved() || !ie->has_appendix()) return false;
+    int cpi = ie->constant_pool_index();
+    if (!cp->tag_at(cpi).is_invoke_dynamic()) return false;
+    int bsm = cp->bootstrap_method_ref_index_at(cpi);
+    if (!cp->tag_at(bsm).is_method_handle()) return false;
+    if (!cp->klass_name_at(cp->method_handle_klass_index_at(bsm))->equals("java/lang/runtime/SwitchBootstraps")
+        || !cp->method_handle_name_ref_at(bsm)->equals("enumSwitch")) return false;
+    // (LE;I)I, and labels that are all names: a Class label (or none) is a
+    // typeSwitch.
+    Symbol* sig = cp->symbol_at(cp->signature_ref_index_at(cp->bootstrap_name_and_type_ref_index_at(cpi)));
+    const int len = sig->utf8_length();
+    if (len < 7 || sig->char_at(0) != '(' || sig->char_at(1) != 'L'
+        || ::memcmp(sig->bytes() + len - 4, ";I)I", 4) != 0) return false;
+    const int nl = cp->bootstrap_argument_count_at(cpi);
+    if (nl < 1) return false;
+    for (int j = 0; j < nl; j++) if (!cp->tag_at(cp->bootstrap_argument_index_at(cpi, j)).is_string()) return false;
+    const EnumOffsets* o = enum_offsets();
+    if (o == nullptr) return false;
+    Symbol* en = SymbolTable::probe((const char*)sig->bytes() + 2, len - 6);
+    if (en == nullptr) return false;
+    Thread* t = Thread::current();
+    HandleMark hm(t);
+    InstanceKlass* e = SystemDictionary::find_instance_klass(t, en, Handle(t, m->method_holder()->class_loader()));
+    if (e == nullptr || !e->is_initialized() || e->java_super() != vmClasses::Enum_klass()) return false;
+    // getEnumConstantsShared's array: until something has asked for it
+    // (mappedEnumSwitch's first map does) there is no map to copy.
+    objArrayOop k = objArrayOop(e->java_mirror()->obj_field_acquire(o->constants));
+    if (k == nullptr || k->length() > MAX_ENUM_CONSTANTS || (map != nullptr && k->length() != cap)) return false;
+    for (int i = 0; i < k->length(); i++) {
+      oop c = k->obj_at(i);
+      if (c == nullptr) return false;                // mappedEnumSwitch's NPE
+      if (map == nullptr) continue;
+      oop name = c->obj_field(o->name);
+      int at = nl;
+      for (int j = 0; j < nl && name != nullptr; j++) {
+        Symbol* l = cp->unresolved_string_at(cp->bootstrap_argument_index_at(cpi, j));
+        if (java_lang_String::equals(name, (const char*)l->bytes(), (size_t)l->utf8_length())) { at = j; break; }
+      }
+      map[i] = at;
+    }
+    s->n = k->length();
+    s->ordinal_off = o->ordinal;
+    return true;
+  }
+  // [v, restart] -> [the case's index]
+  bool emit_enum_switch(Method* m, address code, int bci, int& depth, bool allow_branches) {
+    EnumSwitchShape s;
+    if (!enum_switch_shape(m, code, bci, &s)) return false;
