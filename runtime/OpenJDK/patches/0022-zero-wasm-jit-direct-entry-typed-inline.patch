+  e->nosr = b->nosr;
+  _compiled++;
+  if (ZeroWasmJITPrintCompileTime) {
+    _ct_rr[e->why < RR_N ? e->why : 0]++;
+    if (!ZeroWasmJITPrintBails) e->why = RR_NEW;
+  }
+  if (ZeroWasmJITPrintBails) note_compile_reason(e);
