+// Assembles and installs pieces as one unit at the given slots (zwc_slots
+// indices). The four runtime helpers are this thread's.
+static bool install_unit(ZwcPiece** p, int n, const int* slot_index) {
+  WasmBuf module;
+  int* dslots = (int*)::malloc(sizeof(int) * (size_t)(n * ZwcPiece::MAX_DIRECT + 1));
+  int* slots = (int*)::malloc(sizeof(int) * (size_t)(n + 1));
+  int nd = 0;
+  assemble_unit(p, n, module, dslots, &nd);
+  for (int i = 0; i < n; i++) slots[i] = (int)(intptr_t)zwc_slots[slot_index[i]];
+  bool ok = !module.overflowed()
+      && zwc_install_unit(module.data(), module.length(), slots, n,
+                          (int)(intptr_t)&zwc_invoke, (int)(intptr_t)&zwc_subtype,
+                          (int)(intptr_t)&zwc_fl_call, (int)(intptr_t)&zwc_framed_bail,
+                          (int)(intptr_t)&zwc_frem, (int)(intptr_t)&zwc_drem,
+                          (int)(intptr_t)&zwc_clock, dslots, nd) == 1;
+  ::free(dslots);
+  ::free(slots);
+  return ok;
+}
