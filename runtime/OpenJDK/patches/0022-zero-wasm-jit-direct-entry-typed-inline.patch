+        ok = install_unit(p2, 1, s2);
+        fl_ok = ok && b->fl_built && install_unit(p2 + 1, 1, s2 + 1);
+        if (ZeroWasmJITPrintCompileTime) { _ct_units += 1 + (fl_ok ? 1 : 0); _ct_unit_bodies += 1 + (fl_ok ? 1 : 0); }
+      } else if (nl == 1) {
+        // Already tried as a unit: the ordinary body alone, if there was a pair.
+        ok = np > 1 && install_unit(p2, 1, s2);
+        if (ZeroWasmJITPrintCompileTime && ok) { _ct_units++; _ct_unit_bodies++; }
+      } else if (b->fl_built && install_unit(p2, 2, s2)) {
+        ok = fl_ok = true;
+        if (ZeroWasmJITPrintCompileTime) { _ct_units++; _ct_unit_bodies += 2; }
+      } else {
+        ok = install_unit(p2, 1, s2);
+        if (ZeroWasmJITPrintCompileTime && ok) { _ct_units++; _ct_unit_bodies++; }
+      }
+      finish(b, ok, fl_ok);
+    }
+  }
+  for (int i = 0; i < nl; i++) delete_built(live[i]);
+  ::free(ps);
+  ::free(si);
+  ::free(live);
+  if (ZeroWasmJITPrintCompileTime) _ct_last_install += os::javaTimeNanos() - t0;
+}
+
+// This thread's open unit (ZeroWasmJITUnitSize > 1).
+static THREAD_LOCAL ZwcBuilt** _pending = nullptr;
+static THREAD_LOCAL int _npending = 0;
+static THREAD_LOCAL jlong _pending_born = 0;       // when its first method was built
+static THREAD_LOCAL unsigned _pending_calls = 0;   // entries into its methods since
+
+static void flush_pending() {
+  int n = _npending;
+  _npending = 0;
+  _pending_calls = 0;
+  if (n > 0) install_built(_pending, n);
+}
+
+// An entry into a method waiting in the open unit: installs the unit once
+// it has waited long enough, by time or by calls it made run interpreted.
+// The clock is read on every such call -- a sampled read never fired for a
+// method called a few dozen times more, which then waited for good -- and
+// the calls budget bounds how many reads a unit can cost.
+static NOINLINE void pending_hit() {
+  if (++_pending_calls < (unsigned)ZeroWasmJITUnitCalls
+      && os::javaTimeNanos() - _pending_born < (jlong)ZeroWasmJITUnitDelay * 1000000LL) return;
+  jlong t0 = ZeroWasmJITPrintCompileTime ? os::javaTimeNanos() : 0;
+  if (ZeroWasmJITPrintCompileTime) _ct_last_install = 0;
+  flush_pending();
+  if (ZeroWasmJITPrintCompileTime) note_compile_time(nullptr, os::javaTimeNanos() - t0);
+}
+
+static bool compile_into_timed(Method* method, CacheEntry* e) {
+  // -XX:ZeroWasmJITOnly=Foo isolates a suspect method from everything the
+  // JDK compiles during boot, which is the only practical way to get a
+  // clean differential on a miscompile that breaks startup.
+  // casTabAt's shape -- a bare Unsafe.compareAndSetReference on a computed
+  // Node[] element address, ((long)i << ASHIFT) + ABASE -- is the one the
+  // inline reference compare-exchange in Codegen::emit_unsafe_cas
+  // miscompiles: the whole-ported wasm javac dies inside
+  // ConcurrentHashMap.putVal, casTabAt leaving an unrelated object (a
+  // java.time ZoneOffsetTransition) in a Node[] bin so the next tabAt cannot
+  // cast it back to Node. The defect does not localise in the emitter's
+  // bytes -- with the card mark removed the arm is byte-for-byte the int arm
+  // (which is correct) and still corrupts, the object address is the one the
+  // correct putReference computes (setTabAt writes the same slot fine), the
+  // address is always 4-byte aligned, operator temporaries sit above every
+  // stack slot, and the sequence is not sensitive to re-layout -- so it is
+  // refused at the method granularity rather than patched in the emitter.
+  // casTabAt then runs interpreted, where Unsafe_CompareAndSetReference is
+  // correct, and its native call never enters the JIT's CallStats, so the
+  // "no Unsafe accessors left as natives" gate still holds. Every other
+  // compare-exchange call site -- JitUnsafe's compareAndSetReference on an
+  // object field, AQS, Semaphore, the AtomicReferenceFieldUpdater family --
+  // stays compiled inline.
+  if (method->method_holder() != nullptr
+      && method->method_holder()->name()->equals("java/util/concurrent/ConcurrentHashMap")
+      && method->name()->equals("casTabAt")) {
+    e->index = -1;
+    return false;
+  }
+  if (ZeroWasmJITOnly != nullptr) {
+    ResourceMark rm;
+    if (::strstr(method->name_and_sig_as_C_string(), ZeroWasmJITOnly) == nullptr) {
+      e->index = -1;
+      return false;
+    }
+  }
+  ZwcBuilt* b = build(method, e);
+  if (b == nullptr) return false;
+  if (ZeroWasmJITUnitSize <= 1) {
+    install_built(&b, 1);
+    return e->index == 1;
+  }
+  if (_pending == nullptr) {
+    _pending = (ZwcBuilt**)::calloc(256, sizeof(ZwcBuilt*));
+    if (_pending == nullptr) { install_built(&b, 1); return e->index == 1; }
+  }
+  jlong now = os::javaTimeNanos();
+  if (_npending == 0) _pending_born = now;
+  _pending[_npending++] = b;
+  b->waited = true;
+  e->index = PENDING;
+  if (_npending >= (int)ZeroWasmJITUnitSize
+      || now - _pending_born >= (jlong)ZeroWasmJITUnitDelay * 1000000LL) flush_pending();
+  return e->index == 1;
+}
+
+// ---------------------------------------------------------------------------
+// Direct entry
+//
+// ZeroInterpreter::normal_entry for a method this thread has compiled, minus
+// what compiled code does not need. The ordinary path builds the frame and
+// then runs BytecodeInterpreter::run, whose prologue, entry hook, cache probe
+// and return protocol (Handles, a monitor walk) cost more than a small
+// method's whole body; compiled code was only reached from inside all that.
+//
+// Here the frame is built exactly as normal_entry builds it, so the GC, stack
+// walking and exception dispatch see an ordinary interpreter frame, and the
+// compiled body runs on it straight away. If it reaches a plain return, the
+// frame is popped and the result pushed the way main_loop does it. If it
+// stops anywhere else -- a bail, a pending exception, a safepoint request at
+// the return -- the frame goes to main_loop, which resumes the interpreter at
+// that bytecode and finishes the method. Either way the caller is left with
+// exactly what normal_entry would have left.
+//
+// Called where invoke_method would be, with the arguments already at the top
+// of the stack and the frame anchor cleared. Returns false, having done
+// nothing, when the callee is not one normal_entry would run or is not
+// compiled here.
+// The callee's compiled entry on this thread, compiling it if it has become
+// hot; null if it is not compiled here or would not use the normal entry.
+static ZwcCallSite* compiled_site(Method* m, int bci) {
+  if (_cache == nullptr || bci < 0 || bci >= m->code_size()) return nullptr;
+  unsigned h = ((unsigned)((uintptr_t)m >> 3) * 2654435761u) >> (32 - CACHE_BITS);
+  for (int probe = 0; probe < CACHE_PROBES; probe++) {
+    CacheEntry* e = _cache[(h + (unsigned)probe) & (CACHE_SIZE - 1)];
+    if (e == nullptr) return nullptr;
+    if (e->method == m) return (e->index == 1 && e->sites != nullptr) ? e->sites[bci] : nullptr;
+  }
+  return nullptr;
+}
+
+static const unsigned COLD_CALL_RUNS = 2000;
+static const unsigned RARE_CALL_RATIO = 128;
+static bool call_never_taken(Method* m, int bci) {
+  if (_cache == nullptr || bci < 0 || bci >= m->code_size()) return false;
+  unsigned h = ((unsigned)((uintptr_t)m >> 3) * 2654435761u) >> (32 - CACHE_BITS);
+  for (int probe = 0; probe < CACHE_PROBES; probe++) {
+    CacheEntry* e = _cache[(h + (unsigned)probe) & (CACHE_SIZE - 1)];
+    if (e == nullptr) return false;
+    if (e->method != m) continue;
+    if (e->index != 1 || e->sites == nullptr || e->runs < COLD_CALL_RUNS) return false;
+    ZwcCallSite* s = e->sites[bci];
+    // No record because the invoke is still unresolved: no thread has ever
+    // executed it, which is the strongest "never taken" there is.
+    if (s == nullptr) return invoke_unresolved(m, bci);
+    if (s->mh_basic || s->mh_link) return false;
+    // Never taken -- or taken so rarely (once in RARE_CALL_RATIO runs of the
+    // method) that a hand-back there, which runs the whole call in the
+    // interpreter, costs less than the frames every call pays when the
+    // method cannot be inlined: BrowserNativeMemory.block's cache miss, a
+    // collection's resize, a lazy initializer. A path that turns frequent
+    // hands back often enough to be recompiled without the inline (noinl).
+    return !s->taken || (unsigned long long)s->calls * RARE_CALL_RATIO < e->runs;
+  }
+  return false;
+}
+
+static CacheEntry* compiled_entry(Method* callee, address entry_point) {
+  // Native, synchronized, accessor and intrinsic methods keep their own
+  // entries, and JVMTI's interp-only mode picks a different entry point, so
+  // comparing entries excludes all of them at once. No minimum size:
+  // ZeroWasmJITMinBytecodes exists because entering compiled code from inside
+  // run() used to cost a JS crossing, and a direct entry costs less than the
+  // interpreter's own, whatever the body.
+  if (entry_point != Interpreter::entry_for_kind(Interpreter::zerolocals)) return nullptr;
+  if (disabled(NO_DIRECT)) return nullptr;
+  CacheEntry* e = cache_find(callee);
+  if (e == nullptr || e->index < 0) return nullptr;
+  if (e->index == 1) maybe_profile_recompile(e);
+  if (e->index == PENDING) {
+    pending_hit();
+    if (e->index != 1) return nullptr;
+  }
+  if (e->index == 0) {
+    if (++e->count < (int)ZeroWasmJITThreshold) return nullptr;
+    if (!compile_into(callee, e)) return nullptr;
+  }
+  e->uses++;
+  return e;
+}
+
+static void run_compiled(Method* callee, CacheEntry* e, JavaThread* thread,
+                         bool try_frameless = true);
+
+bool ZeroWasmCompiler::enter_compiled(Method* callee, address entry_point, JavaThread* thread) {
+  CacheEntry* e = compiled_entry(callee, entry_point);
+  if (e == nullptr) return false;
+  run_compiled(callee, e, thread);
+  return true;
+}
+
+// A call from generated code: the site remembers the callee's entry, so a
+// hot site does not probe the code cache at all. Entries never move, but one
+// can be recycled and even reused for another method, so a remembered entry
+// is good only while it still names this callee and is compiled.
+static bool zwc_enter_via_site(ZwcCallSite* site, Method* callee, JavaThread* thread) {
+  CacheEntry* e = site->t.compiled;
+  if (e != nullptr && e->method == callee && e->index == 1) maybe_profile_recompile(e);
+  if (e == nullptr || e->method != callee || e->index != 1) {
+    e = compiled_entry(callee, callee->from_interpreted_entry());
+    site->t.compiled = e;
+    if (e == nullptr) return false;
+  } else {
+    e->uses++;
+  }
+  if (ZeroWasmJITVerbose) note_bail(callee, 0, e->leafable ? "leaf call" : "frame call");
+  run_compiled(callee, e, thread);
+  return true;
+}
+
+// InterpreterFrame::build, for exactly the methods run_compiled runs (not
+// native, not synchronized), with the per-method values taken from the code
+// cache entry. The frame is word-for-word the one build() makes, so the GC,
+// the stack walker and the interpreter cannot tell them apart.
+//
+// The mirror is read straight from its OopHandle slot rather than through the
+// access API, which costs a dispatched barrier call: it is a strong root, and
+// every collector built for this port stops the world, so there is no
+// keep-alive barrier to run. The generated code reads mirrors the same way.
+InterpreterFrame* InterpreterFrame::build_for_wasm_jit(Method* method, int extra_locals,
+                                                       int max_locals, int max_stack,
+                                                       ConstantPoolCache* cpc, oop mirror,
+                                                       address code_base, JavaThread* thread) {
+  ZeroStack* stack = thread->zero_stack();
+  stack->overflow_check(extra_locals + header_words + max_stack, thread);
+  if (thread->has_pending_exception()) return nullptr;
+
+  intptr_t* sp = stack->sp();
+  for (int i = 0; i < extra_locals; i++) *(--sp) = 0;
+  intptr_t* locals = sp + (max_locals - 1);
+  *(--sp) = 0;                                  // next_frame, set by push_zero_frame
+  intptr_t* fp = sp;
+  *(--sp) = INTERPRETER_FRAME;
+  sp -= align_up(sizeof(BytecodeInterpreter), wordSize) >> LogBytesPerWord;
+  interpreterState istate = (interpreterState) sp;
+  istate->set_locals(locals);
+  istate->set_method(method);
+  istate->set_mirror(mirror);
+  istate->set_self_link(istate);
+  istate->set_prev_link(nullptr);
+  istate->set_thread(thread);
+  istate->set_bcp(code_base);
+  istate->set_constants(cpc);
+  istate->set_msg(BytecodeInterpreter::method_entry);
+  istate->set_oop_temp(nullptr);
+  istate->set_callee(nullptr);
+  // The frame's memory is recycled ZeroStack, and the rest of the
+  // frame_manager_message (the callee's entry point and the invoke's length)
+  // is whatever the last frame here left behind. A body that hands this frame
+  // to main_loop (run_compiled_bail) resumes with method_resume, which
+  // advances the bcp by that stale length and can read a garbage entry point,
+  // so both words are seeded here: run this method, from its own interpreted
+  // entry, and resume after nothing. An invoke the interpreted body then
+  // executes overwrites them with the real target, as every invoke handler
+  // does.
+  istate->set_callee_entry_point(method->from_interpreted_entry());
+  istate->set_bcp_advance(0);
+  istate->set_monitor_base((BasicObjectLock*) sp);
+  istate->set_stack_base(sp);
+  istate->set_stack(sp - 1);
+  sp -= max_stack;
+  istate->set_stack_limit(sp - 1);
+  stack->set_sp(sp);
+  return (InterpreterFrame*) fp;
+}
+
+// Everything after a body that did not run straight to a plain return (or
+// ran into a pending safepoint or exception): the interpreter takes over the
+// frame where compiled code stopped. deopt_resume2 re-enters the dispatch
+// loop at bcp; method_resume goes to the handler search first when an
+// exception is pending (its pc advance only runs without one). Out of line,
+// like everything rare on this path: see run_framed.
+static NOINLINE void run_compiled_bail(CacheEntry* e, JavaThread* thread,
+                                       interpreterState istate, address pc, intptr_t* tos,
+                                       bool plain_return) {
+  Method* callee = istate->method();
+  if (ZeroWasmJITVerbose) note_bail(callee, (int)(pc - callee->code_base()), "direct");
+  if (!plain_return && e != nullptr) note_trace_bail(e, callee, (int)(pc - callee->code_base()));
+  istate->set_bcp(pc);
+  istate->set_stack(tos);
+  istate->set_msg(thread->has_pending_exception() ? BytecodeInterpreter::method_resume
+                                                   : BytecodeInterpreter::deopt_resume2);
+  ZeroInterpreter::main_loop(0, thread);
+}
+
+// The framed entry: build the interpreter frame, run the body, and return
+// its result the way the interpreter's return does. Inlined into its
+// callers, zwc_invoke's lean path among them, so a compiled recursion stacks
+// two engine frames per level (that and the body), not three: each frame
+// has a fixed cost on the engine's stack that splitting this out made
+// larger than the saving. Everything that is not the common case is out of
+// line instead (run_compiled_bail), so what the frame keeps live across the
+// body is little.
+static ALWAYSINLINE void run_framed(Method* callee, CacheEntry* e, JavaThread* thread) {
+  // Stack the VM can see, for stack the VM cannot (ZeroWasmJITFramePad):
+  // reserved before the frame is built, so build_for_wasm_jit's overflow
+  // check counts it. The machine stack this level uses (this frame and the
+  // body's) is invisible to HotSpot; without a stand-in the check fired only
+  // once the engine's stack was all but gone, and handling the
+  // StackOverflowError then overflowed it and killed the worker. The
+  // interpreter reserves its own (ZeroWasmInterpreterFramePad).
+  char* pad = (char*)alloca(ZeroWasmJITFramePad + 1);
+  *(volatile char*)pad = 0;
+  InterpreterFrame* frame = InterpreterFrame::build_for_wasm_jit(
+      callee, e->extra_locals, e->max_locals, e->max_stack, e->cpc,
+      cast_to_oop(*(void**)e->mirror_slot), e->code_base, thread);
+  if (frame == nullptr) return;   // stack overflow, as normal_entry
+  thread->push_zero_frame(frame);
+  interpreterState istate = frame->interpreter_state();
+
+  // No frame anchor around the body. Zero's interpreter needs one because its
+  // CALL_VM does not set it, but compiled code makes no VM call of its own:
+  // its calls go through zwc_invoke, which sets and restores the anchor, and
+  // any bail below goes through main_loop, which sets it too. The anchor is
+  // clear here, as main_loop leaves it between frames.
+  //
+  // Everything needed after the body is read first: while it runs, a compile
+  // it triggers can recycle this entry and hand it to another method.
+  address code_base = e->code_base;
+  // result_slots | result_type << 2 | is_initializer << 7: one value live
+  // across the body instead of three.
+  int ret = e->result_slots | ((int)e->result_type << 2) | (e->is_initializer ? 128 : 0);
+  intptr_t out = 0;
+  int bci = e->fn((int)(intptr_t)istate->locals(), (int)(intptr_t)istate->stack(),
+                  (int)(intptr_t)&out, (int)(intptr_t)istate, 0);
+  // A call the body made leaves the anchor on this frame; it must not outlive
+  // the frame, whichever way we leave.
+  thread->reset_last_Java_frame();
+  address pc = code_base + bci;
+  intptr_t* tos = (intptr_t*)out;
+
+  Bytecodes::Code c = (Bytecodes::Code)*pc;
+  bool plain_return = c == Bytecodes::_ireturn || c == Bytecodes::_lreturn
+                   || c == Bytecodes::_freturn || c == Bytecodes::_dreturn
+                   || c == Bytecodes::_areturn || c == Bytecodes::_return;
+  // Compiled code never takes a monitor (monitorenter hands back), so a body
+  // that ran straight to a return holds none; checked anyway because the
+  // interpreter's return would throw IllegalMonitorStateException if it did.
+  // The safepoint poll is the interpreter's RETURN_SAFEPOINT: if one is due,
+  // let the interpreter execute the return and take it. None of the collectors
+  // built for this port uses stack watermarks, so main_loop's unwind check has
+  // nothing to do here.
+  if (!plain_return || thread->has_pending_exception()
+      || SafepointMechanism::local_poll_armed(thread)
+      || (intptr_t*)istate->monitor_base() != istate->stack_base()) {
+    run_compiled_bail(e, thread, istate, pc, tos, plain_return);
+    return;
+  }
+  // handle_return's barrier for final fields, which only a constructor
+  // can have written (see the interpreter's handle_return).
+  if (ret & 128) OrderAccess::storestore();
+  int result_slots = ret & 3;
+  ZeroStack* stack = thread->zero_stack();
+  intptr_t* locals = istate->locals();
+  thread->pop_zero_frame();
+  // The caller's sp is just above the locals, as the interpreter leaves it.
+  stack->set_sp(locals + 1);
+  if (result_slots == 1) {
+    intptr_t res = tos[1];
+    switch ((BasicType)((ret >> 2) & 31)) {
+      case T_BOOLEAN: res = (intptr_t)((jint)res & 1); break;
+      case T_BYTE:    res = (intptr_t)(jint)(jbyte)res; break;
+      case T_CHAR:    res = (intptr_t)(jint)(jchar)res; break;
+      case T_SHORT:   res = (intptr_t)(jint)(jshort)res; break;
+      default: break;
+    }
+    stack->push(res);
+  } else if (result_slots == 2) {
+    stack->push(tos[2]);
+    stack->push(tos[1]);
+  }
+}
+
+static ALWAYSINLINE void run_compiled(Method* callee, CacheEntry* e, JavaThread* thread,
+                                      bool try_frameless) {
+  ZeroStack* stack = thread->zero_stack();
+  if (try_frameless && e->frameless != nullptr) {
+    // The arguments are where the frame's first locals would be. On success
+    // the stack is left as the plain return below leaves it: arguments
+    // popped, result pushed. On -1 nothing happened, and the frame is built.
+    int nparams = e->max_locals - e->extra_locals;
+    intptr_t* args = stack->sp() + nparams - 1;
+    jlong out = 0;
+    bool ok = stack->available_words() > 4096
+           && e->frameless((int)(intptr_t)args, (int)(intptr_t)(stack->sp() - 1),
+                           (int)(intptr_t)&out, FL_DEPTH, 0) == 0;
+    note_frameless(e, ok);
+    if (ok) {
+      stack->set_sp(stack->sp() + nparams);
+      if (e->result_slots == 2) {
+        stack->alloc(2 * wordSize);
+        ::memcpy(stack->sp(), &out, 8);
+      } else if (e->result_slots == 1) {
+        intptr_t res = (intptr_t)*(jint*)&out;
+        switch (e->result_type) {
+          case T_BOOLEAN: res = (intptr_t)((jint)res & 1); break;
+          case T_BYTE:    res = (intptr_t)(jint)(jbyte)res; break;
+          case T_CHAR:    res = (intptr_t)(jint)(jchar)res; break;
+          case T_SHORT:   res = (intptr_t)(jint)(jshort)res; break;
+          default: break;
+        }
+        stack->push(res);
+      }
+      return;
+    }
+  }
+  run_framed(callee, e, thread);
+}
+
+// The callee need not be compiled yet: the helper checks its entry at every
+// call, and until it has a body the call takes zwc_invoke, which compiles it.
+// That is what lets two methods that call each other, or a method that
+// calls itself, both call through helpers, whichever compiles first.
+static bool framed_target(Method* callee, ZwcFramedTarget* t) {
+  if (disabled(NO_DIRECT)) return false;
+  if (callee->from_interpreted_entry() != Interpreter::entry_for_kind(Interpreter::zerolocals)) return false;
+  if (callee->is_native() || callee->is_abstract() || callee->is_synchronized()) return false;
+  CacheEntry* e = cache_find(callee);
+  if (e == nullptr || e->method != callee || e->index < 0) return false;
+  oop* mirror_slot = callee->method_holder()->java_mirror_handle().ptr_raw();
+  ConstantPoolCache* cpc = callee->constants()->cache();
+  if (mirror_slot == nullptr || cpc == nullptr) return false;
+  t->max_locals = callee->max_locals();
+  t->extra_locals = callee->max_locals() - callee->size_of_parameters();
+  t->max_stack = callee->max_stack();
+  t->result_type = callee->result_type();
+  t->result_slots = type2size[t->result_type];
+  t->is_initializer = callee->is_object_initializer();
+  t->cpc = cpc;
+  t->mirror_slot = mirror_slot;
+  t->code_base = callee->code_base();
+  t->entry = callee->from_interpreted_entry();
+  t->method = (address)&e->method;
+  t->fn = (address)&e->fn;
+  t->uses = (address)&e->uses;
+  t->since = (address)&e->since;
+  t->profiled = (address)&e->profiled;
+  return true;
+}
+
+// The rest of a framed helper's call (Codegen::emit_framed_helper) when the
+// body did not run straight to a plain return, or an exception or safepoint
+// is pending: run_framed's tail, then zwc_invoke's.
+extern "C" EMSCRIPTEN_KEEPALIVE int zwc_framed_bail(int caller_i, int istate_i, int bci, int tos_i) {
+  interpreterState caller = (interpreterState)(intptr_t)caller_i;
+  interpreterState istate = (interpreterState)(intptr_t)istate_i;
+  JavaThread* thread = istate->thread();
+  Method* callee = istate->method();
+  address pc = callee->code_base() + bci;
+  CacheEntry* e = cache_find(callee);
+  if (e != nullptr && e->method != callee) e = nullptr;
+  run_compiled_bail(e, thread, istate, pc, (intptr_t*)(intptr_t)tos_i,
+                    is_return_op((Bytecodes::Code)*pc));
+  ZeroStack* stack = thread->zero_stack();
+  caller->set_stack(stack->sp() - 1);
+  stack->set_sp(caller->stack_limit() + 1);
+  thread->set_last_Java_frame();
+  return thread->has_pending_exception() ? -1 : 1;
+}
+
+// ---------------------------------------------------------------------------
+// Frameless calls out of frameless bodies
+//
+// Called from a frameless body with the callee's arguments already in scratch
+// memory, laid out as its first locals. Pure bookkeeping, no VM calls: it
+// can never reach the GC, so the caller's values in wasm locals are safe.
+// Returns 0 with the result at `out`, or -1 for "run the outermost call the
+// ordinary way" -- a cache miss, a callee without a frameless body, the depth
+// budget, or a safepoint that is waiting.
+// ---------------------------------------------------------------------------
+
+// A statically bound site (invokestatic, invokespecial, a final method) is
+// resolved -- its target recorded -- the first time zwc_invoke_slow sees it.
+// But the ordinary body calls a target with a frameless body directly
+// (emit_direct_fast_path), so zwc_invoke may never see the site, and the
+// method's own frameless body, which calls out through zwc_fl_call on the
+// same site record, found it unresolved on every call. Each attempt then
+// retried, the body was dropped, and the drop spread to every caller: all
+// of worldgen's density functions ran framed. Resolved here instead, as
+// zwc_invoke_slow does it; reading an already resolved constant-pool entry
+// cannot collect or throw.
+static NOINLINE void zwc_fill_static_site(ZwcCallSite* site) {
+  Method* m = site->caller;
+  if (m == nullptr) return;
+  ConstantPool* cp = m->constants();
+  if (cp->cache() == nullptr) return;
+  address bcp = site->bcp;
+  Bytecodes::Code c = (Bytecodes::Code)(unsigned char)*bcp;
+  Bytecodes::Code as = (c == Bytecodes::_fast_invokevfinal) ? Bytecodes::_invokevirtual : c;
+  if (as != Bytecodes::_invokestatic && as != Bytecodes::_invokespecial
+      && as != Bytecodes::_invokevirtual) return;
+  ResolvedMethodEntry* re = cp->resolved_method_entry_at(Bytes::get_native_u2(bcp + 1));
+  if (re == nullptr || !re->is_resolved(as)) return;
+  if (as == Bytecodes::_invokevirtual && !re->is_vfinal()) return;
+  Method* callee = re->method();
+  if (callee == nullptr) return;
+  site->t.callee = callee;
+  note_mh_intrinsic(site, callee);
+  site->t.klass = nullptr;
+  site->t.compiled = nullptr;
+  zwc_note_getter(site);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int zwc_fl_call(int site_i, int args_i, int out_i,
+                                                int scratch_i, int depth) {
+  CALL_STAT(CS_FLR_CALLS);
+  ((ZwcCallSite*)(intptr_t)site_i)->taken = true;
+  ((ZwcCallSite*)(intptr_t)site_i)->calls++;
+  if (depth <= 0) { CALL_STAT(CS_FLR_DEPTH); fl_cause((ZwcCallSite*)(intptr_t)site_i, FLC_DEPTH, nullptr); return -1; }
+  // No safepoint poll runs inside a frameless chain. Its bodies are loop
+  // free, but a chain can still be long, so every few thousand calls check
+  // whether one is waiting and, if so, give the work to the ordinary path.
+  if (--_fl_budget < 0) {
+    _fl_budget = 4096;
+    if (SafepointMechanism::local_poll_armed(JavaThread::current())) {
+      CALL_STAT(CS_FLR_POLL); fl_cause((ZwcCallSite*)(intptr_t)site_i, FLC_POLL, nullptr); return -1;
+    }
+  }
+  ZwcCallSite* site = (ZwcCallSite*)(intptr_t)site_i;
+  intptr_t* args = (intptr_t*)(intptr_t)args_i;
+  const ZwcTarget* t = &site->t;
+  if (site->receiver) {
+    intptr_t r = args[0];
+    if (r == 0) { CALL_STAT(CS_FLR_NULL); fl_cause(site, FLC_NULL, t->callee); return -1; }
+    if (site->dispatch) {
+      Klass* rk = cast_to_oop((void*)r)->klass();
+      if (rk != t->klass) {
+        ZwcMega* in = _mega != nullptr ? mega_slot(site, rk) : nullptr;
+        if (in == nullptr || in->site != site || in->t.klass != rk) {
+          CALL_STAT(CS_FLR_MEGA); fl_cause(site, FLC_MEGA, t->callee); return -1;
+        }
+        t = &in->t;
+      }
+    }
+  }
+  if (t->callee == nullptr && !site->dispatch) zwc_fill_static_site(site);
+  if (t->callee == nullptr || JvmtiExport::can_post_interpreter_events()) {
+    fl_cause(site, FLC_UNRESOLVED, nullptr);
+    return -1;
+  }
+  if (t->getter_off > 0) {
+    address obj = (address)args[0];
+    if (obj == nullptr) return -1;
+    *(jint*)(intptr_t)out_i = (jint)getter_load(obj, t);
+    return 0;
+  }
+  CacheEntry* e = t->compiled;
+  if (e == nullptr && t == &site->t) {
+    // Nothing has entered the callee through this site yet (see
+    // zwc_fill_static_site); the site learns its entry here instead.
+    e = cache_find(t->callee);
+    if (e != nullptr && (e->method != t->callee || e->index != 1)) e = nullptr;
+    site->t.compiled = e;
+  }
+  if (e == nullptr || e->method != t->callee || e->index != 1 || e->frameless == nullptr
+      || e->fl_stores) {                              // framed callers only: fl_stores_ok
+    CALL_STAT(CS_FLR_NOBODY);
+    fl_cause(site, FLC_NOBODY, t->callee);
+    if (ZeroWasmJITCallStats) {
+      CacheEntry* ce = (e != nullptr && e->method == t->callee) ? e : cache_find(t->callee);
+      if (ce != nullptr) ce->nobody_hits++;
+    }
+    return -1;
+  }
+  return e->frameless(args_i, scratch_i, out_i, depth - 1, 0) == 0 ? 0 : -1;
+}
+
+static int direct_frameless_slot(Method* callee, bool from_frameless) {
+  CacheEntry* e = cache_find(callee);
+  if (e == nullptr || e->method != callee || e->index != 1 || e->frameless == nullptr) return -1;
+  if (from_frameless && e->fl_stores) return -1;     // see Codegen::fl_stores_ok
+  if (e->fl_retry > 64 && e->fl_retry > e->fl_ok / 4) return -1;   // mostly retries
+  return (int)(intptr_t)e->frameless;
+}
+
+// After a frameless attempt from the ordinary path. A body that mostly has
+// to retry costs its attempt on top of the call, so it is dropped: its slot
+// goes back and the method is called the ordinary way from then on. Safe
+// here: no frameless body can be running below an ordinary entry.
+static NOINLINE void note_frameless(CacheEntry* e, bool ok) {
+  if (ok) { e->fl_ok++; return; }
+  if (ZeroWasmJITCallStats) fl_cause_count();
+  if (++e->fl_retry < 256 || e->fl_retry < e->fl_ok) return;
+  if (ZeroWasmJITVerbose) {
+    ResourceMark rm;
+    tty->print_cr("[zwc] frameless dropped %s: %u retries, %u completed",
+                  e->method->name_and_sig_as_C_string(), e->fl_retry, e->fl_ok);
+  }
+  _free_slots[_nfree++] = e->fslot;
+  e->frameless = nullptr;
+  e->fslot = -1;
+  e->fl_why = "dropped: kept retrying";
+  // Callers that call the dropped body directly would try it first on every
+  // call; recompiled, they call the ordinary body instead.
+  release_dependents(e);
+}
+
+// The common case of a call from compiled code, kept small: the site's cached
+// target is compiled on this thread, and the receiver is of the class it was
+// resolved for. This is zwc_invoke_slow's path for that case with every
+// branch it does not need taken out -- no resolution, no mega table, no
+// getter test, no statistics -- which is most of what a call used to cost.
+// The call protocol of zwc_invoke once the target's compiled entry is known:
+// its frameless body if it has one, else the framed direct entry.
+// `drop`: stack slots above the callee's arguments to discard first (the
+// MemberName a linkTo* call carries last).
+// A call's frameless attempt. Out of line: its values would otherwise add
+// to zwc_invoke's frame on the engine's stack, which a framed call that
+// recurses stacks once per level (see run_framed).
+static NOINLINE bool zwc_try_frameless(ZwcCallSite* site, intptr_t* tos, CacheEntry* e) {
+  // Nothing a frameless body does can reach the GC or the stack walker, so
+  // none of the frame protocol below is needed: the result simply replaces
+  // the arguments, where the framed path would push it (see run_compiled).
+  jlong out = 0;
+  // Scratch for calls out of the body starts at tos: everything from the
+  // top of the caller's operand stack down is free, and the caller checked
+  // there is room for a whole chain.
+  bool ok = e->frameless((int)(intptr_t)&tos[site->parms], (int)(intptr_t)tos,
+                         (int)(intptr_t)&out, FL_DEPTH, 0) == 0;
+  note_frameless(e, ok);
+  CALL_STAT(ok ? CS_FL_OK : CS_FL_RETRY);
+  if (!ok) return false;
+  if (e->result_slots == 1) {
+    intptr_t res = (intptr_t)*(jint*)&out;
+    switch (e->result_type) {
+      case T_BOOLEAN: res = (intptr_t)((jint)res & 1); break;
+      case T_BYTE:    res = (intptr_t)(jint)(jbyte)res; break;
+      case T_CHAR:    res = (intptr_t)(jint)(jchar)res; break;
+      case T_SHORT:   res = (intptr_t)(jint)(jshort)res; break;
+      default: break;
+    }
+    tos[site->parms] = res;
+  } else if (e->result_slots == 2) {
+    ::memcpy(&tos[site->parms - 1], &out, 8);
+  }
+  return true;
+}
+
+static ALWAYSINLINE int zwc_call_compiled(int istate_i, ZwcCallSite* site, intptr_t* tos,
+                                          CacheEntry* e, Method* callee, int drop = 0) {
+  interpreterState istate = (interpreterState)(intptr_t)istate_i;
+  JavaThread* thread = istate->thread();
+  if (e->frameless != nullptr && thread->zero_stack()->available_words() > 4096
+      && zwc_try_frameless(site, tos, e)) {
+    return 1;
+  }
+  // As zwc_invoke_slow: bcp and stack for the GC and the stack walker, and
+  // main_loop's call_method arm around the callee, anchor included.
+  istate->set_bcp(site->bcp);
+  istate->set_stack(tos);
+  ZeroStack* stack = thread->zero_stack();
+  thread->reset_last_Java_frame();
+  stack->set_sp(tos + 1 + drop);
+  e->uses++;
+  CALL_STAT(CS_FRAMED);
+  if (ZeroWasmJITCallStats) {
+    if (e->store_leaf) _cs[CS_FRAMED_LEAF]++;
+    e->framed_calls++;
+  }
+  run_compiled(callee, e, thread, false);   // the frameless body was tried above
+  istate->set_stack(stack->sp() - 1);
+  stack->set_sp(istate->stack_limit() + 1);
+  thread->set_last_Java_frame();
+  return thread->has_pending_exception() ? -1 : 1;
+}
+
+// MethodHandle.invokeBasic calls the method handle's LambdaForm target with
+// the same arguments: mh.form.vmentry.vmtarget. As a call it is a native
+// intrinsic, so every LambdaForm step went through zwc_invoke_slow and
+// MethodHandles' entry. The site remembers the last target and its compiled
+// entry instead, and the call goes straight to it.
+static inline Method* mh_basic_target(intptr_t mh) {
+  oop recv = cast_to_oop((void*)mh);
+  oop form = java_lang_invoke_MethodHandle::form(recv);
+  if (form == nullptr) return nullptr;
+  oop vmentry = java_lang_invoke_LambdaForm::vmentry(form);
+  if (vmentry == nullptr) return nullptr;
+  return (Method*)java_lang_invoke_MemberName::vmtarget(vmentry);
+}
+
+// linkToStatic / linkToSpecial: the target is the trailing MemberName's,
+// called with the arguments before it.
+static NOINLINE int zwc_invoke_mh_basic(int istate_i, ZwcCallSite* site, intptr_t* tos) {
+  int drop = site->mh_link ? 1 : 0;
+  Method* tgt;
+  if (drop) {
+    oop mn = cast_to_oop((void*)tos[1]);
+    if (mn == nullptr) return zwc_invoke_slow(istate_i, (int)(intptr_t)site, (int)(intptr_t)tos);
+    tgt = (Method*)java_lang_invoke_MemberName::vmtarget(mn);
+    // linkToSpecial has a receiver the entry null-checks; so does this.
+    if (tgt != nullptr && !tgt->is_static() && tos[site->parms] == 0) tgt = nullptr;
+  } else {
+    intptr_t r = tos[site->parms];
+    if (r == 0) return zwc_invoke_slow(istate_i, (int)(intptr_t)site, (int)(intptr_t)tos);
+    tgt = mh_basic_target(r);
+  }
+  if (tgt == nullptr || JvmtiExport::can_post_interpreter_events()) {
+    return zwc_invoke_slow(istate_i, (int)(intptr_t)site, (int)(intptr_t)tos);
+  }
+  CacheEntry* e = site->mh_compiled;
+  if (e == nullptr || site->mh_target != tgt || e->method != tgt || e->index != 1) {
+    e = compiled_entry(tgt, tgt->from_interpreted_entry());
+    // Same arguments, by construction; checked because the frame protocol
+    // below relies on it.
+    if (e != nullptr && e->max_locals - e->extra_locals != site->parms - drop) e = nullptr;
+    site->mh_target = tgt;
+    site->mh_compiled = e;
+    if (e == nullptr) return zwc_invoke_slow(istate_i, (int)(intptr_t)site, (int)(intptr_t)tos);
+  } else {
+    e->uses++;
+  }
+  // A frameless body reads its arguments from &tos[parms] down, which is
+  // the same with or without the MemberName below them.
+  return zwc_call_compiled(istate_i, site, tos, e, tgt, drop);
+}
+
+// Every call zwc_invoke's lean path below does not take: getters, method
+// handle intrinsics, frameless bodies, a target to resolve or compile, the
+// profiled recompile, statistics.
+static NOINLINE int zwc_invoke_other(int istate_i, int site_i, int tos_i) {
+  ZwcCallSite* site = (ZwcCallSite*)(intptr_t)site_i;
+  intptr_t* tos = (intptr_t*)(intptr_t)tos_i;
+  if (ZeroWasmJITCallStats && ++_cs[CS_CALLS] >= 2000000u) call_stats_print();
+  if (site->mh_basic || site->mh_link) { CALL_STAT(CS_MH); return zwc_invoke_mh_basic(istate_i, site, tos); }
+  const ZwcTarget* t = &site->t;
+  if (site->receiver) {
+    intptr_t r = tos[site->parms];
+    if (r == 0) return zwc_invoke_slow(istate_i, site_i, tos_i);
+    if (site->dispatch) {
+      Klass* rk = cast_to_oop((void*)r)->klass();
+      if (rk != t->klass) {
+        // A megamorphic site: the target parked for this class, used as it
+        // is. Copying it into the site on every change of class would cost
+        // more than the lookup.
+        ZwcMega* in = _mega != nullptr ? mega_slot(site, rk) : nullptr;
+        if (in == nullptr || in->site != site || in->t.klass != rk) {
+          return zwc_invoke_slow(istate_i, site_i, tos_i);
+        }
+        t = &in->t;
+        CALL_STAT(CS_MEGA);
+      }
+    }
+  }
+  // A plain getter, as zwc_invoke_slow does it: the call is the load, and
+  // the receiver was null-checked above (a static of that shape goes slow).
+  if (t->getter_off > 0 && site->receiver && t->callee != nullptr) {
+    tos[site->parms] = getter_load((address)tos[site->parms], t);
+    return 1;
+  }
+  CacheEntry* e = t->compiled;
+  Method* callee = t->callee;
+  if (e == nullptr || e->method != callee || e->index != 1 || t->getter_off > 0
+      || JvmtiExport::can_post_interpreter_events()) {
+    return zwc_invoke_slow(istate_i, site_i, tos_i);
+  }
+  // Cached calls are how most compiled code is entered, so the profiled
+  // recompile is counted here too; the slow path compiles it.
+  maybe_profile_recompile(e);
+  if (e->index != 1) return zwc_invoke_slow(istate_i, site_i, tos_i);
+  return zwc_call_compiled(istate_i, site, tos, e, callee);
+}
+
+// A call from compiled code. The lean path is a framed call to a compiled
+// target the site has cached, for the receiver's class or through the
+// megamorphic table: most calls, and the only kind a compiled recursion
+// makes at every level. It is kept apart from everything else
+// (zwc_invoke_other) because each level of such a recursion stacks this
+// function's frame on the engine's machine stack, where HotSpot's overflow
+// check cannot see it, and V8's optimizing tier gave the one function that
+// handled every case a frame more than twice the interpreter's per level: in
+// Chromium a recursion the interpreter took 3000 deep killed the worker at
+// 750-1750. So this path calls only the body (and helpers that almost never
+// run), and keeps few values live across it.
+extern "C" EMSCRIPTEN_KEEPALIVE int zwc_invoke(int istate_i, int site_i, int tos_i) {
+  ZwcCallSite* site = (ZwcCallSite*)(intptr_t)site_i;
+  intptr_t* tos = (intptr_t*)(intptr_t)tos_i;
+  if (ZeroWasmJITCallStats || site->mh_basic || site->mh_link) {
+    return zwc_invoke_other(istate_i, site_i, tos_i);
+  }
+  const ZwcTarget* t = &site->t;
+  if (site->receiver) {
+    intptr_t r = tos[site->parms];
+    if (r == 0) return zwc_invoke_other(istate_i, site_i, tos_i);
+    if (site->dispatch) {
+      Klass* rk = cast_to_oop((void*)r)->klass();
+      if (rk != t->klass) {
+        ZwcMega* in = _mega != nullptr ? mega_slot(site, rk) : nullptr;
+        if (in == nullptr || in->site != site || in->t.klass != rk) {
+          return zwc_invoke_other(istate_i, site_i, tos_i);
+        }
+        t = &in->t;
+      }
+    }
+  }
+  CacheEntry* e = t->compiled;
+  if (e == nullptr || e->method != t->callee || e->index != 1
+      || t->getter_off > 0 || JvmtiExport::can_post_interpreter_events()
+      || (!e->profiled && ZeroWasmJITProfileRecompile != 0
+          && ++e->since >= (unsigned)ZeroWasmJITProfileRecompile)) {
+    return zwc_invoke_other(istate_i, site_i, tos_i);
+  }
+  interpreterState istate = (interpreterState)(intptr_t)istate_i;
+  JavaThread* thread = istate->thread();
+  // zwc_call_compiled, both halves: the target's frameless body if it has
+  // one (from here, not zwc_invoke_other: that repeats every check above
+  // and nests another frame, which made a frameless call cost 27 ns
+  // instead of 15), else the framed entry.
+  if (e->frameless != nullptr && thread->zero_stack()->available_words() > 4096
+      && zwc_try_frameless(site, tos, e)) {
+    return 1;
+  }
+  istate->set_bcp(site->bcp);
+  istate->set_stack(tos);
+  thread->reset_last_Java_frame();
+  thread->zero_stack()->set_sp(tos + 1);
+  e->uses++;
+  run_framed(e->method, e, thread);
+  ZeroStack* stack = thread->zero_stack();
+  istate->set_stack(stack->sp() - 1);
+  stack->set_sp(istate->stack_limit() + 1);
+  thread->set_last_Java_frame();
+  return thread->has_pending_exception() ? -1 : 1;
+}
 
