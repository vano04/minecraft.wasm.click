+static bool matches_jit_filter(const char* name, const char* filter) {
+  if (filter == nullptr || *filter == '\0') return true;
+  const char* term = filter;
+  while (true) {
+    const char* end = ::strchr(term, ',');
+    size_t length = end != nullptr ? (size_t)(end - term) : ::strlen(term);
+    if (length > 0) {
+      for (const char* at = name; *at != '\0'; at++) {
+        if (::strncmp(at, term, length) == 0) return true;
+      }
+    }
+    if (end == nullptr) return false;
+    term = end + 1;
+  }
+}
