+
+# Concurrent probes assert consumer state, not identical timing/observation
+# counts. Require both the Java invariant and the browser VM's zero exit.
+PROBE_TMP=$(mktemp -d) || exit 1
+trap 'rm -rf "$PROBE_TMP"' EXIT
+probecheck() {
+  local name=$1 marker=$2
+  shift 2
+  if (cd "$H" && node drive.mjs 180 -Xmx256m "$@") >"$PROBE_TMP/$name.log" 2>&1 \
+      && grep -F "$marker" "$PROBE_TMP/$name.log" >/dev/null \
+      && grep -F '[harness] status=0 ' "$PROBE_TMP/$name.log" >/dev/null \
+      && ! grep -F '[pageerror]' "$PROBE_TMP/$name.log" >/dev/null; then
+    echo "ok   $name (actual consumer invariants, VM exit 0)"
+  else
+    cat "$PROBE_TMP/$name.log"
+    echo "FAIL $name"
+    fail=1
+  fi
+}
+ackcheck() {
+  name=$1
+  if ! grep -E '^volatile-ack attempts=[1-9][0-9]* nullGuards=[1-9][0-9]* impossibleReturns=0 misses=[0-9]+ warmChecksum=280000$' \
+      "$PROBE_TMP/$name.log" >/dev/null; then
+    echo "FAIL $name (acknowledged-publication coverage)"
+    fail=1
+  fi
+}
+
+probecheck "static-store-interpreter" 'PASS static-store-replay ' \
+    -cp /app/classes JitStaticStoreReplay
+probecheck "static-store-jit" 'PASS static-store-replay ' $J \
+    -XX:ZeroWasmJITOnly=JitStaticStoreReplay -cp /app/classes JitStaticStoreReplay
+for mode in null profile; do
+  probecheck "publication-$mode-interpreter" 'PASS volatile-replay:' \
+      -cp /app/classes JitVolatileReplay 1000000 90 "$mode"
+  probecheck "publication-$mode-jit" 'PASS volatile-replay:' $J \
+      '-XX:ZeroWasmJITOnly=JitVolatileReplay$Writer' \
+      -cp /app/classes JitVolatileReplay 1000000 90 "$mode"
+  if [ "$mode" = null ]; then
+    ackcheck "publication-$mode-interpreter"
+    ackcheck "publication-$mode-jit"
+  fi
+done
+for mode in queue executor; do
+  probecheck "queue-$mode-interpreter" "PASS queue-signal mode=$mode " \
+      --add-opens=java.base/java.util.concurrent=ALL-UNNAMED \
+      --add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED \
+      -cp /app/classes QueueSignalStress "$mode" 8000 90
+  probecheck "queue-$mode-jit" "PASS queue-signal mode=$mode " $J \
+      --add-opens=java.base/java.util.concurrent=ALL-UNNAMED \
+      --add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED \
+      -cp /app/classes QueueSignalStress "$mode" 8000 90
+done
 exit $fail
