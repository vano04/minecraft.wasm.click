diff --git a/web/player-textures.mjs b/web/player-textures.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b0325089d9c3a0d60bccc1013b5af32b956b2b3f
--- /dev/null
+++ b/web/player-textures.mjs
@@ -0,0 +1,77 @@
+// GPU-worker fetch adapter for the portable JVM. Authlib still parses profiles
+// and validates texture domains; the existing authenticated verifier owns RSA.
+const VERIFIER_HOST = 'mcweb-profile-verifier.invalid';
+const MAX_TEXTURE_BYTES = 4 * 1024 * 1024;
+function bytesResponse(bytes, status = 200) {
+  const length = bytes.length;
+  return new Response(new ReadableStream({ type: 'bytes', start(controller) { controller.enqueue(bytes); controller.close(); } }), {
+    status, headers: { 'content-type': 'application/octet-stream', 'content-length': String(length), 'content-encoding': 'identity' },
+  });
+}
+export function createPlayerTextureFetch({ fetchImpl = globalThis.fetch.bind(globalThis), origin = globalThis.location?.origin } = {}) {
+  const endpoint = new URL('/mcweb/verify-profile-property', origin);
+  if (!/^https?:$/.test(endpoint.protocol)) throw new Error('Profile verifier requires the launcher origin');
+  return async (input, options = {}) => {
+    const url = new URL(input);
+    if (url.hostname === VERIFIER_HOST) {
+      const keys = [...url.searchParams.keys()];
+      const value = url.searchParams.get('value'), signature = url.searchParams.get('signature');
+      if (url.protocol !== 'https:' || url.port || url.username || url.password || url.hash || url.pathname !== '/verify'
+          || keys.length !== 2 || !keys.includes('value') || !keys.includes('signature')
+          || !value || !signature || value.length > 65536 || signature.length > 8192) throw new Error('Invalid profile verification operation');
+      const response = await fetchImpl(endpoint.href, {
+        method: 'POST', credentials: 'same-origin', mode: 'same-origin', cache: 'no-store', redirect: 'error',
+        headers: { 'content-type': 'application/json' }, body: JSON.stringify({ value, signature }), signal: options.signal,
+      });
+      if (!response.ok) { await response.body?.cancel().catch(() => {}); return bytesResponse(Uint8Array.of(0)); }
+      // Bound even a broken gateway's JSON reply before parsing it.
+      const reader = response.body?.getReader();
+      if (!reader) return bytesResponse(Uint8Array.of(0));
+      let text = '', count = 0;
+      const decoder = new TextDecoder();
+      try {
+        for (;;) {
+          const { done, value: chunk } = await reader.read();
+          if (done) break;
+          count += chunk.byteLength;
+          if (count > 1024) throw new Error('Profile verification response is too large');
+          text += decoder.decode(chunk, { stream: true });
+        }
+        text += decoder.decode();
+        return bytesResponse(Uint8Array.of(JSON.parse(text)?.valid === true ? 1 : 0));
+      } finally { await reader.cancel().catch(() => {}); }
+    }
+    if (url.hostname !== 'textures.minecraft.net') return fetchImpl(input, options);
+    if (!/^https?:$/.test(url.protocol) || url.port || url.username || url.password || url.search || url.hash
+        || !/^\/texture\/[0-9a-f]{32,64}$/i.test(url.pathname)) throw new Error('Invalid Minecraft player texture URL');
+    url.protocol = 'https:';
+    const response = await fetchImpl(url.href, { ...options, credentials: 'omit', mode: 'cors', redirect: 'error' });
+    if (!response.ok || !response.body) return response;
+    if (Number(response.headers.get('content-length')) > MAX_TEXTURE_BYTES) {
+      await response.body.cancel().catch(() => {}); throw new Error('Player texture exceeds 4 MiB');
+    }
+    const reader = response.body.getReader();
+    let count = 0;
+    const body = new ReadableStream({
+      type: 'bytes',
+      async pull(controller) {
+        try {
+          const part = await reader.read();
+          if (part.done) {
+            const pending = controller.byobRequest;
+            controller.close();
+            pending?.respond(0);
+            return;
+          }
+          count += part.value.byteLength;
+          if (count > MAX_TEXTURE_BYTES) throw new Error('Player texture exceeds 4 MiB');
+          controller.enqueue(part.value);
+        } catch (error) { await reader.cancel().catch(() => {}); controller.error(error); }
+      },
+      cancel(reason) { return reader.cancel(reason); },
+    });
+    const headers = new Headers(response.headers);
+    headers.delete('content-length'); headers.set('content-encoding', 'identity');
+    return new Response(body, { status: response.status, statusText: response.statusText, headers });
+  };
+}
diff --git a/web/text-input-check.html b/web/text-input-check.html
new file mode 100644
index 0000000000000000000000000000000000000000..7700f69d6e592b89f45b3208e4f2010485381f15
--- /dev/null
+++ b/web/text-input-check.html
@@ -0,0 +1,73 @@
+<!doctype html>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>MC-Web native keyboard check</title>
+<!-- Isolation page for tests/text-input.spec.ts: the production controls
+     module (game-controls.js) with a stand-in GPU Worker. The test plays the
+     game's side (text-input reports, as webgpu-host.js posts them) and reads
+     back exactly what the page would have sent to the game. -->
+<link rel="stylesheet" href="game-controls.css">
+<style>
+  body { margin: 0; font: 14px system-ui, sans-serif; }
+  #launcher-name { margin: 8px; }
+  #stage { width: 640px; }
+  #game-canvas { display: block; width: 640px; height: 360px; background: #223; }
+</style>
+<input id="launcher-name" aria-label="Launcher field" value="">
+<div id="stage"><canvas id="game-canvas" class="on" width="1280" height="720"></canvas></div>
+<script src="game-controls.js"></script>
+<script>
+  "use strict";
+  // The GPU Worker as the page sees it: postMessage out, "message" events in.
+  class StandInWorker extends EventTarget {
+    constructor() { super(); this.posted = []; }
+    postMessage(message) { this.posted.push(structuredClone(message)); }
+  }
+  const worker = new StandInWorker();
+  globalThis.__mcWebGpuWorker = worker;
+  // A visual viewport the test can shrink and pan the way an on-screen
+  // keyboard does: offsetTop is where the visible band starts inside the
+  // layout viewport, in the client coordinates getBoundingClientRect uses.
+  const viewport = new EventTarget();
+  viewport.offsetTop = 0;
+  viewport.offsetLeft = 0;
+  viewport.width = innerWidth;
+  viewport.height = innerHeight;
+  viewport.scale = 1;
+  globalThis.visualViewport = viewport;
+
+  const controls = mcWebGameControls.create({
+    container: document.getElementById("stage"),
+    getCanvas: () => document.querySelector("#game-canvas.on"),
+    touchMode: "on",
+  });
+  // Seen by a window listener that runs after the controls' capture-phase
+  // touchend handler: proves the focus happened inside the touch gesture.
+  const focusAtTouchEnd = [];
+  addEventListener("touchend", () => {
+    focusAtTouchEnd.push(document.activeElement?.className || document.activeElement?.tagName || null);
+  });
+  globalThis.textCheck = {
+    worker,
+    controls,
+    focusAtTouchEnd,
+    report(state) {
+      worker.dispatchEvent(new MessageEvent("message", { data: { mcwebTextInput: state } }));
+    },
+    grab(wanted) {
+      worker.dispatchEvent(new MessageEvent("message", { data: { mcwebCursorWanted: wanted } }));
+    },
+    keyboard(height, offsetTop = 0) {
+      viewport.height = height;
+      viewport.offsetTop = offsetTop;
+      viewport.dispatchEvent(new Event("resize"));
+    },
+    texts() { return worker.posted.filter((m) => m.mcwebText).map((m) => m.mcwebText); },
+    keys() {
+      return worker.posted.filter((m) => m.mcwebDom && m.mcwebDom.type.startsWith("key"))
+        .map((m) => m.mcwebDom.type + ":" + m.mcwebDom.init.code);
+    },
+    clear() { worker.posted.length = 0; focusAtTouchEnd.length = 0; },
+    proxyFocused() { return document.activeElement === document.querySelector(".mcweb-gc-text-proxy"); },
+  };
+</script>
diff --git a/web/vm-identity.mjs b/web/vm-identity.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4e5170631c183ba5a7be0674fe9eaa2b157bef63
--- /dev/null
+++ b/web/vm-identity.mjs
@@ -0,0 +1,45 @@
+const JVM_PATHS = ['/jdk/bin/libjvm.so', '/jdk/lib/zero/libjvm.so'];
+
+// Hash the selected external VM before startup, then compare mounted bytes
+// synchronously in Emscripten's initialization hook, before Java main runs.
+export async function prepareVmIdentity(record, { ios = false, modules,
+  baseURL = globalThis.location?.href, release = '', fetchImpl = fetch,
+  report = value => { globalThis.__mcWebVmIdentity = value; } } = {}) {
+  if (!record || !Number.isSafeInteger(record.bytes) || record.bytes <= 0
+      || !/^[a-f0-9]{64}$/.test(record.sha256)) throw new Error('Invalid JVM identity record');
+  let expected = null, module;
+  if (ios) {
+    if (!(modules?.['libjvm.so'] instanceof WebAssembly.Module))
+      throw new Error('The pinned iPhone JVM module was not compiled');
+  } else {
+    const url = new URL('libjvm.so', baseURL);
+    if (release) url.searchParams.set('release', release);
+    const response = await fetchImpl(url, { credentials: 'same-origin', cache: 'no-store' });
+    if (!response.ok) throw new Error('Could not verify the selected JVM');
+    expected = new Uint8Array(await response.arrayBuffer());
+    const sha256 = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', expected)),
+      value => value.toString(16).padStart(2, '0')).join('');
+    if (expected.length !== record.bytes || sha256 !== record.sha256)
+      throw new Error('Selected JVM differs from its release identity');
+  }
+  return Object.freeze({
+    preRun(value) { module = value; },
+    onRuntimeInitialized() {
+      const checkedPaths = [];
+      if (!ios) {
+        if (!module?.FS?.readFile || !expected) throw new Error('JVM identity hook ran before MEMFS');
+        for (const path of JVM_PATHS) {
+          const actual = module.FS.readFile(path);
+          if (actual.length !== expected.length) throw new Error('Packaged JVM identity differs: ' + path);
+          for (let i = 0; i < expected.length; i++) {
+            if (actual[i] !== expected[i]) throw new Error('Packaged JVM identity differs: ' + path);
+          }
+          checkedPaths.push(path);
+        }
+        expected = null;
+      }
+      report({ ...record, accepted: true, checkedPaths,
+        mechanism: ios ? 'ios-pinned-external-libjvm-module' : 'desktop-vfs-byte-readback' });
+    }
+  });
+}
