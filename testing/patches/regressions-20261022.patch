+import { expect, test, type Page } from "@playwright/test";
+
+// The page half of the native-keyboard bridge (web/game-controls.js), driven
+// with trusted touches and keys in Chromium. The game's half is played by the
+// test: it posts text-input reports the way webgpu-host.js does, and reads what
+// the page sends back. Chromium on a desktop has no on-screen keyboard, so the
+// iPhone keyboard itself is checked on the device (docs/LOCAL-PLAYTEST.md).
+
+const FIELD = { x: 400, y: 300, w: 480, h: 40 };   // canvas pixels, canvas is 1280x720 at 640x360 CSS
+
+declare global {
+  interface Window {
+    textCheck: {
+      report(state: unknown): void;
+      grab(wanted: boolean): void;
+      keyboard(height: number, offsetTop?: number): void;
+      texts(): Array<{ kind: string; text: string; cursor?: number; selection?: number }>;
+      keys(): string[];
+      clear(): void;
+      proxyFocused(): boolean;
+      focusAtTouchEnd: Array<string | null>;
+      worker: { posted: Array<Record<string, unknown>> };
+      controls: {
+        setReady(v: boolean): void; releaseAll(): void; getState(): { ready: boolean; keyboard: string; held: string[] };
+      };
+    };
+  }
+}
+
+async function cssPoint(page: Page, x: number, y: number) {
+  const box = await page.locator("#game-canvas").boundingBox();
+  expect(box).not.toBeNull();
+  return { x: box!.x + x / 2, y: box!.y + y / 2 };
+}
+
+async function tapCanvas(page: Page, x: number, y: number) {
+  const point = await cssPoint(page, x, y);
+  await page.touchscreen.tap(point.x, point.y);
+}
+
+const state = (active: boolean, focused: boolean, extra: object = {}) => ({
+  active,
+  owner: active ? "widget" : null,
+  area: active ? { x: FIELD.x + 8, y: FIELD.y + 6, w: 2, h: 20 } : null,
+  fields: [{ ...FIELD, focused }],
+  ...extra,
+});
+
+test.describe("native keyboard bridge", () => {
+  test.use({ viewport: { width: 700, height: 460 }, hasTouch: true });
+
+  test.beforeEach(async ({ page }) => {
+    await page.goto("/text-input-check.html");
+    // The page asks the GPU Worker for the current state as soon as it attaches.
+    await expect.poll(() => page.evaluate(() =>
+      window.textCheck.worker.posted.some((m) => m.mcwebTextInputQuery === true))).toBe(true);
+    await page.evaluate(() => window.textCheck.clear());
+  });
+
+  test("a tap on a reported field focuses the textarea inside the touch, before the first frames", async ({ page }) => {
+    await page.evaluate((s) => window.textCheck.report(s), state(false, false));
+    expect(await page.evaluate(() => window.textCheck.controls.getState().ready)).toBe(false);
+
+    await tapCanvas(page, FIELD.x + FIELD.w / 2, FIELD.y + FIELD.h / 2);
+    expect(await page.evaluate(() => window.textCheck.proxyFocused())).toBe(true);
+    expect(await page.evaluate(() => window.textCheck.focusAtTouchEnd)).toEqual(["mcweb-gc-text-proxy"]);
+    expect(await page.evaluate(() => window.textCheck.controls.getState().keyboard)).toBe("open");
+  });
+
+  test("taps beside the field, drags and two-finger gestures never open it", async ({ page }) => {
+    await page.evaluate((s) => window.textCheck.report(s), state(false, false));
+    await tapCanvas(page, 100, 100);
+    expect(await page.evaluate(() => window.textCheck.proxyFocused())).toBe(false);
+
+    const from = await cssPoint(page, FIELD.x + 20, FIELD.y + 20);
+    const client = await page.context().newCDPSession(page);
+    await client.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [{ x: from.x, y: from.y }] });
+    await client.send("Input.dispatchTouchEvent", { type: "touchMove", touchPoints: [{ x: from.x + 60, y: from.y }] });
+    await client.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] });
+    expect(await page.evaluate(() => window.textCheck.proxyFocused())).toBe(false);
+
+    await client.send("Input.dispatchTouchEvent", { type: "touchStart",
+      touchPoints: [{ x: from.x, y: from.y, id: 1 }, { x: from.x + 30, y: from.y, id: 2 }] });
+    await client.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] });
+    expect(await page.evaluate(() => window.textCheck.proxyFocused())).toBe(false);
+    expect(await page.evaluate(() => window.textCheck.texts())).toEqual([]);
+  });
+
+  test("typed Unicode, Backspace and Enter reach the game exactly once", async ({ page }) => {
+    await page.evaluate((s) => window.textCheck.report(s), state(true, true));
+    await tapCanvas(page, FIELD.x + 10, FIELD.y + 10);
+    expect(await page.evaluate(() => window.textCheck.proxyFocused())).toBe(true);
+    await page.evaluate(() => window.textCheck.clear());
+
+    await page.keyboard.type("hé");
+    await page.keyboard.insertText("😀");
+    await page.keyboard.press("Backspace");
+    await page.keyboard.press("Enter");
+
+    const texts = await page.evaluate(() => window.textCheck.texts());
+    expect(texts.every((t) => t.kind === "commit")).toBe(true);
+    expect(texts.map((t) => t.text).join("")).toBe("hé😀");
+    // Printable keys type through the text path only; editing keys are keys.
+    expect(await page.evaluate(() => window.textCheck.keys()))
+      .toEqual(["keydown:Backspace", "keyup:Backspace", "keydown:Enter", "keyup:Enter"]);
+    expect(await page.locator(".mcweb-gc-text-proxy").inputValue()).toBe("");
+  });
+
+  test("an IME composition is a preedit, then one commit", async ({ page }) => {
+    await page.evaluate((s) => window.textCheck.report(s), state(true, true));
+    await tapCanvas(page, FIELD.x + 10, FIELD.y + 10);
+    await page.evaluate(() => window.textCheck.clear());
+
+    const client = await page.context().newCDPSession(page);
+    await client.send("Input.imeSetComposition", { text: "にほ", selectionStart: 2, selectionEnd: 2 });
+    await client.send("Input.insertText", { text: "日本" });
+
+    const texts = await page.evaluate(() => window.textCheck.texts());
+    expect(texts).toContainEqual({ kind: "preedit", text: "にほ", cursor: 2, selection: 0 });
+    expect(texts.filter((t) => t.kind === "commit").map((t) => t.text)).toEqual(["日本"]);
+    expect(texts.at(-2)).toEqual({ kind: "preedit", text: "", cursor: 0, selection: 0 });
+    expect(await page.evaluate(() => window.textCheck.keys())).toEqual([]);
+  });
+
+  test("text inserted after a composition, with no key between, is never dropped", async ({ page }) => {
+    await page.evaluate((s) => window.textCheck.report(s), state(true, true));
+    await tapCanvas(page, FIELD.x + 10, FIELD.y + 10);
+    await page.evaluate(() => window.textCheck.clear());
+
+    const client = await page.context().newCDPSession(page);
