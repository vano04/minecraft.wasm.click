+test("real GPU preserves buffer selections across ranges, formats, lowered topology and passes", async ({page}) => {
+  const pageErrors: string[] = [], validationErrors: string[] = [];
+  page.on("pageerror", (error) => pageErrors.push(String(error)));
+  page.on("console", (message) => {
+    if (/\[(?:WebGPU (?:validation|oom)|GPU-ERROR|GPU-TEXTURE-VALIDATION|build validation error|pipeline create error)\]|\[shader\] fixture-/.test(message.text()))
+      validationErrors.push(message.text());
+  });
+  await page.route("**/graal/**", (route) => route.fulfill({
+    status: 200, contentType: "application/javascript", body: "",
+  }));
+  await page.goto("/frame-pacing-check.html");
+  await page.waitForFunction(() => globalThis.mcWebGpu?.isReady());
+  await page.addScriptTag({url: "/shader-glue.js"});
+  const result = await page.evaluate(async () => {
+    const host = globalThis.mcWebGpu;
+    if (!host) throw new Error("the WebGPU host is not installed");
+    const vertex = `struct Out { @builtin(position) position: vec4<f32>, @location(0) color: vec4<f32> };
+      @vertex fn main(@location(0) Position: vec2<f32>, @location(1) Color: vec4<f32>) -> Out {
+        var out: Out; out.position = vec4<f32>(Position, 0.0, 1.0); out.color = Color; return out;
+      }`;
+    const fragment = `@fragment fn main(@location(0) color: vec4<f32>) -> @location(0) vec4<f32> { return color; }`;
+    globalThis.mcWebShaderTranslate = (_glsl, stage) => ({status: 0, text: stage === "vertex" ? vertex : fragment});
+    const buffers: number[] = [], textures: number[] = [];
+    try {
+      const pipelineSpec = {
+        vertexShader: "fixture", fragmentShader: "fixture",
+        vertexSource: "#version 330\nvoid main() { gl_Position = vec4(0.0); }",
+        fragmentSource: "#version 330\nlayout(location=0) out vec4 fixtureColor; void main() { fixtureColor = vec4(0.0); }",
+        vertexFormats: [{stride: 24, elements: [
+          {name: "Position", format: "RG32_FLOAT", offset: 0},
+          {name: "Color", format: "RGBA32_FLOAT", offset: 8},
+        ]}],
+        bindGroups: [], colorTargets: [{format: "RGBA8_UNORM"}],
+      };
+      const triangles = host.createPipeline(JSON.stringify({...pipelineSpec, label: "fixture-buffer-TRIANGLES", topology: "TRIANGLES"}));
+      const quads = host.createPipeline(JSON.stringify({...pipelineSpec, label: "fixture-buffer-QUADS", topology: "QUADS"}));
+      const split = host.createPipeline(JSON.stringify({
+        ...pipelineSpec, label: "fixture-buffer-split", topology: "TRIANGLES",
+        vertexFormats: [
+          {stride: 24, elements: [{name: "Position", format: "RG32_FLOAT", offset: 0}]},
+          {stride: 24, elements: [{name: "Color", format: "RGBA32_FLOAT", offset: 8}]},
+        ],
+      }));
+      const colors = [[255, 0, 0, 255], [0, 255, 0, 255], [0, 0, 255, 255], [255, 255, 0, 255],
+        [255, 0, 255, 255], [0, 255, 255, 255], [255, 255, 255, 255], [255, 128, 0, 255]];
+      const vertices = new Float32Array(8 * 4 * 6);
+      colors.forEach((color, cell) => {
+        const lo = -1 + cell / 4, hi = lo + 0.25;
+        [[lo, -1], [hi, -1], [hi, 1], [lo, 1]].forEach((position, i) =>
+          vertices.set([...position, ...color.map((c) => c / 255)], (cell * 4 + i) * 6));
+      });
+      const alternate = vertices.slice();
+      for (let i = 0; i < 4; i++)
+        alternate.set(vertices.subarray((6 * 4 + i) * 6, (6 * 4 + i + 1) * 6), (5 * 4 + i) * 6);
+      const buffer = (label: string, usage: number, data: Float32Array | Uint16Array | Uint32Array) => {
+        const handle = host.createBuffer(label, usage | 8, data.byteLength);
+        buffers.push(handle);
+        host.writeBufferRaw(handle, 0, new Uint8Array(data.buffer, data.byteOffset, data.byteLength));
+        return handle;
+      };
+      const vb = buffer("fixture-buffer-vertices", 32, vertices);
+      const other = buffer("fixture-buffer-alternate", 32, alternate);
+      const index16 = buffer("fixture-buffer-indices16", 64, new Uint16Array([0, 1, 2, 0, 1, 2]));
+      const index32 = buffer("fixture-buffer-indices32", 64, new Uint32Array([0, 2, 3, 0, 2, 3]));
+      const target = host.createTexture("fixture-buffer-target", 15, "RGBA8_UNORM", 8, 2, 1, 1);
+      textures.push(target);
+      const view = host.createTextureView(target, 0, 1, "2d");
+      const encoder = host.createCommandEncoder();
+      const pass = host.beginRenderPass(encoder, JSON.stringify({color: [{view, clear: [0, 0, 0, 0]}], height: 2}));
+      const draw = (p: number, base = 0) => host.rpDrawIndexed(p, 6, 1, 0, base, 0);
+      host.rpSetPipeline(pass, triangles);
+      host.rpSetVertexBuffer(pass, 0, vb, 0, 96);
+      host.rpSetIndexBuffer(pass, index16, "uint16");
+      for (let i = 0; i < 8; i++) draw(pass);
+      host.rpSetVertexBuffer(pass, 0, vb, 0, 192);
+      draw(pass, 4);
+      host.rpSetPipeline(pass, quads);
+      host.rpSetVertexBuffer(pass, 0, vb, 192, 96);
+      host.rpDraw(pass, 0, 4, 1, 0);
+      // The lowered quad changed the native index buffer without changing the logical one.
+      host.rpSetPipeline(pass, triangles);
+      host.rpSetVertexBuffer(pass, 0, vb, 288, 96);
+      draw(pass);
+      host.rpSetIndexBuffer(pass, index32, "uint32");
+      host.rpSetVertexBuffer(pass, 0, vb, 384, 96);
+      draw(pass);
+      // The same bytes form only degenerate triangles when interpreted as uint16.
+      host.rpSetIndexBuffer(pass, index32, "uint16");
+      host.rpSetVertexBuffer(pass, 0, vb, 480, 96);
+      draw(pass);
+      host.rpSetIndexBuffer(pass, index16, "uint16");
+      host.rpSetVertexBuffer(pass, 0, other, 480, 96);
+      draw(pass);
+      host.rpEnd(pass);
+      const next = host.beginRenderPass(encoder, JSON.stringify({color: [{view}], height: 2}));
+      host.rpSetPipeline(next, split);
+      host.rpSetVertexBuffer(next, 0, vb, 0, vertices.byteLength);
+      host.rpSetVertexBuffer(next, 1, vb, 0, vertices.byteLength);
+      host.rpSetIndexBuffer(next, index16, "uint16");
+      draw(next, 28);
+      host.rpEnd(next);
+      host.submit(encoder);
+      const read = await host._textureSamples("fixture-buffer-target", []);
+      return {error: read.error ?? null, size: read.size, nonzero: read.nonzero, first: read.first};
+    } finally {
+      for (const handle of textures) host.destroyTexture(handle);
+      for (const handle of buffers) host.destroyBuffer(handle);
+      host.submit(host.createCommandEncoder());
+    }
+  });
+  expect(result).toEqual({error: null, size: [8, 2], nonzero: 8, first: [
+    [2, 0, 0, 0, 255, 255], [4, 0, 255, 0, 255, 255],
+    [0, 1, 255, 0, 0, 255], [1, 1, 0, 255, 0, 255], [2, 1, 0, 0, 255, 255],
+    [3, 1, 255, 255, 0, 255], [6, 1, 255, 255, 255, 255], [7, 1, 255, 128, 0, 255],
+  ]});
+  await page.waitForTimeout(100);
+  expect(await page.evaluate(() => globalThis.mcWebGpu?._gpuErrors?.count ?? 0)).toBe(0);
+  expect(await page.evaluate(() => globalThis.mcWebGpu?._valErrors ?? [])).toEqual([]);
+  expect(validationErrors).toEqual([]);
+  expect(pageErrors).toEqual([]);
+});
