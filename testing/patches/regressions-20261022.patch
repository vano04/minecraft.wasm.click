 if [ ! -f "$DATA" ] || [ -n "$(find "$OJ/tests/classes" -newer "$DATA" -name '*.class' | head -1)" ] \
     || [ "$OJ/work/jdk-min/lib/zero/libjvm.so" -nt "$DATA" ]; then
@@ -55,6 +55,7 @@ check JitVolatile '^volatile' JitVolatile
 check JitClassCast '^cast' JitClassCast
 check JitDirect '^direct' JitDirect
 check JitUnsafe '^unsafe' JitUnsafe
+check JitUnaligned '^unaligned' JitUnaligned
 check JitFramed '^framed' JitFramed
 check JitThreadLocal '^tl' JitThreadLocal
 check JitNested '^nested' JitNested
@@ -72,4 +73,57 @@ check JitRem '^rem' JitRem
 check JitRecordGc '^rgc' JitRecordGc
 check JitRecordShape '^shape' JitRecordShape
