+test("real GPU orders texture uploads, isolates mip/layer clears and honors sampler LOD", async ({page}) => {
+  const errors: string[] = [];
+  page.on("pageerror", (error) => errors.push(String(error)));
+  page.on("console", (message) => {
+    if (/\[(?:WebGPU (?:validation|oom)|GPU-ERROR|GPU-TEXTURE-VALIDATION|build validation error|pipeline create error)\]|\[shader\] fixture-/.test(message.text()))
+      errors.push(message.text());
+  });
+  await page.route("**/graal/**", (route) => route.fulfill({
+    status: 200, contentType: "application/javascript", body: "",
+  }));
+  await page.goto("/frame-pacing-check.html");
+  await page.waitForFunction(() => globalThis.mcWebGpu?.isReady());
+  await page.addScriptTag({url: "/shader-glue.js"});
+  const result = await page.evaluate(async () => {
+    const host = globalThis.mcWebGpu;
+    if (!host) throw new Error("the WebGPU host is not installed");
+    const textures: number[] = [], views: number[] = [];
+    const texture = (name: string, layers = 1, mips = 1, format = "RGBA8_UNORM") => {
+      const handle = host.createTexture("fixture-subresource-" + name, 15, format, 4, 4, layers, mips);
+      textures.push(handle);
+      return handle;
+    };
+    const view = (handle: number, mip: number, count = 1) => {
+      const handleView = host.createTextureView(handle, mip, count, "2d");
+      views.push(handleView);
+      return handleView;
+    };
+    const upload = (handle: number, color: number[], mip = 0, layer = 0) => {
+      const size = 4 >> mip, bytes = new Uint8Array(size * size * 4);
+      for (let i = 0; i < bytes.length; i += 4) bytes.set(color, i);
+      host.writeTextureRaw(handle, bytes, mip, layer, 0, 0, size, size, size * 4, size);
+    };
+    const read = async (name: string, mip = 0, layer = 0) => {
+      const pixels = await host._textureSamples("fixture-subresource-" + name, [], mip, layer);
+      if (pixels.error) throw new Error(pixels.error);
+      return {size: pixels.size, first: pixels.first};
+    };
+    try {
+      const source = texture("source", 2, 3), destination = texture("copy");
+      upload(source, [255, 0, 0, 255]);
+      upload(source, [0, 255, 0, 255], 1);
+      upload(source, [255, 255, 0, 255], 2);
+      const encoder = host.createCommandEncoder();
+      host.copyTexture(encoder, source, destination, 0, 0, 0, 0, 4, 4, 0);
+      // This write must not overtake the already recorded copy.
+      upload(source, [0, 0, 255, 255]);
+      host.clearColorTexture(encoder, source, 0, 1, 1, 1);
+      // Nor may a recorded clear erase a later upload at submission time.
+      upload(source, [255, 0, 0, 255]);
+      upload(source, [255, 0, 255, 255], 0, 1);
+      const mipView = view(source, 1);
+      const pass = host.beginRenderPass(encoder, JSON.stringify({
+        color: [{view: mipView, clear: [0, 1, 0, 1]}], height: 4,
+      }));
+      host.rpDisableScissor(pass);
+      host.rpScissor(pass, -1, -1, 3, 3);
+      host.rpEnd(pass);
+      const depth = texture("depth", 1, 3, "D32_FLOAT");
+      host.clearColorAndDepthRegion(encoder, source, 1, 1, 1, 1, depth, 0.5, 1, 1, 1, 1, 1);
+      host.submit(encoder);
+      const copy = await read("copy"), base = await read("source");
+      const mip = await read("source", 1), layer = await read("source", 0, 1);
+      const mip2 = await read("source", 2), layerMip2 = await read("source", 2, 1);
+
+      const vertex = `@vertex fn main(@builtin(vertex_index) index: u32) -> @builtin(position) vec4<f32> {
+        var p = array<vec2<f32>, 3>(vec2<f32>(-1.0, -1.0), vec2<f32>(3.0, -1.0), vec2<f32>(-1.0, 3.0));
+        return vec4<f32>(p[index], 0.0, 1.0);
+      }`;
+      const fragment = `@group(0) @binding(0) var Source_mcs: sampler;
+        @group(0) @binding(1) var Source_mct: texture_2d<f32>;
+        @fragment fn main() -> @location(0) vec4<f32> {
+          return textureSampleLevel(Source_mct, Source_mcs, vec2<f32>(0.5), 2.0);
+        }`;
+      globalThis.mcWebShaderTranslate = (_source, stage) => ({
+        status: 0, text: stage === "vertex" ? vertex : fragment,
+      });
+      const pipeline = host.createPipeline(JSON.stringify({
+        label: "fixture-subresource-lod", vertexShader: "fixture", fragmentShader: "fixture",
+        vertexSource: "#version 330\nvoid main() { gl_Position = vec4(0.0); }",
+        fragmentSource: "#version 330\nuniform sampler2D Source;\nvoid main() {}",
+        vertexFormats: [], bindGroups: [{uniforms: [], samplers: ["Source"]}],
+        colorTargets: [{format: "RGBA8_UNORM"}], topology: "TRIANGLES",
+      }));
+      const output = texture("sampled");
+      const sampler = host.createSamplerJson(JSON.stringify({min: "NEAREST", mag: "NEAREST", maxLod: 0}));
+      views.push(sampler, pipeline);
+      const sampleEncoder = host.createCommandEncoder();
+      const samplePass = host.beginRenderPass(sampleEncoder, JSON.stringify({color: [{view: view(output, 0)}]}));
+      host.rpSetPipeline(samplePass, pipeline);
+      host.rpBindTexture(samplePass, "Source", view(source, 0, 3), sampler);
+      host.rpDraw(samplePass, 0, 3, 1, 0);
+      host.rpEnd(samplePass);
+      host.submit(sampleEncoder);
+      const sampled = await read("sampled");
+
+      const temporary = texture("temporary"), retained = texture("retained");
+      upload(temporary, [64, 128, 192, 255]);
+      const pending = host.createCommandEncoder();
+      host.copyTexture(pending, temporary, retained, 0, 0, 0, 0, 4, 4, 0);
+      host.destroyTexture(temporary);
+      textures.splice(textures.indexOf(temporary), 1);
+      // Submitting an unrelated encoder must not fence/free this pending copy's source.
+      host.submit(host.createCommandEncoder());
+      const waiting = host.resourceLifetime().pendingDestroy;
+      host.submit(pending);
+      const retainedPixels = await read("retained");
+      return {copy, base, mip, mip2, layer, layerMip2, sampled, waiting, retainedPixels};
+    } finally {
+      for (const handle of views) host.destroyObject(handle);
+      for (const handle of textures) host.destroyTexture(handle);
+      host.submit(host.createCommandEncoder());
+    }
+  });
+  const solid = (size: number, rgba: number[]) => ({
+    size: [size, size],
+    first: Array.from({length: size * size}, (_, i) => [i % size, Math.floor(i / size), ...rgba]),
+  });
+  expect(result.copy).toEqual(solid(4, [255, 0, 0, 255]));
+  expect(result.base).toEqual(solid(4, [255, 0, 0, 255]));
+  expect(result.layer).toEqual(solid(4, [255, 0, 255, 255]));
+  expect(result.mip2).toEqual(solid(1, [0, 255, 255, 255]));
+  expect(result.layerMip2).toEqual(solid(1, [0, 255, 255, 255]));
+  expect(result.mip).toEqual({size: [2, 2], first: [
+    [0, 0, 0, 255, 0, 255], [1, 0, 0, 255, 0, 255],
+    [0, 1, 0, 255, 0, 255], [1, 1, 255, 255, 255, 255],
+  ]});
+  expect(result.sampled).toEqual(solid(4, [255, 0, 0, 255]));
+  expect(result.waiting).toBeGreaterThan(0);
+  expect(result.retainedPixels).toEqual(solid(4, [64, 128, 192, 255]));
+  await page.waitForTimeout(100);
+  expect(await page.evaluate(() => globalThis.mcWebGpu?._gpuErrors?.count ?? 0)).toBe(0);
+  expect(await page.evaluate(() => globalThis.mcWebGpu?._valErrors ?? [])).toEqual([]);
+  expect(errors).toEqual([]);
+});
