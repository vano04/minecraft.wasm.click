+      setReady(value) {
+        readyFlag = Boolean(value);
+        if (typeof opts.isReady !== "function") setReadyState(readyFlag);
+      },
+      setTouchMode,
+      enterFullscreen,
+      exitFullscreen,
+      toggleHelp,
+      releaseAll,
+      layout,
+      setOptions(next) {
+        for (const key of ["tapToUse", "guiScale", "minPhaseMs", "touchLookSpeed", "padLookSpeed", "padInvertY", "padDeadzone", "padLookDeadzone", "transport"]) {
+          if (next && key in next) opts[key] = next[key];
+        }
+        layout();
+      },
+      getState() {
+        const held = [];
+        keySlots.forEach((slot) => { if (slot.down) held.push(slot.code); });
+        for (let i = 0; i < mouseSlots.length; i++) if (mouseSlots[i].down) held.push("Mouse" + i);
+        return Object.assign({}, status, {
+          held,
+          cursor: { x: cursorX, y: cursorY },
+          canvas: { cssWidth: rect.width, cssHeight: rect.height, width: rect.cw, height: rect.ch, guiScale: guiScale() },
+          textInput: {
+            active: textState.active,
+            owner: textState.owner,
+            fields: textState.fields.length,
+            // Canvas pixels, as Java reported them: where a tap opens the keyboard.
+            fieldRects: textState.fields.map((f) => ({ x: f.x, y: f.y, w: f.w, h: f.h, owner: f.focused === true })),
+            reports: textState.reports,
+            focused: document.activeElement === textProxy,
+            composing: textState.composing,
+            shift: textState.shift,
+            // Measured now, for device checks: the field's unlifted top and
+            // bottom and the visible band, all in client CSS px.
+            geometry: keyboardGeometry(),
+            sentCodePoints: textState.sentCodePoints,
+            sentKeys: textState.sentKeys,
+          },
+        });
+      },
+      mapping: MAPPING_HELP,
+      destroy() {
+        if (destroyed) return;
+        releaseAll();
+        if (status.fullscreen !== "off") exitFullscreen();
+        destroyed = true;
+        listeners.abort();
+        clearInterval(syncTimer);
+        clearTimeout(toastTimer);
+        settleFullscreen("off");
+        if (padRaf) cancelAnimationFrame(padRaf);
+        resizeObserver?.disconnect();
+        if (attachedWorker && typeof attachedWorker.removeEventListener === "function") {
+          attachedWorker.removeEventListener("message", onWorkerMessage);
+        }
+        root.remove();
+        exitButton.remove();
+        if (textState.worker && typeof textState.worker.removeEventListener === "function") {
+          textState.worker.removeEventListener("message", onTextWorkerMessage);
+        }
+        textProxy.remove();
+        container.style.removeProperty("--mcweb-gc-kb-shift");
+        container.classList.remove("mcweb-gc-host", "mcweb-gc-host-positioned", "mcweb-gc-fullscreen", "mcweb-gc-css-fullscreen",
+          "mcweb-gc-kb-shifted");
+        document.documentElement.classList.remove("mcweb-gc-scroll-locked");
+        delete container.dataset.mcwebFullscreen;
+        instance = null;
+      },
+    };
+    instance = api;
+    layout();
+    emitStatus();
+    return api;
+  }
+
+  function escapeHtml(text) {
+    return String(text).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
+  }
+
+  function helpHtml() {
+    const rows = (list, cells) => list.map((row) =>
+      "<tr>" + row.slice(0, cells).map((cell, i) => (i ? "<td>" : "<th scope=\"row\">") + escapeHtml(cell) + (i ? "</td>" : "</th>")).join("") + "</tr>").join("");
+    return "<h2>Controller (standard mapping)</h2>"
+      + "<table><thead><tr><th scope=\"col\">Button</th><th scope=\"col\">Playing</th><th scope=\"col\">Menus</th></tr></thead><tbody>"
+      + rows(MAPPING_HELP.controller, 3) + "</tbody></table>"
+      + "<h2>Touch</h2><table><tbody>" + rows(MAPPING_HELP.touch, 2) + "</tbody></table>"
+      + "<p>Keyboard and mouse keep Minecraft's own bindings. Controls follow vanilla defaults; rebinding keys in Minecraft's options does not move them.</p>";
+  }
+
+  globalThis.mcWebGameControls = Object.freeze({
+    create,
+    mapping: MAPPING_HELP,
+    padButtonNames: Object.freeze(PAD_NAMES.slice()),
+    version: 1,
+  });
+})();
diff --git a/web/launch-display.js b/web/launch-display.js
new file mode 100644
index 0000000000000000000000000000000000000000..64000f2c7e08a3b173e412285c0cedd4d3bc6423
--- /dev/null
+++ b/web/launch-display.js
@@ -0,0 +1,135 @@
+// Launch framebuffer for the play page.
+//
+// The OffscreenCanvas handed to the GPU Worker keeps the size it had when it
+// was transferred, and the Worker's page shim reports that size as its layout
+// box at devicePixelRatio 1 (OpenJDK/browser/worker-env.js). So the size picked
+// here, before Play, is the framebuffer the host configures and the size
+// Minecraft reads through its window: it is not a CSS scale. Later window and
+// fullscreen changes only scale that surface on the page.
+//
+// The default is the display-pixel 16:9 fit of the viewport (the 26.3 release's
+// resolution follow-up), with no devicePixelRatio cap. A scale below 100% and
+// the old fixed 1280x720 / 640x360 launch exist only to compare cost against
+// native size; the page always prints the exact size it launched with.
+globalThis.mcWebLaunchDisplay = (() => {
+  const STORAGE_KEY = 'mcweb.launchDisplay';
+  const BASES = {
+    viewport: 'Viewport, display pixels',
+    screen: 'Full screen landscape, display pixels',
+    legacy: 'Fixed 1280x720 (640x360 on iPhone/iPad)',
+  };
+  const SCALES = [1, 0.75, 0.5, 0.25];
+  const MIN_SCALE = 0.25, MAX_SCALE = 1;
+
+  /** The largest whole 16:9 multiple that fits width x height device pixels. */
+  function canvasSize(width, height, pixelRatio = 1) {
+    const scale = Math.max(1, Math.floor(Math.min(width * pixelRatio / 16, height * pixelRatio / 9)));
+    return [scale * 16, scale * 9];
+  }
+
+  function validScale(value) {
+    const scale = Number(value);
+    return Number.isFinite(scale) && scale >= MIN_SCALE && scale <= MAX_SCALE ? scale : null;
+  }
+
+  /** The launch size for a selection, from the current window and screen. */
+  function resolve({ basis, scale }, ios, view = globalThis) {
+    const ratio = view.devicePixelRatio || 1;
+    if (basis === 'legacy') {
+      const [width, height] = ios ? [640, 360] : [1280, 720];
+      return { basis, scale: null, pixelRatio: ratio, width, height };
+    }
+    let cssWidth = view.innerWidth, cssHeight = view.innerHeight;
+    if (basis === 'screen') {
+      // screen.width/height follow the device's natural orientation on
+      // iPadOS; the game is landscape, so take the long side as the width.
+      cssWidth = Math.max(view.screen.width, view.screen.height);
+      cssHeight = Math.min(view.screen.width, view.screen.height);
+    }
+    const [width, height] = canvasSize(cssWidth, cssHeight, ratio * scale);
+    return { basis, scale, pixelRatio: ratio, cssWidth, cssHeight, width, height };
+  }
+
+  function describe(size) {
+    const pixels = (size.width * size.height / 1e6).toFixed(2);
+    const detail = size.basis === 'legacy'
+      ? 'fixed launch size'
+      : Math.round(size.scale * 100) + '% of ' + size.cssWidth + 'x' + size.cssHeight
+        + ' CSS px at devicePixelRatio ' + size.pixelRatio;
+    return size.width + 'x' + size.height + ' (' + pixels + ' MP, ' + detail + ')';
+  }
+
+  /**
+   * Builds the resolution controls in container. Selection order: the query
+   * (?mcweb_resolution=viewport|screen|legacy, ?mcweb_resolution_scale=0.25..1),
+   * then the last choice saved in this browser, then the native viewport.
+   */
+  function mount({ container, query, ios, write = () => {} }) {
+    let saved = {};
+    try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {}; } catch { saved = {}; }
+    const notes = [];
+    let basis = Object.hasOwn(BASES, saved.basis) ? saved.basis : 'viewport';
+    let scale = validScale(saved.scale) ?? 1;
+    if (query.has('mcweb_resolution')) {
+      const requested = query.get('mcweb_resolution');
+      if (Object.hasOwn(BASES, requested)) basis = requested;
+      else notes.push('ignored ?mcweb_resolution=' + requested);
+    }
+    if (query.has('mcweb_resolution_scale')) {
+      const requested = validScale(query.get('mcweb_resolution_scale'));
+      if (requested !== null) scale = requested;
+      else notes.push('ignored ?mcweb_resolution_scale=' + query.get('mcweb_resolution_scale')
+        + ' (allowed ' + MIN_SCALE + '..' + MAX_SCALE + ')');
+    }
+
+    const label = document.createElement('label');
+    label.className = 'launch-option';
+    label.textContent = 'Resolution ';
+    const basisSelect = document.createElement('select');
+    basisSelect.id = 'launch-resolution';
+    for (const [value, text] of Object.entries(BASES)) basisSelect.add(new Option(text, value));
+    const scaleSelect = document.createElement('select');
+    scaleSelect.id = 'launch-resolution-scale';
+    scaleSelect.title = 'Fraction of display pixels, for comparison only';
+    const scales = SCALES.includes(scale) ? SCALES : [...SCALES, scale].sort((a, b) => b - a);
+    for (const value of scales) scaleSelect.add(new Option(Math.round(value * 100) + '%', String(value)));
+    basisSelect.value = basis;
+    scaleSelect.value = String(scale);
+    const output = document.createElement('output');
+    output.id = 'launch-resolution-size';
+    output.className = 'sub';
+    label.append(basisSelect, ' ', scaleSelect, ' ', output);
+    container.append(label);
+
+    let locked = null;
+    const selection = () => ({ basis: basisSelect.value, scale: Number(scaleSelect.value) });
+    const render = () => {
+      const size = locked || resolve(selection(), ios);
+      scaleSelect.disabled = Boolean(locked) || size.basis === 'legacy';
+      output.value = (locked ? 'launched at ' : '') + describe(size)
+        + (notes.length ? ' - ' + notes.join('; ') : '');
+    };
+    const save = () => {
+      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(selection())); } catch { /* private mode */ }
+      render();
+    };
+    basisSelect.addEventListener('change', save);
+    scaleSelect.addEventListener('change', save);
+    addEventListener('resize', render);
+    globalThis.visualViewport?.addEventListener('resize', render);
+    render();
+
+    return {
+      /** Fixes the size for this page's only launch and returns it. */
+      launch() {
+        locked = resolve(selection(), ios);
+        basisSelect.disabled = true;
+        render();
+        write('[display] launch framebuffer ' + describe(locked));
+        return locked;
+      },
+    };
+  }
+
+  return { canvasSize, resolve, describe, mount, BASES, MIN_SCALE, MAX_SCALE };
+})();
diff --git a/web/memory-profile-worker.js b/web/memory-profile-worker.js
new file mode 100644
index 0000000000000000000000000000000000000000..6335d7c4b3edb5f1f26dcc806e0a909b0802bcf1
--- /dev/null
+++ b/web/memory-profile-worker.js
@@ -0,0 +1,410 @@
+// Opt-in memory profile, run on its own Worker (web/memory-profile.js starts it).
+//
+// It allocates ArrayBuffers in fixed steps and fills every word of each one
+// with non-repeating pseudo-random data, until it reaches the limit, an
+// allocation throws, or the page asks it to stop. Filling faults in the pages
+// and avoids trivially compressible zero-filled allocations. The reported
+// MiB count filled ArrayBuffers, not measured physical footprint. Before
+// every step it durably records
+// (OPFS, synchronous access handle, flushed) the amount it is about to try,
+// and a step counts as completed only after its buffer is fully filled, so a
+// page that is killed mid-step can report afterwards both the last completed
+// amount and the attempted one. It never resumes by itself. The page
+// terminates this Worker when a run ends, which releases every allocation
+// with it.
+//
+// Storage: two alternating slot files under mcweb-memory-profile/ in this
+// origin's private file system, each a whole JSON record with a sequence
+// number; readers take the valid slot with the highest number, so a write cut
+// off half way still leaves the previous record. Nothing else in OPFS is
+// opened, so installed game files and saves are untouched.
+//
+// The launch memory the player applies from a profile is kept apart from the
+// run record and its history, in its own two alternating slots
+// (budget-a.json, budget-b.json; same synchronous handles, flush and
+// highest-valid-sequence rule as above, so a cut-off write leaves the
