+      overLimit.forEach((name, k) => host.rpSetUniform(dynamicPass, name, overLimitRing, (9 + k) * 256, 16));
+      host.rpDraw(dynamicPass, 0, 6, 1, 0);
+      host.rpSetPipeline(dynamicPass, dynamicPipeline);
+      dynamicNames.forEach((name, u) => host.rpSetUniform(dynamicPass, name, dynamicRing, (15 + u) * 256, 16));
+      host.rpDraw(dynamicPass, 0, 6, 1, 0);
+      host.rpEnd(dynamicPass);
+      const overLimitPass = host.beginRenderPass(encoder, JSON.stringify({
+        color: [{view: target("fixture-over-limit-offsets-target", 2), clear: [0, 0, 0, 0]}], height: 1}));
+      host.rpSetPipeline(overLimitPass, overLimitPipeline);
+      for (let i = 0; i < 2; i++) {
+        overLimit.forEach((name, k) => host.rpSetUniform(overLimitPass, name, overLimitRing, (i * 9 + k) * 256, 16));
+        host.rpDraw(overLimitPass, 0, 6, 1, 0);
+      }
+      host.rpEnd(overLimitPass);
+      host.submit(encoder);
+      const reads = await Promise.all([
+        host._textureSamples("fixture-dynamic-offsets-target", []),
+        host._textureSamples("fixture-over-limit-offsets-target", []),
+      ]);
+      const [dynamic, overLimitRead] = reads.map(({error, size, nonzero, first}) =>
+        ({error: error ?? null, size, nonzero, first}));
+      return {dynamic, overLimit: overLimitRead};
+    } finally {
+      for (const handle of textures) host.destroyTexture(handle);
+      for (const handle of buffers) host.destroyBuffer(handle);
+      // Submit so the production lifetime queue uses a real GPU fence.
+      host.submit(host.createCommandEncoder());
+    }
+  });
+  // Columns 0/1 retain dynamic draws, column 2 retains the same-pass static
+  // cache miss, and column 3 reads the cached dynamic group after restoration.
+  expect(result.dynamic).toEqual({error: null, size: [4, 1], nonzero: 4, first: [
+    [0, 0, 40, 30, 200, 255], [1, 0, 80, 60, 150, 245], [2, 0, 66, 86, 106, 126], [3, 0, 160, 120, 50, 225],
+  ]});
+  // Channel c of column i: 10(c+1) + 10(c+5) + 6i.
+  expect(result.overLimit).toEqual({error: null, size: [2, 1], nonzero: 2, first: [
+    [0, 0, 60, 80, 100, 120], [1, 0, 66, 86, 106, 126],
+  ]});
+  // Error scopes and uncaptured errors arrive asynchronously after submit.
+  await page.waitForTimeout(100);
+  expect(await page.evaluate(() => globalThis.mcWebGpu?._gpuErrors?.count ?? 0)).toBe(0);
+  expect(await page.evaluate(() => globalThis.mcWebGpu?._valErrors ?? [])).toEqual([]);
+  expect(validationErrors).toEqual([]);
+  expect(pageErrors).toEqual([]);
+});
