diff --git a/tools/graphics-pack-cycle.mjs b/tools/graphics-pack-cycle.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..aecff781d429138985fdf38dde092d748c98195c
--- /dev/null
+++ b/tools/graphics-pack-cycle.mjs
@@ -0,0 +1,122 @@
+import {performance} from "node:perf_hooks";
+import {GRAPHICS_PACK_NAME, GRAPHICS_PACK_MARKER, readGraphicsPackSelection,
+  graphicsPipelineRevision, captureGraphicsResourceCensus} from "./graphics-pack-fixture.mjs";
+import {runMenuGraphicsCheck} from "./menu-graphics-check.mjs";
+
+// Uses native Minecraft widgets/keyboard navigation. It never writes options,
+// selects a pack through Java internals, creates a world, or accepts a dialog.
+// Call in a freshly created/owned test world, with the fixture mounted pre-boot.
+export async function runGraphicsPackCycle({page, getScreen, getWidgets, clickWidget,
+  framesNow, captureNative, getNativeInputSequence, awaitNativeInputReady,
+  timeoutMs = 60000, measureMenus = false, fixtureName = GRAPHICS_PACK_NAME,
+  fixtureMarker = GRAPHICS_PACK_MARKER,
+  fixtureScope = "original folder pack; not the unavailable user pack or server-pack HTTP transport"}) {
+  const evidence = {fixture: fixtureName, phases: [], scope: fixtureScope};
+  const screenIs = (screen, name) => name === "<none>" ? !screen || screen === "<none>" :
+    typeof screen === "string" && (screen === name || screen.endsWith("." + name));
+  async function until(description, predicate) {
+    const deadline = performance.now() + timeoutMs;
+    while (performance.now() < deadline) {
+      const value = await predicate();
+      if (value) return value;
+      await new Promise((resolve) => setTimeout(resolve, 25));
+    }
+    throw new Error("native pack cycle timed out: " + description);
+  }
+  async function settledScreen(name, afterSequence = -1) {
+    await until(name, async () => screenIs(await getScreen(), name));
+    const frame = await framesNow();
+    await until("fresh client frame on " + name, async () => (await framesNow()) > frame);
+    if (!screenIs(await getScreen(), name)) throw new Error("screen changed after settling " + name);
+    await awaitNativeInputReady({ screen: name, afterSequence });
+  }
+  async function click(labels, expected) {
+    const afterSequence = getNativeInputSequence();
+    await clickWidget(labels);
+    await settledScreen(expected, afterSequence);
+  }
+  async function capture(name) {
+    const bytes = await captureNative(name);
+    if (!Buffer.isBuffer(bytes) || !bytes.length) throw new Error("native capture did not return PNG bytes: " + name);
+    return {name, bytes: bytes.length, screen: await getScreen()};
+  }
+  async function state() {
+    const selection = await readGraphicsPackSelection(page);
+    return {...selection, pipelineRevision: await graphicsPipelineRevision(page),
+      resources: await captureGraphicsResourceCensus(page)};
+  }
+  async function changePack(enable) {
+    await page.keyboard.press("Escape"); await settledScreen("PauseScreen");
+    await click(["Options...", "Options…", "Options"], "OptionsScreen");
+    await click(["Resource Packs...", "Resource Packs…", "Resource Packs"], "PackSelectionScreen");
+    const widgets = await getWidgets();
+    const search = widgets.find((widget) => widget.label === "EditBox");
+    const lists = widgets.filter((widget) => widget.label === "TransferableSelectionList").sort((a, b) => a.x - b.x);
+    if (!search || lists.length !== 2) throw new Error("unexpected native pack search/list widgets: " + JSON.stringify(widgets));
+    await clickWidget(["EditBox"]);
+    await page.keyboard.press("ControlOrMeta+A");
+    await page.keyboard.type(fixtureName);
+    // Native init order is search -> available list -> selected list. With a
+    // fresh profile the fixture is the sole searched result. ArrowDown moves
+    // from the list heading onto that PackEntry; Enter invokes its real transfer.
+    await page.keyboard.press("Tab");
+    if (!enable) await page.keyboard.press("Tab");
+    await page.keyboard.press("ArrowDown");
+    await page.keyboard.press("Enter");
+    const listCapture = await capture(enable ? "pack-enable-selection" : "pack-disable-selection");
+    await click(["Done"], "OptionsScreen");
+    const selection = await until("native persisted pack selection " + enable, async () => {
+      const value = await readGraphicsPackSelection(page);
+      return value.selected.some((id) => id.includes(fixtureName)) === enable ? value : null;
+    });
+    await page.keyboard.press("Escape"); await settledScreen("PauseScreen");
+    const markerPresent = fixtureMarker
+      ? (await getWidgets()).some((widget) => widget.label === fixtureMarker) : null;
+    if (fixtureMarker && markerPresent !== enable)
+      throw new Error("native translated Pause widget does not match selected pack");
+    const pauseCapture = await capture(enable ? "pack-enabled-pause" : "pack-disabled-pause");
+    await page.keyboard.press("Escape"); await settledScreen("<none>");
+    return {selection, markerPresent, listCapture, pauseCapture};
+  }
+  try {
+    await settledScreen("<none>");
+    const initial = await state();
+    if (initial.selected.some((id) => id.includes(fixtureName)))
+      throw new Error("pack cycle requires the fixture initially disabled in an owned fresh profile");
+    evidence.phases.push({phase: "baseline", ...initial, capture: await capture("pack-baseline-world")});
+    const enabled = await changePack(true);
+    await until("real GPU pipeline creation after pack apply", async () =>
+      (await graphicsPipelineRevision(page)) > initial.pipelineRevision);
+    evidence.phases.push({phase: "enabled", ...enabled, ...await state(), capture: await capture("pack-enabled-world")});
+    if (measureMenus) {
+      evidence.enabledMenus = await runMenuGraphicsCheck({
+        page, phase: "world", getScreen, getWidgets, clickWidget, framesNow, captureNative,
+        getNativeInputSequence, awaitNativeInputReady,
+        capturePrefix: "pack-enabled-",
+      });
+    }
+    const beforeReload = await graphicsPipelineRevision(page);
+    const reloadSequence = getNativeInputSequence();
+    await page.keyboard.down("F3");
+    try { await page.keyboard.press("t"); } finally { await page.keyboard.up("F3"); }
+    await until("real GPU pipeline creation after native F3+T reload", async () =>
+      (await graphicsPipelineRevision(page)) > beforeReload);
+    await settledScreen("<none>", reloadSequence);
+    await page.keyboard.press("Escape"); await settledScreen("PauseScreen");
+    if (fixtureMarker && !(await getWidgets()).some((widget) => widget.label === fixtureMarker))
+      throw new Error("native pack marker disappeared after F3+T reload");
+    const reloadPause = await capture("pack-reloaded-pause");
+    await page.keyboard.press("Escape"); await settledScreen("<none>");
+    evidence.phases.push({phase: "reloaded", ...await state(), reloadPause,
+      capture: await capture("pack-reloaded-world")});
+    const disabled = await changePack(false);
+    evidence.phases.push({phase: "disabled", ...disabled, ...await state(), capture: await capture("pack-disabled-world")});
+    return evidence;
+  } catch (error) {
+    if (error.menuGraphicsEvidence) evidence.enabledMenus = error.menuGraphicsEvidence;
+    try { evidence.failure = await capture("pack-cycle-failure"); }
+    catch (captureError) { evidence.captureError = String(captureError); }
+    error.graphicsPackEvidence = evidence;
+    throw error;
+  }
+}
diff --git a/tools/graphics-pack-fixture.mjs b/tools/graphics-pack-fixture.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8ec411276b847ec14bffc5bc8ffe3b7eba4c1205
--- /dev/null
+++ b/tools/graphics-pack-fixture.mjs
@@ -0,0 +1,183 @@
+// Original diagnostic artwork only. Mount into an owned fresh test profile;
+// Minecraft's ordinary pack screen selects and reloads these files itself.
+import {deflateSync} from "node:zlib";
+import {createHash} from "node:crypto";
+import {readFileSync} from "node:fs";
+import {mkdir, writeFile} from "node:fs/promises";
+import {basename, dirname, join, resolve} from "node:path";
+import {fileURLToPath} from "node:url";
+
+export const GRAPHICS_PACK_NAME = "MCWeb_Graphics_Fixture";
+export const GRAPHICS_PACK_MARKER = "MC-Web texture fixture active";
+export const GRAPHICS_PACK_ROOT = "/tmp/mcgame/resourcepacks/" + GRAPHICS_PACK_NAME;
+
+function crc32(bytes) {
+  let crc = 0xffffffff;
+  for (const byte of bytes) {
+    crc ^= byte;
+    for (let bit = 0; bit < 8; bit++) crc = (crc >>> 1) ^ (crc & 1 ? 0xedb88320 : 0);
+  }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+function chunk(type, bytes) {
+  const name = Buffer.from(type), length = Buffer.alloc(4), crc = Buffer.alloc(4);
+  length.writeUInt32BE(bytes.length);
+  crc.writeUInt32BE(crc32(Buffer.concat([name, bytes])));
+  return Buffer.concat([length, name, bytes, crc]);
+}
+function png(width, height, colors) {
+  const header = Buffer.alloc(13);
+  header.writeUInt32BE(width, 0); header.writeUInt32BE(height, 4);
+  header[8] = 8; header[9] = 6;
+  const rows = Buffer.alloc((width * 4 + 1) * height);
+  for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
+    const cell = ((x >> 2) ^ (y >> 2)) & 1;
+    const frame = Math.floor(y / width);
+    const color = colors[(cell + frame) % colors.length];
+    rows.set([...color, 255], y * (width * 4 + 1) + 1 + x * 4);
+  }
+  return Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),
+    chunk("IHDR", header), chunk("IDAT", deflateSync(rows)), chunk("IEND", Buffer.alloc(0))]);
+}
+
+export function createGraphicsPackFixture() {
+  const json = (value) => Buffer.from(JSON.stringify(value) + "\n");
+  const files = {
+    "pack.mcmeta": json({pack: {description: "MC-Web original graphics regression fixture",
+      pack_format: 97, min_format: [97, 0], max_format: [97, 1]}}),
+    "pack.png": png(32, 32, [[255, 0, 255], [0, 255, 255]]),
+    "assets/minecraft/lang/en_us.json": json({"menu.returnToGame": GRAPHICS_PACK_MARKER}),
+  };
+  const colors = {
+    grass_block_top: [[245, 30, 220], [20, 235, 220]],
+    grass_block_side: [[240, 170, 20], [25, 75, 240]],
+    dirt: [[245, 140, 20], [120, 35, 210]],
+    stone: [[235, 30, 40], [30, 220, 230]],
+    oak_planks: [[30, 230, 70], [35, 45, 230]],
+  };
+  for (const [name, palette] of Object.entries(colors))
+    files[`assets/minecraft/textures/block/${name}.png`] = png(32, 32, palette);
+  files["assets/minecraft/textures/block/water_still.png"] = png(32, 64, [[240, 40, 160], [20, 220, 240]]);
+  files["assets/minecraft/textures/block/water_still.png.mcmeta"] = json({animation: {
+    width: 32, height: 32, frametime: 2, interpolate: true}});
+  return {name: GRAPHICS_PACK_NAME, marker: GRAPHICS_PACK_MARKER, root: GRAPHICS_PACK_ROOT,
+    files: Object.entries(files).map(([path, bytes]) => ({path, base64: bytes.toString("base64"),
+      bytes: bytes.length, sha256: createHash("sha256").update(bytes).digest("hex")}))};
+}
+
+/** Mount one existing archive as a real Minecraft resource pack without copying or modifying it. */
+export function createArchiveGraphicsPackFixture(path) {
+  const bytes = readFileSync(path);
+  if (bytes.length < 4 || bytes[0] !== 0x50 || bytes[1] !== 0x4b)
+    throw new Error("graphics acceptance pack is not a ZIP archive");
+  const name = basename(path);
+  return {
+    name,
+    marker: null,
+    root: "/tmp/mcgame/resourcepacks",
+    source: {path: resolve(path), url: "/__mcweb-acceptance-pack.zip", bytes: bytes.length,
+      sha256: createHash("sha256").update(bytes).digest("hex")},
+    files: [{path: name, url: "/__mcweb-acceptance-pack.zip", bytes: bytes.length,
+      sha256: createHash("sha256").update(bytes).digest("hex")}],
+  };
+}
+
+// Compose this with the coordinator's existing javavm.js route transformation.
+// The published launcher already uses preRun(module) + module.FS for title
+// assets. No unsupported incoming Module property or renderer substitute is used.
+export function appendGraphicsPackPreRun(script, fixture = createGraphicsPackFixture()) {
+  if (typeof script !== "string" || !script.includes("var createJavaVM ="))
+    throw new Error("expected the released classic createJavaVM factory");
+  if (script.includes("MCWEB_ORIGINAL_GRAPHICS_PACK_PRERUN")) throw new Error("fixture wrapper already installed");
+  return script + `\n;/* MCWEB_ORIGINAL_GRAPHICS_PACK_PRERUN */\n(() => {
+    if (typeof document === 'undefined') return;
+    const original = createJavaVM;
+    const fixture = ${JSON.stringify(fixture)};
+    createJavaVM = async function(options) {
+      const fetched = new Map();
+      for (const file of fixture.files) {
+        if (!file.url) continue;
+        const response = await fetch(file.url, {cache: 'no-store', credentials: 'omit'});
+        if (!response.ok) throw new Error('private graphics acceptance pack fetch failed: ' + response.status);
+        const bytes = new Uint8Array(await response.arrayBuffer());
+        if (bytes.length !== file.bytes) throw new Error('private graphics acceptance pack size changed');
+        const digest = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)),
+          value => value.toString(16).padStart(2, '0')).join('');
+        if (digest !== file.sha256) throw new Error('private graphics acceptance pack hash changed');
+        fetched.set(file.path, bytes);
+      }
+      const previous = options.preRun || [];
+      const hooks = Array.isArray(previous) ? previous.slice() : [previous];
+      hooks.push(function(module) {
+        if (!module.FS || typeof module.FS.mkdirTree !== 'function' || typeof module.FS.writeFile !== 'function')
+          throw new Error('released preRun filesystem exports are missing');
+        for (const file of fixture.files) {
+          const target = fixture.root + '/' + file.path;
+          module.FS.mkdirTree(target.slice(0, target.lastIndexOf('/')));
+          let bytes = fetched.get(file.path);
+          if (!bytes) {
+            const text = atob(file.base64);
+            bytes = new Uint8Array(text.length);
+            for (let i = 0; i < text.length; i++) bytes[i] = text.charCodeAt(i);
+          }
+          module.FS.writeFile(target, bytes);
+        }
+        globalThis.__mcWebGraphicsFixtureModule = module;
+        globalThis.__mcWebGraphicsFixtureMounted = {name: fixture.name, root: fixture.root,
+          files: fixture.files.map(({path, sha256}) => ({path, sha256}))};
+      });
+      return original({...options, preRun: hooks});
+    };
+  })();\n`;
+}
+
+export async function readGraphicsPackSelection(page) {
+  return page.evaluate(() => {
+    const module = globalThis.__mcWebGraphicsFixtureModule;
+    if (!module?.FS) throw new Error("the original graphics fixture was not mounted before boot");
+    const text = module.FS.readFile("/tmp/mcgame/options.txt", {encoding: "utf8"});
+    const line = text.split(/\r?\n/).find((row) => row.startsWith("resourcePacks:"));
+    if (!line) throw new Error("Minecraft has not persisted its native resource-pack selection");
+    const selected = JSON.parse(line.slice("resourcePacks:".length));
+    if (!Array.isArray(selected) || !selected.every((value) => typeof value === "string"))
+      throw new Error("invalid native resourcePacks option");
+    return {selected, mounted: globalThis.__mcWebGraphicsFixtureMounted};
+  });
+}
+
+export async function graphicsPipelineRevision(page) {
+  const targets = [page, ...page.workers().filter((worker) => /gpu-rpc-worker\.js(?:[?#]|$)/.test(worker.url()))];
+  let revision = null;
+  for (const target of targets) {
+    const value = await target.evaluate(() => globalThis.mcWebGpu?._shaderSourceStats?.pipelines ?? null);
+    if (Number.isInteger(value)) revision = Math.max(revision ?? 0, value);
+  }
+  if (revision === null) throw new Error("no live GPU host exposes the real pipeline revision");
+  return revision;
+}
+
+// Cold snapshots only: call outside the frame-timing window. The released host
+// predates this census and must be reported unsupported, not assigned zero use.
+export async function captureGraphicsResourceCensus(page) {
+  const targets = [page, ...page.workers().filter((worker) => /gpu-rpc-worker\.js(?:[?#]|$)/.test(worker.url()))];
+  const hosts = [];
+  for (const target of targets) {
+    const value = await target.evaluate(() => typeof globalThis.mcWebGpu?.resourceLifetime === "function"
+      ? globalThis.mcWebGpu.resourceLifetime() : null);
+    if (value) hosts.push({url: target.url(), ...value});
+  }
+  return {supported: hosts.length > 0, hosts};
+}
+
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const at = process.argv.indexOf("--out"), out = at >= 0 ? process.argv[at + 1] : null;
+  if (!out) throw new Error("usage: node tools/graphics-pack-fixture.mjs --out <private-fixture-directory>");
+  const fixture = createGraphicsPackFixture();
+  for (const file of fixture.files) {
+    const target = join(out, fixture.name, file.path);
+    await mkdir(dirname(target), {recursive: true});
+    await writeFile(target, Buffer.from(file.base64, "base64"));
+  }
+  await writeFile(join(out, "fixture-manifest.json"), JSON.stringify(fixture, null, 2) + "\n");
+}
diff --git a/tools/local-playtest-server.mjs b/tools/local-playtest-server.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8ee06ab78b2a6ea53fa2529cb2be20222b9e525f
--- /dev/null
+++ b/tools/local-playtest-server.mjs
@@ -0,0 +1,248 @@
+// Private HTTPS server for a local playtest stage (tools/local-playtest.mjs).
+//
+// The stage tool copies this file into the stage root, beside stage.json.
+// This private LAN server needs no password or session cookie. It serves only
+// the stage's release-listed runtime/payload and SHA-1-verified Mojang cache.
+// HTTPS, same-origin headers and cross-origin isolation still apply. It never
+// imports or changes the public testing worker or the frozen runtime base.
+// No Minecraft account, multiplayer gateway or relay is served.
+import https from 'node:https';
+import fs from 'node:fs/promises';
+import { createReadStream, createWriteStream } from 'node:fs';
+import { Readable, Transform } from 'node:stream';
+import { pipeline } from 'node:stream/promises';
+import { X509Certificate, createHash, createPrivateKey } from 'node:crypto';
+import { isIP } from 'node:net';
+import { dirname, extname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const stage = JSON.parse(await fs.readFile(root + '/stage.json', 'utf8'));
+const { host, port, origin } = stage;
+const site = root + '/site/testing';
+// stage.json and release.json are read once. Changed settings or served file
+// names require a restart; served file bytes are read on each request.
+const release = JSON.parse(await fs.readFile(root + '/testing/release.json', 'utf8'));
+
+// The key and certificate stage.json names are checked again at start, in
+// case they changed after staging: regular files (not links), a key without
+// group/other permissions, no private key in the certificate file, and a
+// leaf certificate that matches the key, is valid now, names the host and has
+// the fingerprint the stage recorded. Any failure stops the server.
+async function loadTls({ key, cert, fingerprint256 }) {
+  const refuse = (why) => { throw new Error('refusing to serve TLS: ' + why + '; re-stage with tools/local-playtest.mjs'); };
+  if (typeof key !== 'string' || typeof cert !== 'string') refuse('stage.json names no key or certificate');
+  for (const path of [key, cert]) {
+    if (!(await fs.lstat(path)).isFile()) refuse(path + ' is not a regular file');
+  }
+  if ((await fs.stat(key)).mode & 0o077) refuse(key + ' is readable or writable by group or others');
+  const [keyBytes, certBytes] = await Promise.all([fs.readFile(key), fs.readFile(cert)]);
+  if (/PRIVATE KEY-----/.test(certBytes.toString('utf8'))) refuse(cert + ' contains a private key');
+  const leaf = new X509Certificate(certBytes);
+  if (!leaf.checkPrivateKey(createPrivateKey(keyBytes))) refuse(key + ' does not match ' + cert);
+  const now = Date.now();
+  if (!(Date.parse(leaf.validFrom) <= now && now < Date.parse(leaf.validTo))) refuse(cert + ' is not valid now (to ' + leaf.validTo + ')');
+  if (!(isIP(host) ? leaf.checkIP(host) : leaf.checkHost(host))) refuse(cert + ' does not name ' + host);
+  if (fingerprint256 && leaf.fingerprint256 !== fingerprint256) refuse(cert + ' is not the certificate staged');
+  return { key: keyBytes, cert: certBytes };
+}
+const tls = await loadTls(stage.tls || {});
+
+const POLICY = [
+  "default-src 'none'", "base-uri 'none'", "frame-ancestors 'none'", "object-src 'none'",
+  "form-action 'self'", "script-src 'self' blob: 'unsafe-inline' 'unsafe-eval'",
+  "style-src 'self' 'unsafe-inline'", "worker-src 'self' blob:", "img-src 'self' data: blob:",
+  "connect-src 'self' https://piston-data.mojang.com https://piston-meta.mojang.com https://resources.download.minecraft.net https://textures.minecraft.net",
+  "media-src 'self' blob: https://resources.download.minecraft.net",
+].join('; ');
+const SECURITY_HEADERS = {
+  'Cache-Control': 'private, no-store',
+  'Cross-Origin-Opener-Policy': 'same-origin', 'Cross-Origin-Embedder-Policy': 'require-corp',
+  'Cross-Origin-Resource-Policy': 'same-origin', 'Content-Security-Policy': POLICY,
+  'X-Content-Type-Options': 'nosniff', 'X-Frame-Options': 'DENY',
+  'X-Robots-Tag': 'noindex, nofollow, noarchive', 'Referrer-Policy': 'same-origin',
+  'Strict-Transport-Security': 'max-age=31536000; includeSubDomains', Vary: 'User-Agent',
+};
+
+const index = JSON.parse(await fs.readFile(root + '/cache-index.json'));
+const objects = JSON.parse(await fs.readFile(root + '/asset-objects.json'));
+const ownCache = root + '/cache';
+// Caches of the retained runtime, read but never written.
+const readOnlyCaches = stage.readOnlyCaches || [];
+
+// Mojang URL -> SHA-1 for the library/client/index files, so the page's
+// upstream adapter fetches them from the private cache below.
+const sources = Object.fromEntries(Object.entries(index)
+  .filter(([, record]) => !record.url.startsWith('https://resources.download.minecraft.net/'))
+  .map(([hash, record]) => [record.url, hash]));
+const prelude = `(() => {
+  const sources = ${JSON.stringify(sources)};
+  const original = globalThis.fetch.bind(globalThis);
+  globalThis.fetch = (input, init) => {
+    const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
+    let hash = sources[url];
+    const parsed = new URL(url, location.href);
+    if (parsed.origin === location.origin && parsed.pathname.startsWith('/mcweb-audio/'))
+      return original(new URL('/testing/audio/' + parsed.pathname.slice('/mcweb-audio/'.length) + parsed.search, location.href), init);
+    if (parsed.origin === 'https://resources.download.minecraft.net') {
+      const candidate = parsed.pathname.split('/').pop();
+      if (/^[a-f0-9]{40}$/.test(candidate)) hash = candidate;
+    }
+    if (hash) return original(new URL('/testing/cache/' + hash, location.href), init);
+    return original(input, init);
+  };
+})();
+`;
+const upstreamSource = await fs.readFile(site + '/mojang-upstream.js', 'utf8');
+const marker = 'const NO_CORS_HOSTS = new Set(["libraries.minecraft.net", "resources.download.minecraft.net"]);';
+if (upstreamSource.split(marker).length !== 2) throw Error('Unexpected upstream fetch adapter');
+const upstream = prelude + upstreamSource.replace(marker, 'const NO_CORS_HOSTS = new Set();');
+
+const mime = {
+  '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.mjs': 'text/javascript',
+  '.css': 'text/css; charset=utf-8', '.json': 'application/json', '.wasm': 'application/wasm',
+  '.jar': 'application/java-archive', '.ogg': 'audio/ogg', '.png': 'image/png',
+};
+async function asset(file, method) {
+  const path = resolve(site, file);
+  if (!path.startsWith(site + '/')) return new Response('Not found', { status: 404 });
+  try {
+    const info = await fs.stat(path);
+    if (!info.isFile()) return new Response('Not found', { status: 404 });
+    return new Response(method === 'HEAD' ? null : Readable.toWeb(createReadStream(path)), {
+      headers: { 'Content-Length': String(info.size), 'Content-Type': mime[extname(path)] || 'application/octet-stream' },
+    });
+  } catch {
+    return new Response('Not found', { status: 404 });
+  }
+}
+
