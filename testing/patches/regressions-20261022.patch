diff --git a/OpenJDK/tests/DeepMH.java b/OpenJDK/tests/DeepMH.java
new file mode 100644
index 0000000000000000000000000000000000000000..58ab21e373fbcd0e8cb18ff3239f55c8b8a391c6
--- /dev/null
+++ b/OpenJDK/tests/DeepMH.java
@@ -0,0 +1,64 @@
+import java.lang.invoke.MethodHandle;
+import java.lang.invoke.MethodHandles;
+import java.lang.invoke.MethodType;
+
+// Compare bound/direct MethodHandle recursion with java.lang.invoke included
+// and excluded from the JIT allowlist, using identical stack/frame-pad limits.
+// "soe N" records Java stack-overflow handling; recovery uses the depth that
+// already completed during warmup, not the depth that just overflowed.
+// Retain the worker error separately: a truncated log alone proves no cause.
+//
+//   DeepMH [step] [special|static]
+public class DeepMH {
+  private static final MethodType STEP = MethodType.methodType(int.class, int.class);
+  private static MethodHandle staticSelf;
+
+  private MethodHandle self;
+
+  private int step(int n) throws Throwable {
+    return n == 0 ? 0 : 1 + (int) self.invokeExact(n - 1);
+  }
+
+  private static int stepStatic(int n) throws Throwable {
+    return n == 0 ? 0 : 1 + (int) staticSelf.invokeExact(n - 1);
+  }
+
+  public static void main(String[] a) throws Throwable {
+    int stepBy = a.length > 0 ? Integer.parseInt(a[0]) : 250;
+    boolean special = a.length < 2 || !a[1].equals("static");
+    MethodHandles.Lookup lookup = MethodHandles.lookup();
+    DeepMH d = new DeepMH();
+    MethodHandle top;
+    if (special) {
+      d.self = lookup.findSpecial(DeepMH.class, "step", STEP, DeepMH.class).bindTo(d);
+      top = d.self;
+    } else {
+      // Bound to a dummy leading argument, so the call still goes through a
+      // bound handle's LambdaForm before the direct handle's.
+      MethodHandle direct = lookup.findStatic(DeepMH.class, "stepStatic", STEP);
+      staticSelf = MethodHandles.dropArguments(direct, 0, Object.class).bindTo("bound");
+      top = staticSelf;
+    }
+    // Enough calls for the LambdaForms to be customized and compiled.
+    long warm = 0;
+    for (int w = 0; w < 5000; w++) warm += (int) top.invokeExact(10);
+    System.out.println("warm " + warm);
+    int soe = -1;
+    for (int n = stepBy; n <= 400000; n += stepBy) {
+      try {
+        int r = (int) top.invokeExact(n);
+        if (r != n) throw new AssertionError("wrong " + n + " -> " + r);
+      } catch (StackOverflowError e) {
+        soe = n;
+        System.out.println("soe " + n);
+        break;
+      }
+      System.out.println("ok " + n);
+    }
+    if (soe < 0) throw new AssertionError("no overflow within probe depth");
+    int after = (int) top.invokeExact(10);
+    if (after != 10) throw new AssertionError("recovery returned " + after);
+    System.out.println("after " + after);
+    System.out.println("deepmh done");
+  }
+}
diff --git a/OpenJDK/tests/JitStaticStoreReplay.java b/OpenJDK/tests/JitStaticStoreReplay.java
new file mode 100644
index 0000000000000000000000000000000000000000..ac1d681e040c8aee5eee5c6010711d1bd5654f71
--- /dev/null
+++ b/OpenJDK/tests/JitStaticStoreReplay.java
@@ -0,0 +1,67 @@
+public class JitStaticStoreReplay {
+    static int plainCount;
+    static volatile int volatileCount;
+
+    static final class Cell {
+        int value = 7;
+    }
+
+    static int publishPlain(Cell cell) {
+        plainCount++;
+        return cell.value;
+    }
+
+    static int drivePlain(Cell cell) {
+        return publishPlain(cell) + 1;
+    }
+
+    static int publishVolatile(Cell cell) {
+        volatileCount++;
+        return cell.value;
+    }
+
+    static int driveVolatile(Cell cell) {
+        return publishVolatile(cell) + 1;
+    }
+
+    static void expectNull(Runnable action) {
+        try {
+            action.run();
+        } catch (NullPointerException expected) {
+            return;
+        }
+        throw new AssertionError("The field read must throw for a null cell");
+    }
+
+    public static void main(String[] args) {
+        Cell cell = new Cell();
+        long checksum = 0;
+        for (int n = 0; n < 40000; n++) {
+            checksum += drivePlain(cell);
+            checksum += driveVolatile(cell);
+        }
+        if (checksum != 640000 || plainCount != 40000 || volatileCount != 40000)
+            throw new AssertionError("Warm calls lost or duplicated a static store");
+
+        // The cold guard follows the store in the spliced callee. Replaying
+        // that call must not publish the static increment a second time.
+        int before = plainCount;
+        expectNull(() -> drivePlain(null));
+        if (plainCount - before != 1)
+            throw new AssertionError("Plain static store replayed: delta=" + (plainCount - before));
+        before = volatileCount;
+        expectNull(() -> driveVolatile(null));
+        if (volatileCount - before != 1)
+            throw new AssertionError("Volatile static store replayed: delta=" + (volatileCount - before));
+
+        before = plainCount;
+        expectNull(() -> publishPlain(null));
+        if (plainCount - before != 1)
+            throw new AssertionError("Framed root plain store changed: delta=" + (plainCount - before));
+        before = volatileCount;
+        expectNull(() -> publishVolatile(null));
+        if (volatileCount - before != 1)
+            throw new AssertionError("Framed root volatile store changed: delta=" + (volatileCount - before));
+        System.out.println("PASS static-store-replay plain=" + plainCount + " volatile=" + volatileCount + " checksum=" + checksum);
+    }
+}
diff --git a/OpenJDK/tests/JitUnaligned.java b/OpenJDK/tests/JitUnaligned.java
new file mode 100644
index 0000000000000000000000000000000000000000..bd55f3f9610ddd1da118a659d63c9d9d67be70ed
--- /dev/null
+++ b/OpenJDK/tests/JitUnaligned.java
@@ -0,0 +1,124 @@
+import java.lang.invoke.MethodHandles;
+import java.lang.invoke.VarHandle;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/**
+ * jdk.internal.misc.Unsafe's native-endian unaligned accessors
+ * (get/put{Short,Char,Int,Long}Unaligned) as JIT intrinsics, reached the way
+ * the JDK reaches them: heap and direct ByteBuffers in both byte orders, and
+ * byte-array view VarHandles. Every offset 0..7 (each alignment the lowering
+ * dispatches on), the last index that fits, the first that does not, values
+ * with the sign bit set in every piece (short sign-extends, char does not),
+ * and a get made from a small method the JIT inlines or runs frameless.
+ *
+ * Lines starting with "unaligned" must be identical with and without the JIT.
+ */
+public class JitUnaligned {
+    static final VarHandle VS_LE = MethodHandles.byteArrayViewVarHandle(short[].class, ByteOrder.LITTLE_ENDIAN);
+    static final VarHandle VC_BE = MethodHandles.byteArrayViewVarHandle(char[].class, ByteOrder.BIG_ENDIAN);
+    static final VarHandle VI_LE = MethodHandles.byteArrayViewVarHandle(int[].class, ByteOrder.LITTLE_ENDIAN);
+    static final VarHandle VI_BE = MethodHandles.byteArrayViewVarHandle(int[].class, ByteOrder.BIG_ENDIAN);
+    static final VarHandle VL_LE = MethodHandles.byteArrayViewVarHandle(long[].class, ByteOrder.LITTLE_ENDIAN);
+    static final VarHandle VL_BE = MethodHandles.byteArrayViewVarHandle(long[].class, ByteOrder.BIG_ENDIAN);
+
+    // Every byte of each pattern has its top bit set or clear depending on r,
+    // so a lost sign extension or a byte from the wrong piece changes the hash.
+    static short s(int r) { return (short) (0x8001 ^ (r * 0x0101)); }
+    static char c(int r) { return (char) (0xfffe - r * 0x0103); }
+    static int i(int r) { return 0x80ff7f01 ^ (r * 0x01010101); }
+    static long l(int r) { return 0x8000ff7f0180fe02L ^ (r * 0x0101010101010101L); }
+
+    // A small get-only method: a candidate for inlining and for a frameless body.
+    static long peek(ByteBuffer b, int at) {
+        return b.getShort(at) + 3L * b.getChar(at) + 5L * b.getInt(at) + 7L * b.getLong(at);
+    }
+
+    static long buffer(ByteBuffer b, int r) {
+        long h = 0;
+        int lim = b.capacity();
+        for (int at = 0; at < 8; at++) {
+            b.putShort(at, s(r + at));     h = h * 31 + b.getShort(at) + b.get(at) + b.get(at + 1);
+            b.putChar(at + 1, c(r + at));  h = h * 31 + b.getChar(at + 1) + b.get(at + 2);
+            b.putInt(at + 2, i(r + at));   h = h * 31 + b.getInt(at + 2) + b.get(at + 2) + b.get(at + 5);
+            b.putLong(at + 3, l(r + at));  h = h * 31 + b.getLong(at + 3) + b.get(at + 3) + b.get(at + 10);
+            // Overlapping reads across what the last stores wrote.
+            h = h * 31 + b.getInt(at + 1) + b.getLong(at) + b.getShort(at + 7) + b.getChar(at + 9);
+            b.putFloat(at + 4, i(r) * 0.5f);      h = h * 31 + Float.floatToRawIntBits(b.getFloat(at + 4));
+            b.putDouble(at + 5, l(r) * 0.25);     h = h * 31 + Double.doubleToRawLongBits(b.getDouble(at + 5));
+            h = h * 31 + peek(b, at);
+        }
+        // The last index each width fits at, and the first it does not.
+        b.putLong(lim - 8, l(r)); b.putInt(lim - 4, i(r)); b.putShort(lim - 2, s(r));
+        h = h * 31 + b.getLong(lim - 8) + b.getInt(lim - 4) + b.getShort(lim - 2) + b.getChar(lim - 2);
+        int oob = 0;
+        try { b.putLong(lim - 7, 1L); } catch (IndexOutOfBoundsException e) { oob++; }
+        try { b.getInt(lim - 3); } catch (IndexOutOfBoundsException e) { oob++; }
+        try { b.putShort(lim - 1, (short) 1); } catch (IndexOutOfBoundsException e) { oob++; }
+        try { b.getChar(lim - 1); } catch (IndexOutOfBoundsException e) { oob++; }
+        return h * 31 + oob;
+    }
+
+    static long views(byte[] a, int r) {
+        long h = 0;
+        for (int at = 0; at < 8; at++) {
+            VS_LE.set(a, at, s(r + at));       h = h * 31 + (short) VS_LE.get(a, at);
+            VC_BE.set(a, at + 1, c(r + at));   h = h * 31 + (char) VC_BE.get(a, at + 1);
+            VI_LE.set(a, at + 2, i(r + at));   h = h * 31 + (int) VI_LE.get(a, at + 2) + (int) VI_BE.get(a, at + 2);
+            VI_BE.set(a, at + 3, i(r - at));   h = h * 31 + (int) VI_BE.get(a, at + 3) + a[at + 3];
+            VL_LE.set(a, at + 4, l(r + at));   h = h * 31 + (long) VL_LE.get(a, at + 4) + (long) VL_BE.get(a, at + 4);
+            VL_BE.set(a, at + 5, l(r - at));   h = h * 31 + (long) VL_BE.get(a, at + 5) + a[at + 12];
+        }
+        return h;
+    }
+
+    static String hex(ByteBuffer b, int n) {
+        StringBuilder sb = new StringBuilder();
+        for (int k = 0; k < n; k++) sb.append(String.format("%02x", b.get(k) & 0xff));
+        return sb.toString();
+    }
+
+    public static void main(String[] args) {
+        int rounds = args.length > 0 ? Integer.parseInt(args[0]) : 20000;
+        if (args.length > 1 && args[1].equals("bench")) { bench(rounds); return; }
+        ByteBuffer[] bufs = {
+            ByteBuffer.allocate(64), ByteBuffer.allocate(64).order(ByteOrder.LITTLE_ENDIAN),
+            ByteBuffer.allocateDirect(64), ByteBuffer.allocateDirect(64).order(ByteOrder.LITTLE_ENDIAN),
+        };
+        String[] names = { "heap-be", "heap-le", "direct-be", "direct-le" };
+        for (int k = 0; k < bufs.length; k++) {
+            long h = 0;
+            for (int r = 0; r < rounds; r++) h = h * 31 + buffer(bufs[k], r);
+            System.out.println("unaligned " + names[k] + " " + h);
+        }
+        byte[] a = new byte[24];
+        long g = 0;
+        for (int r = 0; r < rounds; r++) g = g * 31 + views(a, r);
+        System.out.println("unaligned views " + g);
+        // Byte layout of one store per piece size, compared byte by byte:
+        // an int at 1 (bytes), a long at 6 (shorts), a short at 17 (bytes), a char at 20 (whole).
+        ByteBuffer le = ByteBuffer.allocateDirect(32).order(ByteOrder.LITTLE_ENDIAN);
+        le.putInt(1, 0x11223344).putLong(6, 0x0102030405060708L).putShort(17, (short) 0xa1b2).putChar(20, (char) 0xc3d4);
+        System.out.println("unaligned bytes " + hex(le, 24) + " " + le.getShort(17) + " " + (int) le.getChar(20));
+    }
+
+    // `JitUnaligned <n> bench`: ns per ByteBuffer put or get on a direct
+    // native-order buffer (the uniform-upload shape): ints at 0 mod 16 and
+    // longs at 4 mod 16, then everything at an odd address.
+    // Timing only; not part of the differential.
+    static void bench(int n) {
+        ByteBuffer b = ByteBuffer.allocateDirect(4096).order(ByteOrder.nativeOrder());
+        for (int pass = 0; pass < 5; pass++) {
+            for (int shift = 0; shift < 2; shift++) {
+                long t0 = System.nanoTime(), sum = 0;
+                for (int r = 0; r < n; r++) {
+                    for (int at = shift; at < 4000; at += 16) { b.putInt(at, r ^ at); b.putLong(at + 4, r); }
+                    for (int at = shift; at < 4000; at += 16) sum += b.getInt(at) + b.getLong(at + 4);
+                }
+                long ops = (long) n * 250 * 4;
+                System.out.println("bench " + (shift == 0 ? "aligned" : "offset1") + " "
+                        + String.format("%.2f", (System.nanoTime() - t0) / (double) ops) + " ns/op checksum " + sum);
+            }
+        }
+    }
+}
diff --git a/OpenJDK/tests/JitVolatileReplay.java b/OpenJDK/tests/JitVolatileReplay.java
new file mode 100644
index 0000000000000000000000000000000000000000..39fb968244ddfa4c9d3d51c4249cfcae7cc56a6e
--- /dev/null
+++ b/OpenJDK/tests/JitVolatileReplay.java
@@ -0,0 +1,326 @@
+import java.util.concurrent.TimeUnit;
+
+/**
+ * A single writer only increases a volatile field. A concurrent reader must
+ * never observe it decreasing, even when a later guard in a writer's inlined
+ * callee fails. Null mode also acknowledges a publication before forcing that
+ * guard; only a replay can then see the acknowledgement at the callee's entry.
+ * Run with -XX:ZeroWasmJITOnly=JitVolatileReplay$Writer so observers and the
+ * JDK run interpreted. The monotonic profile case remains scheduler-dependent;
+ * a run without a decrease does not exonerate the original compiler.
+ */
+public class JitVolatileReplay {
+    static final class Cell {
+        volatile int value;
+        volatile int noise;
+        volatile boolean ready;
+        volatile boolean done;
+        volatile Throwable failure;
+        long checksum;
+        int guardedCalls;
+    }
+
+    static final int ACK_WARM_ROUNDS = 40000;
+    static final int ACK_IMPOSSIBLE = -777;
+    static final int ACK_MISS = -778;
+
+    static final class AckValue {
+        int value = 7;
+    }
+
+    static final class AckCell {
+        volatile int seq;
+        volatile int ack;
+        volatile int armed;
+        volatile int expected;
+        volatile int done;
+        volatile AckValue cold;
+        volatile boolean stop;
+        volatile Throwable failure;
+    }
+
+    interface Gate { int read(int value); }
+    static final class Hot implements Gate {
+        public int read(int value) { return value ^ 0x13579; }
+    }
+    static final class Cold implements Gate {
+        public int read(int value) { return value ^ 0x24680; }
+    }
+    static final class Later implements Gate {
+        public int read(int value) { return value ^ 0x36912; }
+    }
+
+    static final class Writer implements Runnable {
+        final Cell cell;
+        final int rounds;
+        final long deadline;
+        final boolean nullGuards;
+        final Gate hot = new Hot(), cold = new Cold(), later = new Later();
+
+        Writer(Cell cell, int rounds, long deadline, boolean nullGuards) {
+            this.cell = cell;
+            this.rounds = rounds;
+            this.deadline = deadline;
+            this.nullGuards = nullGuards;
+        }
+
+        static int publish(Cell cell, int next, Gate gate) {
+            cell.value = next;
+            // Keep a straight-line, inline-admissible observation window. A
+            // polling loop cannot be spliced by this compiler (forward edges
+            // only), and a native pause would change the effect classification.
+            int salt = cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            salt += cell.noise;
+            // The receiver guard runs AFTER the volatile store. Restoring the
+            // old field before retrying this call violates volatile ordering.
+            return gate.read(next + salt);
+        }
+
+        static int drive(Cell cell, int next, Gate gate) {
+            return publish(cell, next, gate) + 1;
+        }
+
+        // Each window stays below the compiler's 180-byte inline limit. The
+        // nested straight-line calls make one long observation interval while
+        // keeping ackPublish itself eligible for a splice.
+        static int ackWindow0(AckCell cell) {
+            int ignored = cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack;
+            return ackWindow1(cell);
+        }
+
+        static int ackWindow1(AckCell cell) {
+            int ignored = cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack;
+            return ackWindow2(cell);
+        }
+
+        static int ackWindow2(AckCell cell) {
+            int ignored = cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack;
+            return ackWindow3(cell);
+        }
+
+        static int ackWindow3(AckCell cell) {
+            int ignored = cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack;
+            return ackWindow4(cell);
+        }
+
+        static int ackWindow4(AckCell cell) {
+            int ignored = cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack
+                    + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack + cell.ack;
+            return cell.ack;
+        }
+
+        static int ackPublish(AckCell cell, int next) {
+            // During measured attempts expected equals next. An acknowledgement
+            // at entry is therefore possible only after this invocation was
+            // restarted following its volatile seq publication. Warmup sets
+            // expected to zero so it can train the guarded dereference path.
+            if (cell.ack == next && cell.expected == next) return ACK_IMPOSSIBLE;
+            cell.seq = next;
+            int seen = ackWindow0(cell);
+            if (seen != next) return ACK_MISS;
+            // Acquiring ack also acquires the observer's preceding null store.
+            // A correct framed call must throw at this plain field access.
+            return cell.cold.value;
+        }
+
+        static int ackDrive(AckCell cell, int next) {
+            return ackPublish(cell, next);
+        }
+
+        public void run() {
+            try {
+                while (!cell.ready) {
+                    if (System.nanoTime() >= deadline) throw new AssertionError("Observer did not become ready");
+                    Thread.onSpinWait();
+                }
+                long checksum = 0;
+                for (int next = 1; next <= rounds; next++) {
+                    if ((next & 4095) == 0 && System.nanoTime() >= deadline)
+                        throw new AssertionError("Publication probe deadline before completing its fixed rounds");
+                    Gate gate = hot;
+                    if (next > 40000 && (next & 1023) == 0) {
+                        cell.guardedCalls++;
+                        gate = nullGuards ? null : ((next & 2047) == 0 ? cold : later);
+                    }
+                    try {
+                        checksum += drive(cell, next, gate);
+                    } catch (NullPointerException expected) {
+                        if (gate != null) throw expected;
+                        // The Java store preceding the null dereference must
+                        // remain published. This is a specified test input.
+                        checksum += next;
+                    }
+                }
+                cell.checksum = checksum;
+            } catch (Throwable failure) {
+                cell.failure = failure;
+            } finally {
+                cell.done = true;
+            }
+        }
+    }
+
+    static void awaitArmed(AckCell cell, int next, long deadline) {
+        while (cell.armed != next) {
+            if (cell.failure != null) throw new AssertionError("ACK observer failed", cell.failure);
+            if (System.nanoTime() >= deadline)
+                throw new AssertionError("Finite ACK arm deadline expected=" + next + " armed=" + cell.armed);
+            Thread.onSpinWait();
+        }
+    }
+
+    static void awaitAck(AckCell cell, int next, long deadline) {
+        while (cell.done != next) {
+            if (cell.failure != null) throw new AssertionError("ACK observer failed", cell.failure);
+            if (System.nanoTime() >= deadline)
+                throw new AssertionError("Finite ACK deadline expected=" + next + " done=" + cell.done);
+            Thread.onSpinWait();
+        }
+    }
+
+    static void runAckWitness(int rounds, int seconds) throws Exception {
+        AckCell cell = new AckCell();
+        AckValue live = new AckValue();
+        cell.cold = live;
+        long warmChecksum = 0;
+        for (int next = 1; next <= ACK_WARM_ROUNDS; next++) {
+            cell.ack = next;
+            warmChecksum += Writer.ackDrive(cell, next);
+        }
+        if (warmChecksum != (long) ACK_WARM_ROUNDS * live.value)
+            throw new AssertionError("ACK warmup changed: " + warmChecksum);
+
+        int attempts = Math.min(16000, Math.max(4000, rounds / 80));
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(Math.min(seconds, 45));
+        Thread observer = new Thread(() -> {
+            int completed = ACK_WARM_ROUNDS;
+            try {
+                while (!cell.stop) {
+                    int next = cell.expected;
+                    if (next <= completed) {
+                        if (System.nanoTime() >= deadline) throw new AssertionError("ACK observer deadline");
+                        Thread.onSpinWait();
+                        continue;
+                    }
+                    // Publish null before arming the caller. ackPublish still
+                    // dereferences only after this observer sees seq and
+                    // acknowledges it with the following release store.
+                    cell.cold = null;
+                    cell.armed = next;
+                    while (!cell.stop && cell.seq != next) {
+                        if (System.nanoTime() >= deadline)
+                            throw new AssertionError("ACK observer did not see seq=" + next);
+                        Thread.onSpinWait();
+                    }
+                    if (cell.stop) break;
+                    cell.ack = next;
+                    cell.done = next;
+                    completed = next;
+                }
+            } catch (Throwable failure) {
+                cell.failure = failure;
+            }
+        }, "volatile-replay-ack-observer");
+        observer.setDaemon(true);
+        observer.start();
+        int nullGuards = 0, impossibleReturns = 0, misses = 0;
+        try {
+            for (int attempt = 1; attempt <= attempts; attempt++) {
+                int next = ACK_WARM_ROUNDS + attempt;
+                cell.cold = live;
+                cell.expected = next;
+                awaitArmed(cell, next, deadline);
+                try {
+                    int value = Writer.ackDrive(cell, next);
+                    if (value == ACK_IMPOSSIBLE) impossibleReturns++;
+                    else if (value == ACK_MISS) misses++;
+                    else throw new AssertionError("ACK helper returned unexpected value: " + value);
+                } catch (NullPointerException expected) {
+                    nullGuards++;
+                }
+                awaitAck(cell, next, deadline);
+            }
+        } finally {
+            cell.stop = true;
+            observer.join(2000);
+        }
+        if (observer.isAlive()) throw new AssertionError("ACK observer did not stop");
+        if (cell.failure != null) throw new AssertionError("ACK observer failed", cell.failure);
+        System.out.println("volatile-ack attempts=" + attempts + " nullGuards=" + nullGuards
+                + " impossibleReturns=" + impossibleReturns + " misses=" + misses
+                + " warmChecksum=" + warmChecksum);
+        if (impossibleReturns != 0)
+            throw new AssertionError("Volatile publication was undone and replayed: " + impossibleReturns);
+        if (nullGuards == 0)
+            throw new AssertionError("ACK witness never reached the post-publication null guard");
+    }
+
+    public static void main(String[] args) throws Exception {
+        int rounds = args.length > 0 ? Integer.parseInt(args[0]) : 1000000;
+        int seconds = args.length > 1 ? Integer.parseInt(args[1]) : 90;
+        String mode = args.length > 2 ? args[2] : "null";
+        if (rounds < 50000 || rounds > 20000000 || seconds < 1 || seconds > 300
+                || !(mode.equals("null") || mode.equals("profile")))
+            throw new IllegalArgumentException("rounds=50000..20000000 seconds=1..300 mode=null|profile");
+        if (mode.equals("null")) runAckWitness(rounds, seconds);
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
+        Cell cell = new Cell();
+        Thread writer = new Thread(new Writer(cell, rounds, deadline, mode.equals("null")), "volatile-replay-writer");
+        writer.setDaemon(true);
+        writer.start();
+        int maximum = 0, decreases = 0, firstFrom = 0, firstTo = 0;
+        long observations = 0;
+        cell.ready = true;
+        while (!cell.done && System.nanoTime() < deadline) {
+            int observed = cell.value;
+            observations++;
+            if (observed < maximum) {
+                if (decreases++ == 0) { firstFrom = maximum; firstTo = observed; }
+            } else maximum = observed;
+        }
+        writer.join(2000);
+        if (writer.isAlive()) throw new AssertionError("Writer did not finish before the finite deadline");
+        if (cell.failure != null) throw new AssertionError("Writer failed", cell.failure);
+        if (cell.value != rounds || cell.guardedCalls == 0 || observations == 0)
+            throw new AssertionError("Incomplete actual publication coverage: final=" + cell.value
+                    + " guards=" + cell.guardedCalls + " observations=" + observations);
+        System.out.println("volatile-replay mode=" + mode + " rounds=" + rounds + " guardedCalls=" + cell.guardedCalls
+                + " observations=" + observations + " decreases=" + decreases + " firstFrom=" + firstFrom
+                + " firstTo=" + firstTo + " checksum=" + cell.checksum);
+        if (decreases != 0) throw new AssertionError("Published volatile value decreased: " + firstFrom + " -> " + firstTo);
+        System.out.println("PASS volatile-replay: no observed monotonicity violation; not proof the original rollback was unobservable");
+    }
+}
diff --git a/OpenJDK/tests/QueueSignalStress.java b/OpenJDK/tests/QueueSignalStress.java
new file mode 100644
index 0000000000000000000000000000000000000000..077278438e2549f0ca489c2a7744232901939c4f
--- /dev/null
+++ b/OpenJDK/tests/QueueSignalStress.java
@@ -0,0 +1,154 @@
+import java.lang.reflect.Field;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.locks.ReentrantLock;
+
+/**
+ * Warm the real JDK empty-queue offer path, then repeatedly wake its parked
+ * consumer. The executor case adds the actual DelegatedExecutorService ->
+ * ThreadPoolExecutor -> LinkedBlockingQueue path from the server crash. No
+ * replacement queue, lock or executor implementation is used. Every item/task
+ * must be consumed exactly once and in order. This is a targeted stress probe,
+ * not a deterministic reproduction claim for an intermittent JVM race.
+ */
+public class QueueSignalStress {
+    static volatile int consumed;
+    static volatile Throwable failure;
+    static volatile Thread worker;
+    static long checksum;
+
+    static void checkDeadline(long deadline, String phase) {
+        if (failure != null) throw new AssertionError("Worker failed during " + phase, failure);
+        if (System.nanoTime() >= deadline) throw new AssertionError("Finite deadline in " + phase);
+    }
+
+    static void awaitConsumed(int expected, long deadline) throws InterruptedException {
+        while (consumed != expected) {
+            checkDeadline(deadline, "consumer progression expected=" + expected + " actual=" + consumed);
+            if (consumed > expected) throw new AssertionError("Consumer skipped sequence " + expected);
+            Thread.sleep(0, 100000);
+        }
+    }
+
+    static void awaitParked(long deadline) throws InterruptedException {
+        while (worker == null || worker.getState() != Thread.State.WAITING) {
+            checkDeadline(deadline, "real queue consumer parking");
+            if (worker != null && !worker.isAlive()) throw new AssertionError("Consumer terminated before handoff");
+            Thread.sleep(0, 100000);
+        }
+    }
+
+    static void consume(int value) {
+        int expected = consumed + 1;
+        if (value != expected) throw new AssertionError("Out-of-order/duplicate task: expected=" + expected + " actual=" + value);
+        checksum += value;
+        consumed = value;
+    }
+
+    static Field field(Class<?> owner, String name) throws Exception {
+        Field field = owner.getDeclaredField(name);
+        field.setAccessible(true);
+        return field;
+    }
+
+    static String lockState(LinkedBlockingQueue<?> queue) {
+        try {
+            ReentrantLock lock = (ReentrantLock) field(LinkedBlockingQueue.class, "takeLock").get(queue);
+            Object sync = field(ReentrantLock.class, "sync").get(lock);
+            Class<?> aqs = Class.forName("java.util.concurrent.locks.AbstractQueuedSynchronizer");
+            Class<?> aos = Class.forName("java.util.concurrent.locks.AbstractOwnableSynchronizer");
+            Thread owner = (Thread) field(aos, "exclusiveOwnerThread").get(sync);
+            return "actualQueueTakeLock state=" + field(aqs, "state").getInt(sync)
+                    + " owner=" + (owner == null ? "null" : owner.getName())
+                    + " current=" + Thread.currentThread().getName() + " queued=" + lock.getQueueLength()
+                    + " observation=after-fault-not-atomic";
+        } catch (Throwable unavailable) {
+            return "actualQueueTakeLock unavailable=" + unavailable.getClass().getName()
+                    + "; add --add-opens=java.base/java.util.concurrent=ALL-UNNAMED"
+                    + " --add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED";
+        }
+    }
+
+    public static void main(String[] args) throws Exception {
+        String mode = args.length > 0 ? args[0] : "queue";
+        int rounds = args.length > 1 ? Integer.parseInt(args[1]) : 8000;
+        int seconds = args.length > 2 ? Integer.parseInt(args[2]) : 90;
+        if (!(mode.equals("queue") || mode.equals("executor")) || rounds < 4000 || rounds > 100000
+                || seconds < 1 || seconds > 300)
+            throw new IllegalArgumentException("queue|executor rounds=4000..100000 seconds=1..300");
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
+        LinkedBlockingQueue<Integer> queue = new LinkedBlockingQueue<>();
+        // Same submitting JavaThread sees many uncontended signalNotEmpty calls
+        // before the first wait/transfer makes previously cold release paths run.
+        for (int n = 0; n < 30000; n++) {
+            if (!queue.offer(n) || queue.poll() != n) throw new AssertionError("Warm queue lost an item");
+        }
+        ExecutorService executor = null;
+        LinkedBlockingQueue<Runnable> workQueue = null;
+        Throwable primaryFailure = null;
+        try {
+            if (mode.equals("queue")) {
+                worker = new Thread(() -> {
+                    try {
+                        for (int n = 1; n <= rounds; n++) consume(queue.take());
+                    } catch (Throwable caught) { failure = caught; }
+                }, "queue-signal-consumer");
+                worker.setDaemon(true);
+                worker.start();
+            } else {
+                workQueue = new LinkedBlockingQueue<>();
+                ThreadPoolExecutor pool = new ThreadPoolExecutor(1, 1, 0L, TimeUnit.MILLISECONDS, workQueue, runnable -> {
+                    Thread thread = new Thread(runnable, "queue-signal-serial-lane");
+                    thread.setDaemon(true);
+                    thread.setUncaughtExceptionHandler((ignored, caught) -> { failure = caught; });
+                    worker = thread;
+                    return thread;
+                });
+                executor = Executors.unconfigurableExecutorService(pool);
+                // Start the real worker, then require it to park before offers.
+                executor.execute(() -> {});
+            }
+            for (int n = 1; n <= rounds; n++) {
+                awaitConsumed(n - 1, deadline);
+                awaitParked(deadline);
+                if (executor == null) {
+                    if (!queue.offer(n)) throw new AssertionError("Unbounded queue rejected an item");
+                } else {
+                    final int value = n;
+                    executor.execute(() -> consume(value));
+                }
+                awaitConsumed(n, deadline);
+            }
+            if (failure != null) throw new AssertionError("Consumer failed", failure);
+            long expectedChecksum = (long) rounds * (rounds + 1) / 2;
+            if (consumed != rounds || checksum != expectedChecksum || !queue.isEmpty()
+                    || workQueue != null && !workQueue.isEmpty())
+                throw new AssertionError("Actual consumer accounting failed: consumed=" + consumed + " checksum=" + checksum);
+        } catch (Throwable caught) {
+            primaryFailure = caught;
+            System.err.println(lockState(workQueue == null ? queue : workQueue));
+            throw caught;
+        } finally {
+            try {
+                if (executor != null) {
+                    executor.shutdownNow();
+                    if (!executor.awaitTermination(2, TimeUnit.SECONDS))
+                        throw new AssertionError("Owned executor did not stop");
+                } else if (worker != null) {
+                    worker.interrupt();
+                    worker.join(2000);
+                    if (worker.isAlive()) throw new AssertionError("Owned consumer did not stop");
+                }
+            } catch (Throwable cleanupFailure) {
+                if (primaryFailure != null) primaryFailure.addSuppressed(cleanupFailure);
+                else throw cleanupFailure;
+            }
+        }
+        if (failure != null) throw new AssertionError("Consumer failed during cleanup", failure);
+        System.out.println("PASS queue-signal mode=" + mode + " consumed=" + consumed + " checksum=" + checksum
+                + " parkedHandoffs=" + rounds + " pending=0");
+    }
+}
